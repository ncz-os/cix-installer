From 6f6d9822a1e325a25d3ce873bb831a19d760e945 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Sat, 29 Aug 2026 11:02:25 -0400
Subject: [PATCH] drm/cix: populate DPTX connector ELD

trilin_dp_connector_get_modes() owns the SST AUX/DDC EDID read, but it immediately converts the result into a legacy struct edid path. The DP HDMI-codec glue added for Sky1 audio can only return the bytes that DRM stores in connector->eld, so the mode-probe path needs to run through the DRM EDID object update sequence that updates display_info, the EDID property and ELD before modes are exposed.

Read SST EDID through connector->ddc with drm_edid_read(), update the connector with drm_edid_connector_update(), then add modes from the updated EDID blob. Keep trilin_connector_update_modes() on the raw struct edid path so callers that still receive legacy EDID objects, including MST, keep their existing behaviour.

Upstream-Status: Pending
Signed-off-by: Jason Perlow <jperlow@gmail.com>
---
 drivers/gpu/drm/cix/dptx/trilin_drm.c | 22 ++++++++++++++--------
 1 file changed, 14 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/cix/dptx/trilin_drm.c b/drivers/gpu/drm/cix/dptx/trilin_drm.c
index d6ac3d9..a3ed101 100644
--- a/drivers/gpu/drm/cix/dptx/trilin_drm.c
+++ b/drivers/gpu/drm/cix/dptx/trilin_drm.c
@@ -341,24 +341,24 @@ static int trilin_dp_connector_get_modes(struct drm_connector *connector)
 	struct trilin_dp *dp = connector_to_dp(connector);
 	struct drm_display_info *info = &connector->display_info;
 	struct drm_display_mode *mode;
-	struct edid *edid;
+	const struct drm_edid *drm_edid;
 	int ret = 0;
 
 	DP_DEBUG("enter\n");
 
 	if (dp->platform_id != CIX_PLATFORM_EMU) {
-		edid = drm_get_edid(connector, &dp->aux.ddc);
-		if (!edid) { /* try once again */
+		drm_edid = drm_edid_read(connector);
+		if (!drm_edid) { /* try once again */
 			for (int count = 0; count < GET_EDID_RETRY_MAX;
 			     count++) {
 				msleep(20);
-				edid = drm_get_edid(connector, &dp->aux.ddc);
-				if (edid)
+				drm_edid = drm_edid_read(connector);
+				if (drm_edid)
 					break;
 			}
 		}
 
-		if (!edid) {
+		if (!drm_edid) {
 			mode = drm_dp_downstream_mode(connector->dev, dp->dpcd,
 						      dp->downstream_ports);
 			if (mode) {
@@ -376,8 +376,14 @@ static int trilin_dp_connector_get_modes(struct drm_connector *connector)
 			return ret;
 		}
 
-		ret = trilin_connector_update_modes(connector, edid);
-		kfree(edid);
+		ret = drm_edid_connector_update(connector, drm_edid);
+		if (ret) {
+			drm_edid_free(drm_edid);
+			return ret;
+		}
+
+		ret = drm_edid_connector_add_modes(connector);
+		drm_edid_free(drm_edid);
 
 		if (connector->connector_type == DRM_MODE_CONNECTOR_eDP)
 			ret += trilin_dp_add_virtual_modes_noedid(connector);
-- 

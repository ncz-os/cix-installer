From 1ec54b40b1fe6dd7ae10ba314720fcbfe144af23 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Fri, 21 Aug 2026 20:41:00 +0000
Subject: [PATCH] misc: armchina-npu: use IRQ object as dev_id

The AIPU IRQ handler treated request_irq()'s dev_id as a struct device
and then dereferenced dev->driver_data as struct aipu_priv. On Sky1 probe
that drvdata is temporarily the Sky1 SoC private struct before the generic
AIPU probe installs struct aipu_priv. Because the IRQ is requested with
IRQF_PROBE_SHARED, the handler can be invoked immediately during probe and
can reach aipu_job_manager_irq_upper_half() with invalid private data,
faulting in the embedded spinlock.

Pass the IRQ object as dev_id instead. It owns the partition pointer and is
valid before request_irq(), so early IRQF_PROBE_SHARED callbacks either see
an uninitialized partition and return IRQ_NONE or later use the initialized
partition directly. Use the same dev_id for free_irq(), and unregister the
IRQ before destroying the workqueue so no new bottom-half work can be queued
during teardown.

Signed-off-by: Jason Perlow <jperlow@gmail.com>
---
 drivers/misc/armchina-npu/aipu_irq.c | 21 ++++++++++++++-------
 1 file changed, 14 insertions(+), 7 deletions(-)

diff --git a/drivers/misc/armchina-npu/aipu_irq.c b/drivers/misc/armchina-npu/aipu_irq.c
index 10e912b..c2bb706 100755
--- a/drivers/misc/armchina-npu/aipu_irq.c
+++ b/drivers/misc/armchina-npu/aipu_irq.c
@@ -10,8 +10,13 @@
 
 static irqreturn_t aipu_irq_handler_upper_half(int irq, void *dev_id)
 {
-	struct aipu_priv *aipu =(((struct device *)dev_id)->driver_data);
-	struct aipu_partition *partition = aipu->partitions;
+	struct aipu_irq_object *irq_obj = dev_id;
+	struct aipu_partition *partition = NULL;
+
+	if (!irq_obj)
+		return IRQ_NONE;
+
+	partition = irq_obj->partition;
 
 	if (partition && partition->ops && partition->ops->upper_half)
 		return partition->ops->upper_half(partition);
@@ -28,7 +33,8 @@ static void aipu_irq_handler_bottom_half(struct work_struct *work)
 	if (work) {
 		irq_obj = container_of(work, struct aipu_irq_object, work);
 		partition = irq_obj->partition;
-		partition->ops->bottom_half(partition);
+		if (partition && partition->ops && partition->ops->bottom_half)
+			partition->ops->bottom_half(partition);
 	}
 }
 
@@ -62,6 +68,7 @@ struct aipu_irq_object *aipu_create_irq_object(struct device *dev, u32 irqnum, v
 		goto err_handle;
 
 	INIT_WORK(&irq_obj->work, aipu_irq_handler_bottom_half);
+	irq_obj->partition = partition;
 
 	/**
 	 * Flag IRQF_ONESHOT is used when sharing interrupts with other devices using thread_irq.
@@ -69,14 +76,13 @@ struct aipu_irq_object *aipu_create_irq_object(struct device *dev, u32 irqnum, v
 	 */
 	ret = request_irq(irqnum, aipu_irq_handler_upper_half,
 			  IRQF_SHARED | IRQF_PROBE_SHARED,
-			  description, irq_obj->dev);
+			  description, irq_obj);
 	if (ret) {
 		dev_err(dev, "request_irq failed: irqnum %u, ret %d", irqnum, ret);
 		goto err_handle;
 	}
 
 	irq_obj->irqnum = irqnum;
-	irq_obj->partition = partition;
 
 	goto finish;
 
@@ -101,12 +107,12 @@ void aipu_destroy_irq_object(struct aipu_irq_object *irq_obj)
 {
 	if (irq_obj) {
+		if (irq_obj->irqnum)
+			free_irq(irq_obj->irqnum, irq_obj);
 		if (irq_obj->aipu_wq) {
 			flush_workqueue(irq_obj->aipu_wq);
 			destroy_workqueue(irq_obj->aipu_wq);
 			irq_obj->aipu_wq = NULL;
 		}
-		if (irq_obj->irqnum)
-			free_irq(irq_obj->irqnum, irq_obj->dev);
 		kfree(irq_obj);
 	}
 }
@@ -122,5 +128,6 @@ void aipu_irq_schedulework(struct aipu_irq_object *irq_obj)
  */
 void aipu_irq_flush_workqueue(struct aipu_irq_object *irq_obj)
 {
-	flush_workqueue(irq_obj->aipu_wq);
+	if (irq_obj && irq_obj->aipu_wq)
+		flush_workqueue(irq_obj->aipu_wq);
 }
-- 

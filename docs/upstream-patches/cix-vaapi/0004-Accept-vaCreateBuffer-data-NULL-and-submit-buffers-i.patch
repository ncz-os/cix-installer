From 1d3dd7ca8083aaa6accb9a1ab4eeb8b1c22e1141 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Wed, 5 Aug 2026 22:53:54 -0400
Subject: [PATCH 4/6] Accept vaCreateBuffer(data == NULL) and submit buffers in
 client order

Two related defects in the same path.

First, vaCreateBuffer() explicitly permits data == NULL: the buffer is created
uninitialised and the client fills it through vaMapBuffer(). The guard in
MediaDeviceV4l2Stateful::CreateBuffer() rejected that for every type except
VAEncCodedBufferType, returning VA_STATUS_ERROR_INVALID_PARAMETER. Chromium's
VP9 and AV1 decode paths both create their picture parameter buffer that way
(its H.264 path passes the struct inline, which is why only H.264 worked), so
both were rejected before a single frame was submitted.

Second, the payload was handed to the codec at creation time. That discards the
client's submission order: Chromium creates an AV1 slice parameter buffer empty
(so it arrived late) while passing slice data inline (so it arrived early), and
the packer then saw tile data before the slice parameters describing it.

Keep the payload in the buffer and apply it from vaRenderPicture(), which is
where the client defines the order, and apply parameter buffers before data
buffers so a payload can never precede its descriptor.

Signed-off-by: Jason Perlow <jperlow@gmail.com>
---
 devices/v4l2/v4l2_stateful_device.cpp | 76 +++++++++++++++++++++++----
 devices/v4l2/v4l2_stateful_device.h   |  3 ++
 2 files changed, 70 insertions(+), 9 deletions(-)

diff --git a/devices/v4l2/v4l2_stateful_device.cpp b/devices/v4l2/v4l2_stateful_device.cpp
index 4bd39ed..0c55cce 100644
--- a/devices/v4l2/v4l2_stateful_device.cpp
+++ b/devices/v4l2/v4l2_stateful_device.cpp
@@ -17,6 +17,7 @@
 #include <unistd.h>
 #include <fcntl.h>
 #include <string>
+#include <cstring>
 #include <climits>
 #include <linux/videodev2.h>
 #include <sys/ioctl.h>
@@ -408,10 +409,7 @@ VAStatus MediaDeviceV4l2Stateful::CreateBuffer(
     void *data,
     VABufferID *buf_id
 ) {
-    CIX_VAAPI_INFO("CreateBuffer: context %d, type %d, size %d, num_elements %d\n",
-        context, type, size, num_elements);
-    if ((type != VASliceParameterBufferType && num_elements > 1) ||
-        (type != VAEncCodedBufferType && data == nullptr))
+    if (type != VASliceParameterBufferType && num_elements > 1)
         return VA_STATUS_ERROR_INVALID_PARAMETER;
 
     auto bpool = GetBufferPool();
@@ -422,25 +420,53 @@ VAStatus MediaDeviceV4l2Stateful::CreateBuffer(
         buf->id, type, context);
     *buf_id = buf->id;
 
+    if (type == VAEncCodedBufferType)
+        return VA_STATUS_SUCCESS;
+
+    // Keep the payload here rather than handing it to the codec immediately.
+    // vaCreateBuffer() also permits data == NULL, in which case the client
+    // fills the buffer through vaMapBuffer() afterwards. Either way the codec
+    // must see the buffers in the order the client submits them to
+    // vaRenderPicture(), not in creation order: Chromium creates an AV1 slice
+    // parameter buffer empty (deferred) but passes slice data inline, so
+    // applying at creation time fed the tile data to the packer before its
+    // slice parameters existed, and the frame was silently dropped.
+    size_t total = (size_t)size * (num_elements ? num_elements : 1);
+    buf->host_data.assign(total, 0);
+    buf->num_elements = num_elements;
+    if (data != nullptr)
+        memcpy(buf->host_data.data(), data, total);
+
+    return VA_STATUS_SUCCESS;
+}
+
+VAStatus MediaDeviceV4l2Stateful::ApplyBufferData(
+    VAContextID context,
+    VABufferType type,
+    void *data,
+    unsigned int size,
+    unsigned int num_elements,
+    VABufferID buf_id
+) {
     auto codec = codecs[context];
     if (type == VAPictureParameterBufferType) {
-        codec->SetPicParamBuffer(data, size, *buf_id);
+        codec->SetPicParamBuffer(data, size, buf_id);
     } else if (type == VAIQMatrixBufferType) {
         if (codec->SetIQMatrix(data, size) != 0)
             return VA_STATUS_ERROR_OPERATION_FAILED;
     } else if (type == VASliceParameterBufferType) {
         codec->SetSliceParamBuffer(data, size, num_elements);
     } else if (type == VASliceDataBufferType) {
-        codec->SetSliceDataBuffer(data, size, *buf_id);
+        codec->SetSliceDataBuffer(data, size, buf_id);
 #if (VA_MAJOR_VERSION == 1 && VA_MINOR_VERSION == 22 && VA_MICRO_VERSION == 1)
     } else if (type == VASequenceParameterBufferType) {
-        codec->SetSpsBuffer(data, size, *buf_id);
+        codec->SetSpsBuffer(data, size, buf_id);
 #endif
     } else if (type == VAEncCodedBufferType) {
     } else if (type == VAEncSequenceParameterBufferType) {
         codec->SetSeqParamBuffer(data, size);
     } else if (type == VAEncPictureParameterBufferType) {
-        codec->SetPicParamBuffer(data, size, *buf_id);
+        codec->SetPicParamBuffer(data, size, buf_id);
     } else if (type == VAEncSliceParameterBufferType) {
         codec->SetSliceParamBuffer(data, size, num_elements);
     } else if (type == VAEncPackedHeaderParameterBufferType) {
@@ -484,6 +510,32 @@ VAStatus MediaDeviceV4l2Stateful::RenderPicture(
     VABufferID *buffers,
     int num_buffers
 ) {
+    // Buffers created with data == NULL carry their contents in host storage;
+    // hand them to the codec now, in the order the client submits them, before
+    // the codec consumes the buffer list.
+    // Parameter buffers must reach the codec before the payload they describe.
+    // Clients do not guarantee an order within one vaRenderPicture() call --
+    // Chromium submits AV1 tile data ahead of its slice parameters -- so apply
+    // every parameter buffer first, then the data buffers.
+    auto bpool = GetBufferPool();
+    for (int pass = 0; pass < 2; pass++) {
+        for (int i = 0; i < num_buffers; i++) {
+            auto info = bpool->GetBufferInfo(buffers[i]);
+            if (info == nullptr || info->host_data.empty())
+                continue;
+            bool is_data = (info->type == VASliceDataBufferType ||
+                            info->type == VAProtectedSliceDataBufferType);
+            if ((pass == 0) == is_data)
+                continue;
+            unsigned int elements = info->num_elements ? info->num_elements : 1;
+            unsigned int size = (unsigned int)(info->host_data.size() / elements);
+            VAStatus st = ApplyBufferData(context, info->type, info->host_data.data(),
+                                          size, info->num_elements, buffers[i]);
+            if (st != VA_STATUS_SUCCESS)
+                return st;
+        }
+    }
+
     auto codec = codecs[context];
     if (codec->ProcessBuffers(buffers, num_buffers) != 0)
         return VA_STATUS_ERROR_OPERATION_FAILED;
@@ -701,7 +753,13 @@ void MediaDeviceV4l2Stateful::GetSupportedProfiles() {
         EnumProfiles(V4L2_CID_MPEG_VIDEO_H264_PROFILE, false);
         EnumProfiles(V4L2_CID_MPEG_VIDEO_HEVC_PROFILE, false);
         EnumProfiles(V4L2_CID_MPEG_VIDEO_VP9_PROFILE, false);
-        EnumProfiles(V4L2_CID_MVE_VIDEO_AV1_PROFILE, false);
+        // AV1 decode currently stalls: the first frame never completes, so a
+        // client that picks AV1 hangs instead of falling back to software.
+        // Withhold the profile until that is fixed -- clients then choose VP9
+        // or H.264, which decode correctly, or their own software AV1 decoder.
+        // Set CIX_VAAPI_ENABLE_AV1=1 to advertise it anyway for debugging.
+        if (getenv("CIX_VAAPI_ENABLE_AV1"))
+            EnumProfiles(V4L2_CID_MVE_VIDEO_AV1_PROFILE, false);
         // EnumProfiles(V4L2_CID_MPEG_VIDEO_VP8_PROFILE, false);
         Close();
     }
diff --git a/devices/v4l2/v4l2_stateful_device.h b/devices/v4l2/v4l2_stateful_device.h
index d78715a..6969a7e 100644
--- a/devices/v4l2/v4l2_stateful_device.h
+++ b/devices/v4l2/v4l2_stateful_device.h
@@ -90,6 +90,9 @@ public:
         void *data,
         VABufferID *buf_id);
 
+    VAStatus ApplyBufferData(VAContextID context, VABufferType type, void *data,
+                             unsigned int size, unsigned int num_elements, VABufferID buf_id);
+
     VAStatus BeginPicture(VAContextID context, VASurfaceID render_target);
 
     VAStatus RenderPicture(

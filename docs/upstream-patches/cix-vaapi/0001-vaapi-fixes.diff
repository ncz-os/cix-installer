+// Per-plane DRM format for a planar surface exported with one layer per plane.
+static uint32_t GetDrmFormatForPlane(uint32_t fourcc, uint32_t plane)
+{
+    switch (fourcc) {
+    case VA_FOURCC_NV12:
+        return plane == 0 ? DRM_FORMAT_R8 : DRM_FORMAT_GR88;
+    case VA_FOURCC_P010:
+        return plane == 0 ? DRM_FORMAT_R16 : DRM_FORMAT_GR1616;
+    default:
+        return fourcc;
+    }
+}

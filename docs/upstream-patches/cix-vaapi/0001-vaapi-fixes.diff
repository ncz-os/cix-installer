+Surface *SurfacePool::FetchCaptureBoundSurface()
+{
+    // Capture buffers are the decoder's real output targets: CreateBuffers()
+    // binds a pool surface to each V4l2Buffer and clears its ID. One of those
+    // that no client currently owns is exactly what an export-before-decode
+    // should hand back, so the caller ends up holding the buffer the VPU
+    // writes into rather than a throwaway that BeginPicture() will destroy.
+    for (auto surface : surfaces) {
+        if (surface->GetId() == VA_INVALID_SURFACE && surface->HasUser())
+            return surface;
+    }
+
+    return nullptr;
+}
+
+Surface *SurfacePool::FetchUnassignedSurface()
+{
+    // A surface that is merely !IsInUse() can still be bound to a live
+    // VASurfaceID from an earlier frame. Handing one back makes the caller
+    // rebind it, so two VASurfaceIDs alias a single dmabuf and the client
+    // imports somebody else's buffer. Only offer a surface that was never
+    // bound and has no users; the caller falls back to FetchSurface() when
+    // none is free. This is a last resort behind FetchCaptureBoundSurface():
+    // it closes a real aliasing hole, but on its own it did not fix the flat
+    // green frames - exporting a non-decode-target buffer did that.
+    for (auto surface : surfaces) {
+        if (!surface->IsInUse() && surface->GetId() == VA_INVALID_SURFACE &&
+            !surface->HasUser()) {
+            surface->SetInUse(true);
+            return surface;
         }
     }
+
+    return nullptr;
 }
 

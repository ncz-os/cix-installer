@@ -526,15 +526,11 @@ static int v4l2_get_raw_format(V4L2Context* ctx, enum AVPixelFormat *p)
 static int v4l2_get_coded_format(V4L2Context* ctx, uint32_t *p)
 {
     struct v4l2_fmtdesc fdesc;
-    uint32_t v4l2_fmt;

+bool SanitizeInputPlaneSizes(struct v4l2_format* format) {
+  if (!V4L2_TYPE_IS_MULTIPLANAR(format->type)) {
+    return false;
+  }
+
+  v4l2_pix_format_mplane& pix_mp = format->fmt.pix_mp;
+  const auto fourcc = media::Fourcc::FromV4L2PixFmt(pix_mp.pixelformat);
+  if (!fourcc) {
+    return false;
+  }
+
+  const media::VideoPixelFormat video_format = fourcc->ToVideoPixelFormat();
+  const size_t num_color_planes = media::VideoFrame::NumPlanes(video_format);
+  if (num_color_planes == 0 || pix_mp.num_planes != num_color_planes) {
+    return false;
+  }
+
+  bool sanitized = false;
+  const gfx::Size coded_size(base::checked_cast<int>(pix_mp.width),
+                             base::checked_cast<int>(pix_mp.height));
+  for (size_t i = 0; i < pix_mp.num_planes; ++i) {
+    v4l2_plane_pix_format& plane_format = UNSAFE_TODO(pix_mp.plane_fmt[i]);
+    const gfx::Size color_plane_size =
+        media::VideoFrame::PlaneSize(video_format, i, coded_size);
+    const size_t expected_stride =
+        media::VideoFrame::RowBytes(i, video_format, coded_size.width());
+    base::CheckedNumeric<size_t> stride_threshold = expected_stride;
+    stride_threshold *= 4u;
+    const size_t max_reasonable_stride = std::max<size_t>(
+        stride_threshold.ValueOrDefault(std::numeric_limits<size_t>::max()),
+        1024u * 1024u);
+    if (plane_format.bytesperline == 0 ||
+        plane_format.bytesperline > max_reasonable_stride) {
+      VLOGF(1) << "Sanitizing encoder input plane " << i
+               << " bytesperline from " << plane_format.bytesperline << " to "
+               << expected_stride;
+      plane_format.bytesperline = base::checked_cast<uint32_t>(expected_stride);
+      sanitized = true;
+    }
+
+    base::CheckedNumeric<size_t> required_size = plane_format.bytesperline;
+    required_size *= base::checked_cast<size_t>(color_plane_size.height());
+    if (!required_size.IsValid() || required_size.ValueOrDie() == 0 ||
+        !base::IsValueInRangeForNumericType<uint32_t>(
+            required_size.ValueOrDie())) {
+      continue;
+    }
+
+    const size_t expected = required_size.ValueOrDie();
+    base::CheckedNumeric<size_t> threshold = expected;
+    threshold *= 4u;
+    const size_t max_reasonable = std::max<size_t>(
+        threshold.ValueOrDefault(std::numeric_limits<size_t>::max()),
+        64u * 1024u * 1024u);
+    if (plane_format.sizeimage != 0 &&
+        plane_format.sizeimage <= max_reasonable) {
+      continue;
+    }
+
+    VLOGF(1) << "Sanitizing encoder input plane " << i << " sizeimage from "
+             << plane_format.sizeimage << " to " << expected;
+    plane_format.sizeimage = base::checked_cast<uint32_t>(expected);
+    sanitized = true;
+  }
+  return sanitized;
+}

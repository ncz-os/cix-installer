diff --git a/assets/kernel/KERNEL-LIFECYCLE b/assets/kernel/KERNEL-LIFECYCLE
index 99c5c2d7..30462ba9 100644
--- a/assets/kernel/KERNEL-LIFECYCLE
+++ b/assets/kernel/KERNEL-LIFECYCLE
@@ -25,11 +25,12 @@ MIN_VERSION=7.3.3
 CURRENT_KVER_amd64=7.3.3-t2-ncz
 CURRENT_PKG_amd64=7.3.3-r297
 
-# arm64: none promoted. 7.3.0-sky1-ncz (r292/r293) is retired; no 7.3.3 Sky1
-# build exists (7.3.1-sky1-ncz r297 exists only as side-by-side debs and is
-# below MIN_VERSION). See docs/RC-DEFINITION.md "arm64".
-CURRENT_KVER_arm64=
-CURRENT_PKG_arm64=
+# arm64: Sky1 7.3.3-sky1-ncz r298 (ULTRA build 2026-11-07, v7.3.3 d50d994bffa3,
+# meta-cix kb/sky1-7.3.3-r298-20261107), boot-tested on O6N @O6N_BOOT_DATE@ (Image
+# sha256 f47b74e2..., vmlinux build id 19c5ddd7...). Pool dir
+# kernel-staging/r298-7.3.3-sky1-ncz-20261107 (assets/kernel/mainline.release).
+CURRENT_KVER_arm64=7.3.3-sky1-ncz
+CURRENT_PKG_arm64=7.3.3-sky1-ncz+r298
 
 # Retired KVERs, comma-separated: never pinned again, on any arch.
-RETIRED=7.3.0-t2-ncz,7.3.1-t2-ncz,7.3.0-sky1-ncz
+RETIRED=7.3.0-t2-ncz,7.3.1-t2-ncz,7.3.0-sky1-ncz,7.3.1-sky1-ncz
diff --git a/assets/kernel/KERNEL-POLICY b/assets/kernel/KERNEL-POLICY
index 3ad679cf..b91bbc8d 100644
--- a/assets/kernel/KERNEL-POLICY
+++ b/assets/kernel/KERNEL-POLICY
@@ -11,8 +11,7 @@
 #   arm64: assets/kernel/mainline/KVER  (manifest variants.mainline.kver)
 #   amd64: assets/kernel/amd64-stable/KVER
 # Since 2026-11-07 (rc4) amd64 is 7.3.3-t2-ncz (7.3.3-r297, boot-tested on MEDUSA).
-# arm64 is still 7.3.0-sky1-ncz (r292/r293), which is RETIRED: arm64 builds are
-# refused until a 7.3.3 Sky1 build is staged and promoted.
+# arm64 is 7.3.3-sky1-ncz (r298, boot-tested on O6N), the same 7.3.3 as amd64.
 # Which version may be pinned (MIN_VERSION, CURRENT, RETIRED) lives in
 # assets/kernel/KERNEL-LIFECYCLE, written by the kernel-ci promotion registry.
 DEFAULT_BASE=7.3
diff --git a/assets/kernel/mainline.deb-revision b/assets/kernel/mainline.deb-revision
deleted file mode 100644
index a6c0726f..00000000
--- a/assets/kernel/mainline.deb-revision
+++ /dev/null
@@ -1,13 +0,0 @@
-# Packaging revision of the Sky1 kernel debs (linux-image/headers-cixmini,
-# cixmini-boot), when it differs from the staged release in mainline.release.
-# Read by build/build-kernel-debs.sh (default BUILD_REV) and checked by
-# build/check-pin-coherence.sh (== kernel-manifest.json == ncz-packages.tsv;
-# never older than the staged release).  Delete this file when the next staged
-# release (rNNN-...) is packaged at its own revision.
-#
-# r293 (2026-10-27) repackages the staged r292-7.3.0-sky1-ncz-20261023 kernel:
-# same Image (kernel-manifest.json image sha256 e8586c15..., unchanged by
-# 100bd157), overlays rebuilt against the r292 headers (1c2d3371), headers tree
-# kept byte-identical by modules_prepare (a18a8d57), cixmini-boot 1.6
-# (e7417407).  No r293 staging directory or kernel source tag exists.
-r293

FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    gawk wget git diffstat unzip texinfo gcc g++ make build-essential \
    chrpath socat cpio python3 python3-pip python3-pexpect python3-git \
    python3-jinja2 python3-subunit xz-utils debianutils iputils-ping \
    zstd lz4 file locales libacl1 bc libssl-dev libelf-dev bison flex \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
RUN useradd -m -u 1000 -s /bin/bash builder
USER builder
WORKDIR /workdir
ENTRYPOINT ["/bin/bash", "-c"]

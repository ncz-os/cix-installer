build/ota-repo/
build/server-mirror/
build/kernel-debs/
*.r97bak
build/*.squashfs

# Mesa 26.1.3 GPU compute stack (built from source on .66; staged at build time)
assets/gpu/*.tar.gz
assets/gpu/*.tar.zst

# r130 fat-ISO + rescue build artifacts (rebuildable; do NOT commit)
build/desktop-mirror/
build/desktop-mirror.gaps
build/rescue-rootfs/
build/r*-gitlab-upload.json
assets/rescue/*.tar.zst
preseed/*.pre-btrfs.*
assets/mgmt/*.tar.zst
build/mgmt-rootfs/
post-install/buildkite-read-token

# squashfs layer artifacts are BUILD OUTPUTS (1-2GB) — NFS/releases only, never git
assets/squashfs/

# r181: Vivaldi browser .deb — build-time blob (staged via NFS, like base.squashfs)
assets/vivaldi/*.deb
assets/vivaldi/*.gpg
assets/zoder/

# MNEMOS offline container image — build-time OCI archive (~260MB, staged via
# NFS/build-host like base.squashfs). Bundled into the ISO for offline
# `ncz install mnemos`. Regenerate with assets/agent-images/README.md.
assets/agent-images/*.tar
assets/agent-images/*.oci.tar

# 26.7: retired kernel channels (build artifacts like stable/edge; pruned from base.squashfs)
assets/kernel/retired-*/
# rEFInd banner pre-robot backup (dev artifact)
assets/refind/*.bak-pre-*
# split-release ISO parts (leftover build artifacts)
build/*.iso.*-part*

# Singularity Desktop payload — build-time blob (staged via NFS/ARGONAS, like base.squashfs)
assets/singularity/*.tgz

# regreet greeter binary — build-time blob (fetch from .66:/tmp/regreet)
assets/regreet/regreet

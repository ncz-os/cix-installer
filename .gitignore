# squashfs layer artifacts are BUILD OUTPUTS (1-2GB) — NFS/releases only, never git
assets/squashfs/

# r181: Vivaldi browser .deb — build-time blob (staged via NFS, like base.squashfs)
assets/vivaldi/*.deb
assets/vivaldi/*.gpg
assets/zoder/

# MNEMOS offline container image — build-time OCI archive (~260MB, staged via
# NFS/build-host like base.squashfs). Bundled into the ISO for offline
# `ncz install mnemos`. Regenerate with assets/agent-images/README.md.
assets/agent-images/*.tar
assets/agent-images/*.oci.tar

# 26.7: retired kernel channels (build artifacts like stable/edge; pruned from base.squashfs)
assets/kernel/retired-*/
# rEFInd banner pre-robot backup (dev artifact)
assets/refind/*.bak-pre-*
# split-release ISO parts (leftover build artifacts)
build/*.iso.*-part*

# Singularity Desktop payload — build-time blob (staged via NFS/ARGONAS, like base.squashfs)
assets/singularity/*.tgz

# sinty-nm daemon — build-time blob (build singularityos-lab/sinty-nm; fetch from
# .66:/home/jasonperlow/sinty-build/nm-build/out/sinty-nmd)
assets/sinty-nm/sinty-nmd
# singularity-boot-splash — native KMS boot splash, build-time blob
# (build/build-singularity.sh also folds it into the /opt/singularity payload;
# this staged copy is a fallback for 60-boot-splash). arm64 ELF from .66.
assets/singularity-boot-splash/singularity-boot-splash

# Large NOE graphs: the nomic-embed-text-v1.5 .cix is ~500MB, past GitLab's
# 100MB per-file limit. Staged onto the build host like assets/cix-debs and
# baked into the ISO from there; rebuild instructions in assets/models/MODELS-README.md.
assets/models/nomic-embed-text-*.cix

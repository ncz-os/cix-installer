# AI image-gen candidates (only canonical-promoted assets are committed)
assets/branding/_candidates/

# Upstream downloads
downloads/

# Gitignored asset blobs (supplied at build time from cixmini-gen-assets
# on ARGOS, or from a release artifact in CI)
assets/cix-debs/*.deb
assets/kernel/legacy/
assets/kernel/edge/
assets/kernel/*.bin
assets/kernel/*.tgz
assets/sky1-firmware/
# NOTE the trailing /* -- git cannot re-include a file inside an EXCLUDED
# DIRECTORY, so the old `assets/npu/` form silently defeated the negations
# below (npu_embed_v2.py was ignored and untracked despite the ! rule).
assets/npu/*
!assets/npu/npu_embed_v2.py
!assets/npu/ncz-npu-embed-server.py
# The NPU ACPI SSDT override is REPRODUCIBLE FROM SOURCE: keep the ASL in
# git and let build/build-npu-ssdt.sh regenerate npu-acpi-override.cpio.
# Recovered 2026-08-02 from an installed board -- until then the only copy
# of this table was an unexplained binary blob nobody could rebuild.
!assets/npu/ssdt-npucre.asl
assets/rootfs/

# NPU py3.11 uv venv toolchain: relocatable CPython 3.11 (python-build-
# standalone, install_only) + uv static binary. Supplied at build time;
# 46-python311.sh consumes these offline-first. See docs/POST-CIX-NPU-EMBEDDINGS-DRAFT.md.
assets/python311/

# Autoinstall scaffolding (work-in-progress, not r74-shippable)
autoinstall/


# server.pkgs — Server (headless) squashfs delta seed (arm64).
#
# Seed for build/build-squashfs-layers.sh's `server` stage: the explicit set
# of packages layered on top of base.squashfs to produce server.squashfs,
# same mechanism as manifests/desktop.pkgs for the desktop layer. Names only
# (one per line); apt resolves the dependency closure against base + the
# Buildkite/Ubuntu-ports sources wired by post-install/24-apt-sources.sh.
#
# Derived 2026-07-05 from build/server-seed.txt (the offline-mirror seed for
# build-server-mirror.sh -- a different build stage with the same underlying
# package set). This file didn't exist before, so build_layer server never
# had a manifest to build against.
#
# This list MUST be a superset of everything post-install/48-server-variant.sh,
# 38-recovery-container.sh, and the base agent-stack expect on a headless box.

# --- remote access / admin ---
openssh-server
sudo
bash-completion
less
vim
nano
htop
curl
wget
rsync
ca-certificates
gnupg

# --- system services / time / logging ---
chrony
cron
logrotate
unattended-upgrades
software-properties-common

# --- networking ---
netplan.io
systemd-resolved
network-manager
dbus
iproute2
iputils-ping

# --- storage / filesystem tooling ---
e2fsprogs
dosfstools
btrfs-progs
lvm2
parted
gdisk

# --- boot / kernel plumbing ---
efibootmgr
kmod
initramfs-tools
zstd
squashfs-tools

# --- hardware introspection ---
pciutils
usbutils

# --- agent appliance (Server) runtime ---
podman
catatonit
crun
conmon
netavark
# nspawn recovery/management container host runtime (post-install/38)
systemd-container
# NPU/onnxruntime inference (cix-npu-onnxruntime depends on pip)
python3
python3-pip

# --- lockout-prevention (doctrine #9) ---
inetutils-telnetd
openbsd-inetd

# --- boot splash branding (r196: Magnetar shipped stock Xubuntu plymouth
# theme because these packages were never installed, so 60-plymouth.sh's
# rebrand hook bailed at its 'spinner theme not installed' guard) ---
plymouth-theme-spinner
imagemagick

# desktop.pkgs — r130 fat/offline desktop seed (arm64)
#
# Seed for build/build-desktop-mirror.sh: the explicit set of desktop packages
# whose full dependency closure is downloaded from ports.ubuntu.com into
# build/desktop-mirror/ and embedded in the ISO pool. This reverses the old
# "server-only mirror, desktop installs ONLINE" policy (post-install/20-desktop.sh)
# so the desktop layer installs fully offline from file:///cdrom and never stalls
# on a slow/unreachable Ubuntu mirror (the r129 14% / 20-desktop stall).
#
# This list MUST be a superset of everything post-install/20-desktop.sh installs,
# so the bundled pool carries the full closure of the installed desktop.
# Names only (one per line); apt resolves the dependency closure. Component of
# origin (main/universe) is irrelevant — everything is repackaged into our single
# 'main' offline component.

# --- curated Sky1 core (XFCE + LightDM + Xorg fbdev + xrdp + GL) ---
lightdm
lightdm-gtk-greeter
xubuntu-core
xfce4-session
xfce4-power-manager
xfce4-screenshooter
xfce4-taskmanager
xserver-xorg-video-fbdev
xserver-xorg-video-modesetting
xrdp
mesa-utils
vulkan-tools
libglu1-mesa

# --- audio (PipeWire + Pulse shim + WirePlumber + control) ---
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
pavucontrol
xfce4-pulseaudio-plugin

# --- removable media / disks ---
gvfs
gvfs-backends
udisks2
gnome-disk-utility

# --- network applet ---
network-manager-gnome

# --- bluetooth (Sky1 MT7922) ---
bluez
blueman

# --- fonts (Noto base + CJK + colour emoji) ---
fonts-noto-core
fonts-noto-cjk
fonts-noto-color-emoji
fonts-liberation  # vivaldi-stable dependency (52-vivaldi.sh)

# --- archives ---
xarchiver
thunar-archive-plugin
7zip
unrar-free

# --- core apps (PDF / media / image / text) ---
evince
mpv
ristretto
mousepad

# --- panel UX (Whisker menu + clipboard) ---
xfce4-whiskermenu-plugin
xfce4-clipman-plugin

# --- screensaver (2D + GL hacks) ---
# xscreensaver-gl/-gl-extra add the OpenGL hacks (gears, molecule, cubestorm,
# pipes, atlantis, ...). They render via native Mali-G720 Panfrost GL 3.1 once
# 26-gpu-default-open demotes the broken CIX libmali stack (verified .66 metal
# 2026-07-04). x11-utils ships glxinfo/xwd used to verify GL at install/debug.
xscreensaver
xscreensaver-data
xscreensaver-data-extra
xscreensaver-gl
xscreensaver-gl-extra
x11-utils

# --- r130 bucket: desktop completeness (Xubuntu defaults cix lacked) ---
catfish
menulibre
mugshot
gigolo
xfce4-panel-profiles
baobab
gnome-system-monitor
gnome-font-viewer
seahorse
xfce4-dict
xfce4-cpugraph-plugin
xfce4-netload-plugin
xfce4-systemload-plugin
xfce4-weather-plugin
xfce4-places-plugin
xfce4-verve-plugin
xfce4-xkb-plugin

# --- r130 bucket: offline-apt management tools ---
synaptic
gdebi
gdebi-core
software-properties-gtk

# --- r130 bucket: image editing ---
gimp

# --- r130.4 bucket: cix-gstreamer runtime deps (bundle so it force-configures
#     cleanly offline). The vendor deb declares Debian-style libxml2 /
#     libjpeg62-turbo (absent on Ubuntu); the runtime .so's ship under the
#     Ubuntu names libxml2-16 / libjpeg-turbo8, plus the over-broad multi-GPU
#     libdrm-* family it pulls in. ---
libxml2-16
libjpeg-turbo8
libva-glx2
libwayland-bin
libnice10
libdrm-radeon1
libdrm-nouveau2
libdrm-freedreno1
libdrm-tegra0
libdrm-etnaviv1

# --- r130.4 bucket: desktop apps 20-desktop installs that were missing from
#     the offline pool (App Center, Flatpak/portal stack, browsers, tweaks) ---
flatpak
gnome-session-canberra
xdg-desktop-portal-gtk
epiphany-browser
# r181: falkon dropped — it half-configures (iF) on Sky1/qemu (its postinst was
# the desktop apt rc=100), and its stale .desktop launcher errored like the
# mnemos one. Vivaldi (staged .deb, 52-vivaldi.sh) is the default browser now;
# epiphany stays as a lightweight secondary.
feh

# --- r130.4 bucket: GPU/Vulkan validation + benchmark tools 47-llm-stack +
#     16-mesa request (glmark2 is split on Ubuntu: -x11 / -es2-x11 variants;
#     the bare glmark2 / glmark2-es2 names do not exist) ---
vulkan-validationlayers
clinfo
glmark2-x11
glmark2-es2-x11
glmark2-es2-wayland
glmark2-wayland
glslc

# --- r130.4 bucket: agents + system utilities (nodejs/npm for ncz agents,
#     podman DNS, syslog, dialog UI, SVG rasteriser) ---
nodejs
npm
whiptail
rsyslog
librsvg2-bin
aardvark-dns

# --- r181: full podman runtime so `ncz agent install` + `ncz install mnemos`
#     (the MNEMOS desktop icon) work OFFLINE. All present in server/resolute
#     mirrors (bound at build time), so this is a safe explicit pin — 30-agents.sh
#     also apt-installs these, this just guarantees they land in the delta. ---
podman
crun
conmon
netavark
catatonit

# --- r130.4 bucket: Plymouth boot splash theme + asset tooling ---
plymouth-theme-spinner
imagemagick

# --- r164: IceWM — ultra-light alternate WM (selectable at LightDM greeter)
icewm
icewm-common

# --- r178: telnetd fleet lockout-prevention (doctrine #9). Baked here so
# future desktop.squashfs includes it; until then late.sh installs it offline.
inetutils-telnetd
openbsd-inetd

# --- r189.4: 47-llm-stack.sh Vulkan/SPIR-V substrate (was never wired into
#     MACHINE_HOOKS_RE, so this hook never ran and these packages were never
#     in the offline-mirror closure either -- fixing both together). ---
libvulkan-dev
glslang-tools
glslang-dev
spirv-tools
spirv-headers
vulkan-tools
vulkan-validationlayers
clinfo
glmark2-x11
glmark2-es2-x11
glmark2-wayland

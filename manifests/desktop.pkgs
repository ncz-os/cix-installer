podman
crun
conmon
netavark
aardvark-dns
catatonit

# --- console fallback (telnet — fleet doctrine) -----------------------------
inetutils-telnetd
openbsd-inetd

# --- toolchain bits some post-install hooks use -----------------------------
nodejs
npm


libxml2-16
# Debian's ABI package name; replaces Ubuntu's libjpeg-turbo8.
libjpeg62-turbo
libva-glx2
libwayland-bin
libnice10
libdrm-radeon1
libdrm-nouveau2
libdrm-freedreno1
libdrm-tegra0
libdrm-etnaviv1

# --- desktop app infrastructure --------------------------------------------
# 21-flatpak-arch-filter.sh configures Flathub with a deny-by-default target-architecture
# filter, so neither the app store nor the CLI catalogue can expose foreign refs.
flatpak
gnome-session-canberra
xdg-desktop-portal-gtk
epiphany-browser
# r181: falkon dropped — it half-configures (iF) on Sky1/qemu (its postinst was
# the desktop apt rc=100), and its stale .desktop launcher errored like the
# mnemos one. Vivaldi (staged .deb, 52-vivaldi.sh) is the default browser now;
# epiphany stays as a lightweight secondary.
feh


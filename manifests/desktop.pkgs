polkitd
xdg-desktop-portal

# --- system bus (dbus-broker replaces dbus-daemon as the actual bus) --------
# dbus-broker is the modern D-Bus system-bus implementation
# (https://github.com/bus1/dbus-broker) and the recommended default on
# Debian forky. The legacy 'dbus' package (provides /usr/bin/dbus-daemon)
# is kept as a compatibility package because a small number of binaries
# exec() it directly — but no systemd unit points at it; the broker
# daemon owns the system bus (dbus-broker.service replaces
# dbus.service as the bus activator). libdbus-based clients
# (sinty-nm, polkit, seatd, PipeWire/WirePlumber, xdg-desktop-portal,
# greetd, our singularity portal) all work transparently with either
# implementation, so this is a pure drop-in.
dbus
dbus-broker

# --- AppArmor (NCZ-OS 26.7 audit W3.5) --------------------------------------
# Mandatory access control via AppArmor. The kernel config
# (assets/kernel/edge/config-7.2.0-rc7-sky1-ncz, verified at audit time):
#   CONFIG_SECURITY_APPARMOR=y
#   CONFIG_DEFAULT_SECURITY_APPARMOR=y
#   CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,apparmor,selinux,smack,tomoyo,bpf,ipe"
# i.e. AppArmor is built AND is the default LSM (no lsm= cmdline override
# needed; the broker boots in enforce mode for shipped profiles).
#
# apparmor-profiles pulls the upstream Debian profile bundle
# (usr.sbin.*, abstractions/, tunables/). apparmor-utils ships the
# `aa-complain` / `aa-enforce` / `aa-disable` admin CLI; not strictly
# required for boot, but the post-install hook uses them to load and
# enforce the bundled profiles, and operators will want them for
# per-service overrides.
#
# The systemd unit (apparmor.service) loads shipped profiles at boot.
# post-install/92-apparmor-enable.sh enables that unit and verifies
# `aa-status` reports the loaded profile set on first boot.
apparmor
apparmor-profiles
apparmor-utils

# --- native Wayland screensaver / idle-lock (57-screensaver) ----------------
# swayidle = wlroots ext-idle-notify idle timer; swaylock = fallback blank lock
# (the native Singularity lockscreen is primary); wlopm = wlr-output-power DPMS.
# These REPLACE X11 xscreensaver (NOT in this closure — wrong stack for Mali/WL).
swayidle
swaylock
wlopm
# "Screensaver & Lock" config app (ncz-screensaver-settings) is Python GTK4 +
# libadwaita — needs the GObject-introspection bindings + typelibs at runtime
# (the Vala Singularity apps link the libs directly and don't pull these).
python3-gi
gir1.2-gtk-4.0
gir1.2-adw-1
gir1.2-glib-2.0


#     (the MNEMOS desktop icon) work OFFLINE. All present in server/resolute
#     mirrors (bound at build time), so this is a safe explicit pin — 30-agents.sh
#     also apt-installs these, this just guarantees they land in the delta. ---
podman
crun
conmon
netavark
catatonit

# --- r164: IceWM — ultra-light alternate WM (selectable at LightDM greeter)
icewm
icewm-common

# --- r178: telnetd fleet lockout-prevention (doctrine #9). Baked here so
# future desktop.squashfs includes it; until then late.sh installs it offline.
inetutils-telnetd
openbsd-inetd

# --- r189.4: 47-llm-stack.sh Vulkan/SPIR-V substrate (was never wired into
#     MACHINE_HOOKS_RE, so this hook never ran and these packages were never
#     in the offline-mirror closure either -- fixing both together). ---
libvulkan-dev
glslang-tools
glslang-dev
spirv-tools
spirv-headers
vulkan-tools
vulkan-validationlayers
clinfo
glmark2-x11
glmark2-es2-x11
glmark2-wayland
shotcut
kdenlive
handbrake
ffmpeg
audacity
vlc

# --- GTK4/libadwaita native-Wayland apps, hardware-accelerated via GSK's
#     GL renderer (GSK_RENDERER=gl, already set in singularity-desktop-session).
#     kooha fixes the earlier screen-recording bug -- goes through
#     xdg-desktop-portal's ScreenCast interface, which singularity.portal
#     does implement. celluloid is a native GTK4 GUI complement to the CLI
#     mpv already above (same VAAPI hardware decode path). loupe is GNOME's
#     GPU-accelerated image viewer. The rest are small, real desktop-
#     completeness gaps (calc/text-editor/font-viewer/characters/calendar/
#     weather/sound-recorder/drawing), no GNOME-shell dependency drag. ---
kooha
celluloid
loupe
gnome-calculator
gnome-text-editor
gnome-font-viewer
gnome-characters
gnome-calendar
gnome-weather
gnome-sound-recorder
drawing
# Additional Wayland-first utilities: native image viewers and GNOME Console.
# These are small, composited clients and do not pull in a second desktop
# session or an Xorg server; Xwayland remains only for legacy applications.
imv
swayimg
gnome-console

# zstd: post-install/72-rescue-partition.sh unpacks rescue-rootfs.tar.zst on the
# installed system and hard-requires it. The base layer is the Debian forky
# rootfs tarball, which (unlike Ubuntu) does not ship zstd, and the base layer
# installs no manifest -- so this delta is what puts it on the target. Without
# it 72 aborts, RESCUE_READY is never written, and ncz-refind-refresh refuses
# to install BOOTAA64.EFI, failing the install as unbootable.
zstd

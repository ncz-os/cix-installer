From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2000
From: Stuart Shelton <srcshelton@gmail.com>
Subject: [PATCH] firmware: arm_scmi: preserve rational perf-level frequency scale

Some SCMI firmware uses performance levels that do not divide the
sustained frequency into an integer Hz-per-level multiplier.  The
current code truncates the multiplier once and then reuses that
truncated value, accumulating small frequency errors and warning even
though the firmware-provided ratio is coherent.

Store the sustained frequency in Hz and convert non-indexing
performance levels with the original sustained_freq/sustained_perf
ratio.  Convert Hz requests back to the closest performance level so
OPP frequencies round-trip to the levels that firmware advertised.
Keep the existing 1000 multiplier fallback for level-indexing/
indicative-frequency domains and malformed attributes.

Ported from srcshelton/gentoo-ebuilds:
  30195-firmware-arm-scmi-use-rational-perf-frequency-conversion-adapted.patch

Signed-off-by: Stuart Shelton <srcshelton@gmail.com>
[adapted: see upstream patch headers for original rationale,
 applied against 176-patches state with 0183 dedup adaptation]
Signed-off-by: Jason Perlow <jperlow@gmail.com>
---
diff --git a/drivers/firmware/arm_scmi/perf.c b/drivers/firmware/arm_scmi/perf.c
index 4b0a96ebf..b100958f4 100644
--- a/drivers/firmware/arm_scmi/perf.c
+++ b/drivers/firmware/arm_scmi/perf.c
@@ -11,6 +11,7 @@
 #include <linux/hashtable.h>
 #include <linux/io.h>
 #include <linux/log2.h>
+#include <linux/math64.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
@@ -156,6 +157,7 @@ struct perf_dom_info {
 	u32 rate_limit_us;
 	u32 sustained_freq_khz;
 	u32 sustained_perf_level;
+	u64 sustained_freq_hz;
 	unsigned long mult_factor;
 	struct scmi_perf_domain_info info;
 	struct scmi_opp opp[MAX_OPPS];
@@ -287,9 +289,12 @@ scmi_perf_domain_attributes_get(const struct scmi_protocol_handle *ph,
 					le32_to_cpu(attr->sustained_freq_khz);
 		dom_info->sustained_perf_level =
 					le32_to_cpu(attr->sustained_perf_level);
+		dom_info->sustained_freq_hz =
+					dom_info->sustained_freq_khz * 1000ULL;
 		/*
-		 * sustained_freq_khz = mult_factor * sustained_perf_level
-		 * mult_factor must be non zero positive integer(not fraction)
+		 * Keep a legacy integer multiplier for level-indexing domains
+		 * and malformed sustained attributes. Non-indexing domains use
+		 * the exact sustained_freq/sustained_perf ratio when converting.
 		 */
 		if (!dom_info->sustained_freq_khz ||
 		    !dom_info->sustained_perf_level ||
@@ -298,13 +303,8 @@ scmi_perf_domain_attributes_get(const struct scmi_protocol_handle *ph,
 			dom_info->mult_factor =	1000;
 		} else {
 			dom_info->mult_factor =
-					(dom_info->sustained_freq_khz * 1000UL)
-					/ dom_info->sustained_perf_level;
-			if ((dom_info->sustained_freq_khz * 1000UL) %
-			    dom_info->sustained_perf_level)
-				dev_dbg(ph->dev,
-					 "multiplier for domain %d rounded\n",
-					 dom_info->id);
+					div_u64(dom_info->sustained_freq_hz,
+						dom_info->sustained_perf_level);
 		}
 		if (!dom_info->mult_factor)
 			dev_warn(ph->dev,
@@ -509,6 +509,63 @@ scmi_perf_domain_lookup(const struct scmi_protocol_handle *ph, u32 domain)
 	return pi->dom_info + domain;
 }
 
+static unsigned long scmi_perf_level_to_freq(struct perf_dom_info *dom,
+					     u32 level)
+{
+	u64 freq;
+
+	if (!dom->sustained_freq_hz || !dom->sustained_perf_level ||
+	    dom->level_indexing_mode) {
+		if (!dom->mult_factor)
+			return 0;
+
+		freq = (u64)level * dom->mult_factor;
+	} else {
+		freq = mul_u64_u32_div(dom->sustained_freq_hz, level,
+				       dom->sustained_perf_level);
+	}
+
+	return min_t(u64, freq, ULONG_MAX);
+}
+
+static u32 scmi_perf_freq_to_level(struct perf_dom_info *dom,
+				   unsigned long freq)
+{
+	u64 level, this_freq, next_freq, this_delta, next_delta;
+
+	if (!dom->sustained_freq_hz || !dom->sustained_perf_level ||
+	    dom->level_indexing_mode) {
+		if (!dom->mult_factor)
+			return 0;
+
+		return freq / dom->mult_factor;
+	}
+
+	level = mul_u64_u64_div_u64(freq, dom->sustained_perf_level,
+				    dom->sustained_freq_hz);
+	if (level >= U32_MAX)
+		return U32_MAX;
+
+	this_freq = scmi_perf_level_to_freq(dom, level);
+	next_freq = scmi_perf_level_to_freq(dom, level + 1);
+	this_delta = this_freq > freq ? this_freq - freq : freq - this_freq;
+	next_delta = next_freq > freq ? next_freq - freq : freq - next_freq;
+
+	if (next_delta < this_delta)
+		level++;
+
+	return level;
+}
+
+static unsigned long scmi_perf_opp_to_freq(struct perf_dom_info *dom,
+					   struct scmi_opp *opp)
+{
+	if (dom->level_indexing_mode)
+		return scmi_perf_level_to_freq(dom, opp->indicative_freq);
+
+	return scmi_perf_level_to_freq(dom, opp->perf);
+}
+
 static const struct scmi_perf_domain_info *
 scmi_perf_info_get(const struct scmi_protocol_handle *ph, u32 domain)
 {
@@ -894,10 +951,7 @@ static int scmi_dvfs_device_opps_add(const struct scmi_protocol_handle *ph,
 		return 0;
 
 	for (idx = 0; idx < dom->opp_count; idx++) {
-		if (!dom->level_indexing_mode)
-			freq = dom->opp[idx].perf * dom->mult_factor;
-		else
-			freq = dom->opp[idx].indicative_freq * dom->mult_factor;
+		freq = scmi_perf_opp_to_freq(dom, &dom->opp[idx]);
 
 		/*
 		 * Some firmware DVFS tables expose several performance levels
@@ -907,9 +961,8 @@ static int scmi_dvfs_device_opps_add(const struct scmi_protocol_handle *ph,
 		 * warning, so skip a frequency an earlier level already added.
 		 */
 		for (j = 0; j < idx; j++) {
-			unsigned long prev = !dom->level_indexing_mode ?
-				dom->opp[j].perf * dom->mult_factor :
-				dom->opp[j].indicative_freq * dom->mult_factor;
+			unsigned long prev = scmi_perf_opp_to_freq(dom,
+								  &dom->opp[j]);
 
 			if (prev == freq)
 				break;
@@ -918,7 +971,8 @@ static int scmi_dvfs_device_opps_add(const struct scmi_protocol_handle *ph,
 			continue;
 
 		/* All OPPs above the sustained frequency are treated as turbo */
-		data.turbo = freq > dom->sustained_freq_khz * 1000UL;
+		data.turbo = freq > min_t(u64, dom->sustained_freq_hz,
+					  ULONG_MAX);
 
 		data.level = dom->opp[idx].perf;
 		data.freq = freq;
@@ -979,7 +1033,7 @@ static int scmi_dvfs_freq_set(const struct scmi_protocol_handle *ph, u32 domain,
 		return PTR_ERR(dom);
 
 	if (!dom->level_indexing_mode) {
-		level = freq / dom->mult_factor;
+		level = scmi_perf_freq_to_level(dom, freq);
 	} else {
 		struct scmi_opp *opp;
 
@@ -1010,7 +1064,7 @@ static int scmi_dvfs_freq_get(const struct scmi_protocol_handle *ph, u32 domain,
 		return ret;
 
 	if (!dom->level_indexing_mode) {
-		*freq = level * dom->mult_factor;
+		*freq = scmi_perf_level_to_freq(dom, level);
 	} else {
 		struct scmi_opp *opp;
 
@@ -1018,7 +1072,7 @@ static int scmi_dvfs_freq_get(const struct scmi_protocol_handle *ph, u32 domain,
 		if (!opp)
 			return -EIO;
 
-		*freq = opp->indicative_freq * dom->mult_factor;
+		*freq = scmi_perf_opp_to_freq(dom, opp);
 	}
 
 	return ret;
@@ -1038,10 +1092,7 @@ static int scmi_dvfs_est_power_get(const struct scmi_protocol_handle *ph,
 		return PTR_ERR(dom);
 
 	for (opp = dom->opp, idx = 0; idx < dom->opp_count; idx++, opp++) {
-		if (!dom->level_indexing_mode)
-			opp_freq = opp->perf * dom->mult_factor;
-		else
-			opp_freq = opp->indicative_freq * dom->mult_factor;
+		opp_freq = scmi_perf_opp_to_freq(dom, opp);
 
 		if (opp_freq < *freq)
 			continue;
@@ -1163,16 +1214,14 @@ scmi_perf_xlate_opp_to_freq(struct perf_dom_info *dom,
 		opp = xa_load(&dom->opps_by_lvl, index);
 		if (!opp)
 			return -ENODEV;
-
-		*freq = opp->perf * dom->mult_factor;
 	} else {
 		opp = xa_load(&dom->opps_by_idx, index);
 		if (!opp)
 			return -ENODEV;
-
-		*freq = opp->indicative_freq * dom->mult_factor;
 	}
 
+	*freq = scmi_perf_opp_to_freq(dom, opp);
+
 	return 0;
 }
 

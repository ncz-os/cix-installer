From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Thu, 30 Jul 2026 18:00:00 -0400
Subject: [PATCH] drm/panthor: route SCMI DVFS through perf OPP device

The Sky1 SCMI performance domain owns the OPP table when Panthor uses
the DT multi-domain path. The devfreq callback must resolve and set OPPs
on that domain device, not the GPU platform device. Also advance through
the actual OPP rates when copying the SCMI table; incrementing by 1 Hz
repeatedly only discovers the first OPP.

Upstream-Status: Inappropriate [oe-specific]
---
diff --git a/drivers/gpu/drm/panthor/panthor_devfreq.c b/drivers/gpu/drm/panthor/panthor_devfreq.c
index 61ed91dfe43c..1e45be5bcb61 100644
--- a/drivers/gpu/drm/panthor/panthor_devfreq.c
+++ b/drivers/gpu/drm/panthor/panthor_devfreq.c
@@ -126,13 +126,14 @@ static int panthor_devfreq_target(struct device *dev, unsigned long *freq,
 {
 	struct panthor_device *ptdev = dev_get_drvdata(dev);
 	struct panthor_devfreq *pdevfreq = ptdev->devfreq;
+	struct device *opp_dev = pdevfreq->opp_dev ?: dev;
 	struct dev_pm_opp *opp;
 	unsigned long target_freq;
 	unsigned long irqflags;
 	ktime_t now;
 	int err;
 
-	opp = devfreq_recommended_opp(dev, freq, flags);
+	opp = devfreq_recommended_opp(opp_dev, freq, flags);
 	if (IS_ERR(opp))
 		return PTR_ERR(opp);
 	target_freq = *freq;
@@ -167,7 +168,7 @@ static int panthor_devfreq_target(struct device *dev, unsigned long *freq,
 	spin_unlock_irqrestore(&pdevfreq->lock, irqflags);
 
 	/* Actual SCMI frequency change (may sleep on mailbox) */
-	err = panthor_devfreq_scmi_set_freq(dev, target_freq);
+	err = panthor_devfreq_scmi_set_freq(opp_dev, target_freq);
 
 	spin_lock_irqsave(&pdevfreq->lock, irqflags);
 
@@ -199,7 +200,7 @@ static int panthor_devfreq_target(struct device *dev, unsigned long *freq,
 			drm_info(&ptdev->base,
 				 "GPU DVFS: boosting to safe freq %lu MHz\n",
 				 pdevfreq->safe_freq / 1000000);
-			err = panthor_devfreq_scmi_set_freq(dev,
+			err = panthor_devfreq_scmi_set_freq(opp_dev,
 						       pdevfreq->safe_freq);
 
 			spin_lock_irqsave(&pdevfreq->lock, irqflags);
@@ -300,19 +301,24 @@ static int panthor_devfreq_scmi_init(struct panthor_device *ptdev,
 		if (count <= 0)
 			return 0;
 
-		for (i = 0, freq = 0; ; i++, freq++) {
+		for (i = 0, freq = 0; ; i++) {
 			opp = dev_pm_opp_find_freq_ceil(opp_dev, &freq);
 			if (IS_ERR(opp))
 				break;
-			dev_pm_opp_put(opp);
 
+			freq = dev_pm_opp_get_freq(opp);
 			ret = dev_pm_opp_add(dev, freq, 0);
-			if (ret) {
+			dev_pm_opp_put(opp);
+			if (ret && ret != -EEXIST) {
 				drm_warn(&ptdev->base,
 					 "Failed to add OPP %lu Hz: %d\n",
 					 freq, ret);
 				break;
 			}
+
+			if (freq == ULONG_MAX)
+				break;
+			freq++;
 		}
 
 		if (i == 0)
-- 

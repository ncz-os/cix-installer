# SCMI hwmon sensors. MEASURED 2026-08-16: absent from this lean defconfig, so
# olddefconfig took the default n and the driver was never built. On O6N the
# SCMI stack itself came up fine -- perf (12 domains), clocks and genpd all
# registered, and the log even reads "ACPI: activating SCMI protocol 0x12",
# the SENSOR protocol -- but no device was created for 0x12 and no hwmon chip
# appeared. The board showed 5 bare ACPI thermal zones (TZB0 TZB1 TZM0 TZM1
# TZGT, unlabelled) instead of the 22 labelled readings (CPU_B0, GPU_AVE, NPU,
# VPU, DDR_top, PCB_AMB, ...) that 7.0.12 shows, where this symbol is =y.
# Nothing to do with acpi_scmi_en, which only chooses a clock provider.
CONFIG_SENSORS_ARM_SCMI=y
CONFIG_NVME_HOST_AUTH=y
CONFIG_SRAM=y
# ARMCHINA_NPU MUST NOT BE BUILT IN-TREE. The accelerator ships as a vendor
# DKMS module (cix-npu-kmd -> updates/dkms/aipu.ko), and an in-tree copy wins
# modprobe, so the DKMS module is rejected outright. Measured on O6N with r239:
#
#   armchina CIXH4000:00: sky1_npu_probe: NPU core num is 3
#   armchina CIXH4000:00: sky1_npu_probe: armchina_aipu_probe done
#   aipu: exports duplicate symbol armchina_aipu_alloc_dma_buf (owned by armchina_npu)
#   aipu: exports duplicate symbol armchina_aipu_alloc_dma_buf (owned by armchina_npu)
#
# i.e. the in-tree armchina_npu.ko (kernel/drivers/misc/armchina-npu/) claims
# the symbols first and the vendor module cannot load at all. This is exactly
# what build-kernel-debs.sh has been warning about on every single build:
#
#   WARN: [edge] CONFIG_ARMCHINA_NPU=m is IN-TREE ... an in-tree copy masks the
#   validated overlay/DKMS module at modprobe time
#
# and it matches the standing rule that CIX accelerator drivers ship DKMS,
# never in-tree.
#
# NOTE: turning this off does not by itself make the NPU usable. There is no
# userspace driver on the image at all (nothing under /usr/lib matching noe/npu),
# so the device has no consumer either way. What this fixes is the kernel side
# sabotaging its own vendor module.
#
# CONFIG_VIDEO_LINLON is deliberately LEFT AS IS despite the same warning: on a
# real r239 install no in-tree mvx module is produced at all, the only module on
# disk is updates/dkms/amvx.ko, and the VPU works in both directions (H.264
# decode 90 frames @45x, encode 60 frames verified). Nothing is shadowed there,
# so changing it would be a blind edit to a working path.
# CONFIG_ARMCHINA_NPU is not set

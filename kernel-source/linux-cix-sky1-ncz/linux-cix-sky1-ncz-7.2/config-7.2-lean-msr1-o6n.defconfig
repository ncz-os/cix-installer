CONFIG_SQUASHFS=m
# The INSTALLER boots from an ISO9660 image. Without this the kernel brings up
# the USB stick as a block device and then cannot mount it, and debian-installer
# reports "No device for installation media was detected" -- which looks like a
# missing storage driver but is not: USB_STORAGE, UAS, SCSI, BLK_DEV_SD and
# XHCI are all already built in. The lean pass dropped ISO9660 as unnecessary,
# which is true for the installed system and fatal for the installer.
# JOLIET + NLS_UTF8 are needed for the long filenames the image actually uses.
# The INSTALLER mounts its root filesystem out of base.squashfs and
# desktop.squashfs, and a squashfs can only be mounted through a loop device.
# Without this the install cannot complete no matter what else is fixed: d-i
# gets past media detection and then has nothing to unpack from. The lean pass
# dropped it because an installed system never loop-mounts anything.
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_NLS_UTF8=y
CONFIG_SQUASHFS_XZ=y
# uinput lets a userspace process create a virtual keyboard/mouse. The lean
# pass dropped it, which is defensible for an appliance and costly for us: with
# no /dev/uinput there is no way to drive the desktop from a script, so every
# UI-level check on O6 (hot-corner behaviour, launcher open/close, overlay
# dismissal) has to be done by hand at the machine. Measured 2026-08-12 --
# `modprobe uinput` found nothing to load because it is not built at all, and
# three Singularity fixes had to ship validated only at the Wayland-protocol
# layer. Module, not builtin: nothing needs it at boot.
CONFIG_INPUT_UINPUT=m
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_DEVFREQ_GOV_POWERSAVE=y
CONFIG_DEVFREQ_GOV_USERSPACE=y
CONFIG_DEVFREQ_GOV_PASSIVE=y
CONFIG_KEYBOARD_IMX_BBM_SCMI=y
CONFIG_SND_SOC_CIX=m
CONFIG_SND_SOC_SOF=m
CONFIG_SND_SOC_SOF_CIX_SKY1=m
CONFIG_SND_SOC_HDMI_CODEC=m
CONFIG_USB_CDNSP_SKY1=y
CONFIG_RTC_DRV_IMX_BBM_SCMI=y
CONFIG_COMMON_CLK_SCMI=y
CONFIG_RESET_SCMI=y
CONFIG_RESET_SKY1=y
CONFIG_SND_COMPRESS_OFFLOAD=m
CONFIG_SND_SOC_COMPRESS=y
CONFIG_SND_SOC_TOPOLOGY=y
CONFIG_SND_SOC_SOF_OF=m
CONFIG_SND_SOC_SOF_OF_DEV=m
CONFIG_SND_SOC_SOF_COMPRESS=y
CONFIG_SND_SOC_SOF_IPC3=y
CONFIG_SND_SOC_SOF_CIX_TOPLEVEL=y
CONFIG_SND_SOC_SOF_CIX_COMMON=m
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y

# ---------------------------------------------------------------------------
# Restored from the 7.0.12 config after a config diff, 2026-08-13.
#
# 7.0.12 installs from a USB stick on this hardware; 7.2 r218 does not -- d-i
# fails at "Detect and mount installation media" with 14 xhci root hubs up,
# cdnsp-sky1 bound to all nine CIXH2030 instances, and ZERO devices enumerated
# on any port (serial-captured from the d-i shell on O6N). Diffing the two
# BUILT configs is what surfaced these; the initrd module prune was not the
# cause (drivers/usb and drivers/gpu are both present in the installer).
#
# PHYLINK: 7.0.12 had it builtin, 7.2 dropped it entirely. It is the generic
# MAC<->PHY layer a lot of ethernet drivers bind through, so losing it can take
# wired networking with it -- and d-i on O6N had no network at all (no ping, no
# ssh) while the installed 7.2 system does.
CONFIG_PHYLINK=y

# USB ethernet: the whole class went away. These are the dongles people
# actually install through when the on-board NIC is unusable, and d-i is
# wired-only here because the wireless drivers are pruned from the initrd for
# size. Cheap to carry as modules.
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_SMSC95XX=m
CONFIG_USB_LAN78XX=m
CONFIG_USB_RTL8152=m

# Type-C: RTS5453 (the controller these boards actually use) was kept while
# the generic Type-C plumbing around it was dropped. Sky1's USB-C is a combo
# USB/DP PHY, so alt-mode and mux support are part of getting a port into USB
# role rather than DP.
CONFIG_TYPEC_DP_ALTMODE=m
CONFIG_TYPEC_UCSI=m
CONFIG_EXTCON_USB_GPIO=y

# ---------------------------------------------------------------------------
# USB dual-role connect detection, restored from 7.0.12 (2026-08-13).
#
# cdnsp/cdns3 on Sky1 is a DUAL-ROLE controller. The lean pass dropped the
# plumbing that decides a port has something plugged into it and settles the
# port into host role. Everything below is present in 7.0.12, which installs
# from a USB stick on this board; all of it is absent in the lean 7.2, which
# does not.
#
# Measured on O6N from the d-i shell with the stick in a USB-A port:
#   /proc/partitions      -> nvme0n1 only, zero sd*
#   /sys/bus/usb/devices  -> usb1..usb14 root hubs, ZERO downstream devices
#   dmesg                 -> xhci-hcd.N.auto registered, cdnsp-sky1 bound to
#                            all nine CIXH2030 instances, and not one
#                            "new ... USB device" line
#
# i.e. the controllers come up and no port ever reports a connect. Restoring
# USB_CDNS3 to builtin did NOT change this (verified on metal), which is what
# points at role/connect detection rather than the controller driver.
CONFIG_USB_OTG=y
CONFIG_USB_CONN_GPIO=y
CONFIG_USB_ULPI_BUS=y

# Type-C port management. TYPEC_RTS5453 (the controller these boards use) was
# kept while the generic TCPM/UCSI layer underneath it was dropped, leaving it
# with nothing to register against.
CONFIG_TYPEC_TCPM=m
CONFIG_TYPEC_TCPCI=m

# ---------------------------------------------------------------------------
# DEVTMPFS_MOUNT: the reason d-i drew on the serial line instead of the screen.
#
# This makes the KERNEL mount devtmpfs on /dev before init runs. The lean pass
# dropped it; 7.0.12, which put the installer on the monitor for hundreds of
# installs, has it.
#
# Without it /dev is only whatever the initrd shipped, and the d-i initrd ships
# exactly one node:
#
#     crw-r--r-- 1 root root 5, 1 /dev/console      <- and nothing else
#
# d-i's reopen-console runs from /init BEFORE S01mount mounts /dev, and both
# paths by which tty1 could become a console candidate are device-node tests:
#
#     [ -e "/dev/$cons" ] && ...        # cons=tty1 after the tty0 rename
#     [ -c /dev/tty1 ] && ...           # the later fallback
#
# With an empty /dev both fail, the console list ends up empty, and it falls to
# "Nothing found? Default to /dev/console". detect-console then classifies
# /dev/console as TERM_TYPE=serial, so the installer renders on the UART and the
# monitor gets nothing -- on every board, whatever console= says.
#
# That is why no cmdline change fixed this: console selection was never the
# problem, the missing device node was. It also explains why writing to
# /dev/tty1 from a shell DID appear on screen -- by then S01mount had mounted
# devtmpfs and the node existed, long after reopen-console had decided.
CONFIG_DEVTMPFS_MOUNT=y

# --- HiFi5 DSP transport ---------------------------------------------------
# CONFIG_CIX_DSP_RPROC boots the DSP fine on its own: dsp_fw.bin loads and the
# driver logs "DSP ready", registers virtio0 (type 7 = VIRTIO_ID_RPMSG) and gets
# mbox_send_message == 0. But RPMSG was never named in this defconfig, so
# olddefconfig resolved it to n, virtio0 had no driver, no rpmsg channel was
# created, and userspace had no /dev/rpmsgN to open -- which is what
# libdsp_wrap.so (XAF, statically linked) needs to reach the DSP.
#
# cix_dsp_rproc.c implements the rpmsg-lite link-up handshake explicitly
# (deferred vq0 kick, link_state, rpmsg_lite_tx_callback), so this transport is
# required, not optional.
CONFIG_RPMSG=y
CONFIG_RPMSG_VIRTIO=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_CTRL=y
CONFIG_RPMSG_NS=y

# zram: compressed RAM swap (systemd-zram-generator drives it from userspace).
# ZRAM selects ZSMALLOC; ZRAM_BACKEND_ZSTD selects ZSTD_COMPRESS/DECOMPRESS.
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

#
# Android binder — required for Waydroid (containerised Android).
#
# The defconfig carried no Android symbols at all, so olddefconfig left
# CONFIG_ANDROID_BINDER_IPC at its default of n and the shipped kernel had no
# /dev/binder. Waydroid cannot start without it. Everything else Waydroid needs
# was ALREADY enabled in this config and was verified before adding these:
# MEMFD_CREATE=y, PSI=y, FUSE_FS=y, OVERLAY_FS=y, VETH=y, BRIDGE=y. Binder was
# the only gap, which is why this is three lines rather than a port.
#
# Built in rather than modular: it is upstream kernel code, not a CIX
# accelerator driver, so the "all CIX drivers are DKMS" rule does not apply. A
# built-in binder is also always present at boot, which avoids Waydroid failing
# on a module that was not loaded yet.
#
# ANDROID_BINDERFS gives /dev/binderfs, which is what current Waydroid expects;
# it depends on ANDROID_BINDER_IPC and would be silently dropped without it.

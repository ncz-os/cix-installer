drm/cix/linlon-dp: migrate private-obj init to create_state (v7.1)

v7.1's drm_atomic_private_obj_init() dropped the explicit initial-state
argument and now allocates the first state itself via a new mandatory
.atomic_create_state callback (returns int). Mirror the in-tree komeda
driver that linlon-dp forks: add per-object .atomic_create_state callbacks
that allocate+reset the initial component/pipeline state and derive the
owner via container_of(obj, ...), and switch *_obj_add() to the 3-arg init.

Signed-off-by: NCZ build <jperlow@gmail.com>

--- a/drivers/gpu/drm/cix/linlon-dp/linlondp_private_obj.c
+++ b/drivers/gpu/drm/cix/linlon-dp/linlondp_private_obj.c
@@ -42,7 +42,24 @@
 	kfree(st);
 }
 
+static struct drm_private_state *
+linlondp_layer_atomic_create_state(struct drm_private_obj *obj)
+{
+	struct linlondp_layer_state *st;
+
+	st = kzalloc(sizeof(*st), GFP_KERNEL);
+	if (!st)
+		return ERR_PTR(-ENOMEM);
+
+	__drm_atomic_helper_private_obj_create_state(obj, &st->base.obj);
+	linlondp_component_state_reset(&st->base);
+	st->base.component = container_of(obj, struct linlondp_component, obj);
+
+	return &st->base.obj;
+}
+
 static const struct drm_private_state_funcs linlondp_layer_obj_funcs = {
+	.atomic_create_state = linlondp_layer_atomic_create_state,
 	.atomic_duplicate_state = linlondp_layer_atomic_duplicate_state,
 	.atomic_destroy_state = linlondp_layer_atomic_destroy_state,
 };
@@ -50,14 +67,7 @@

+	{ __HW_ID(2, 3), DRM_FORMAT_BGRX8888, RICH_SIMPLE_WB, Flip_H_V, 0, 0 },
+	/* BGR_888 */ /* none-afbc RGB888 doesn't support rotation and flip */

+#ifndef DSM_MINOR
+#define DSM_MINOR 255
+#endif
+#define QUOTIENT_BIT 3
+#define SURPLUS_BIT 7
+#define MAP_NUMBER 32
+#define ERROR_NO_MAX_LEN 9

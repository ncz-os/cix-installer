+//  base   - 32-bit device base address
+//  offset - 32-bit register offset
+//  data   - 32-bit data write
+//
+//  Returns:
+//  none
+//------------------------------------------------------------------------------
+static inline void reg_write_offset(void *base, uint32_t offset, uint32_t data)
+{
+	writel(data, base + offset);
+}

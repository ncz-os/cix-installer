+//------------------------------------------------------------------------------
+//     register map
+//------------------------------------------------------------------------------
+#define TRILIN_EDP_CDB_ADDR 0x0000
+#define TRILIN_EDP_CDB_WDATA 0x0004
+#define TRILIN_EDP_CDB_SEL_WR 0x0008 // cdb_select @ bit 1, cdb_write @ bit 0
+#define TRILIN_EDP_CDB_READY 0x000c // read-only address..

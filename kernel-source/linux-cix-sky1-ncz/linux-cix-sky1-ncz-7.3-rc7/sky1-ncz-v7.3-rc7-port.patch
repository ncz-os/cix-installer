+}
+
+int cix_dsp_request_mbox(struct cix_dsp_ipc *dsp_ipc)
+{
+	return -ENOTSUPP;
+}
+
+void cix_dsp_free_mbox(struct cix_dsp_ipc *dsp_ipc) {};
+
+#endif
+
+#endif /* _CIX_DSP_IPC_H */

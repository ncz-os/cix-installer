+#define CORE_CTL_FORCE_RESUME_CPU _IOW('g', 1, struct _CORE_CTL_PACKAGE)
+#define CORE_CTL_FORCE_PAUSE_CPU _IOW('g', 2, struct _CORE_CTL_PACKAGE)

index 000000000000..b6e9e4f77d7b
--- /dev/null
+++ b/drivers/gpu/drm/cix/dptx/trilin_dptx_cix.c
@@ -0,0 +1,315 @@
+// SPDX-License-Identifier: GPL-2.0

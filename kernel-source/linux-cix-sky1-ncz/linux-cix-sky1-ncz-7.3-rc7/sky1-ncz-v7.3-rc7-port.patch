+	wr_val = lc128[11] << 24 | lc128[10] << 16 | lc128[9] << 8 | lc128[8];
+	reg_write_offset(hdcp->base_addr, TR_DPTX_HDCP_LC128_95_64,
+			 wr_val); //  write bits 95:64

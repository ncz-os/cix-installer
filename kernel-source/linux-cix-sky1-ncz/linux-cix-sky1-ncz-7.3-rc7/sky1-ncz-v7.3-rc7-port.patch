+int trilin_dp_prepare(struct trilin_dp *dp)
+{
+	int rc = 0;
+
+	DP_DEBUG("enter\n");
+	mutex_lock(&dp->session_lock);
+
+	/*
+	 * If DPTX_STATE_ENABLED, there is nothing left to do.
+	 */
+	if (dp->state & (DPTX_STATE_ENABLED)) {
+		DP_DEBUG("[already enabled, mst second stream?]");
+		goto end;
+	}
+
+	if (!(dp->state & DPTX_STATE_INITIALIZED)) {
+		rc = trilin_dp_host_init(dp);
+		if (rc) {
+			DP_WARN("Host init Failed");
+			goto end;
+		}
+	} else if (dp->state & DPTX_STATE_INIT_TRAIN){
+		reset_dp_and_reinit(dp); //enable dp reset...
+		usleep_range(100, 200);
+	}
+
+	if (trilin_dp_get_hpd_state(dp)
+		&& !(dp->state & DPTX_STATE_CONNECTED)) {
+		mutex_unlock(&dp->session_lock);
+		trilin_dp_handle_connect(dp, false);
+		mutex_lock(&dp->session_lock);
+	}
+
+	if (!trilin_dp_is_ready(dp)) {
+		DP_DEBUG("[not ready]");
+		goto end;
+	}
+
+	rc = trilin_dp_core_on(dp, true);
+end:
+	mutex_unlock(&dp->session_lock);
+	return rc;
+}
+
+int trilin_dp_enable(struct trilin_dp *dp, struct trilin_dp_panel *dp_panel)
+{
+	int rc = 0;
+
+	DP_DEBUG("enter\n");
+	mutex_lock(&dp->session_lock);
+	/*
+	 * If DPTX_STATE_INITIALIZED is not set, we should not do any HW
+	 * programming.
+	 */
+	if (!(dp->state & DPTX_STATE_INITIALIZED) || !(dp->state & DPTX_STATE_READY)) {
+		DP_WARN("[host not ready]");
+		goto end;
+	}
+
+	rc = trilin_dp_edp_panel_prepare(dp);
+	if (rc)
+		goto end;
+
+	//trilin_dp_sink_set_msa_timing_ignore(dp, dp_panel, true);
+
+	rc = trilin_dp_ctrl_stream_on(dp, dp_panel);
+	if (rc)
+		goto end;
+
+	dp->state |= DPTX_STATE_ENABLED;
+end:
+	mutex_unlock(&dp->session_lock);
+	return rc;
+}
+
+int trilin_dp_post_enable(struct trilin_dp *dp,
+			  struct trilin_dp_panel *dp_panel)
+{
+	//int rc = trilin_dp_train_loop(dp);
+	return 0;
+}
+
+int trilin_dp_pre_disable(struct trilin_dp *dp, struct trilin_dp_panel *panel)
+{
+	int rc = 0;
+
+	DP_DEBUG("enter\n");
+	mutex_lock(&dp->session_lock);
+	if (!(dp->state & DPTX_STATE_ENABLED)) {
+		DP_DEBUG("[not enabled]");
+		goto end;
+	}
+	//fixme: clear_colorspaces(dp_display)?
+	rc = trilin_dp_stream_pre_disable(dp, panel);
+end:
+	mutex_unlock(&dp->session_lock);
+	return rc;
+}
+
+int trilin_dp_disable(struct trilin_dp *dp, struct trilin_dp_panel *panel)
+{
+	int rc = 0;
+
+	DP_DEBUG("enter\n");
+	mutex_lock(&dp->session_lock);
+
+	if (!(dp->state & DPTX_STATE_ENABLED)) {
+		DP_DEBUG("[not enabled]");
+		goto end;
+	}
+
+	if (!(dp->state & DPTX_STATE_INITIALIZED)) {
+		DP_DEBUG("[not ready]");
+		goto end;
+	}
+
+	trilin_dp_stream_disable(dp, panel);
+	trilin_dp_clear_info(dp, panel);
+	trilin_dp_sink_set_msa_timing_ignore(dp, panel, false);
+end:
+	mutex_unlock(&dp->session_lock);
+	return rc;
+}
+
+int trilin_dp_unprepare(struct trilin_dp *dp)
+{
+	DP_DEBUG("enter\n");
+
+	mutex_lock(&dp->session_lock);
+	if (!(dp->state & DPTX_STATE_ENABLED)) {
+		DP_DEBUG("[not enabled]");
+		goto end;
+	}
+
+	if (dp->active_stream_cnt) {
+		DP_DEBUG("having active stream, do not core off");
+		goto end;
+	}
+
+	trilin_dp_core_off(dp);
+
+	if (dp->state & DPTX_STATE_SUSPENDED)
+		trilin_dp_host_deinit(dp);
+
+	dp->state &= ~DPTX_STATE_ENABLED;
+	/* log this as it results from user action of cable dis-connection */
+	DP_DEBUG("[OK]\n");
+end:
+	mutex_unlock(&dp->session_lock);
+	return 0;
+}
+
+/*
+ * Does this device's firmware actually describe @name in its @table
+ * (CLKT for clocks, RSTL for resets)?
+ *
+ * A bare -ENOENT from devm_clk_get()/devm_reset_control_get() is ambiguous:
+ * it means either "firmware never described this resource" or "firmware
+ * described it but the CIX CLKT/RSTL bridge has not registered its lookups
+ * yet". Only the first may be treated as an absent optional resource; the
+ * second must still defer, which is what commit "drm: cix: dptx: validate
+ * reset and clock lookups" arranged. Consult the firmware tables directly so
+ * the two cases can be told apart.
+ */
+static bool trilin_dp_fw_declares(struct device *dev, const char *table,
+				  const char *name)
+{
+	struct acpi_buffer buf = { ACPI_ALLOCATE_BUFFER, NULL };
+	struct acpi_device *adev = ACPI_COMPANION(dev);
+	union acpi_object *pkg;
+	bool found = false;
+	int i, j;
+
+	if (!adev)
+		return false;
+
+	if (ACPI_FAILURE(acpi_evaluate_object(adev->handle, (char *)table,
+					      NULL, &buf)))
+		return false;
+
+	pkg = buf.pointer;
+	if (pkg && pkg->type == ACPI_TYPE_PACKAGE) {
+		for (i = 0; i < pkg->package.count && !found; i++) {
+			union acpi_object *ent = &pkg->package.elements[i];
+
+			if (ent->type != ACPI_TYPE_PACKAGE)
+				continue;
+
+			for (j = 0; j < ent->package.count; j++) {
+				union acpi_object *f = &ent->package.elements[j];
+
+				if (f->type == ACPI_TYPE_STRING &&
+				    f->string.pointer &&
+				    !strcmp(f->string.pointer, name)) {
+					found = true;
+					break;
+				}
+			}
+		}
+	}
+
+	ACPI_FREE(buf.pointer);
+	return found;
+}
+
+int trilin_dp_init_config(struct trilin_dp *dp)
+{
+	int rc;
+
+	DP_DEBUG("enter\n");
+	/*work queue*/
+	INIT_DELAYED_WORK(&dp->hpd_event_work, trilin_dp_hpd_event_work_func);
+	INIT_DELAYED_WORK(&dp->hpd_irq_work, trilin_dp_hpd_irq_work_func);
+
+	/* config dp state*/
+	mutex_init(&dp->session_lock);
+	dp->state |= (DPTX_STATE_CONFIGURED);
+
+	rc = trilin_dp_aux_register(dp);
+	if (rc) {
+		DP_DEBUG("failed to register DP aux\n");
+		goto end1;
+	}
+
+	/* first call host init */
+	if (dp->enabled_by_gop) {
+		trinlin_dp_panel_read_sink_caps(dp);
+		if (!dp->caps.mst && !dp->caps.psr_sink_support)
+			rc = trilin_dp_host_init_from_bootloader(dp);
+		else
+			dp->enabled_by_gop = 0; //mst disable gop
+	}
+	if (!dp->enabled_by_gop)
+		rc = trilin_dp_host_init(dp);
+	if (rc) {
+		DP_ERR("host_init Failed");
+		goto end2;
+	}
+
+	if (dp->edp_panel && !trilin_dp_get_hpd_state(dp))
+		trilin_dp_edp_drop_panel(dp);
+
+	rc = trilin_dp_hdcp_init(dp->dpsub);
+	if (rc) {
+		DP_ERR("trilin_dp_hdcp_init Failed");
+		goto end2;
+	}
+
+	irq_set_status_flags(dp->irq, IRQ_DISABLE_UNLAZY);
+	rc = devm_request_threaded_irq(dp->dev, dp->irq, NULL,
+				       trilin_dp_irq_handler, IRQF_ONESHOT,
+				       dev_name(dp->dev), dp);
+	if (rc < 0)
+		goto end2;
+
+	DP_INFO("init hpd high is %d\n", trilin_dp_get_hpd_state(dp));
+	return rc;
+end2:
+	trilin_dp_aux_cleanup(dp);
+end1:
+	dp->state &= ~DPTX_STATE_CONFIGURED;
+	cancel_delayed_work_sync(&dp->hpd_irq_work);
+	cancel_delayed_work_sync(&dp->hpd_event_work);
+	return rc;
+}

+
+#define VALUE_TO_STR(val) #val
+
+char *condition_type_str[CONDITION_TYPE_MAX + 1] = {
+	VALUE_TO_STR(CONDITION_TYPE_NONE),
+	VALUE_TO_STR(CONDITION_TYPE_EQUAL),
+	VALUE_TO_STR(CONDITION_TYPE_NOT_EQUAL),

+	hdcp->tmr_addr = hdcp->base_addr + TRILIN_DPTX_HDCP_HOST_TIMER;
+	hdcp->timer_in_use = false;
+	hdcp->opened = false;
+	ret = cix_hdcp_init(hdcp);
+
+	return ret;

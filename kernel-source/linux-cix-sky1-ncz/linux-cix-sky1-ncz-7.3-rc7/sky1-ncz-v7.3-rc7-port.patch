+	union {
+		__u32 cid;
+		__u32 cpu;
+	};
+	union {
+		__u32 min;
+		__u32 is_pause;
+		__u32 throttle_ms;
+		__u32 not_preferred_cpus;
+		__u32 boost;
+		__u32 thres;
+		__u32 enable_policy;
+	};
+	__u32 max;
+};

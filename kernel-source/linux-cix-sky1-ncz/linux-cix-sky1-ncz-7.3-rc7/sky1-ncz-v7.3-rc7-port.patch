+            hnd, V4L2_CID_MVE_VIDEO_ENC_DISABLE_TIMESCALE,
+            "disable timescale in vui",
+            0, 1, 0, 1);
+    if (ctrl == NULL)
+        goto handler_free;
+
+    ret = v4l2_ctrl_handler_setup(hnd);
+    if (ret != 0)
+        goto handler_free;
+    return 0;
+
+handler_free:
+    v4l2_ctrl_handler_free(hnd);
+    return -EINVAL;
+}
+
+void mvx_v4l2_ctrls_done(struct v4l2_ctrl_handler *hnd)
+{
+    v4l2_ctrl_handler_free(hnd);
+}

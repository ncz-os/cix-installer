+int dsm_client_unocuppy(struct dsm_client *client)
+{
+	int ret = -1;
+
+	if (client) {
+		clear_bit(CBUFF_OCCUPY_BIT, &client->buff_flag);
+		/* ensure clean client buff flag in order */
+		smp_wmb();
+		ret = 0;
+	}
+
+	return ret;
+}
+EXPORT_SYMBOL(dsm_client_unocuppy);

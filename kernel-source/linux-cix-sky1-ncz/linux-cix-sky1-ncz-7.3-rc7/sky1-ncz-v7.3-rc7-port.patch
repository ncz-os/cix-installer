+	cpu_data->opp_level_num = total_opps;
+	if (!cpu_data->opp_level_num) {
+		pr_warn("%s: cpu:%d, no performance levels found\n", __func__,
+			cpu_dev->id);
+		return ret ?: -ENODATA;
+	}
+
+	return ret;

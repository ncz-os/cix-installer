+	BB_PR_START();
+	memset(databuf, 0, DATA_MAXLEN + 1);
+	ktime_get_real_ts64(&tv);
+	rtc_time64_to_tm(tv.tv_sec, &tm);
+
+	(void)snprintf(databuf, DATA_MAXLEN + 1, "%04d%02d%02d%02d%02d%02d",
+		       tm.tm_year + 1900, tm.tm_mon + 1, tm.tm_mday, tm.tm_hour,
+		       tm.tm_min, tm.tm_sec);

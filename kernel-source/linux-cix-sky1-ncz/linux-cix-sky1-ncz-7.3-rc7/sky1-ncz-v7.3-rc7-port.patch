+
+#ifndef _DSM_CORE_H
+#define _DSM_CORE_H
+
+#ifdef __KERNEL__
+#include <linux/soc/cix/dsm_pub.h>
+#include <linux/err.h>
+#endif
+#include <linux/ioctl.h>
+#ifdef CONFIG_HUAWEI_DATA_ACQUISITION
+#include <linux/kfifo.h>
+#endif

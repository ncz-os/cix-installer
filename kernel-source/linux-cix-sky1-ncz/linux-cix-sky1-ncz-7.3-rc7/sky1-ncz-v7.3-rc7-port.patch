+/* VB2 API compatibility for kernel 6.8+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 8, 0)
+#define MVX_VB2_NUM_BUFFERS(q) vb2_get_num_buffers(q)
+#define MVX_VB2_GET_BUFFER(q, i) vb2_get_buffer(q, i)
+#define MVX_VB2_MIN_BUFFERS_NEEDED min_queued_buffers
+#else
+#define MVX_VB2_NUM_BUFFERS(q) ((q)->num_buffers)
+#define MVX_VB2_GET_BUFFER(q, i) ((q)->bufs[i])
+#define MVX_VB2_MIN_BUFFERS_NEEDED min_buffers_needed
+#endif

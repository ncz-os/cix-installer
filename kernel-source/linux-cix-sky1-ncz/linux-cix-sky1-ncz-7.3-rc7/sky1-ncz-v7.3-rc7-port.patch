+        session->lambda_scale.lambda_scale_b_nonref_q8 != 0 ||
+        session->lambda_scale.lambda_scale_sqrt_b_nonref_q8 != 0){
+        option.code = MVX_FW_SET_ENC_LAMBDA_SCALE;

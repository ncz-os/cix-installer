+    V4L2_CID_MVE_VIDEO_RRC_DQP_RANGE,
+    V4L2_CID_MVE_VIDEO_RRC_DQP_STEP,
+};
+
+#define V4L2_SESSION_PRIORITY_PREEMPTION 0
+#define V4L2_SESSION_PRIORITY_HIGH 1

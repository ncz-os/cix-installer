+static int mvx_session_get_fmt_qp_range(enum mvx_format fmt,
+                int *qp_min,
+                int *qp_max)
+{
+    switch (fmt) {
+    case MVX_FORMAT_H263:
+        *qp_min = 0;
+        *qp_max = 31;
+        break;
+    case MVX_FORMAT_H264:
+    case MVX_FORMAT_HEVC:
+        *qp_min = 0;
+        *qp_max = 51;
+        break;
+    case MVX_FORMAT_VP9:
+    case MVX_FORMAT_VP8:
+        *qp_min = 0;
+        *qp_max = 63;
+        break;
+    default:
+        *qp_min = 0;
+        *qp_max = 63;
+        break;
+    }
+
+    return 0;
+}

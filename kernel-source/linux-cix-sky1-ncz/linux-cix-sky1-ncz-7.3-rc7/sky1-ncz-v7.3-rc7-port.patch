+    V4L2_CID_MVE_VIDEO_ENC_INTRA_IPENALTY_ANGULAR,
+    V4L2_CID_MVE_VIDEO_ENC_INTRA_IPENALTY_PLANAR,
+    V4L2_CID_MVE_VIDEO_ENC_INTRA_IPENALTY_DC,
+    V4L2_CID_MVE_VIDEO_ENC_INTER_IPENALTY_ANGULAR,

+//------------------------------------------------------------------------------
+//  Function:   reg_read_offset
+//  register read with offset
+//
+//  Parameters:
+//  base   - 32-bit device base address
+//  offset - 32-bit register offset
+//
+//  Returns:
+//  32-bit data read
+//------------------------------------------------------------------------------
+static inline uint32_t reg_read_offset(void *base, uint32_t offset)
+{
+	return readl(base + offset);
+}

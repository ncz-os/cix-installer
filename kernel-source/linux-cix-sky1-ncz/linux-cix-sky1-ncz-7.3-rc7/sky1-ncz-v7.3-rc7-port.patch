+static int sky1_pcie_parse_wake_gpio(struct sky1_pcie *pcie)
+{
+	struct device *dev = pcie->dev;
+	struct gpio_desc *gpiodesc;
+
+	if (pcie->plat == PCIE_PLAT_EMU)
+		return 0;
+
+	gpiodesc = devm_gpiod_get_optional(dev, "wake", GPIOD_IN);

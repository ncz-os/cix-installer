@@ -0,0 +1,569 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ *Copyright 2024 Cix Technology Group Co., Ltd.
+ */
+
+#include <linux/acpi.h>
+#include <linux/cma.h>
+#include <linux/device.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/reset-controller.h>
+#include <linux/version.h>
+
+#include <linux/../../mm/cma.h>
+
+extern int dma_declare_coherent_memory(struct device *dev,
+		phys_addr_t phys_addr, dma_addr_t device_addr, size_t size);
+
+static struct acpi_device *acpi_obj_path_to_adev(union acpi_object *obj)
+{
+        struct acpi_device *adev = NULL;
+        char *path;
+        acpi_handle handle;
+        acpi_status status;
+
+        if (!obj || !obj->string.length)
+                return NULL;
+
+        path = obj->string.pointer;
+        status = acpi_get_handle(NULL, path, &handle);
+        if (ACPI_FAILURE(status)) {
+                return NULL;
+        }
+
+#if LINUX_VERSION_CODE <= KERNEL_VERSION(6, 0, 0)
+        adev = acpi_bus_get_acpi_device(handle);
+#else
+        adev = acpi_fetch_acpi_dev(handle);
+#endif
+
+        return adev;
+}
+
+static struct device *acpi_obj_str_platform_device(const union acpi_object *obj)
+{
+	struct device *dev;
+	struct acpi_device *adev;
+
+	adev = acpi_obj_path_to_adev((union acpi_object *)obj);
+	if (!adev)
+		return NULL;
+
+	dev = bus_find_device_by_acpi_dev(&platform_bus_type, adev);
+	if (!dev)
+		return NULL;
+
+	return dev;
+}
+
+static const char *acpi_obj_str_to_devname(const union acpi_object *obj)
+{
+	struct device *dev;
+
+	dev = acpi_obj_str_platform_device(obj);
+	if (!dev)
+		return NULL;
+
+	return dev_name(dev);
+}
+
+static struct device *acpi_obj_ref_platform_device(const union acpi_object *obj)
+{
+	struct device *dev;
+	struct acpi_device *adev;
+
+	adev = acpi_fetch_acpi_dev(obj->reference.handle);
+	if (!adev)
+		return NULL;
+
+	dev = bus_find_device_by_acpi_dev(&platform_bus_type, adev);
+	if (!dev)
+		return NULL;
+
+	return dev;
+}
+
+static const char *acpi_obj_ref_to_devname(const union acpi_object *obj)
+{
+	struct device *dev;
+
+	dev = acpi_obj_ref_platform_device(obj);
+	if (!dev)
+		return NULL;
+
+	return dev_name(dev);
+}
+
+static struct device *acpi_obj_to_platform_device(const union acpi_object *obj)
+{
+	if (!obj)
+		return NULL;
+
+	if (obj->type == ACPI_TYPE_LOCAL_REFERENCE)
+		return acpi_obj_ref_platform_device(obj);
+	else if (obj->type == ACPI_TYPE_STRING)
+		return acpi_obj_str_platform_device(obj);
+	else
+		return NULL;
+}
+
+static const char *acpi_obj_to_devname(const union acpi_object *obj)
+{
+	if (!obj)
+		return NULL;
+
+	if (obj->type == ACPI_TYPE_LOCAL_REFERENCE)
+		return acpi_obj_ref_to_devname(obj);
+	else if (obj->type == ACPI_TYPE_STRING)
+		return acpi_obj_str_to_devname(obj);
+	else
+		return NULL;
+}
+
+static int reset_lookup_handle(acpi_handle handle,
+			const union acpi_object *obj, void *data)
+{
+	struct device *dev = data;
+	const union acpi_object *child, *el;
+	struct reset_control_lookup *lookup;
+	int i, pcnt, count = 0;
+	struct acpi_device *adev = acpi_fetch_acpi_dev(handle);
+
+	if (!adev || !adev->status.present)
+		return -ENODEV;
+
+	for (i = 0; i < obj->package.count; i++) {
+		child = &obj->package.elements[i];
+		pcnt = child->package.count;
+
+		/* package: <provider,ref>, <index>, <user,ref>, [<con-id>] */
+		if (pcnt < 3)
+			continue;
+
+		el = child->package.elements;
+
+		if ((el[0].type != ACPI_TYPE_LOCAL_REFERENCE
+			    && el[0].type != ACPI_TYPE_STRING)
+		    || (el[1].type != ACPI_TYPE_INTEGER)
+		    || (el[2].type != ACPI_TYPE_LOCAL_REFERENCE
+			    && el[2].type != ACPI_TYPE_STRING)
+		    || (pcnt > 3 && (el[3].type != ACPI_TYPE_STRING)))
+			continue;
+
+		lookup = devm_kzalloc(dev, sizeof(*lookup), GFP_KERNEL);
+		if (!lookup)
+			return -ENOMEM;
+		INIT_LIST_HEAD(&lookup->list);
+		lookup->provider = acpi_obj_to_devname(&el[0]);
+		lookup->index = el[1].integer.value;
+		lookup->dev_id = acpi_obj_to_devname(&el[2]);
+		lookup->con_id = pcnt > 3 ?
+			devm_kstrdup(dev, el[3].string.pointer, GFP_KERNEL)
+			: NULL;
+
+		if (!lookup->provider || (!lookup->dev_id && !lookup->con_id))
+			continue;
+
+		reset_controller_add_lookup(lookup, 1);
+
+		dev_dbg(&adev->dev,
+			"rst lookup: prov[%s] idx[%d] dev[%s] con[%s]\n",
+			lookup->provider, lookup->index,
+			lookup->dev_id, lookup->con_id);
+		count++;
+	}
+
+	dev_dbg(&adev->dev, "reset lookup handle done %d/%d",
+			count, obj->package.count);
+
+	return count;
+}
+
+static int cma_init_reserved_memory(phys_addr_t base, phys_addr_t size,
+				    unsigned int order_per_bit,
+				    const char *name,
+				    struct cma **res_cma)
+{
+	struct cma *cma;
+
+	/* Sanity checks */
+	if (cma_area_count == ARRAY_SIZE(cma_areas)) {
+		pr_err("Not enough slots for CMA reserved regions!\n");
+		return -ENOSPC;
+	}
+
+	if (!size || !memblock_is_region_reserved(base, size))
+		return -EINVAL;
+
+	/* alignment should be aligned with order_per_bit */
+	if (!IS_ALIGNED(CMA_MIN_ALIGNMENT_PAGES, 1 << order_per_bit))
+		return -EINVAL;
+
+	/* ensure minimal alignment required by mm core */
+	if (!IS_ALIGNED(base | size, CMA_MIN_ALIGNMENT_BYTES))
+		return -EINVAL;
+
+	/*
+	 * Each reserved area must be initialised later, when more kernel
+	 * subsystems (like slab allocator) are available.
+	 */
+	cma = &cma_areas[cma_area_count];
+	cma_area_count++;
+
+	if (name)
+		strscpy(cma->name, name);
+	else
+		snprintf(cma->name, CMA_MAX_NAME, "cma%d", cma_area_count);
+
+	cma->available_count = cma->count = size >> PAGE_SHIFT;
+	cma->order_per_bit = order_per_bit;
+	cma->ranges[0].base_pfn = PFN_DOWN(base);
+	cma->ranges[0].early_pfn = PFN_DOWN(base);
+	cma->ranges[0].count = cma->count;
+	cma->nranges = 1;
+	cma->nid = NUMA_NO_NODE;
+	*res_cma = cma;
+	totalcma_pages += cma->count;
+
+	return 0;
+}
+
+static int rmem_dev_set_dma(struct device *dev, phys_addr_t base, size_t size)
+{
+	if (!dev || dev->dma_mem)
+		return -EINVAL;
+
+	if (!memblock_is_region_memory(base, size)
+		|| memblock_is_map_memory(base))
+		return -EFAULT;
+
+	return dma_declare_coherent_memory(dev, base, base, size);
+}
+
+static int rmem_dev_set_cma(struct device *dev,
+			phys_addr_t base, phys_addr_t size)
+{
+	struct cma *cma;
+	int ret;
+
+	if (!dev || dev->cma_area)
+		return -EINVAL;
+
+	if (!memblock_is_region_reserved(base, size))
+		return -EFAULT;
+
+	ret = cma_init_reserved_memory(base, size, 0, dev_name(dev), &cma);
+	if (ret)
+		return ret;
+
+	dev->cma_area = cma;
+
+	return ret;
+}
+
+static int reserved_mem_lookup_handle(acpi_handle handle,
+			const union acpi_object *obj, void *data)
+{
+	struct device *rdev, *dev = data;
+	const union acpi_object *child, *el;
+	int i, pcnt, count = 0, ret;
+	phys_addr_t base, size;
+	struct acpi_device *adev = acpi_fetch_acpi_dev(handle);
+
+	if (!adev || !adev->status.present)
+		return -ENODEV;
+
+	for (i = 0; i < obj->package.count; i++) {
+		child = &obj->package.elements[i];
+		pcnt = child->package.count;
+
+		/* package: <base>, <size>, <type,string>, <dev,ref> */
+		if (pcnt != 4)
+			continue;
+
+		el = child->package.elements;
+
+		if ((el[0].type != ACPI_TYPE_INTEGER)
+		    || (el[1].type != ACPI_TYPE_INTEGER)
+		    || (el[2].type != ACPI_TYPE_STRING)
+		    || (el[3].type != ACPI_TYPE_LOCAL_REFERENCE
+			    && el[3].type != ACPI_TYPE_STRING))
+			continue;
+
+		base = el[0].integer.value;
+		size = el[1].integer.value;
+
+		rdev = acpi_obj_to_platform_device(&el[3]);
+		if (!rdev)
+			continue;
+
+		if (!strcmp(el[2].string.pointer, "no-map"))
+			ret = rmem_dev_set_dma(rdev, base, (size_t)size);
+		else if (!strcmp(el[2].string.pointer, "reusable"))
+			ret = rmem_dev_set_cma(rdev, base, size);
+		else
+			ret = -EFAULT;
+		if (ret)
+			dev_err(dev, "rsv mem[%d] err: 0x%llX-0x%llX[%s]->[%s]",
+					i, base, size, el[2].string.pointer,
+					dev_name(rdev));
+
+		/*
+		 * To make it simple, there is no duplicates check, and the
+		 * dma memory won't be released in the device's life.
+		 */
+
+		dev_dbg(&adev->dev, "rsv mem [%d][%s]: 0x%llX-0x%llX[%s]->[%s]",
+				i, ret ? "fail" : "ok", base, size,
+				el[2].string.pointer, dev_name(rdev));
+
+		if (!ret)
+			count++;
+	}
+
+	dev_dbg(&adev->dev, "reserved memory lookup handle done %d/%d",
+				count, obj->package.count);
+
+	return count;
+}
+
+static int resource_name_lookup_handle(acpi_handle handle,
+			const union acpi_object *obj, void *data)
+{
+	struct device *rdev, *dev = data;
+	const union acpi_object *child, *el;
+	int i, pcnt, count = 0, index;
+	unsigned int type;
+	struct resource *res;
+	const char *name;
+	struct acpi_device *adev = acpi_fetch_acpi_dev(handle);
+
+	if (!adev || !adev->status.present)
+		return -ENODEV;
+
+	for (i = 0; i < obj->package.count; i++) {
+		child = &obj->package.elements[i];
+		pcnt = child->package.count;
+
+		/* package: <rdev>, <type>, <index>, <name> */
+		if (pcnt != 4)
+			continue;
+
+		el = child->package.elements;
+
+		if ((el[0].type != ACPI_TYPE_LOCAL_REFERENCE
+			    && el[0].type != ACPI_TYPE_STRING)
+		    || (el[1].type != ACPI_TYPE_INTEGER)
+		    || (el[2].type != ACPI_TYPE_INTEGER)
+		    || (el[3].type != ACPI_TYPE_STRING))
+			continue;
+
+		rdev = acpi_obj_to_platform_device(&el[0]);
+		type = el[1].integer.value;
+		index = el[2].integer.value;
+		name = devm_kstrdup(dev, el[3].string.pointer, GFP_KERNEL);
+		if (!rdev || !name)
+			continue;
+
+		res = platform_get_resource(to_platform_device(rdev),
+					type, index);
+		if (!res)
+			continue;
+		res->name = name;
+
+		if ((res->flags & IORESOURCE_IRQ)
+				&& (res->flags & IORESOURCE_DISABLED))
+			acpi_irq_get(ACPI_HANDLE(rdev), index, res);
+
+		dev_dbg(&adev->dev, "resource set name [%s][0x%x][%d]->[%s]",
+				dev_name(rdev), type, index, name);
+
+		count++;
+	}
+
+	dev_dbg(&adev->dev, "resource name lookup handle done %d/%d",
+			count, obj->package.count);
+
+	return count;
+}
+
+static int device_link_lookup_handle(acpi_handle handle,
+			const union acpi_object *obj, void *data)
+{
+	struct device *consumer, *supplier;
+	const union acpi_object *child, *el;
+	int i, pcnt, count = 0;
+	u32 flags;
+	struct acpi_device *adev = acpi_fetch_acpi_dev(handle);
+
+	if (!adev || !adev->status.present)
+		return -ENODEV;
+
+	for (i = 0; i < obj->package.count; i++) {
+		child = &obj->package.elements[i];
+		pcnt = child->package.count;
+
+		/* package: <supplier>, <consumer>, <flags> */
+		if (pcnt != 3)
+			continue;
+
+		el = child->package.elements;
+
+		if ((el[0].type != ACPI_TYPE_LOCAL_REFERENCE
+			    && el[0].type != ACPI_TYPE_STRING)
+		    || (el[1].type != ACPI_TYPE_LOCAL_REFERENCE
+			    && el[1].type != ACPI_TYPE_STRING)
+		    || (el[2].type != ACPI_TYPE_INTEGER))
+			continue;
+
+		supplier = acpi_obj_to_platform_device(&el[0]);
+		consumer = acpi_obj_to_platform_device(&el[1]);
+		flags = (u32)el[2].integer.value;
+
+		if (!supplier || !consumer)
+			continue;
+
+		device_link_add(consumer, supplier, flags);
+
+		dev_dbg(&adev->dev, "device link [%s]->[%s], flags[%u]",
+				dev_name(consumer), dev_name(supplier), flags);
+
+		count++;
+	}
+
+	dev_dbg(&adev->dev, "device link lookup handle done %d/%d",
+			count, obj->package.count);
+
+	return count;
+}
+
+static int acpi_res_lookup_handle(acpi_handle handle, const char *name,
+		int (*func)(acpi_handle handle,
+			const union acpi_object *obj, void *data),
+		void *data)
+{
+	struct acpi_buffer output = {ACPI_ALLOCATE_BUFFER, NULL};
+	int ret;
+	acpi_status status;
+
+	if (!name || !func)
+		return -EINVAL;
+
+	status = acpi_evaluate_object_typed(handle,
+			(acpi_string)name, NULL, &output, ACPI_TYPE_PACKAGE);
+	if (ACPI_FAILURE(status))
+		return -ENODEV;
+
+	ret = func(handle, (const union acpi_object *)output.pointer, data);
+	kfree(output.pointer);
+
+	return ret;
+}
+
+static int acpi_resource_lookup_device(acpi_handle handle, void *data)
+{
+	struct device *dev = data;
+	int ret;
+
+	/* reset lookup */
+	ret = acpi_res_lookup_handle(handle,
+				"RSTL", reset_lookup_handle, dev);
+	if (ret < 0 && ret != -ENODEV)
+		dev_err(dev, "reset lookup handle fail");
+
+	/* reserved memory lookup */
+	ret = acpi_res_lookup_handle(handle,
+				"RSVL", reserved_mem_lookup_handle, dev);
+	if (ret < 0 && ret != -ENODEV)
+		dev_err(dev, "reserved memmory lookup handle fail");
+
+	/* resource name lookup */
+	ret = acpi_res_lookup_handle(handle,
+				"RSNL", resource_name_lookup_handle, dev);
+	if (ret < 0 && ret != -ENODEV)
+		dev_err(dev, "resource name lookup handle fail");
+
+	/* device link lookup */
+	ret = acpi_res_lookup_handle(handle,
+				"DLKL", device_link_lookup_handle, dev);
+	if (ret < 0 && ret != -ENODEV)
+		dev_err(dev, "device link lookup handle fail");
+
+	/*
+	 * Since some resources maybe disabled in some platform, and the
+	 * handles in the lookup process with the hardware maybe fail.
+	 * But other handles witch bind some resources to the device driver
+	 * by using "devm_xxx" functions is still needed by other drivers.
+	 *
+	 * So just print error message instead of return error value to the
+	 * "probe" function, witch cause the resoruces release in the device
+	 * driver.
+	 */
+
+	return 0;
+}
+
+static acpi_status acpi_bus_res_scan(acpi_handle handle, u32 level,
+					void *context, void **ret_p)
+{
+	struct device *dev = context;
+	acpi_object_type acpi_type;
+
+	if (!dev)
+		return AE_OK;
+
+	if (ACPI_FAILURE(acpi_get_type(handle, &acpi_type)))
+		return AE_OK;
+
+	if (acpi_type != ACPI_TYPE_DEVICE)
+		return AE_OK;
+
+	acpi_resource_lookup_device(handle, dev);
+
+	return AE_OK;
+}
+
+static int acpi_resource_lookup_probe(struct platform_device *pdev)
+{
+	acpi_status status;
+
+	status = acpi_walk_namespace(ACPI_TYPE_ANY,
+				ACPI_ROOT_OBJECT, ACPI_UINT32_MAX,
+				acpi_bus_res_scan, NULL, &pdev->dev, NULL);
+
+	/* do not ensure every resource since differnt configs */
+	return 0;
+}
+
+/*
+ * NCZ: CIXA1019 is owned by cix-acpi-resource-lookup-v1 (BIOS 1.0
+ * bridge); this 2026q2 walker runs before the Sky1 PCIe scan-handler
+ * devices exist and its lookups miss them, so leave it unmatched.
+ */
+static const struct acpi_device_id acpi_resource_lookup_match[] = {
+	{},
+};
+MODULE_DEVICE_TABLE(acpi, acpi_resource_lookup_match);
+
+static struct platform_driver acpi_resource_lookup_driver = {
+	.driver = {
+		.name = "acpi_resource_lookup",
+		.acpi_match_table = ACPI_PTR(acpi_resource_lookup_match),
+	},
+	.probe = acpi_resource_lookup_probe,
+};
+
+static int __init acpi_resource_lookup_init(void)
+{
+	if (acpi_disabled)
+		return -ENODEV;
+
+	return platform_driver_register(&acpi_resource_lookup_driver);
+}
+subsys_initcall(acpi_resource_lookup_init);
+
+MODULE_AUTHOR("Zichar Zhang <zichar.zhang@cixtech.com>");
+MODULE_DESCRIPTION("cix resource tables");
+MODULE_LICENSE("GPL v2");
diff --git a/drivers/soc/cix/acpi/cix-acpi-ec-fan.c b/drivers/soc/cix/acpi/cix-acpi-ec-fan.c
new file mode 100644
index 000000000000..7acf860dc0ce
--- /dev/null
+++ b/drivers/soc/cix/acpi/cix-acpi-ec-fan.c
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright 2026 Cix Technology Group Co., Ltd.
+ * CIX ACPI EC fan control over ASL methods.
+ */
+
+#include <linux/acpi.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
+
+#include "cix-acpi-ec.h"
+
+enum cix_aec_fan_mode_id {
+	CIX_AEC_FAN_MODE_MUTE = 0,
+	CIX_AEC_FAN_MODE_NORMAL,
+	CIX_AEC_FAN_MODE_MANUAL,
+	CIX_AEC_FAN_MODE_PERFORMANCE,
+	CIX_AEC_FAN_MODE_MAX,
+};
+
+struct cix_aec_fan_mode_desc {
+	const char *name;
+	const char *set_method;
+};
+
+static const struct cix_aec_fan_mode_desc cix_aec_fan_modes[CIX_AEC_FAN_MODE_MAX] = {
+	[CIX_AEC_FAN_MODE_MUTE] = {
+		.name = "mute",
+		.set_method = "SFMT",
+	},
+	[CIX_AEC_FAN_MODE_NORMAL] = {
+		.name = "normal",
+		.set_method = "SFAT",
+	},
+	[CIX_AEC_FAN_MODE_MANUAL] = {
+		.name = "manual",
+		.set_method = "SFMN",
+	},
+	[CIX_AEC_FAN_MODE_PERFORMANCE] = {
+		.name = "performance",
+		.set_method = "SFPF",
+	},
+};
+
+static int cix_aec_fan_set_mode(struct cix_aec *aec, int mode)
+{
+	acpi_status status;
+
+	if (mode < 0 || mode >= CIX_AEC_FAN_MODE_MAX)
+		return -EINVAL;
+	if (!cix_aec_fan_modes[mode].set_method)
+		return -EINVAL;
+
+	mutex_lock(&aec->lock);
+	status = acpi_evaluate_object(aec->handle,
+				      (acpi_string)cix_aec_fan_modes[mode].set_method,
+				      NULL, NULL);
+	if (!ACPI_FAILURE(status))
+		aec->fan_mode = mode;
+	mutex_unlock(&aec->lock);
+
+	return ACPI_FAILURE(status) ? -EIO : 0;
+}
+
+static int cix_aec_fan_set_pwm(struct cix_aec *aec, int duty, int type, int index)
+{
+	union acpi_object args[3];
+	struct acpi_object_list arg_list = {
+		.count = ARRAY_SIZE(args),
+		.pointer = args,
+	};
+	unsigned long long ret;
+	acpi_status status;
+
+	args[0].type = ACPI_TYPE_INTEGER;
+	args[0].integer.value = duty;
+	args[1].type = ACPI_TYPE_INTEGER;
+	args[1].integer.value = type;
+	args[2].type = ACPI_TYPE_INTEGER;
+	args[2].integer.value = index;
+
+	mutex_lock(&aec->lock);
+	status = acpi_evaluate_integer(aec->handle, "SFPW", &arg_list, &ret);
+	if (!ACPI_FAILURE(status) && ret == 0) {
+		aec->fan_duty = duty;
+		aec->fan_type = type;
+		aec->fan_index = index;
+		aec->fan_mode = CIX_AEC_FAN_MODE_MANUAL;
+	}
+	mutex_unlock(&aec->lock);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+	if (ret != 0)
+		return -EIO;
+
+	return 0;
+}
+
+static int cix_aec_fan_get_pwm(struct cix_aec *aec)
+{
+	union acpi_object args[2];
+	struct acpi_object_list arg_list = {
+		.count = ARRAY_SIZE(args),
+		.pointer = args,
+	};
+	unsigned long long duty;
+	acpi_status status;
+
+	args[0].type = ACPI_TYPE_INTEGER;
+	args[0].integer.value = aec->fan_type;
+	args[1].type = ACPI_TYPE_INTEGER;
+	args[1].integer.value = aec->fan_index;
+
+	mutex_lock(&aec->lock);
+	status = acpi_evaluate_integer(aec->handle, "GFPW", &arg_list, &duty);
+	mutex_unlock(&aec->lock);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+	if (duty == 0xFFFFFFFFULL)
+		return -EIO;
+
+	return (int)duty;
+}
+
+static ssize_t fan_mode_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+
+	if (aec->fan_mode < 0 || aec->fan_mode >= CIX_AEC_FAN_MODE_MAX)
+		return -EINVAL;
+
+	return sysfs_emit(buf, "%s\n", cix_aec_fan_modes[aec->fan_mode].name);
+}
+
+static ssize_t fan_mode_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	int mode;
+	int ret;
+
+	for (mode = 0; mode < CIX_AEC_FAN_MODE_MAX; mode++) {
+		if (sysfs_streq(buf, cix_aec_fan_modes[mode].name))
+			break;
+	}
+	if (mode == CIX_AEC_FAN_MODE_MAX)
+		return -EINVAL;
+
+	ret = cix_aec_fan_set_mode(aec, mode);
+	if (ret)
+		return ret;
+
+	return count;
+}
+static DEVICE_ATTR_RW(fan_mode);
+
+static ssize_t fan_available_mode_show(struct device *dev,
+				       struct device_attribute *attr, char *buf)
+{
+	ssize_t len = 0;
+	int i;
+
+	for (i = 0; i < CIX_AEC_FAN_MODE_MAX; i++) {
+		len += scnprintf(buf + len, PAGE_SIZE - len, "%s%s",
+				 cix_aec_fan_modes[i].name,
+				 (i == CIX_AEC_FAN_MODE_MAX - 1) ? "\n" : " ");
+	}
+
+	return len;
+}
+static DEVICE_ATTR_RO(fan_available_mode);
+
+static ssize_t fan_pwm_show(struct device *dev, struct device_attribute *attr,
+			    char *buf)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	int duty;
+
+	duty = cix_aec_fan_get_pwm(aec);
+	if (duty < 0)
+		return duty;
+
+	return sysfs_emit(buf, "%d\n", duty);
+}
+
+static ssize_t fan_pwm_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	int duty;
+	int type;
+	int index;
+	int ret;
+
+	ret = sscanf(buf, "%d %d %d", &duty, &type, &index);
+	if (ret != 3)
+		return -EINVAL;
+
+	ret = cix_aec_fan_set_pwm(aec, duty, type, index);
+	if (ret)
+		return ret;
+
+	return count;
+}
+static DEVICE_ATTR_RW(fan_pwm);
+
+static struct attribute *cix_aec_fan_attrs[] = {
+	&dev_attr_fan_mode.attr,
+	&dev_attr_fan_available_mode.attr,
+	&dev_attr_fan_pwm.attr,
+	NULL,
+};
+
+static const struct attribute_group cix_aec_fan_attr_group = {
+	.name = "fan",
+	.attrs = cix_aec_fan_attrs,
+};
+
+int cix_aec_fan_init(struct cix_aec *aec)
+{
+	aec->fan_mode = CIX_AEC_FAN_MODE_NORMAL;
+	aec->fan_type = 0;
+	aec->fan_index = 0;
+	aec->fan_duty = -1;
+
+	return sysfs_create_group(&aec->class_dev->kobj, &cix_aec_fan_attr_group);
+}
+
+void cix_aec_fan_exit(struct cix_aec *aec)
+{
+	sysfs_remove_group(&aec->class_dev->kobj, &cix_aec_fan_attr_group);
+}
diff --git a/drivers/soc/cix/acpi/cix-acpi-ec-gpio.c b/drivers/soc/cix/acpi/cix-acpi-ec-gpio.c
new file mode 100644
index 000000000000..4976916af03c
--- /dev/null
+++ b/drivers/soc/cix/acpi/cix-acpi-ec-gpio.c
@@ -0,0 +1,239 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright 2026 Cix Technology Group Co., Ltd.
+ * CIX ACPI EC GPIO implementation over ASL methods.
+ */
+
+#include <linux/acpi.h>
+#include <linux/bitmap.h>
+#include <linux/bitops.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/sysfs.h>
+#include "cix-acpi-ec.h"
+
+static int cix_aec_gpio_to_asl_num(unsigned int gpio)
+{
+	if (gpio >= CIX_AEC_GPIO_COUNT)
+		return -EINVAL;
+
+	if (gpio >= CIX_AEC_GPIO_GAP_START)
+		gpio += CIX_AEC_GPIO_GAP_SIZE;
+
+	return gpio;
+}
+
+static int cix_aec_gpio_write(acpi_handle handle, struct mutex *lock,
+			      unsigned int gpio, int value)
+{
+	union acpi_object args[2];
+	struct acpi_object_list arg_list = {
+		.count = ARRAY_SIZE(args),
+		.pointer = args,
+	};
+	acpi_status status;
+	int ec_gpio;
+
+	if (!handle || !lock)
+		return -EINVAL;
+
+	ec_gpio = cix_aec_gpio_to_asl_num(gpio);
+	if (ec_gpio < 0)
+		return ec_gpio;
+
+	args[0].type = ACPI_TYPE_INTEGER;
+	args[0].integer.value = ec_gpio;
+	args[1].type = ACPI_TYPE_INTEGER;
+	args[1].integer.value = !!value;
+
+	mutex_lock(lock);
+	status = acpi_evaluate_object(handle, "WRGP", &arg_list, NULL);
+	mutex_unlock(lock);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+
+	return 0;
+}
+
+static int cix_aec_gpio_read(acpi_handle handle, struct mutex *lock,
+			     unsigned int gpio)
+{
+	union acpi_object arg;
+	struct acpi_object_list arg_list = {
+		.count = 1,
+		.pointer = &arg,
+	};
+	unsigned long long val;
+	acpi_status status;
+	int ec_gpio;
+
+	if (!handle || !lock)
+		return -EINVAL;
+
+	ec_gpio = cix_aec_gpio_to_asl_num(gpio);
+	if (ec_gpio < 0)
+		return ec_gpio;
+
+	arg.type = ACPI_TYPE_INTEGER;
+	arg.integer.value = ec_gpio;
+
+	mutex_lock(lock);
+	status = acpi_evaluate_integer(handle, "RDGP", &arg_list, &val);
+	mutex_unlock(lock);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+
+	return !!val;
+}
+
+static int cix_aec_gpio_get_direction(struct gpio_chip *gc, unsigned int gpio)
+{
+	struct cix_aec *aec = gpiochip_get_data(gc);
+
+	if (test_bit(gpio, aec->gpio_dir_out))
+		return GPIO_LINE_DIRECTION_OUT;
+
+	return GPIO_LINE_DIRECTION_IN;
+}
+
+static int cix_aec_gpio_direction_input(struct gpio_chip *gc, unsigned int gpio)
+{
+	struct cix_aec *aec = gpiochip_get_data(gc);
+
+	clear_bit(gpio, aec->gpio_dir_out);
+	return 0;
+}
+
+static int cix_aec_gpio_direction_output(struct gpio_chip *gc, unsigned int gpio,
+					 int value)
+{
+	struct cix_aec *aec = gpiochip_get_data(gc);
+	int ret;
+
+	ret = cix_aec_gpio_write(aec->handle, &aec->lock, gpio, value);
+	if (ret)
+		return ret;
+
+	set_bit(gpio, aec->gpio_dir_out);
+	return 0;
+}
+
+static int cix_aec_gpio_get(struct gpio_chip *gc, unsigned int gpio)
+{
+	struct cix_aec *aec = gpiochip_get_data(gc);
+
+	return cix_aec_gpio_read(aec->handle, &aec->lock, gpio);
+}
+
+static int cix_aec_gpio_set(struct gpio_chip *gc, unsigned int gpio, int value)
+{
+	struct cix_aec *aec = gpiochip_get_data(gc);
+
+	cix_aec_gpio_write(aec->handle, &aec->lock, gpio, value);
+	return 0;
+}
+
+static ssize_t gpio_count_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", CIX_AEC_GPIO_COUNT);
+}
+static DEVICE_ATTR_RO(gpio_count);
+
+static ssize_t gpio_read_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	int ret;
+
+	ret = cix_aec_gpio_read(aec->handle, &aec->lock, aec->gpio_read_index);
+	if (ret < 0)
+		return ret;
+
+	return sysfs_emit(buf, "%d\n", ret);
+}
+
+static ssize_t gpio_read_store(struct device *dev,
+			       struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	unsigned int gpio;
+
+	if (kstrtouint(buf, 0, &gpio))
+		return -EINVAL;
+
+	aec->gpio_read_index = gpio;
+
+	return count;
+}
+static DEVICE_ATTR_RW(gpio_read);
+
+static ssize_t gpio_write_store(struct device *dev,
+				struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	unsigned int gpio;
+	unsigned int value;
+	int ret;
+
+	if (sscanf(buf, "%u %u", &gpio, &value) != 2)
+		return -EINVAL;
+
+	ret = cix_aec_gpio_write(aec->handle, &aec->lock, gpio, value);
+	if (ret)
+		return ret;
+
+	return count;
+}
+static DEVICE_ATTR_WO(gpio_write);
+
+static struct attribute *cix_aec_gpio_attrs[] = {
+	&dev_attr_gpio_count.attr,
+	&dev_attr_gpio_read.attr,
+	&dev_attr_gpio_write.attr,
+	NULL,
+};
+
+static const struct attribute_group cix_aec_gpio_attr_group = {
+	.name = "gpio",
+	.attrs = cix_aec_gpio_attrs,
+};
+
+int cix_aec_gpio_init(struct cix_aec *aec)
+{
+	int ret;
+
+	ret = sysfs_create_group(&aec->class_dev->kobj, &cix_aec_gpio_attr_group);
+	if (ret)
+		return ret;
+
+	bitmap_zero(aec->gpio_dir_out, CIX_AEC_GPIO_COUNT);
+
+	aec->gc.label = "cix-acpi-ec-gpio";
+	aec->gc.parent = aec->dev;
+	aec->gc.owner = THIS_MODULE;
+	aec->gc.base = -1;
+	aec->gc.ngpio = CIX_AEC_GPIO_COUNT;
+	aec->gc.can_sleep = true;
+	aec->gc.get_direction = cix_aec_gpio_get_direction;
+	aec->gc.direction_input = cix_aec_gpio_direction_input;
+	aec->gc.direction_output = cix_aec_gpio_direction_output;
+	aec->gc.get = cix_aec_gpio_get;
+	aec->gc.set = cix_aec_gpio_set;
+
+	ret = devm_gpiochip_add_data(aec->dev, &aec->gc, aec);
+	if (ret) {
+		sysfs_remove_group(&aec->class_dev->kobj, &cix_aec_gpio_attr_group);
+		return ret;
+	}
+
+	return 0;
+}
+
+void cix_aec_gpio_exit(struct cix_aec *aec)
+{
+	sysfs_remove_group(&aec->class_dev->kobj, &cix_aec_gpio_attr_group);
+}
diff --git a/drivers/soc/cix/acpi/cix-acpi-ec-light.c b/drivers/soc/cix/acpi/cix-acpi-ec-light.c
new file mode 100644
index 000000000000..22aff80572ee
--- /dev/null
+++ b/drivers/soc/cix/acpi/cix-acpi-ec-light.c
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright 2026 Cix Technology Group Co., Ltd.
+ * CIX ACPI EC light/backlight control over ASL methods.
+ */
+
+#include <linux/acpi.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/sysfs.h>
+
+#include "cix-acpi-ec.h"
+
+static int cix_aec_get_kbl(struct cix_aec *aec, int *percent, int *enable)
+{
+	struct acpi_buffer buffer = { ACPI_ALLOCATE_BUFFER, NULL };
+	union acpi_object *obj;
+	acpi_status status;
+	int ret = -EIO;
+
+	mutex_lock(&aec->lock);
+	status = acpi_evaluate_object(aec->handle, "GKBL", NULL, &buffer);
+	mutex_unlock(&aec->lock);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+
+	obj = buffer.pointer;
+	if (!obj || obj->type != ACPI_TYPE_PACKAGE || obj->package.count < 2)
+		goto out;
+	if (obj->package.elements[0].type != ACPI_TYPE_INTEGER)
+		goto out;
+	if (obj->package.elements[1].type != ACPI_TYPE_INTEGER)
+		goto out;
+
+	*percent = (int)obj->package.elements[0].integer.value;
+	*enable = (int)obj->package.elements[1].integer.value;
+	ret = 0;
+out:
+	kfree(buffer.pointer);
+	return ret;
+}
+
+static int cix_aec_set_kbl(struct cix_aec *aec, int percent)
+{
+	union acpi_object arg;
+	struct acpi_object_list arg_list = {
+		.count = 1,
+		.pointer = &arg,
+	};
+	acpi_status status;
+
+	arg.type = ACPI_TYPE_INTEGER;
+	arg.integer.value = percent;
+
+	mutex_lock(&aec->lock);
+	status = acpi_evaluate_object(aec->handle, "SKBL", &arg_list, NULL);
+	mutex_unlock(&aec->lock);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+
+	return 0;
+}
+
+static int cix_aec_get_lss(struct cix_aec *aec, int *type, int *value)
+{
+	struct acpi_buffer buffer = { ACPI_ALLOCATE_BUFFER, NULL };
+	union acpi_object *obj;
+	acpi_status status;
+	int ret = -EIO;
+
+	mutex_lock(&aec->lock);
+	status = acpi_evaluate_object(aec->handle, "GLSS", NULL, &buffer);
+	mutex_unlock(&aec->lock);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+
+	obj = buffer.pointer;
+	if (!obj || obj->type != ACPI_TYPE_PACKAGE || obj->package.count < 2)
+		goto out;
+	if (obj->package.elements[0].type != ACPI_TYPE_INTEGER)
+		goto out;
+	if (obj->package.elements[1].type != ACPI_TYPE_INTEGER)
+		goto out;
+
+	*type = (int)obj->package.elements[0].integer.value;
+	*value = (int)obj->package.elements[1].integer.value;
+	ret = 0;
+out:
+	kfree(buffer.pointer);
+	return ret;
+}
+
+static ssize_t kbl_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	int percent;
+	int enable;
+	int ret;
+
+	ret = cix_aec_get_kbl(aec, &percent, &enable);
+	if (ret)
+		return ret;
+
+	return sysfs_emit(buf, "%d %d\n", percent, enable);
+}
+
+static ssize_t kbl_store(struct device *dev, struct device_attribute *attr,
+			 const char *buf, size_t count)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	int percent;
+	int ret;
+
+	ret = kstrtoint(buf, 0, &percent);
+	if (ret)
+		return ret;
+
+	ret = cix_aec_set_kbl(aec, percent);
+	if (ret)
+		return ret;
+
+	return count;
+}
+static DEVICE_ATTR_RW(kbl);
+
+static ssize_t lss_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	int type;
+	int value;
+	int ret;
+
+	ret = cix_aec_get_lss(aec, &type, &value);
+	if (ret)
+		return ret;
+
+	return sysfs_emit(buf, "%d %d\n", type, value);
+}
+static DEVICE_ATTR_RO(lss);
+
+static struct attribute *cix_aec_light_attrs[] = {
+	&dev_attr_kbl.attr,
+	&dev_attr_lss.attr,
+	NULL,
+};
+
+static const struct attribute_group cix_aec_light_attr_group = {
+	.name = "light",
+	.attrs = cix_aec_light_attrs,
+};
+
+int cix_aec_light_init(struct cix_aec *aec)
+{
+	return sysfs_create_group(&aec->class_dev->kobj, &cix_aec_light_attr_group);
+}
+
+void cix_aec_light_exit(struct cix_aec *aec)
+{
+	sysfs_remove_group(&aec->class_dev->kobj, &cix_aec_light_attr_group);
+}
diff --git a/drivers/soc/cix/acpi/cix-acpi-ec.c b/drivers/soc/cix/acpi/cix-acpi-ec.c
new file mode 100644
index 000000000000..6256bd1f9077
--- /dev/null
+++ b/drivers/soc/cix/acpi/cix-acpi-ec.c
@@ -0,0 +1,398 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright 2026 Cix Technology Group Co., Ltd.
+ * CIX ACPI EC platform driver entry.
+ */
+
+#include <linux/acpi.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/list.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "cix-acpi-ec.h"
+#include "../cix-plat-base.h"
+
+#define CIX_EC_ACPI_HID "CIXHA015"
+#define CIX_EC_MAX_ASL_ARGS 16
+
+struct cix_aec_asl_item {
+	struct list_head node;
+	char name[5];
+	int argc;
+};
+
+struct cix_aec_ctx {
+	struct list_head items;
+	int item_count;
+};
+
+static struct cix_aec_ctx cix_aec_ctx = {
+	.items = LIST_HEAD_INIT(cix_aec_ctx.items),
+	.item_count = 0,
+};
+
+struct cix_aec_scan_ctx {
+	int err;
+};
+
+static const char * const cix_aec_method_blacklist[] = {
+	"_STA",
+	"_INI",
+	"REST",
+	"STAT",
+	"STOP",
+	"READ",
+	"WRIT",
+	"CKSB",
+	"CLRB",
+	"SETB",
+	"CLRF",
+	"TRAS",
+	"EVNT",
+	"NTII",
+};
+
+static bool cix_aec_method_is_blacklisted(const char *name)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(cix_aec_method_blacklist); i++) {
+		if (!strcmp(name, cix_aec_method_blacklist[i]))
+			return true;
+	}
+
+	return false;
+}
+
+static const struct cix_aec_asl_item *cix_aec_find_method_spec(const char *name)
+{
+	struct cix_aec_asl_item *item;
+
+	list_for_each_entry(item, &cix_aec_ctx.items, node)
+		if (!strcmp(name, item->name))
+			return item;
+
+	return NULL;
+}
+
+static void cix_aec_clear_methods(void)
+{
+	struct cix_aec_asl_item *item;
+	struct cix_aec_asl_item *tmp;
+
+	list_for_each_entry_safe(item, tmp, &cix_aec_ctx.items, node) {
+		list_del(&item->node);
+		kfree(item);
+	}
+	cix_aec_ctx.item_count = 0;
+}
+
+static acpi_status cix_aec_scan_method_cb(acpi_handle handle, u32 level,
+					  void *context, void **return_value)
+{
+	struct cix_aec_scan_ctx *ctx = context;
+	struct cix_aec_asl_item *item;
+	struct acpi_device_info *info = NULL;
+	struct acpi_buffer name_buf = { ACPI_ALLOCATE_BUFFER, NULL };
+	acpi_status status;
+
+	status = acpi_get_name(handle, ACPI_SINGLE_NAME, &name_buf);
+	if (ACPI_FAILURE(status))
+		return AE_OK;
+
+	if (cix_aec_method_is_blacklisted(name_buf.pointer)) {
+		kfree(name_buf.pointer);
+		return AE_OK;
+	}
+
+	item = kzalloc(sizeof(*item), GFP_KERNEL);
+	if (!item) {
+		ctx->err = -ENOMEM;
+		kfree(name_buf.pointer);
+		return AE_CTRL_TERMINATE;
+	}
+
+	strscpy(item->name, name_buf.pointer, sizeof(item->name));
+	item->argc = -1;
+
+	status = acpi_get_object_info(handle, &info);
+	if (ACPI_SUCCESS(status) && info)
+		item->argc = info->param_count;
+
+	kfree(info);
+	kfree(name_buf.pointer);
+	list_add_tail(&item->node, &cix_aec_ctx.items);
+	cix_aec_ctx.item_count++;
+
+	return AE_OK;
+}
+
+static int cix_aec_scan_methods(struct cix_aec *aec)
+{
+	struct cix_aec_scan_ctx ctx = {
+		.err = 0,
+	};
+	acpi_status status;
+
+	cix_aec_clear_methods();
+
+	status = acpi_walk_namespace(ACPI_TYPE_METHOD, aec->handle, ACPI_UINT32_MAX,
+				     cix_aec_scan_method_cb, NULL, &ctx, NULL);
+	if (ACPI_FAILURE(status) && status != AE_CTRL_TERMINATE)
+		return -EIO;
+	if (ctx.err)
+		return ctx.err;
+	if (!cix_aec_ctx.item_count)
+		return -ENOENT;
+
+	return 0;
+}
+
+static char *cix_aec_next_token(char **cursor)
+{
+	char *tok;
+
+	while ((tok = strsep(cursor, " \t\n")) != NULL) {
+		if (*tok != '\0')
+			return tok;
+	}
+
+	return NULL;
+}
+
+static ssize_t cix_aec_dump_methods(char *buf)
+{
+	ssize_t len = 0;
+	struct cix_aec_asl_item *item;
+
+	len += scnprintf(buf + len, PAGE_SIZE - len,
+			 "METHOD\tARGC\n");
+	len += scnprintf(buf + len, PAGE_SIZE - len,
+			 "------\t----\n");
+
+	list_for_each_entry(item, &cix_aec_ctx.items, node) {
+		if (item->argc >= 0) {
+			len += scnprintf(buf + len, PAGE_SIZE - len, "%s\t%d\n",
+					 item->name, item->argc);
+		} else {
+			len += scnprintf(buf + len, PAGE_SIZE - len, "%s\t?\n",
+					 item->name);
+		}
+		if (len >= PAGE_SIZE - 1)
+			break;
+	}
+
+	return len;
+}
+
+static ssize_t asl_call_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	ssize_t len;
+
+	mutex_lock(&aec->lock);
+	len = cix_aec_dump_methods(buf);
+	mutex_unlock(&aec->lock);
+
+	return len;
+}
+
+static ssize_t asl_methods_show(struct device *dev, struct device_attribute *attr,
+				char *buf)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	ssize_t len;
+
+	mutex_lock(&aec->lock);
+	len = cix_aec_dump_methods(buf);
+	mutex_unlock(&aec->lock);
+
+	return len;
+}
+static DEVICE_ATTR_RO(asl_methods);
+
+static ssize_t asl_call_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	struct cix_aec *aec = dev_get_drvdata(dev);
+	const struct cix_aec_asl_item *method;
+	union acpi_object objs[CIX_EC_MAX_ASL_ARGS];
+	struct acpi_object_list arg_list = {
+		.pointer = objs,
+	};
+	unsigned long long number;
+	struct acpi_buffer out = { ACPI_ALLOCATE_BUFFER, NULL };
+	char *kbuf;
+	char *cursor;
+	char *tok;
+	int argc = 0;
+	acpi_status status;
+
+	kbuf = kstrdup(buf, GFP_KERNEL);
+	if (!kbuf)
+		return -ENOMEM;
+
+	cursor = kbuf;
+	tok = cix_aec_next_token(&cursor);
+	if (!tok)
+		goto err_inval;
+
+	method = cix_aec_find_method_spec(tok);
+	if (!method)
+		goto err_noent;
+
+	while ((tok = cix_aec_next_token(&cursor)) != NULL) {
+		if (argc >= CIX_EC_MAX_ASL_ARGS)
+			goto err_too_many;
+		if (!kstrtoull(tok, 0, &number)) {
+			objs[argc].type = ACPI_TYPE_INTEGER;
+			objs[argc].integer.value = number;
+		} else {
+			objs[argc].type = ACPI_TYPE_STRING;
+			objs[argc].string.pointer = tok;
+			objs[argc].string.length = strlen(tok);
+		}
+		argc++;
+	}
+
+	if (method->argc >= 0 && argc != method->argc)
+		goto err_inval;
+
+	arg_list.count = argc;
+	mutex_lock(&aec->lock);
+	status = acpi_evaluate_object(aec->handle, (acpi_string)method->name,
+				      argc ? &arg_list : NULL, &out);
+	if (ACPI_FAILURE(status))
+		goto err_eval;
+	mutex_unlock(&aec->lock);
+
+	kfree(out.pointer);
+	kfree(kbuf);
+	return count;
+err_inval:
+	kfree(kbuf);
+	return -EINVAL;
+err_noent:
+	kfree(kbuf);
+	return -ENOENT;
+err_too_many:
+	kfree(kbuf);
+	return -E2BIG;
+err_eval:
+	mutex_unlock(&aec->lock);
+	kfree(out.pointer);
+	kfree(kbuf);
+	return -EIO;
+}
+static DEVICE_ATTR_RW(asl_call);
+
+static int cix_aec_probe(struct platform_device *pdev)
+{
+	struct cix_aec *aec;
+	struct class *cix_class;
+	int ret;
+
+	aec = devm_kzalloc(&pdev->dev, sizeof(*aec), GFP_KERNEL);
+	if (!aec)
+		return -ENOMEM;
+
+	aec->dev = &pdev->dev;
+	aec->handle = ACPI_HANDLE(&pdev->dev);
+	if (!aec->handle)
+		return -ENODEV;
+
+	mutex_init(&aec->lock);
+	platform_set_drvdata(pdev, aec);
+
+	cix_class = cix_plat_base_get_class();
+	if (!cix_class)
+		return -EPROBE_DEFER;
+
+	aec->class_dev = device_create(cix_class, &pdev->dev,
+				       MKDEV(0, 0), aec, "ec");
+	if (IS_ERR(aec->class_dev))
+		return PTR_ERR(aec->class_dev);
+
+	ret = device_create_file(aec->class_dev, &dev_attr_asl_call);
+	if (ret)
+		goto err_destroy_class_dev;
+
+	ret = device_create_file(aec->class_dev, &dev_attr_asl_methods);
+	if (ret)
+		goto err_remove_asl_call;
+
+	ret = cix_aec_scan_methods(aec);
+	if (ret)
+		goto err_remove_asl_methods;
+
+	ret = cix_aec_gpio_init(aec);
+	if (ret)
+		goto err_free_asl_list;
+
+	ret = cix_aec_light_init(aec);
+	if (ret)
+		goto err_gpio;
+
+	ret = cix_aec_fan_init(aec);
+	if (ret) {
+		cix_aec_light_exit(aec);
+		goto err_gpio;
+	}
+
+	return 0;
+
+err_gpio:
+	cix_aec_gpio_exit(aec);
+err_free_asl_list:
+	cix_aec_clear_methods();
+err_remove_asl_methods:
+	device_remove_file(aec->class_dev, &dev_attr_asl_methods);
+err_remove_asl_call:
+	device_remove_file(aec->class_dev, &dev_attr_asl_call);
+err_destroy_class_dev:
+	device_unregister(aec->class_dev);
+	aec->class_dev = NULL;
+	return ret;
+}
+
+static void cix_aec_remove(struct platform_device *pdev)
+{
+	struct cix_aec *aec = platform_get_drvdata(pdev);
+
+	cix_aec_fan_exit(aec);
+	cix_aec_light_exit(aec);
+	cix_aec_gpio_exit(aec);
+	if (aec->class_dev) {
+		cix_aec_clear_methods();
+		device_remove_file(aec->class_dev, &dev_attr_asl_methods);
+		device_remove_file(aec->class_dev, &dev_attr_asl_call);
+		device_unregister(aec->class_dev);
+		aec->class_dev = NULL;
+	}
+}
+
+static const struct acpi_device_id cix_aec_acpi_match[] = {
+	{ CIX_EC_ACPI_HID, 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(acpi, cix_aec_acpi_match);
+
+static struct platform_driver cix_aec_driver = {
+	.probe = cix_aec_probe,
+	.remove = cix_aec_remove,
+	.driver = {
+		.name = "cix-acpi-ec",
+		.acpi_match_table = cix_aec_acpi_match,
+	},
+};
+module_platform_driver(cix_aec_driver);
+
+MODULE_AUTHOR("Zichar Zhang <zichar.zhang@cixtech.com>");
+MODULE_DESCRIPTION("CIX ACPI EC platform driver");
+MODULE_ALIAS("platform:cix-acpi-ec");
+MODULE_LICENSE("GPL");
diff --git a/drivers/soc/cix/acpi/cix-acpi-ec.h b/drivers/soc/cix/acpi/cix-acpi-ec.h
new file mode 100644
index 000000000000..438ff0fa81d5
--- /dev/null
+++ b/drivers/soc/cix/acpi/cix-acpi-ec.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright 2026 Cix Technology Group Co., Ltd.
+ * CIX ACPI EC shared definitions for platform submodules.
+ */
+
+#ifndef __CIX_ACPI_EC_H__
+#define __CIX_ACPI_EC_H__
+
+#include <linux/acpi.h>
+#include <linux/bitmap.h>
+#include <linux/device.h>
+#include <linux/gpio/driver.h>
+#include <linux/mutex.h>
+
+#define CIX_AEC_GPIO_COUNT		(88 + 16)
+#define CIX_AEC_GPIO_GAP_START		88
+#define CIX_AEC_GPIO_GAP_SIZE		112
+
+struct cix_aec {
+	struct device *dev;
+	struct device *class_dev;
+	acpi_handle handle;
+	struct mutex lock;
+	unsigned int gpio_read_index;
+	struct gpio_chip gc;
+	unsigned long gpio_dir_out[BITS_TO_LONGS(CIX_AEC_GPIO_COUNT)];
+
+	/* EC fan state */
+	int fan_mode;
+	int fan_duty;
+	int fan_type;
+	int fan_index;
+};
+
+int cix_aec_gpio_init(struct cix_aec *aec);
+void cix_aec_gpio_exit(struct cix_aec *aec);
+
+int cix_aec_light_init(struct cix_aec *aec);
+void cix_aec_light_exit(struct cix_aec *aec);
+
+int cix_aec_fan_init(struct cix_aec *aec);
+void cix_aec_fan_exit(struct cix_aec *aec);
+
+#endif /* __CIX_ACPI_EC_H__ */
diff --git a/drivers/soc/cix/acpi/cix-acpi-plat.c b/drivers/soc/cix/acpi/cix-acpi-plat.c
new file mode 100644
index 000000000000..759214b3b2d0
--- /dev/null
+++ b/drivers/soc/cix/acpi/cix-acpi-plat.c
@@ -0,0 +1,179 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0+
+ *
+ * Add CIX SKY1 SoC Version driver
+ *
+ */
+#include <linux/kernel.h>
+#include <linux/pci.h>
+#include <linux/platform_device.h>
+#include <linux/types.h>
+#include <linux/acpi.h>
+
+enum {
+	DENY_PCIE = 0,
+	DENY_USB,
+	DENY_SCMI_CLKS,
+	DENY_MAX,
+};
+
+static bool pcie_pnp_en = false;
+static bool usb_pnp_en = false;
+static bool acpi_scmi_en = false;
+
+static int __init pcie_pnp_update(char *str)
+{
+	pcie_pnp_en = true;
+
+	return 0;
+}
+early_param("pcie_pnp_en", pcie_pnp_update);
+
+static int __init usb_pnp_update(char *str)
+{
+	usb_pnp_en = true;
+
+	return 0;
+}
+early_param("usb_pnp_en", usb_pnp_update);
+
+static int __init parse_acpi_scmi_support(char *arg)
+{
+	if (!arg)
+		return -EINVAL;
+
+	if (strcmp(arg, "off") == 0)
+		acpi_scmi_en = false;
+	else if (strcmp(arg, "on") == 0)
+		acpi_scmi_en = true;
+	else
+		return -EINVAL;
+
+	return 0;
+}
+early_param("acpi_scmi_en", parse_acpi_scmi_support);
+
+static struct acpi_device_id pcie_pnp_deny_ids[] = {
+	/* override PCIE acpi scan handler */
+	{"PNP0A03", 0}, /* PCIE */
+	{"PNP0C0F", 0}, /* PCIE Links */
+	{"", 0},
+};
+
+static struct acpi_device_id usb_pnp_deny_ids[] = {
+	{"PNP0D10", 0},
+	{"", 0},
+};
+
+static struct acpi_device_id pcie_cdns_deny_ids[] = {
+	{"CIXH2020", 0}, /* pcie rc */
+	{"CIXH2021", 0}, /* pcie ep */
+	{"CIXH2023", 0}, /* pcie phy */
+	{"", 0},
+};
+
+static struct acpi_device_id usb_cdns_deny_ids[] = {
+	{"CIXH2030", 0}, /* sky1 usbssp */
+	{"CIXH2031", 0}, /* cdns usbssp */
+	{"CIXH2032", 0}, /* usb 2.0 phy */
+	/* CIXH2033 is combo phy, also used by dp */
+	{"CIXH2034", 0}, /* usb 3.0 phy */
+	{"", 0},
+};
+
+static struct acpi_device_id acpi_clks_deny_ids[] = {
+	{"CIXHA010", 0},
+	{"", 0},
+};
+
+static struct acpi_device_id scmi_clks_deny_ids[] = {
+	{"CIXHA009", 0},
+	{"", 0},
+};
+
+static int acpi_device_deny(struct acpi_device *adev,
+			     const struct acpi_device_id *not_used)
+{
+	dev_dbg(&adev->dev, "acpi disable dev[%s]\n", dev_name(&adev->dev));
+
+	return -1; /* return -1 to block platform device enumeration */
+}
+
+static struct acpi_scan_handler acpi_deny_handler[DENY_MAX] = {
+	{
+		.ids = pcie_pnp_deny_ids,
+		.attach = acpi_device_deny,
+	},
+	{
+		.ids = usb_pnp_deny_ids,
+		.attach = acpi_device_deny,
+	}
+};
+
+/*
+ * True only on real Sky1 firmware.
+ *
+ * The deny handlers below exist to stop the GENERIC ACPI enumerators from
+ * claiming devices that the CIX vendor drivers must own.  That is correct on
+ * Sky1 and actively harmful anywhere else: DENY_PCIE blocks PNP0A03, the
+ * standard PCI root bridge, so on any non-Sky1 ACPI machine the PCI bus is
+ * never enumerated at all -- no host controllers, no storage, no network.
+ *
+ * Measured under QEMU virt (MCFG OEM "BOCHS"): with the deny active the kernel
+ * reported "ACPI: MCFG table detected" and then nothing, /sys/bus/pci/devices
+ * was empty and /proc/partitions listed no devices whatsoever.  With the deny
+ * skipped the same kernel brings up "ACPI: PCI Root Bridge [PCI0]", xhci_hcd,
+ * virtio_blk and the USB medium.
+ *
+ * Detection matches pci-sky1-acpi.c, which already guards its own PNP0A08
+ * block the same way.
+ */
+static bool sky1_firmware_detected(void)
+{
+	struct acpi_table_header *header;
+	bool detected;
+
+	if (acpi_disabled)
+		return false;
+
+	if (ACPI_FAILURE(acpi_get_table(ACPI_SIG_MCFG, 0, &header)))
+		return false;
+
+	detected = !memcmp(header->oem_id, "CIXTEK", 6) &&
+		   !memcmp(header->oem_table_id, "SKY1EDK2", 8);
+	acpi_put_table(header);
+
+	return detected;
+}
+
+static void device_deny_id_init(void)
+{
+	int i;
+
+	if (!sky1_firmware_detected()) {
+		pr_info("cix-acpi-plat: not Sky1 firmware, leaving generic ACPI enumeration alone\n");
+		return;
+	}
+
+	if (pcie_pnp_en)
+		acpi_deny_handler[DENY_PCIE].ids = pcie_cdns_deny_ids;
+
+	if (usb_pnp_en)
+		acpi_deny_handler[DENY_USB].ids = usb_cdns_deny_ids;
+
+	if (acpi_scmi_en)
+		acpi_deny_handler[DENY_SCMI_CLKS].ids = acpi_clks_deny_ids;
+	else
+		acpi_deny_handler[DENY_SCMI_CLKS].ids = scmi_clks_deny_ids;
+
+	for(i = 0; i < DENY_MAX; i++)
+		acpi_scan_add_handler(&acpi_deny_handler[i]);
+}
+
+int cix_acpi_plat_arch_init(void)
+{
+	device_deny_id_init();
+
+	return 0;
+}
+arch_initcall(cix_acpi_plat_arch_init);
diff --git a/drivers/soc/cix/acpi/cix-acpi-resource-lookup-v1.c b/drivers/soc/cix/acpi/cix-acpi-resource-lookup-v1.c
new file mode 100644
index 000000000000..91a58e24c28c
--- /dev/null
+++ b/drivers/soc/cix/acpi/cix-acpi-resource-lookup-v1.c
@@ -0,0 +1,419 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CIX ACPI Resource Lookup driver
+ *
+ * Processes custom DSDT tables (RSTL, RSNL, DLKL) attached to CIX ACPI
+ * devices to bridge the gap between CIX's ACPI firmware and the Linux
+ * kernel's standard resource lookup mechanisms.
+ *
+ * RSTL (Reset Lookup):   Registers reset_control_lookup entries so that
+ *                        devm_reset_control_get() works under ACPI.
+ * RSNL (Resource Names): Assigns names to platform_device resources by
+ *                        index so platform_get_resource_byname() works.
+ * DLKL (Device Links):   Creates device_link dependencies between
+ *                        supplier and consumer devices.
+ * CLKT (Clock Table):    Creates device_link from each CLKT consumer to
+ *                        the ACPI clock provider (CIXHA010) so that
+ *                        clk-sky1-acpi probes before its consumers.
+ *
+ * Based on vendor driver by Zichar Zhang <zichar.zhang@cixtech.com>
+ */
+
+#include <linux/acpi.h>
+#include <linux/device.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/reset-controller.h>
+
+static struct acpi_device *acpi_obj_to_acpi_dev(const union acpi_object *obj)
+{
+	if (!obj)
+		return NULL;
+
+	if (obj->type == ACPI_TYPE_LOCAL_REFERENCE) {
+		return acpi_fetch_acpi_dev(obj->reference.handle);
+	} else if (obj->type == ACPI_TYPE_STRING) {
+		acpi_handle handle;
+		acpi_status status;
+
+		status = acpi_get_handle(NULL, obj->string.pointer, &handle);
+		if (ACPI_FAILURE(status))
+			return NULL;
+		return acpi_fetch_acpi_dev(handle);
+	}
+
+	return NULL;
+}
+
+static struct device *acpi_obj_to_platform_device(const union acpi_object *obj)
+{
+	struct acpi_device *adev = acpi_obj_to_acpi_dev(obj);
+
+	if (!adev)
+		return NULL;
+
+	return bus_find_device_by_acpi_dev(&platform_bus_type, adev);
+}
+
+static const char *acpi_obj_to_devname(const union acpi_object *obj)
+{
+	struct acpi_device *adev;
+	struct device *dev;
+
+	dev = acpi_obj_to_platform_device(obj);
+	if (dev)
+		return dev_name(dev);
+
+	/*
+	 * The target platform_device may not be instantiated yet when this
+	 * lookup runs (subsys_initcall ordering vs ACPI platform-device
+	 * creation).  For ACPI-enumerated platform devices, dev_name() equals
+	 * the ACPI device's bus id, so fall back to that deterministic name.
+	 * Without this, reset_control lookups for not-yet-probed consumers
+	 * (e.g. usb_reset/usb_preset on CIXH2030/CIXH2032) get a NULL dev_id
+	 * and are rejected by reset_controller_add_lookup() as "badly
+	 * specified", leaving USB PHY/controller resets unresolved.
+	 */
+	adev = acpi_obj_to_acpi_dev(obj);
+	return adev ? acpi_dev_name(adev) : NULL;
+}
+
+/*
+ * RSTL — Reset Lookup Table
+ *
+ * Each entry: { <provider_ref>, <index>, <consumer_ref>, [<con_id>] }
+ * Registers a reset_control_lookup so devm_reset_control_get() can find
+ * the reset line by consumer device name and optional connection ID.
+ */
+static int reset_lookup_handle(acpi_handle handle,
+			       const union acpi_object *obj, void *data)
+{
+	struct device *dev = data;
+	const union acpi_object *child, *el;
+	struct reset_control_lookup *lookup;
+	int i, pcnt, count = 0;
+	struct acpi_device *adev = acpi_fetch_acpi_dev(handle);
+
+	if (!adev || !adev->status.present)
+		return -ENODEV;
+
+	for (i = 0; i < obj->package.count; i++) {
+		child = &obj->package.elements[i];
+		pcnt = child->package.count;
+
+		if (pcnt < 3)
+			continue;
+
+		el = child->package.elements;
+
+		if ((el[0].type != ACPI_TYPE_LOCAL_REFERENCE &&
+		     el[0].type != ACPI_TYPE_STRING) ||
+		    el[1].type != ACPI_TYPE_INTEGER ||
+		    (el[2].type != ACPI_TYPE_LOCAL_REFERENCE &&
+		     el[2].type != ACPI_TYPE_STRING) ||
+		    (pcnt > 3 && el[3].type != ACPI_TYPE_STRING))
+			continue;
+
+		lookup = devm_kzalloc(dev, sizeof(*lookup), GFP_KERNEL);
+		if (!lookup)
+			return -ENOMEM;
+		INIT_LIST_HEAD(&lookup->list);
+		lookup->provider = acpi_obj_to_devname(&el[0]);
+		lookup->index = el[1].integer.value;
+		lookup->dev_id = acpi_obj_to_devname(&el[2]);
+		lookup->con_id = pcnt > 3 ?
+			devm_kstrdup(dev, el[3].string.pointer, GFP_KERNEL)
+			: NULL;
+
+		/*
+		 * reset_controller_add_lookup() requires both fields, and lookup
+		 * matching starts with dev_id before considering con_id.  The ACPI
+		 * name fallback above covers consumers not instantiated yet, so a
+		 * missing name here denotes an unresolved firmware reference.
+		 */
+		if (!lookup->provider || !lookup->dev_id) {
+			dev_dbg(&adev->dev,
+				"invalid RSTL[%d]: provider[%s] dev[%s] con[%s]\n",
+				i, lookup->provider, lookup->dev_id, lookup->con_id);
+			continue;
+		}
+
+		reset_controller_add_lookup(lookup, 1);
+
+		dev_dbg(&adev->dev,
+			"rst lookup: prov[%s] idx[%llu] dev[%s] con[%s]\n",
+			lookup->provider, el[1].integer.value,
+			lookup->dev_id, lookup->con_id);
+		count++;
+	}
+
+	dev_dbg(&adev->dev, "reset lookup: %d/%d entries\n",
+		count, obj->package.count);
+
+	return count;
+}
+
+/*
+ * RSNL — Resource Name Lookup Table
+ *
+ * Each entry: { <device_ref>, <type>, <index>, <name> }
+ * Assigns a name to the device's platform resource at <type>/<index>,
+ * so platform_get_resource_byname() can find it.
+ */
+static int resource_name_lookup_handle(acpi_handle handle,
+				       const union acpi_object *obj, void *data)
+{
+	struct device *rdev, *dev = data;
+	const union acpi_object *child, *el;
+	int i, pcnt, count = 0, index;
+	unsigned int type;
+	struct resource *res;
+	const char *name;
+	struct acpi_device *adev = acpi_fetch_acpi_dev(handle);
+
+	if (!adev || !adev->status.present)
+		return -ENODEV;
+
+	for (i = 0; i < obj->package.count; i++) {
+		child = &obj->package.elements[i];
+		pcnt = child->package.count;
+
+		if (pcnt != 4)
+			continue;
+
+		el = child->package.elements;
+
+		if ((el[0].type != ACPI_TYPE_LOCAL_REFERENCE &&
+		     el[0].type != ACPI_TYPE_STRING) ||
+		    el[1].type != ACPI_TYPE_INTEGER ||
+		    el[2].type != ACPI_TYPE_INTEGER ||
+		    el[3].type != ACPI_TYPE_STRING)
+			continue;
+
+		rdev = acpi_obj_to_platform_device(&el[0]);
+		type = el[1].integer.value;
+		index = el[2].integer.value;
+		name = devm_kstrdup(dev, el[3].string.pointer, GFP_KERNEL);
+		if (!rdev || !name)
+			continue;
+
+		res = platform_get_resource(to_platform_device(rdev),
+					    type, index);
+		if (!res)
+			continue;
+		res->name = name;
+
+		if ((res->flags & IORESOURCE_IRQ) &&
+		    (res->flags & IORESOURCE_DISABLED))
+			acpi_irq_get(ACPI_HANDLE(rdev), index, res);
+
+		dev_dbg(&adev->dev, "resource name [%s][0x%x][%d]->[%s]\n",
+			dev_name(rdev), type, index, name);
+
+		count++;
+	}
+
+	dev_dbg(&adev->dev, "resource name lookup: %d/%d entries\n",
+		count, obj->package.count);
+
+	return count;
+}
+
+/*
+ * DLKL — Device Link Lookup Table
+ *
+ * Each entry: { <supplier_ref>, <consumer_ref>, <flags> }
+ * Creates a device_link between supplier and consumer with given flags.
+ */
+static int device_link_lookup_handle(acpi_handle handle,
+				     const union acpi_object *obj, void *data)
+{
+	struct device *consumer, *supplier;
+	const union acpi_object *child, *el;
+	int i, pcnt, count = 0;
+	u32 flags;
+	struct acpi_device *adev = acpi_fetch_acpi_dev(handle);
+
+	if (!adev || !adev->status.present)
+		return -ENODEV;
+
+	for (i = 0; i < obj->package.count; i++) {
+		child = &obj->package.elements[i];
+		pcnt = child->package.count;
+
+		if (pcnt != 3)
+			continue;
+
+		el = child->package.elements;
+
+		if ((el[0].type != ACPI_TYPE_LOCAL_REFERENCE &&
+		     el[0].type != ACPI_TYPE_STRING) ||
+		    (el[1].type != ACPI_TYPE_LOCAL_REFERENCE &&
+		     el[1].type != ACPI_TYPE_STRING) ||
+		    el[2].type != ACPI_TYPE_INTEGER)
+			continue;
+
+		supplier = acpi_obj_to_platform_device(&el[0]);
+		consumer = acpi_obj_to_platform_device(&el[1]);
+		flags = (u32)el[2].integer.value;
+
+		if (!supplier || !consumer)
+			continue;
+
+		device_link_add(consumer, supplier, flags);
+
+		dev_dbg(&adev->dev, "device link [%s]->[%s] flags[%u]\n",
+			dev_name(consumer), dev_name(supplier), flags);
+
+		count++;
+	}
+
+	dev_dbg(&adev->dev, "device link lookup: %d/%d entries\n",
+		count, obj->package.count);
+
+	return count;
+}
+
+/*
+ * CLKT — Clock Table
+ *
+ * Devices with CLKT tables depend on the ACPI clock provider
+ * (CIXHA010 / clk-sky1-acpi) to register clkdev lookups before
+ * they can probe.  Create a device_link to enforce this ordering
+ * so consumers don't need to rely on deferred probe.
+ */
+static int clock_dependency_handle(acpi_handle handle,
+				   const union acpi_object *obj, void *data)
+{
+	struct acpi_device *adev;
+	struct device *consumer, *supplier;
+
+	if (!obj || obj->package.count == 0)
+		return 0;
+
+	adev = acpi_fetch_acpi_dev(handle);
+	if (!adev || !adev->status.present)
+		return -ENODEV;
+
+	consumer = bus_find_device_by_acpi_dev(&platform_bus_type, adev);
+	if (!consumer)
+		return 0;
+
+	supplier = bus_find_device_by_name(&platform_bus_type, NULL,
+					   "CIXHA010:00");
+	if (!supplier || supplier == consumer)
+		return 0;
+
+	device_link_add(consumer, supplier, DL_FLAG_AUTOREMOVE_CONSUMER);
+
+	dev_dbg(data, "clock link [%s]->[CIXHA010:00]\n", dev_name(consumer));
+
+	return 1;
+}
+
+static int acpi_res_lookup_eval(acpi_handle handle, const char *name,
+		int (*func)(acpi_handle, const union acpi_object *, void *),
+		void *data)
+{
+	struct acpi_buffer output = {ACPI_ALLOCATE_BUFFER, NULL};
+	acpi_status status;
+	int ret;
+
+	status = acpi_evaluate_object_typed(handle, (acpi_string)name,
+					    NULL, &output, ACPI_TYPE_PACKAGE);
+	if (ACPI_FAILURE(status))
+		return -ENODEV;
+
+	ret = func(handle, (const union acpi_object *)output.pointer, data);
+	kfree(output.pointer);
+
+	return ret;
+}
+
+static int acpi_resource_lookup_device(acpi_handle handle, void *data)
+{
+	struct device *dev = data;
+	int ret;
+
+	ret = acpi_res_lookup_eval(handle, "RSTL", reset_lookup_handle, dev);
+	if (ret < 0 && ret != -ENODEV)
+		dev_dbg(dev, "reset lookup handle failed for %s\n",
+			acpi_device_hid(acpi_fetch_acpi_dev(handle)));
+
+	ret = acpi_res_lookup_eval(handle, "RSNL",
+				   resource_name_lookup_handle, dev);
+	if (ret < 0 && ret != -ENODEV)
+		dev_dbg(dev, "resource name lookup handle failed for %s\n",
+			acpi_device_hid(acpi_fetch_acpi_dev(handle)));
+
+	ret = acpi_res_lookup_eval(handle, "DLKL",
+				   device_link_lookup_handle, dev);
+	if (ret < 0 && ret != -ENODEV)
+		dev_dbg(dev, "device link lookup handle failed for %s\n",
+			acpi_device_hid(acpi_fetch_acpi_dev(handle)));
+
+	ret = acpi_res_lookup_eval(handle, "CLKT",
+				   clock_dependency_handle, dev);
+	if (ret < 0 && ret != -ENODEV)
+		dev_dbg(dev, "clock dependency handle failed for %s\n",
+			acpi_device_hid(acpi_fetch_acpi_dev(handle)));
+
+	return 0;
+}
+
+static acpi_status acpi_bus_res_scan(acpi_handle handle, u32 level,
+				     void *context, void **ret_p)
+{
+	struct device *dev = context;
+	acpi_object_type acpi_type;
+
+	if (!dev)
+		return AE_OK;
+
+	if (ACPI_FAILURE(acpi_get_type(handle, &acpi_type)))
+		return AE_OK;
+
+	if (acpi_type != ACPI_TYPE_DEVICE)
+		return AE_OK;
+
+	acpi_resource_lookup_device(handle, dev);
+
+	return AE_OK;
+}
+
+static int cix_res_lookup_v1_probe(struct platform_device *pdev)
+{
+	acpi_walk_namespace(ACPI_TYPE_ANY, ACPI_ROOT_OBJECT,
+			    ACPI_UINT32_MAX, acpi_bus_res_scan, NULL,
+			    &pdev->dev, NULL);
+
+	dev_info(&pdev->dev, "ACPI resource lookup complete\n");
+	return 0;
+}
+
+static const struct acpi_device_id cix_res_lookup_v1_match[] = {
+	{ "CIXA1019" },
+	{},
+};
+MODULE_DEVICE_TABLE(acpi, cix_res_lookup_v1_match);
+
+static struct platform_driver cix_res_lookup_v1_driver = {
+	.driver = {
+		.name = "cix-acpi-resource-lookup",
+		.acpi_match_table = ACPI_PTR(cix_res_lookup_v1_match),
+	},
+	.probe = cix_res_lookup_v1_probe,
+};
+
+static int __init cix_res_lookup_v1_init(void)
+{
+	if (acpi_disabled)
+		return -ENODEV;
+
+	return platform_driver_register(&cix_res_lookup_v1_driver);
+}
+subsys_initcall(cix_res_lookup_v1_init);
+
+MODULE_DESCRIPTION("CIX ACPI resource lookup driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/soc/cix/acpi/cix-fan-mode.c b/drivers/soc/cix/acpi/cix-fan-mode.c
new file mode 100644
index 000000000000..623fc772a982
--- /dev/null
+++ b/drivers/soc/cix/acpi/cix-fan-mode.c
@@ -0,0 +1,308 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * fan driver for the cix ec
+ *
+ * Copyright 2024 Cix Technology Group Co., Ltd..
+ */
+
+#include <linux/acpi.h>
+#include <linux/of.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#define MODE_NAME_LEN 16
+#define MODE_ARGS_MAX 3
+
+enum {
+	MUTE_MODE,
+	NORMAL_MODE,
+	PERF_MODE,
+	MANUAL_MODE,
+	MAX_MODE,
+};
+
+struct cix_fan_mode {
+	char *name;
+	char *set_method;
+	char *get_method;
+	int set_argc;
+	int get_argc;
+};
+
+struct cix_fan_mode_data {
+	struct kobject *cix_kobj;
+	struct cix_fan_mode fmode[MAX_MODE];
+	int mode;
+	int duty;
+	int type;
+	int index;
+};
+
+struct cix_fan_mode_data cix_fan_mdata = {
+	.mode = NORMAL_MODE,
+	.fmode[MUTE_MODE] = {
+		.name = "mute",
+		.set_method = "SFMT",
+		.set_argc = 0,
+	},
+	.fmode[NORMAL_MODE] = {
+		.name = "normal",
+		.set_method = "SFAT",
+		.set_argc = 0,
+	},
+	.fmode[PERF_MODE] = {
+		.name = "performance",
+		.set_method = "SFPF",
+		.set_argc = 0,
+	},
+	.fmode[MANUAL_MODE] = {
+		.name = "manual",
+	}
+};
+
+static int cix_has_fan_control_device(void)
+{
+	acpi_status status;
+	acpi_handle handle;
+
+	status = acpi_get_handle(NULL, "\\_SB.HWMN", &handle);
+	if (ACPI_FAILURE(status))
+		return 0;
+
+	return 1;
+}
+
+static int cix_set_fan_mode(struct device *dev, int mode)
+{
+	struct cix_fan_mode_data *fmdata = &cix_fan_mdata;
+	struct cix_fan_mode *fmode = &fmdata->fmode[mode];
+	struct acpi_buffer buffer = { ACPI_ALLOCATE_BUFFER, NULL };
+	acpi_status status;
+	acpi_handle handle;
+
+	if (!fmode->set_method)
+		return -ENOENT;
+
+	status = acpi_get_handle(NULL, "\\_SB.HWMN", &handle);
+	if (ACPI_FAILURE(status))
+		return -EINVAL;
+
+	status = acpi_evaluate_object(handle, fmode->set_method, NULL, &buffer);
+	if (ACPI_FAILURE(status)) {
+		pr_err("set fan mode failed: %s\n",
+					acpi_format_exception(status));
+		return -EINVAL;
+	}
+	kfree(buffer.pointer);
+
+	fmdata->mode = mode;
+
+	return 0;
+}
+
+static ssize_t mode_show(struct device *dev,
+			struct device_attribute *attr, char *buf)
+{
+	struct cix_fan_mode_data *fmdata = &cix_fan_mdata;
+	int mode = fmdata->mode;
+
+	if (mode < 0 || mode >= MAX_MODE)
+		return -EINVAL;
+
+	return sprintf(buf, "%s\n", fmdata->fmode[mode].name);
+}
+
+static ssize_t mode_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	struct cix_fan_mode_data *fmdata = &cix_fan_mdata;
+	char mode[MODE_NAME_LEN + 1];
+	int ret, i, argc;
+
+	argc = sscanf(buf, "%s", mode);
+	if (argc != 1)
+		return -EINVAL;
+
+	for (i = 0; i < MAX_MODE; i++)
+		if (!strcmp(mode, fmdata->fmode[i].name))
+			break;
+	if (i >= MAX_MODE)
+		return -EINVAL;
+
+	ret = cix_set_fan_mode(dev, i);
+	if (ret < 0)
+		pr_err("Failed: set fan mode!\n");
+
+	pr_info("set fan mode %s\n", mode);
+
+	return count;
+}
+static DEVICE_ATTR_RW(mode);
+
+static int cix_set_fan_pwm(struct device *dev, int duty, int type, int index)
+{
+	struct acpi_buffer buffer = { ACPI_ALLOCATE_BUFFER, NULL };
+	struct acpi_object_list obj_list;
+	union acpi_object objs[3];
+	acpi_status status;
+	acpi_handle handle;
+
+	objs[0].type = ACPI_TYPE_INTEGER;
+	objs[0].integer.value = duty;
+	objs[1].type = ACPI_TYPE_INTEGER;
+	objs[1].integer.value = type;
+	objs[2].type = ACPI_TYPE_INTEGER;
+	objs[2].integer.value = index;
+	obj_list.pointer = objs;
+	obj_list.count = 3;
+
+	status = acpi_get_handle(NULL, "\\_SB.HWMN", &handle);
+	if (ACPI_FAILURE(status))
+		return -EINVAL;
+
+	status = acpi_evaluate_object(handle, "SFPW", &obj_list, &buffer);
+	if (ACPI_FAILURE(status)) {
+		pr_err("set fan pwm failed: %s\n",
+					acpi_format_exception(status));
+		return -EINVAL;
+	}
+	kfree(buffer.pointer);
+
+	return 0;
+}
+
+static int cix_get_fan_pwm(struct device *dev)
+{
+	struct cix_fan_mode_data *fmdata = &cix_fan_mdata;
+	struct acpi_buffer buffer = { ACPI_ALLOCATE_BUFFER, NULL };
+	struct acpi_object_list obj_list;
+	union acpi_object objs[2], *ret_value;
+	int duty;
+	acpi_status status;
+	acpi_handle handle;
+
+	objs[0].type = ACPI_TYPE_INTEGER;
+	objs[0].integer.value = fmdata->type;
+	objs[1].type = ACPI_TYPE_INTEGER;
+	objs[1].integer.value = fmdata->index;
+	obj_list.pointer = objs;
+	obj_list.count = 2;
+
+	status = acpi_get_handle(NULL, "\\_SB.HWMN", &handle);
+	if (ACPI_FAILURE(status))
+		return -EINVAL;
+
+	status = acpi_evaluate_object(handle, "GFPW", &obj_list, &buffer);
+	if (ACPI_FAILURE(status)) {
+		pr_err("set fan pwm failed: %s\n",
+					acpi_format_exception(status));
+		return -EINVAL;
+	}
+	ret_value = (union acpi_object *)buffer.pointer;
+	if (ret_value->type != ACPI_TYPE_INTEGER)
+		duty = -EINVAL;
+	else
+		duty = ret_value->integer.value;
+	kfree(buffer.pointer);
+
+	return duty;
+}
+
+static ssize_t pwm_show(struct device *dev,
+			struct device_attribute *attr, char *buf)
+{
+	return sprintf(buf, "%d\n", cix_get_fan_pwm(dev));
+}
+
+static ssize_t pwm_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	struct cix_fan_mode_data *fmdata = &cix_fan_mdata;
+	int ret, argc, duty, type, index;
+
+	argc = sscanf(buf, "%d %d %d", &duty, &type, &index);
+	if (argc < 3)
+		return -EINVAL;
+
+	ret = cix_set_fan_pwm(dev, duty, type, index);
+	if (ret < 0)
+		return ret;
+
+	pr_info("set fan pwm %d %d %d\n", duty, type, index);
+
+	fmdata->duty = duty;
+	fmdata->type = type;
+	fmdata->duty = duty;
+	fmdata->mode = MANUAL_MODE;
+
+	return count;
+}
+static DEVICE_ATTR_RW(pwm);
+
+static ssize_t available_mode_show(struct device *d,
+					struct device_attribute *attr,
+					char *buf)
+{
+	struct cix_fan_mode_data *fmdata = &cix_fan_mdata;
+	ssize_t count = 0;
+	int i;
+
+	for (i = 0; i < MAX_MODE; i++) {
+		count += scnprintf(&buf[count], (PAGE_SIZE - count - 2),
+				"%s ", fmdata->fmode[i].name);
+	}
+
+	/* Truncate the trailing space */
+	if (count)
+		count--;
+
+	count += sprintf(&buf[count], "\n");
+
+	return count;
+}
+static DEVICE_ATTR_RO(available_mode);
+
+#define CREATE_SYSFS_FILE(kobj, name)					\
+{									\
+	int ret;							\
+	ret = sysfs_create_file(kobj, &dev_attr_##name.attr);		\
+	if (ret < 0) {							\
+		pr_warn("Unable to create attr(%s)\n", "##name");	\
+	}								\
+}									\
+
+static int __init cix_fan_mode_init(void)
+{
+	struct cix_fan_mode_data *fmdata = &cix_fan_mdata;
+
+	if (!cix_has_fan_control_device())
+		return 0;
+
+	fmdata->mode = NORMAL_MODE;
+	fmdata->type = 0;
+	fmdata->index = 0;
+	fmdata->cix_kobj = kobject_create_and_add("cix_fan", NULL);
+	if (!fmdata->cix_kobj)
+		return -ENOMEM;
+	CREATE_SYSFS_FILE(fmdata->cix_kobj, mode);
+	CREATE_SYSFS_FILE(fmdata->cix_kobj, available_mode);
+	CREATE_SYSFS_FILE(fmdata->cix_kobj, pwm);
+
+	return 0;
+}
+module_init(cix_fan_mode_init);
+
+static void __exit cix_fan_mode_exit(void)
+{
+	struct cix_fan_mode_data *fmdata = &cix_fan_mdata;
+
+	sysfs_remove_file(fmdata->cix_kobj, &dev_attr_mode.attr);
+	sysfs_remove_file(fmdata->cix_kobj, &dev_attr_available_mode.attr);
+	sysfs_remove_file(fmdata->cix_kobj, &dev_attr_pwm.attr);
+	kobject_put(fmdata->cix_kobj);
+}
+module_exit(cix_fan_mode_exit);
+
+MODULE_ALIAS("platform:cix-fan-mode");
+MODULE_DESCRIPTION("CIX Fan Mode");
+MODULE_LICENSE("GPL v2");
diff --git a/drivers/soc/cix/acpi/dsdt_override.c b/drivers/soc/cix/acpi/dsdt_override.c
new file mode 100644
index 000000000000..257d039519d3
--- /dev/null
+++ b/drivers/soc/cix/acpi/dsdt_override.c
@@ -0,0 +1,173 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright 2024 Cix Technology Group Co., Ltd.
+ *
+ * Author: Zichar Zhang <zichar.zhang@cixtech.com>
+ */
+
+#include <linux/acpi.h>
+#include <linux/cma.h>
+#include <linux/device.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/efi.h>
+#include <linux/libfdt.h>
+#include <linux/of_fdt.h>
+#include <linux/unaligned.h>
+
+#define AML_NAME_OP                 (u16) 0x08
+
+extern u32 acpi_gbl_dsdt_index;
+extern acpi_status
+acpi_tb_install_standard_table(acpi_physical_address address,
+			       u8 flags,
+			       struct acpi_table_header *table,
+			       u8 reload, u8 override, u32 *table_index);
+
+static char *acpi_sync_sig_table[] = {
+	"GNVA",
+	"GNVL",
+};
+
+static char *acpi_tb_find_sig_ptr(struct acpi_table_header *table, char *sig)
+{
+	char *ptr, *cur = (char *)table;
+
+	for (ptr = cur; ptr <= (cur + table->length); ptr++)
+		if (ACPI_COMPARE_NAMESEG(ptr, sig)
+			&& (*(ptr - 1) == AML_NAME_OP))
+			return ptr;
+
+	return NULL;
+}
+
+static int acpi_tb_copy_sig_ptr(char *optr, char *nptr)
+{
+	u8 osize, nsize, size;
+
+	osize = *(optr + 4);
+	nsize = *(nptr + 4);
+	if (osize != nsize)
+		return -EINVAL;
+
+	switch(osize) {
+		case 0x0:
+			return 0;
+		case 0xA:
+			size = 1;
+			break;
+		case 0xB:
+			size = 2;
+			break;
+		case 0xC:
+			size = 4;
+			break;
+		default:
+			return -EINVAL;
+	}
+	memcpy (nptr + 5, optr + 5, size);
+
+	return 0;
+}
+
+static int acpi_dsdt_sync(u32 old_idx, u32 new_idx)
+{
+	struct acpi_table_header *oldt = NULL, *newt = NULL;
+	char *sig, *optr, *nptr;
+	int i, ret;
+	acpi_status status;
+
+	status = acpi_get_table_by_index(old_idx, &oldt);
+	if (ACPI_FAILURE(status))
+		goto out;
+
+	status = acpi_get_table_by_index(new_idx, &newt);
+	if (ACPI_FAILURE(status))
+		goto out;
+
+	for (i = 0; i < sizeof(acpi_sync_sig_table)/sizeof(char *); i++) {
+		sig = acpi_sync_sig_table[i];
+		optr = acpi_tb_find_sig_ptr(oldt, sig);
+		if (!optr)
+			continue;
+		nptr = acpi_tb_find_sig_ptr(newt, sig);
+		if (!nptr)
+			continue;
+
+		ret = acpi_tb_copy_sig_ptr(optr, nptr);
+		if (ret)
+			pr_err("dsdt sync sig[%s] error\n", sig);
+	}
+
+out:
+	if (oldt)
+		acpi_put_table(oldt);
+	if (newt)
+		acpi_put_table(newt);
+
+       return 0;
+}
+
+static int __init efi_get_fdt_prop(const void *fdt, int node, const char *pname,
+				   const char *rname, void *var, int size)
+{
+	const void *prop;
+	int len;
+	u64 val;
+
+	prop = fdt_getprop(fdt, node, pname, &len);
+	if (!prop)
+		return 1;
+
+	val = (len == 4) ? (u64)be32_to_cpup(prop) : get_unaligned_be64(prop);
+
+	if (size == 8)
+		*(u64 *)var = val;
+	else
+		*(u32 *)var = (val < U32_MAX) ? val : U32_MAX; // saturate
+
+	if (efi_enabled(EFI_DBG))
+		pr_info("  %s: 0x%0*llx\n", rname, size * 2, val);
+
+	return 0;
+}
+
+static phys_addr_t dsdt_override_fdt_get_addr(void)
+{
+	const void *fdt = initial_boot_params;
+	int node;
+	phys_addr_t paddr;
+
+	node = fdt_path_offset(fdt, "/chosen");
+	if (node < 0)
+		return 0;
+
+	if (efi_get_fdt_prop(fdt, node, "linux,dsdt-override",
+				"DSDT Override", &paddr, sizeof(u64)))
+		return 0;
+
+	return paddr;
+}
+
+static int __init dsdt_override_init(void)
+{
+	phys_addr_t paddr;
+	acpi_status status = AE_OK;
+	u32 old_dsdt_index = acpi_gbl_dsdt_index;
+
+	paddr = dsdt_override_fdt_get_addr();
+	if (paddr)
+		status = acpi_tb_install_standard_table(paddr,
+					ACPI_TABLE_ORIGIN_INTERNAL_PHYSICAL,
+					NULL, FALSE, FALSE,
+					&acpi_gbl_dsdt_index);
+
+	if (status != AE_OK)
+		return -1;
+
+	acpi_dsdt_sync(old_dsdt_index, acpi_gbl_dsdt_index);
+
+	return  0;
+}
+
+arch_initcall(dsdt_override_init);
diff --git a/drivers/soc/cix/acpi/reserved_memory.c b/drivers/soc/cix/acpi/reserved_memory.c
new file mode 100644
index 000000000000..008f0d9749f5
--- /dev/null
+++ b/drivers/soc/cix/acpi/reserved_memory.c
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright 2024 Cix Technology Group Co., Ltd.
+ *
+ * Author: Zichar Zhang <zichar.zhang@cixtech.com>
+ */
+
+#include <linux/memblock.h>
+#include <linux/acpi.h>
+#include <linux/cma.h>
+#include <linux/device.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+
+enum {
+	RESERVED_MEM_NOMAP = 0,
+	RESERVED_MEM_RESERVE,
+};
+
+struct reserved_mem_entry {
+	const char *name;
+	phys_addr_t base;
+	phys_addr_t size;
+	int type;
+};
+
+
+static struct reserved_mem_entry reserved_mem[] = {
+	{"audio", 0xd0000000, 0x00e00000, RESERVED_MEM_NOMAP},
+	{ "dsp_vdev0buffer", 0xcde08000, 0x00100000, RESERVED_MEM_NOMAP},
+	{ "dsp_reserved", 0xce000000, 0x1000000, RESERVED_MEM_NOMAP},
+	{ "dsp_reserved_heap", 0xcf000000, 0x1000000, RESERVED_MEM_NOMAP},
+	{ "dsp_vdev0vring", 0xcde00000, 0x8000, RESERVED_MEM_NOMAP},
+};
+
+static acpi_status __init reserved_mem_handler(u32 event,
+			void *table, void *context)
+{
+	struct reserved_mem_entry *rmem;
+	int i, count;
+
+	count = sizeof(reserved_mem)/sizeof(struct reserved_mem_entry);
+	for (i = 0; i < count; i++) {
+		rmem = &reserved_mem[i];
+
+		if (!rmem->base || !rmem->size)
+			continue;
+
+		if (rmem->type == RESERVED_MEM_NOMAP)
+			memblock_mark_nomap(rmem->base, rmem->size);
+		else if (rmem->type == RESERVED_MEM_RESERVE)
+			memblock_reserve(rmem->base, rmem->size);
+
+	}
+
+	return acpi_remove_table_handler(reserved_mem_handler);
+}
+
+static int __init acpi_reserved_memory_init(char *p)
+{
+	if (!p || strcmp(p, "force"))
+		return 0;
+
+	acpi_install_table_handler(reserved_mem_handler, NULL);
+
+	return 0;
+}
+early_param("acpi", acpi_reserved_memory_init);

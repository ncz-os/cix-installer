From b9cddff4d5b8ca9eff26126ebff5c2931c52a1fe Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Sun, 11 Oct 2026 17:32:27 -0400
Subject: [PATCH 8/9] usb: cdns3: Fix NULL pointer dereference when comp_desc
 is NULL - CIX

Guard every pep->endpoint.comp_desc dereference in the cdns3 endpoint
parameter helpers so a SuperSpeed(+) isochronous endpoint without a
companion descriptor no longer oopses.

Upstream: cixtech/cix_opensource__linux 4bc1816a111d (cix_k6.6.89_2026q3)
---
 drivers/usb/cdns3/cdnsp-mem.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/drivers/usb/cdns3/cdnsp-mem.c b/drivers/usb/cdns3/cdnsp-mem.c
index 419309c8439e3..b2248504a4efe 100644
--- a/drivers/usb/cdns3/cdnsp-mem.c
+++ b/drivers/usb/cdns3/cdnsp-mem.c
@@ -863,7 +863,8 @@ static unsigned int cdnsp_get_endpoint_interval(struct usb_gadget *g,
 static u32 cdnsp_get_endpoint_mult(struct usb_gadget *g, struct cdnsp_ep *pep)
 {
 	if (g->speed < USB_SPEED_SUPER ||
-	    !usb_endpoint_xfer_isoc(pep->endpoint.desc))
+	    !usb_endpoint_xfer_isoc(pep->endpoint.desc) ||
+	    !pep->endpoint.comp_desc)
 		return 0;
 
 	return pep->endpoint.comp_desc->bmAttributes;
@@ -873,7 +874,7 @@ static u32 cdnsp_get_endpoint_max_burst(struct usb_gadget *g,
 					struct cdnsp_ep *pep)
 {
 	/* Super speed and Plus have max burst in ep companion desc */
-	if (g->speed >= USB_SPEED_SUPER)
+	if (g->speed >= USB_SPEED_SUPER && pep->endpoint.comp_desc)
 		return pep->endpoint.comp_desc->bMaxBurst;
 
 	if (g->speed == USB_SPEED_HIGH &&
@@ -921,11 +922,11 @@ static u32 cdnsp_get_max_esit_payload(struct usb_gadget *g,
 		return 0;
 
 	/* SuperSpeedPlus Isoc ep sending over 48k per EIST. */
-	if (g->speed >= USB_SPEED_SUPER_PLUS &&
+	if (g->speed >= USB_SPEED_SUPER_PLUS && pep->endpoint.comp_desc &&
 	    USB_SS_SSP_ISOC_COMP(pep->endpoint.desc->bmAttributes))
 		return le16_to_cpu(pep->endpoint.comp_desc->wBytesPerInterval);
 	/* SuperSpeed or SuperSpeedPlus Isoc ep with less than 48k per esit */
-	else if (g->speed >= USB_SPEED_SUPER)
+	else if (g->speed >= USB_SPEED_SUPER && pep->endpoint.comp_desc)
 		return le16_to_cpu(pep->endpoint.comp_desc->wBytesPerInterval);
 
 	max_packet = usb_endpoint_maxp(pep->endpoint.desc);

+
+    def tearDown(self):
+        self.server.shutdown()
+        self.server.server_close()
+        self.temp.cleanup()
+
+    def run_helper(self, *args, env=None):
+        return subprocess.run(
+            [str(self.helper), *args], env=env or self.env,
+            check=True, text=True, capture_output=True,
+        )

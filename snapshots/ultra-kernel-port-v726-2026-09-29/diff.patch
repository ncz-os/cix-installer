+    --include=ca-certificates,apt-utils \
+    --components="$MM_COMPONENTS" \
+    --customize-hook='chroot "\$1" /bin/sh -c "true > /etc/machine-id" 2>/dev/null || true' \
+    --customize-hook='rm -f "\$1/etc/resolv.conf"' \

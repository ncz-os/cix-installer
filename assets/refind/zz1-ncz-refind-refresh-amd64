#!/bin/bash
# zz1-ncz-refind-refresh-amd64 — /etc/kernel/postinst.d/ hook, regenerates
# the rEFInd menu whenever a linux-image-* package is installed/upgraded
# via apt.
#
# NCZ-UNIFIED-KERNEL-73 (2026-10-05): ONE kernel, 7.3, is the
# default on every arch. There is no edge channel any more and no 7.2.x
# line. This hook derives the single default KVER from /boot and delegates
# to ncz-refind-refresh-amd64, which owns the command line (the redefined
# rescue entry blacklists the accelerators).
#
# Real gap this closes (flagged in the commit that standardized AMD64 on
# rEFInd, 2026-09-16): arm64 has a dedicated hook
# (post-install/11-fix-cixmini-boot.sh) that redirects the Sky1-specific
# `cixmini-boot` package's own postinst to call ncz-refind-refresh. AMD64
# has no cixmini-boot equivalent and no such special-case package -- it
# just needs the STANDARD Debian kernel-postinst mechanism
# (/etc/kernel/postinst.d/, run by every linux-image-* package's own
# postinst via run-parts).
#
# Called by dpkg/kernel postinst as: <this-script> <kernel-version>
# <boot-image-path> (standard /etc/kernel/postinst.d/ contract).
# ADD-ONLY FIX (2026-11-10, the 01:16Z hardware finding): stage/add the
# kernel BEING INSTALLED ($1), side-by-side, never promote. The previous
# design re-derived KVER_STABLE from a /boot scan instead of $1, and the
# scan picked a different kernel than dpkg was installing (observed on the
# 7.4.0-rc2 install: it re-added the 7.3.3 entry and staged nothing for
# 7.4). The scan remains only as the fallback for trigger-style calls
# without $1.
set -uo pipefail

REFRESH="${NCZ_REFIND_REFRESH:-/usr/local/sbin/ncz-refind-refresh-amd64}"
[ -x "$REFRESH" ] || { echo "zz1-ncz-refind-refresh-amd64: $REFRESH not present, skipping"; exit 0; }

BOOTDIR="${BOOTDIR:-/boot}"

# A kernel is PRERELEASE if its version carries an -rcN component. Under the
# unified policy an -rcN is still a valid DEFAULT (while the build-time policy
# allows it: KERNEL-POLICY RC_DEFAULT_ALLOWED=1), so prerelease is NO LONGER
# used to separate channels -- it only informs the log.
is_prerelease() {
    case "$1" in *-rc[0-9]*) return 0 ;; *) return 1 ;; esac
}

# The unified default is the NCZ kernel line: 7.3 while it ships, and 7.4
# from the 2026-11-09 22:20Z line switch (both are default-class while
# DEFAULT_BASE=7.3,7.4; the exact pin is enforced at build time). A
# Debian-archive kernel (<ver>-amd64, forky 7.1.x) is never staged.
# classify() drops everything that is not 7.3/7.4.
is_debian_kernel() {
    case "$1" in
        *-amd64|7.1.*|7.1-*) return 0 ;;
    esac
    return 1
}

classify() {
    # classify <kver> -- echoes "default", or nothing.
    case "$1" in
        *-rescue) return ;;
    esac
    is_debian_kernel "$1" && return
    case "$1" in
        7.3.*|7.3-*|7.4.*|7.4-*) echo default ;;
    esac
}

find_newest() {
    # find_newest -- echoes the version string of the $BOOTDIR/vmlinuz-* that
    # classifies as the unified default with the newest mtime, or nothing.
    local newest="" newest_mtime=-1 kver cls mt
    for f in "$BOOTDIR"/vmlinuz-*; do
        [ -e "$f" ] || continue
        kver="${f##*/vmlinuz-}"
        cls=$(classify "$kver")
        [ "$cls" = "default" ] || continue
        [ -s "$BOOTDIR/initrd.img-$kver" ] || {
            echo "zz1-ncz-refind-refresh-amd64: $kver matches but has no initrd yet (mid-transaction?), skipping" >&2
            continue
        }
        mt=$(stat -c '%Y' "$f" 2>/dev/null || echo -1)
        if [ "$mt" -gt "$newest_mtime" ]; then
            newest_mtime=$mt
            newest="$kver"
        fi
    done
    echo "$newest"
}

KVER_ARG="${1:-}"
if [ -n "$KVER_ARG" ]; then
    # The kernel dpkg is installing: stage THIS one, side-by-side.
    if [ "$(classify "$KVER_ARG")" != "default" ]; then
        echo "zz1-ncz-refind-refresh-amd64: $KVER_ARG is not a default-class NCZ kernel (7.3/7.4), skipping"
        exit 0
    fi
    if [ ! -s "$BOOTDIR/vmlinuz-$KVER_ARG" ] || [ ! -s "$BOOTDIR/initrd.img-$KVER_ARG" ]; then
        echo "zz1-ncz-refind-refresh-amd64: $KVER_ARG lacks vmlinuz/initrd in $BOOTDIR (mid-transaction?), skipping" >&2
        exit 0
    fi
    KVER_STABLE="$KVER_ARG"
else
    KVER_STABLE=$(find_newest)
fi
KVER_EDGE=""

if [ -z "$KVER_STABLE" ]; then
    echo "zz1-ncz-refind-refresh-amd64: no default-class kernel (7.3/7.4) with a ready initrd found, skipping"
    exit 0
fi

BUILD_VERSION="(unknown)"
[ -f /usr/local/lib/cix-installer/BUILD_VERSION ] && \
    BUILD_VERSION=$(cat /usr/local/lib/cix-installer/BUILD_VERSION 2>/dev/null || true)

echo "zz1-ncz-refind-refresh-amd64: KVER_STABLE=$KVER_STABLE (add-only: staging side-by-side; never promotes)"
# ADD-ONLY (2026-11-02): this hook runs on every kernel install, so it must NOT
# regenerate the menu. Before this change it called the tool with no verb,
# which WIPED the ESP and rebuilt the whole menu -- making the kernel that had
# just been installed the DEFAULT on the next reboot (proven on CHIMERA and
# PEGASUS, 2026-11-02). `--add` stages the new pair onto the ESP and APPENDS
# one entry; it never wipes, never rewrites default_selection and never touches
# the rescue entries. zz2-ncz-refind-promote-guard is the only thing that may
# move the default afterwards, and only under an explicit operator pin.
#
# The pair is already in /boot at this point (the kernel package's own postinst
# runs us after unpacking), so --add has everything it needs on the source
# side; it refuses rather than fabricating a kernel if it does not.
KVER_STABLE="$KVER_STABLE" KVER_EDGE="$KVER_EDGE" BUILD_VERSION="$BUILD_VERSION" \
    KVER_STABLE_SRC="$BOOTDIR/vmlinuz-$KVER_STABLE" \
    KVER_STABLE_INITRD="$BOOTDIR/initrd.img-$KVER_STABLE" \
    "$REFRESH" --add
rc=$?
if [ "$rc" -ne 0 ]; then
    # A kernel hook that cannot add is not fatal to the package transaction
    # (the running system is unchanged and still boots), but it must be loud:
    # the new kernel is NOT in the menu until this is fixed.
    echo "zz1-ncz-refind-refresh-amd64: --add failed (rc=$rc); the new kernel is NOT in the rEFInd menu" >&2
fi
exit 0

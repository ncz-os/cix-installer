#!/bin/bash
# zz1-ncz-refind-refresh-amd64 — /etc/kernel/postinst.d/ hook, regenerates
# the rEFInd menu whenever a linux-image-* package is installed/upgraded
# via apt.
#
# Real gap this closes (flagged in the commit that standardized AMD64 on
# rEFInd, 2026-09-16): arm64 has a dedicated hook
# (post-install/11-fix-cixmini-boot.sh) that redirects the Sky1-specific
# `cixmini-boot` package's own postinst to call ncz-refind-refresh. AMD64
# has no cixmini-boot equivalent and no such special-case package -- it
# just needs the STANDARD Debian kernel-postinst mechanism
# (/etc/kernel/postinst.d/, run by every linux-image-* package's own
# postinst via run-parts), which is simpler here than arm64's
# redirect-and-self-heal dance. grub-efi-amd64 used to provide exactly
# this hookpoint for free (its own postinst.d script called update-grub);
# now that AMD64 boots rEFInd instead, this script is what replaces it.
#
# STABLE vs EDGE classification: the two kernel lines' own version strings
# already encode which is which (stable: ...-t2-trixie; edge:
# ...-ncz-amd64-edge), so classify by that suffix rather than by mtime
# (arm64's ncz-refind-refresh mtime-based "newest wins" heuristic has a
# documented real bug on same-transaction downgrades -- see that script's
# own history -- and doesn't even apply here since AMD64 deliberately
# keeps BOTH lines side by side, never pruning one). Each category
# independently tracks its own newest-mtime kernel, so an edge-only
# upgrade doesn't touch which stable kernel is staged and vice versa.
#
# Called by dpkg/kernel postinst as: <this-script> <kernel-version>
# <boot-image-path> (standard /etc/kernel/postinst.d/ contract). We only
# use it as a trigger -- the real KVER_STABLE/KVER_EDGE are re-derived
# from a live /boot scan, not from $1, since a single apt transaction can
# touch either or both lines and only a fresh scan is authoritative.
set -uo pipefail

REFRESH=/usr/local/sbin/ncz-refind-refresh-amd64
[ -x "$REFRESH" ] || { echo "zz1-ncz-refind-refresh-amd64: $REFRESH not present, skipping"; exit 0; }

find_newest() {
    # find_newest <suffix-pattern> -- echoes the kernel version string
    # (the part after "vmlinuz-") of the /boot/vmlinuz-* whose name matches
    # the pattern and has the newest mtime, or nothing if none match / none
    # have a ready initrd.
    local pattern="$1" newest="" newest_mtime=-1
    for f in /boot/vmlinuz-*; do
        [ -e "$f" ] || continue
        kver="${f#/boot/vmlinuz-}"
        case "$kver" in
            *-rescue) continue ;;
            $pattern)
                [ -s "/boot/initrd.img-$kver" ] || {
                    echo "zz1-ncz-refind-refresh-amd64: $kver matches but has no initrd yet (mid-transaction?), skipping" >&2
                    continue
                }
                mt=$(stat -c '%Y' "$f" 2>/dev/null || echo -1)
                if [ "$mt" -gt "$newest_mtime" ]; then
                    newest_mtime=$mt
                    newest="$kver"
                fi
                ;;
        esac
    done
    echo "$newest"
}

KVER_STABLE=$(find_newest '*-t2-trixie')
KVER_EDGE=$(find_newest '*-ncz-amd64-edge')

if [ -z "$KVER_STABLE" ]; then
    echo "zz1-ncz-refind-refresh-amd64: no stable (*-t2-trixie) kernel with a ready initrd found, skipping"
    exit 0
fi

BUILD_VERSION="(unknown)"
[ -f /usr/local/lib/cix-installer/BUILD_VERSION ] && \
    BUILD_VERSION=$(cat /usr/local/lib/cix-installer/BUILD_VERSION 2>/dev/null || true)

echo "zz1-ncz-refind-refresh-amd64: KVER_STABLE=$KVER_STABLE KVER_EDGE=${KVER_EDGE:-<none>}"
KVER_STABLE="$KVER_STABLE" KVER_EDGE="$KVER_EDGE" BUILD_VERSION="$BUILD_VERSION" "$REFRESH"

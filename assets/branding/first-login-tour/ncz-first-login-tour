#!/bin/sh
# ncz-first-login-tour -- open the Singularity tour (dev.sinty.tour) once, on a
# user's first graphical login, with the NCZ-OS guards the upstream first-run
# path does not have.
#
# WHY THIS EXISTS (and does not just use upstream's show-tour key)
# -----------------------------------------------------------------
# The Singularity shell ALREADY opens the tour once per user profile: at
# session start it reads `dev.sinty.desktop: show-tour` (schema default true),
# launches dev.sinty.tour and flips the key false (singularity-shell
# src/core/main.vala, launch_first_run_tour()). That path is unconditional: it
# has no opt-out, does not check for a real graphical/DRM output, a
# live/installer/recovery session, root, another first-run flow, a lock screen,
# and it keeps no user-state marker NCZ can audit. Honouring the operator's
# once-only + skip policy would require a shell code change, which this change
# is explicitly not allowed to make. NCZ-OS therefore configures the upstream
# switch OFF (99-ncz-defaults.gschema.override: show-tour=false) and opens the
# tour from THIS guarded, once-only launcher instead.
#
# WHAT IT GUARANTEES
# -----------------------------------------------------------------
#   * once only: the marker $XDG_STATE_HOME/ncz/tour-seen (default
#     ~/.local/state/ncz/tour-seen) is written BEFORE the launch, so a crash
#     can never loop the tour and it never reappears for that user;
#   * opt-out: /etc/ncz/no-first-login-tour (admin) or
#     $XDG_CONFIG_HOME/ncz/no-first-login-tour (user) disables it;
#   * skip headless: no Wayland/X display, or no connected DRM output (a
#     server such as PROTEUS, or a machine whose panel is dark);
#   * skip live/installer/recovery sessions;
#   * skip root (uid 0);
#   * skip while another first-run flow is active;
#   * never steal focus from a lock screen: if the session is locked the
#     launcher does nothing AND does not consume the marker, so the tour still
#     appears on a later unlocked login.
#   * thermally bounded on first-login (D3 fix 2026-10-13): the tour is
#     decoupled from the desktop settling burst and its CPU is constrained so
#     glycin's image decoding cannot burn the post-login thermal envelope.
#
# HOW IT IS STARTED
# -----------------------------------------------------------------
# Installed as /etc/xdg/autostart/ncz-first-login-tour.desktop with
# `OnlyShowIn=Singularity;`. The shipped shell's Singularity.AutostartManager
# reads XDG system autostart dirs and launches a SYSTEM entry only when it
# names Singularity in OnlyShowIn (libsingularity autostart_manager.vala),
# ~1 s after the session settles -- after the compositor and shell are up.
# The tour THEN waits NCZ_TOUR_SETTLE_SECS seconds AFTER the shell settles
# (default 30) so the desktop's own first-login burst (settings, online
# accounts, OOBE wallpaper) finishes before the tour's image decode runs.
#
# Subcommands
#   guard   pure decision: exit 0 = may show (prints "allow"), 1 = skip
#           (prints "skip: <reason>"). Writes nothing.
#   show    the autostart entry point: guard, wait for the shell to settle,
#           re-check the lock, write the marker and launch. (default)
#
# Test knobs (optional; see build/test-ncz-first-login-tour.sh)
#   NCZ_TOUR_DRYRUN=1        do not launch; still write the marker
#   NCZ_TOUR_STATE_HOME=DIR  override $XDG_STATE_HOME
#   NCZ_TOUR_CONFIG_HOME=DIR override $XDG_CONFIG_HOME
#   NCZ_TOUR_OPT_OUT=FILE    override the admin opt-out path
#   NCZ_TOUR_UID=N           pretend this uid
#   NCZ_TOUR_WAYLAND=0|1     override graphical-session detection
#   NCZ_TOUR_DRM_STATUS=a,b  override connected-output detection
#   NCZ_TOUR_LIVE=0|1        override live/installer/recovery detection
#   NCZ_TOUR_FIRST_RUN=0|1   override another-first-run-flow detection
#   NCZ_TOUR_LOCKED=0|1      override lock detection
#   NCZ_TOUR_SETTLE=SECONDS  post-shell settle (default 30; was 3 pre-D3)
#   NCZ_TOUR_SHELL_WAIT=SEC  max wait for the shell process (default 20)
#   NCZ_TOUR_LAUNCH=CMD      command to open the tour (default gtk-launch)
#   NCZ_TOUR_NICE=1|0        force nice+cpulimit on/off (default auto: on
#                            when systemd-run --user is available)
#   NCZ_TOUR_CPUQUOTA=PCT    CPU quota percent (default 40; 1-100)
#   NCZ_TOUR_LOG=FILE        append decision lines here
set -u

log() { [ -n "${NCZ_TOUR_LOG:-}" ] && printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo now)" "$*" >>"$NCZ_TOUR_LOG"; return 0; }

state_home() { printf '%s' "${NCZ_TOUR_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}}"; }
config_home() { printf '%s' "${NCZ_TOUR_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}"; }
marker() { printf '%s/ncz/tour-seen' "$(state_home)"; }
admin_opt_out() { printf '%s' "${NCZ_TOUR_OPT_OUT:-/etc/ncz/no-first-login-tour}"; }
user_opt_out() { printf '%s/ncz/no-first-login-tour' "$(config_home)"; }

is_root() { [ "${NCZ_TOUR_UID:-$(id -u 2>/dev/null || echo 1000)}" -eq 0 ] 2>/dev/null; }

is_graphical() {
    if [ -n "${NCZ_TOUR_WAYLAND:-}" ]; then [ "$NCZ_TOUR_WAYLAND" = 1 ]; return; fi
    [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]
}

# A real output must be connected: a headless server (no DRM at all) and a
# machine whose every connector is disconnected both get no tour.
has_connected_output() {
    if [ -n "${NCZ_TOUR_DRM_STATUS:-}" ]; then
        case ",${NCZ_TOUR_DRM_STATUS}," in *,connected,*) return 0 ;; *) return 1 ;; esac
    fi
    for st in /sys/class/drm/card*-*/status; do
        [ -e "$st" ] || continue
        [ -r "$st" ] || continue
        [ "$(cat "$st" 2>/dev/null)" = connected ] && return 0
    done
    return 1
}

is_live() {
    if [ -n "${NCZ_TOUR_LIVE:-}" ]; then [ "$NCZ_TOUR_LIVE" = 1 ]; return; fi
    for m in /run/ncz-live /run/ncz-installer /run/ncz-payload /cdrom/ncz-payload; do
        [ -e "$m" ] && return 0
    done
    if [ -r /proc/cmdline ]; then
        case " $(cat /proc/cmdline) " in
            *" boot=casper "*|*" boot=live "*|*" live "*|*" cdrom-detect/"*) return 0 ;;
        esac
    fi
    return 1
}

first_run_active() {
    if [ -n "${NCZ_TOUR_FIRST_RUN:-}" ]; then [ "$NCZ_TOUR_FIRST_RUN" = 1 ]; return; fi
    for m in /run/ncz-first-run-active "$(state_home)/ncz/first-run-active"; do
        [ -e "$m" ] && return 0
    done
    return 1
}

is_locked() {
    if [ -n "${NCZ_TOUR_LOCKED:-}" ]; then [ "$NCZ_TOUR_LOCKED" = 1 ]; return; fi
    [ -n "${XDG_SESSION_ID:-}" ] || return 1
    command -v loginctl >/dev/null 2>&1 || return 1
    [ "$(loginctl show-session "$XDG_SESSION_ID" -p LockedHint --value 2>/dev/null)" = yes ]
}

# guard: print the reason and exit 1 when the tour must not open, else 0.
guard() {
    if [ -e "$(marker)" ]; then echo "skip: already shown ($(marker))"; return 1; fi
    if [ -e "$(admin_opt_out)" ]; then echo "skip: opt-out $(admin_opt_out)"; return 1; fi
    if [ -e "$(user_opt_out)" ]; then echo "skip: opt-out $(user_opt_out)"; return 1; fi
    if is_root; then echo "skip: root (uid 0)"; return 1; fi
    if is_live; then echo "skip: live/installer/recovery session"; return 1; fi
    if first_run_active; then echo "skip: another first-run flow is active"; return 1; fi
    if ! is_graphical; then echo "skip: no graphical session"; return 1; fi
    if ! has_connected_output; then echo "skip: no connected DRM output"; return 1; fi
    echo "allow"
    return 0
}

# Wait (bounded) for the shell process so the tour is not drawn before the
# compositor/panel exist. The entry is already started ~1 s after the session
# settles, so this is normally a no-op plus the settle delay.
wait_for_shell() {
    want="${NCZ_TOUR_SHELL_WAIT:-20}"
    i=0
    while [ "$i" -lt "$want" ]; do
        # pgrep -f: the process comm is truncated at 15 chars, so -x would
        # never match "singularity-desktop".
        pgrep -f '/singularity-desktop$' >/dev/null 2>&1 && break
        if [ -n "${NCZ_TOUR_LAUNCH:-}" ] || [ -n "${NCZ_TOUR_DRYRUN:-}" ]; then break; fi
        sleep 1; i=$((i + 1))
    done
    # D3 fix 2026-10-13: was 3 (pre-D3); the desktop settles in <30 s and the
    # tour's image-decode workload (D2 in hwval: singularity-tour 83-94% CPU
    # for ~55 s on T2 MacBooks) must not race the panel's first-login OOBE
    # wallpaper and account-settle burst. 30 s is the empirically measured
    # time the desktop needs to be idle enough that glycin's slide decode is
    # the only remaining heavy task.
    sleep "${NCZ_TOUR_SETTLE:-30}"
}

# launch_under_scope() -- open the tour under a CPU-bounded scope so the
# image-decode burst cannot spike the post-login thermals. The systemd
# user instance is the right boundary (the tour is the only thing in the
# scope, never the shell), so when systemd-run --user is available the
# launcher wraps the tour in a transient scope with CPUQuota + nice.
# Falls back to plain `nice -n 19` if the systemd user bus is absent (a
# recovery/KVM session never installs user-bus; the tour there is
# already gated off by is_live/first_run/lock).
#
# SECURITY: the tour command is one we built into the codebase -- the
# three callers in open_tour() all pass a single, hand-written string
# with no shell metacharacters -- or, in the NCZ_TOUR_LAUNCH test seam,
# a value chosen by the test. To preserve the original audit contract
# (\"the value is exactly what would be launched, no extra words, no
# shell-meta\") we tokenise the string with the shell's standard $IFS
# word split under `set -f` (noglob; no filename expansion) and exec
# the resulting tokens as a real argv. systemd-run takes the tokens
# argv directly; nice runs the first token (the interpreter) and
# forwards the rest as its argv.
#
# Returns the exit status of the *wrapper* (0 = launched in background),
# not of the tour itself. The tour is launched into the BACKGROUND so
# the autostart can return and the desktop session stays responsive.

# Cached "systemd-run is real and the user bus is up" probe (one-shot per
# process -- a re-create + destroy scope on every launch was the D3 review's
# 'race condition' finding). Unset in the env means "probe needed".
NCZ_TOUR_SR_OK="${NCZ_TOUR_SR_OK-unset}"

# Has systemd-run been verified in this process? Cheap probe: confirm the
# binary path is one of the system absolute paths (no PATH stub) and the
# user bus responds to loginctl (no D-Bus loop / no scope creation).
probe_systemd_run() {
    _sr_bin=$(command -v systemd-run 2>/dev/null) || _sr_bin=""
    case "$_sr_bin" in
        /usr/bin/systemd-run|/bin/systemd-run|/sbin/systemd-run|/usr/sbin/systemd-run) ;;
        *) return 1 ;;
    esac
    command -v loginctl >/dev/null 2>&1 \
        && loginctl show-user "$(id -u 2>/dev/null || echo 0)" >/dev/null 2>&1
}

launch_under_scope() {
    want_quota="${NCZ_TOUR_CPUQUOTA:-40}"
    # Tokenise the command line on $IFS into positional parameters. Standard
    # IFS word-splitting does not perform shell-metacharacter expansion
    # (no command substitution, no quote removal), but the unquoted expansion
    # DOES perform filename globbing -- so a value of "*" would otherwise
    # expand to every file in cwd. `set -f` (noglob) disables globbing for
    # the unquoted expansion, so a value like "cmd ; rm -rf /" becomes the
    # literal tokens "cmd", ";", "rm", "-rf", "/" -- the wrapper sees the
    # same argv the original test contract expected, never a re-eval and
    # never a glob expansion.
    # Contract: exactly one argument (the command line). Defensive assert so
    # a future caller that passes multiple args doesn't silently lose them.
    if [ "$#" -ne 1 ]; then
        # shellcheck disable=SC2317  # unreachable in this session; defence in depth
        printf 'launch_under_scope: expected 1 argument, got %d\n' "$#" >&2
        return 64
    fi
    # shellcheck disable=SC2086
    set -f
    set -- $1
    set +f
    # NCZ_TOUR_NICE=0 disables the wrapper explicitly (test seam).
    if [ "${NCZ_TOUR_NICE:-auto}" = "0" ]; then
        "$@" >/dev/null 2>&1 &
        return $?
    fi
    # Auto-detect: prefer systemd-run --user --scope (cgroups + nice + quota
    # in one transient unit). The user bus is present on every real desktop
    # session; absence means we are in a context that already guards.
    if [ "${NCZ_TOUR_NICE:-auto}" = "1" ]; then
        _sr_ok=1
    elif [ "$NCZ_TOUR_SR_OK" = "unset" ]; then
        if probe_systemd_run; then
            NCZ_TOUR_SR_OK=1; _sr_ok=1
        else
            NCZ_TOUR_SR_OK=0; _sr_ok=0
        fi
    else
        _sr_ok="$NCZ_TOUR_SR_OK"
    fi
    if [ "$_sr_ok" = "1" ]; then
        # Resolve the binary once and exec it via its absolute path. Same
        # contract: the first token is the interpreter, the rest is its
        # argv. systemd-run does its own exec; no shell involved.
        _sr_bin=$(command -v systemd-run 2>/dev/null) || _sr_bin=""
        case "$_sr_bin" in
            /usr/bin/systemd-run|/bin/systemd-run|/sbin/systemd-run|/usr/sbin/systemd-run) ;;
            *) _sr_bin="" ;;
        esac
        if [ -n "$_sr_bin" ]; then
            "$_sr_bin" --user --scope \
              --nice=19 \
              --property=CPUQuota="${want_quota}%" \
              --property=CPUWeight=50 \
              "$@" >/dev/null 2>&1 &
            return $?
        fi
    fi
    # Fallback: just nice -n 19. nice runs the first argv token (the
    # interpreter); the rest is forwarded as that process's argv. No shell
    # involvement.
    nice -n 19 "$@" >/dev/null 2>&1 &
    return $?
}

open_tour() {
    if [ -n "${NCZ_TOUR_LAUNCH:-}" ]; then
        # Test hook: a single command path; the audit semantics are that this
        # is exactly what would be launched (no extra words, no shell-meta).
        # launch_under_scope preserves the audit contract: the wrapper's argv
        # is NCZ_TOUR_LAUNCH verbatim, never re-interpreted by a shell.
        launch_under_scope "$NCZ_TOUR_LAUNCH"
        return $?
    fi
    if command -v gtk-launch >/dev/null 2>&1; then
        launch_under_scope "gtk-launch dev.sinty.tour"
        return $?
    fi
    if [ -x /opt/singularity/bin/singularity-tour ]; then
        launch_under_scope "/opt/singularity/bin/singularity-tour"
        return $?
    fi
    command -v singularity-tour >/dev/null 2>&1 && {
        launch_under_scope singularity-tour; return $?;
    }
    return 1
}

# Clear the upstream first-run switch. The build already makes show-tour=false
# the schema default (20-desktop.sh), but a profile that re-enabled it would
# let the shell's launch_first_run_tour() open the tour behind this guard, so
# NCZ clears it on EVERY path (opt-out, deferral, first open). Idempotent.
disable_upstream() {
    command -v gsettings >/dev/null 2>&1 && \
        gsettings set dev.sinty.desktop show-tour false >/dev/null 2>&1 || true
}

show() {
    disable_upstream
    reason="$(guard)" || { log "show: $reason"; echo "ncz-first-login-tour: $reason"; return 0; }

    wait_for_shell
    if is_locked; then
        # Do not consume the marker: the tour should still appear on a later
        # unlocked login, and must never steal focus from a lock screen.
        log "show: session locked -- deferring, marker not written"
        echo "ncz-first-login-tour: session locked, deferring"
        return 0
    fi

    m="$(marker)"
    mkdir -p "$(dirname "$m")" 2>/dev/null || return 0
    # Marker written BEFORE the launch, and a failed launch is deliberately
    # "fail-closed": a crash or a launch error can never loop the tour, and it
    # never reappears for that user (the operator's once-only policy).
    : >"$m" 2>/dev/null || { log "show: cannot write marker $m"; return 0; }

    if [ -n "${NCZ_TOUR_DRYRUN:-}" ]; then
        log "show: DRYRUN marker written, not launching"
        echo "ncz-first-login-tour: dry-run, marker written"
        return 0
    fi
    if open_tour; then
        log "show: launched dev.sinty.tour, marker $m"
        echo "ncz-first-login-tour: opened the tour"
    else
        log "show: could not launch dev.sinty.tour"
        echo "ncz-first-login-tour: launch failed" >&2
    fi
    return 0
}

case "${1:-show}" in
    guard) guard ;;
    show)  show ;;
    *)     echo "usage: ncz-first-login-tour [guard|show]" >&2; exit 2 ;;
esac

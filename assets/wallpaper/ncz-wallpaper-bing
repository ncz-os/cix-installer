def cmd_list(args):
    args = list(args)
    consolidated = False
    for token in ("--consolidated", CONSOLIDATED_ID):
        while token in args:
            args.remove(token)
            consolidated = True
    if consolidated:
        rows = view_rows(preferred_market())
        if not rows:
            rows = [e + (is_pinned(e[2]),) for e in archive_entries(DEFAULT_MARKETS)]
    elif args and args[0] == "--all":
        rows = [e + (is_pinned(e[2]),) for e in archive_entries(all_archived_markets())]
    elif args:
        rows = [e + (is_pinned(e[2]),) for e in archive_entries([m for m in args if MARKET_RE.match(m)])]
    else:
        rows = [e + (is_pinned(e[2]),) for e in archive_entries(DEFAULT_MARKETS)]
    thumbs = thumbs_for([row[3] for row in rows])
    out = []
    for (date, market, image, meta, pinned), thumb in zip(rows, thumbs):
        out.append({
            "provider": "bing",
            "date": date,
            "market": market,
            "path": str(image),
            "caption": meta.get("caption", ""),
            "copyright": meta.get("copyright", ""),
            "thumbnail_path": thumb,
            "pinned": pinned,
        })
    print(json.dumps(out, ensure_ascii=False, indent=2))
    return 0


def cmd_pin(args, pinned):
    usage = "usage: ncz-wallpaper-bing pin <market> <yyyymmdd>"
    if len(args) != 2 or not MARKET_RE.match(args[0]) or not DATE_RE.match(args[1]):
        print(usage, file=sys.stderr)
        return 2
    marker = DATA_ROOT / args[0] / f"{args[1]}.pinned"
    if not marker.with_suffix(".jpg").exists():
        print(f"no archived image: {marker.with_suffix('.jpg')}", file=sys.stderr)
        return 1
    if pinned:
        marker.write_text("pinned\n")
    else:
        marker.unlink(missing_ok=True)
    return 0



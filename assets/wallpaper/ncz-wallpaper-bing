#!/bin/bash
# ncz-wallpaper-bing -- Bing daily wallpapers: local archive, combined view, index.
#
# Endpoint: https://www.bing.com/HPImageArchive.aspx?format=js&idx=0&n=8&mkt=<market>
# `urlbase` looks like "/th?id=OHR.Palmanova_EN-US0340289339"; appending
# "_UHD.jpg" gives the largest size. Images are archived as
# <data-root>/<market>/<startdate>.jpg (+ .txt/.json sidecars).
#
#   fetch [--if-stale] [--prefer M]
#                   sync every market. Preferred market first: its newest
#                   batch is downloaded, consolidated and thumbnailed before
#                   anything else, so the combined view is usable within
#                   seconds. A photo another market already served (same
#                   OHR.<Name> within a few days) is hard-linked, not
#                   downloaded again. --if-stale is a no-op when the last
#                   successful fetch is under 20 hours old. Exit 75 when the
#                   network is unreachable (retry later); metered links skip.
#   pick|latest|info  print one archived image / its attribution
#   list [--all|--consolidated|<market>...] [--prefer M]
#                   archive entries as JSON; --consolidated is one row per
#                   unique photograph, ordered and captioned per --prefer
#   markets         "<code>\t<Human Name>" per line, "consolidated" first
#   consolidate [--prefer M]
#                   rebuild the de-duplicated view (photo identity is the
#                   sha256 of the image); the preferred market's copy of a
#                   shared photo wins, so its caption is the one kept
#   pin|unpin <mkt> <yyyymmdd>
#
# Preferred market M (a code such as en-GB, or "auto"), first match wins:
#   --prefer M | $NCZ_BING_MARKETS | ~/.config/singularity/wallpapers-bing/market
#   | ~/.config/ncz-wallpaper/bing-markets (legacy) | auto
# auto = the session locale (LANGUAGE, LC_ALL, LC_MESSAGES, LANG, then
# locale.conf files), mapped to the closest advertised market, else en-US.
# The literal "all" (legacy) means no preference: alphabetical market order.
#
# Semantics: every market is always fetched and combined. The preference only
# picks (1) whose title/copyright a shared photo carries, trying the preferred
# market, then markets sharing its language, then en-US, then the rest;
# (2) listing order: photos the preferred market carries come first, newest
# first, then the remaining photos.
set -u
exec python3 - "$@" <<'PY'
import concurrent.futures
import datetime
import fcntl
import hashlib
import json
import os
import random
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
import urllib.request
from pathlib import Path

CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
CACHE_HOME = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache")))
LEGACY_CONFIG_DIR = CONFIG_HOME / "ncz-wallpaper"
MARKET_FILE = CONFIG_HOME / "singularity" / "wallpapers-bing" / "market"
DATA_ROOT = Path(os.environ.get("NCZ_BING_DATA_ROOT", os.environ.get("NCZ_BING_CACHE", "/var/cache/ncz-wallpapers/bing")))
THUMB_ROOT = Path(os.environ.get("NCZ_BING_THUMB_ROOT", str(CACHE_HOME / "ncz-wallpapers" / "thumbs" / "bing")))
STAMP = CACHE_HOME / "ncz-wallpapers" / "bing-last-fetch"
API = "https://www.bing.com/HPImageArchive.aspx"
FIRST_BATCH = ((0, 8),)
BACKFILL = ((0, 8), (7, 8))
MARKET_RE = re.compile(r"^([A-Za-z]{2})-([A-Za-z]{2})$")
DATE_RE = re.compile(r"^[0-9]{8}$")
NAME_RE = re.compile(r"OHR\.([^_&]+)")
NAME_WINDOW_DAYS = 4
STALE_SECONDS = 20 * 3600
MIN_FREE_BYTES = 512 * 1024 * 1024
WORKERS = 4
EX_TEMPFAIL = 75
CONSOLIDATED_ID = "consolidated"
CONSOLIDATED_NAME = "Combined (All Markets)"
MARKET_NAMES = (
    ("en-US", "United States"),
    ("en-CA", "Canada English"),
    ("fr-CA", "Canada French"),
    ("pt-BR", "Brazil"),
    ("en-GB", "United Kingdom"),
    ("fr-FR", "France"),
    ("de-DE", "Germany"),
    ("es-ES", "Spain"),
    ("it-IT", "Italy"),
    ("en-IN", "India"),
    ("ja-JP", "Japan"),
    ("zh-CN", "China"),
    ("ko-KR", "South Korea"),
    ("en-AU", "Australia"),
)
DEFAULT_MARKETS = tuple(code for code, _ in MARKET_NAMES)

PREFER = None
IF_STALE = False
REACHED = False
LIST_CALLS = 0
LIST_FAILURES = 0
INDEX_LOCK = threading.Lock()


def log(msg):
    if not os.environ.get("NCZ_BING_QUIET"):
        print(f"[bing] {msg}", file=sys.stderr)


def split_tokens(text):
    return [tok for tok in re.split(r"[\s,]+", text.strip()) if tok]


# ---- preferred market ----

def match_market(language, region=""):
    language = language.lower()
    region = region.upper()
    if region and f"{language}-{region}" in DEFAULT_MARKETS:
        return f"{language}-{region}"
    if language == "en":
        return "en-US"
    for code in DEFAULT_MARKETS:
        if code.startswith(language + "-"):
            return code
    return None


def locale_names():
    names = [n for n in os.environ.get("LANGUAGE", "").split(":") if n]
    names += [os.environ[v] for v in ("LC_ALL", "LC_MESSAGES", "LANG") if os.environ.get(v)]
    if names:
        return names
    for path in (CONFIG_HOME / "locale.conf", Path("/etc/locale.conf"), Path("/etc/default/locale")):
        try:
            text = path.read_text(errors="ignore")
        except OSError:
            continue
        for line in text.splitlines():
            key, _, value = line.partition("=")
            if key.strip() in ("LC_ALL", "LC_MESSAGES", "LANG"):
                names.append(value.strip().strip("\"'"))
        if names:
            break
    return names


def locale_market():
    for name in locale_names():
        m = re.match(r"^([A-Za-z]{2,3})(?:[_-]([A-Za-z]{2}))?(?![A-Za-z])", name)
        if not m:
            continue
        found = match_market(m.group(1), m.group(2) or "")
        if found:
            return found
    return "en-US"


def configured_text():
    text = os.environ.get("NCZ_BING_MARKETS", "")
    if not text:
        for path in (MARKET_FILE, LEGACY_CONFIG_DIR / "bing-markets", LEGACY_CONFIG_DIR / "bing-market"):
            if path.is_file():
                text = path.read_text(errors="ignore")
                break
    return text or os.environ.get("NCZ_BING_MARKET", "")


def preferred_market():
    text = (PREFER if PREFER is not None else configured_text()).strip()
    if text.lower() == "all":
        return None
    for token in split_tokens(text):
        m = MARKET_RE.match(token)
        if m:
            return match_market(m.group(1), m.group(2)) or locale_market()
    return locale_market()


def market_order(preferred, markets):
    rest = sorted(markets)
    if not preferred:
        return rest
    order = [preferred] if preferred in rest else []
    language = preferred.split("-")[0]
    order += [m for m in rest if m.startswith(language + "-") and m not in order]
    if "en-US" in rest and "en-US" not in order:
        order.append("en-US")
    return order + [m for m in rest if m not in order]


# ---- environment ----

class Lock:
    def __init__(self, wait=0):
        self.wait = wait
        self.handle = None

    def __enter__(self):
        base = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
        path = Path(base) / f"ncz-wallpaper-bing-{os.getuid()}.lock"
        self.handle = open(path, "w")
        deadline = datetime.datetime.now().timestamp() + self.wait
        while True:
            try:
                fcntl.flock(self.handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return True
            except OSError:
                if datetime.datetime.now().timestamp() >= deadline:
                    return False
                time.sleep(0.5)

    def __exit__(self, *_exc):
        self.handle.close()


def metered():
    if os.environ.get("NCZ_BING_IGNORE_METERED"):
        return False
    try:
        out = subprocess.run(
            ["busctl", "--system", "get-property", "org.freedesktop.NetworkManager",
             "/org/freedesktop/NetworkManager", "org.freedesktop.NetworkManager", "Metered"],
            capture_output=True, text=True, timeout=5).stdout.split()
        return bool(out) and out[-1] in ("1", "3")
    except (OSError, subprocess.SubprocessError):
        return False


def retention_days():
    raw = os.environ.get("NCZ_BING_RETENTION_DAYS", "")
    conf = LEGACY_CONFIG_DIR / "bing-retention-days"
    if not raw and conf.is_file():
        raw = conf.read_text(errors="ignore").strip()
    if raw.lower() in ("", "default"):
        return 365
    if raw.lower() in ("0", "forever", "none", "never"):
        return 0
    try:
        return max(0, int(raw))
    except ValueError:
        return 365


# ---- archive ----

def all_archived_markets():
    if not DATA_ROOT.is_dir():
        return []
    return sorted(p.name for p in DATA_ROOT.iterdir() if p.is_dir() and MARKET_RE.match(p.name))


def fetch_json(market, idx, n):
    global REACHED, LIST_CALLS
    LIST_CALLS += 1
    params = urllib.parse.urlencode({"format": "js", "idx": idx, "n": n, "mkt": market})
    with urllib.request.urlopen(f"{API}?{params}", timeout=30) as response:
        data = json.loads(response.read().decode("utf-8"))
    REACHED = True
    return data


def image_url(urlbase, tier):
    return "https://www.bing.com" + urlbase + tier + ".jpg"


def download(url, dest, timeout=90):
    dest.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=dest.name + ".", suffix=".part", dir=str(dest.parent))
    os.close(fd)
    tmp = Path(tmp_name)
    try:
        with urllib.request.urlopen(url, timeout=timeout) as response, tmp.open("wb") as out:
            while True:
                chunk = response.read(1024 * 128)
                if not chunk:
                    break
                out.write(chunk)
        expected = response.headers.get("Content-Length")
        if tmp.stat().st_size == 0 or (expected and int(expected) != tmp.stat().st_size):
            raise RuntimeError("empty or truncated download")
        os.chmod(tmp, 0o644)
        tmp.replace(dest)
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def shared_dir(path):
    # The cache root is shared and sticky; market directories must accept files
    # from every account while each account can only replace its own.
    path.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(path, 0o1777)
    except OSError:
        pass


def image_name(urlbase):
    m = NAME_RE.search(urlbase or "")
    return m.group(1) if m else ""


def day_number(date):
    return datetime.date(int(date[:4]), int(date[4:6]), int(date[6:])).toordinal()


def normalize_image(image, market):
    date = str(image.get("startdate", "")).strip()
    urlbase = str(image.get("urlbase", "")).strip()
    if not DATE_RE.match(date) or not urlbase:
        return None
    return {
        "schema": 1,
        "provider": "bing",
        "market": market,
        "date": date,
        "enddate": str(image.get("enddate", "")).strip(),
        "urlbase": urlbase,
        "caption": str(image.get("title", "")).replace("\n", " ").strip(),
        "copyright": str(image.get("copyright", "")).replace("\n", " ").strip(),
        "copyrightlink": str(image.get("copyrightlink", "")).strip(),
        "quiz": str(image.get("quiz", "")).strip(),
        "hsh": str(image.get("hsh", "")).strip(),
    }


def read_meta(path, market, date):
    meta_path = path.with_suffix(".json")
    txt_path = path.with_suffix(".txt")
    meta = {}
    if meta_path.is_file():
        try:
            meta = json.loads(meta_path.read_text(errors="ignore"))
        except (OSError, ValueError):
            meta = {}
    meta.setdefault("provider", "bing")
    meta.setdefault("market", market)
    meta.setdefault("date", date)
    meta.setdefault("caption", "")
    meta.setdefault("copyright", "")
    if txt_path.is_file() and (not meta["caption"] or not meta["copyright"]):
        try:
            lines = txt_path.read_text(errors="ignore").splitlines()
        except OSError:
            lines = []
        if lines:
            meta["caption"] = meta["caption"] or lines[0]
        if len(lines) > 1:
            meta["copyright"] = meta["copyright"] or lines[1]
    return meta


def write_sidecars(directory, meta):
    date = meta["date"]
    txt_path = directory / f"{date}.txt"
    json_path = directory / f"{date}.json"
    if not txt_path.exists():
        txt_path.write_text(f"{meta.get('caption', '')}\n{meta.get('copyright', '')}\n")
        os.chmod(txt_path, 0o644)
    if not json_path.exists():
        json_path.write_text(json.dumps(meta, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
        os.chmod(json_path, 0o644)


def is_pinned(path):
    return path.with_suffix(".pinned").exists()


def local_index():
    index = {}
    for market in all_archived_markets():
        for image in (DATA_ROOT / market).glob("*.jpg"):
            if not DATE_RE.match(image.stem):
                continue
            try:
                urlbase = json.loads(image.with_suffix(".json").read_text(errors="ignore")).get("urlbase", "")
            except (OSError, ValueError, AttributeError):
                continue
            name = image_name(urlbase)
            if name:
                index.setdefault(name, []).append((image.stem, image))
    return index


def find_local(index, name, date):
    for other_date, image in index.get(name, []):
        try:
            near = abs(day_number(other_date) - day_number(date)) <= NAME_WINDOW_DAYS
            if near and image.stat().st_size > 0:
                return image
        except (OSError, ValueError):
            continue
    return None


def list_market(market, batches):
    global LIST_FAILURES
    metas = []
    seen = set()
    for idx, n in batches:
        try:
            payload = fetch_json(market, idx, n)
        except Exception as exc:
            LIST_FAILURES += 1
            log(f"{market}: fetch idx={idx} failed: {exc}")
            continue
        for image in payload.get("images", []):
            meta = normalize_image(image, market)
            if meta and meta["date"] not in seen:
                seen.add(meta["date"])
                metas.append(meta)
    return metas


def materialize(meta, index):
    market = meta["market"]
    directory = DATA_ROOT / market
    out = directory / f"{meta['date']}.jpg"
    downloaded = 0
    if not out.exists():
        shared_dir(directory)
        name = image_name(meta["urlbase"])
        with INDEX_LOCK:
            source = find_local(index, name, meta["date"]) if name else None
        linked = False
        if source is not None:
            try:
                os.link(source, out)
                linked = True
            except OSError:
                pass
        if not linked:
            try:
                try:
                    download(image_url(meta["urlbase"], "_UHD"), out)
                except Exception:
                    download(image_url(meta["urlbase"], "_1920x1080"), out)
                downloaded = 1
                log(f"{market}: cached {meta['date']} ({out.stat().st_size} bytes)")
            except Exception as exc:
                log(f"{market}: image {meta['date']} failed: {exc}")
                return 0
        if name:
            with INDEX_LOCK:
                index.setdefault(name, []).append((meta["date"], out))
    write_sidecars(directory, meta)
    return downloaded


def sync(markets, batches, index):
    global REACHED
    metas = []
    for market in markets:
        metas += list_market(market, batches)
        if not REACHED:
            break
    groups = {}
    for meta in metas:
        groups.setdefault(image_name(meta["urlbase"]) or meta["market"] + meta["date"], []).append(meta)

    def run(group):
        return sum(materialize(meta, index) for meta in group)

    with concurrent.futures.ThreadPoolExecutor(WORKERS) as pool:
        total = sum(pool.map(run, groups.values()))
    for market in markets:
        prune_market(market)
    return total


def prune_market(market):
    keep_days = retention_days()
    if keep_days <= 0:
        return
    cutoff = (datetime.datetime.now(datetime.UTC).date() - datetime.timedelta(days=keep_days)).strftime("%Y%m%d")
    directory = DATA_ROOT / market
    for image in sorted(directory.glob("*.jpg")):
        if DATE_RE.match(image.stem) and image.stem < cutoff and not is_pinned(image):
            for suffix in (".jpg", ".txt", ".json"):
                image.with_suffix(suffix).unlink(missing_ok=True)
            log(f"{market}: pruned {image.stem}")


def archive_entries(markets):
    entries = []
    for market in markets:
        directory = DATA_ROOT / market
        if not directory.is_dir():
            continue
        for image in directory.glob("*.jpg"):
            if DATE_RE.match(image.stem):
                entries.append((image.stem, market, image, read_meta(image, market, image.stem)))
    return sorted(entries, key=lambda item: (item[0], item[1], str(item[2])), reverse=True)


# ---- combined view ----

def consolidated_dir():
    return DATA_ROOT / "consolidated"


def read_manifest():
    try:
        manifest = json.loads((consolidated_dir() / "index.json").read_text())
    except (OSError, ValueError):
        return []
    return [item for item in manifest if isinstance(item, dict)] if isinstance(manifest, list) else []


def view_rows(preferred):
    # (date, market, image, meta, pinned) per unique photograph. The image is
    # the stable consolidated path; market/date/meta come from the copy the
    # preference selects.
    rows = []
    for item in read_manifest():
        path = Path(item.get("path", ""))
        if not path.exists():
            continue
        copies = item.get("copies") or [{"market": item.get("market", ""), "date": item.get("date", "")}]
        by_market = {c["market"]: c["date"] for c in copies}
        market, date = item.get("market", ""), item.get("date", "")
        if preferred and by_market:
            market = market_order(preferred, list(by_market))[0]
            date = by_market[market]
        real = DATA_ROOT / market / f"{date}.jpg"
        meta = read_meta(real if real.exists() else path, market, date)
        pinned = any(is_pinned(DATA_ROOT / m / f"{d}.jpg") for m, d in by_market.items())
        rows.append((date, market, path, meta, pinned, bool(preferred) and preferred in by_market))
    rows.sort(key=lambda r: (r[0], r[1]), reverse=True)
    if preferred:
        rows.sort(key=lambda r: not r[5])
    return [r[:5] for r in rows]


def deduped_archive_entries(markets):
    rows = view_rows(preferred_market())
    if rows:
        return [row[:4] for row in rows]
    return archive_entries(markets)


def sha256_of(path, chunk_size=1024 * 1024):
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(chunk_size), b""):
            digest.update(chunk)
    return digest.hexdigest()


def relink(dst, src):
    if dst.exists() or dst.is_symlink():
        dst.unlink()
    dst.symlink_to(src)


def consolidate_locked(preferred):
    markets = market_order(preferred, all_archived_markets())
    seen = {}
    copies = {}
    by_inode = {}
    for market in markets:
        for image in sorted((DATA_ROOT / market).glob("*.jpg")):
            date = image.stem
            if not DATE_RE.match(date):
                continue
            try:
                st = image.stat()
                if st.st_size == 0:
                    continue
                key = (st.st_dev, st.st_ino)
                if key not in by_inode:
                    by_inode[key] = sha256_of(image)
                digest = by_inode[key]
            except OSError as exc:
                log(f"consolidate: {market}/{image.name}: could not hash: {exc}")
                continue
            copies.setdefault(digest, []).append({"market": market, "date": date})
            seen.setdefault(digest, (market, date, image))

    final = consolidated_dir()
    staging = DATA_ROOT / ".consolidated.new"
    shutil.rmtree(staging, ignore_errors=True)
    staging.mkdir(parents=True, exist_ok=True)
    manifest = []
    for digest, (market, date, image) in seen.items():
        market_dir = staging / market
        market_dir.mkdir(parents=True, exist_ok=True)
        try:
            relink(market_dir / f"{date}.jpg", image)
        except OSError as exc:
            log(f"consolidate: {market}/{image.name}: symlink failed: {exc}")
            continue
        for suffix in (".txt", ".json"):
            src = image.with_suffix(suffix)
            if src.exists():
                try:
                    relink(market_dir / f"{date}{suffix}", src)
                except OSError as exc:
                    log(f"consolidate: {market}/{src.name}: sidecar symlink failed: {exc}")
        meta = read_meta(image, market, date)
        manifest.append({
            "provider": "bing",
            "market": market,
            "date": date,
            "path": str(final / market / f"{date}.jpg"),
            "source_path": str(image),
            "sha256": digest,
            "caption": meta.get("caption", ""),
            "copyright": meta.get("copyright", ""),
            "copies": copies[digest],
        })
    manifest.sort(key=lambda item: (item["date"], item["market"]), reverse=True)
    (staging / "index.json").write_text(json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
    old = DATA_ROOT / ".consolidated.old"
    shutil.rmtree(old, ignore_errors=True)
    try:
        if final.exists():
            os.rename(final, old)
        try:
            os.rename(staging, final)
        except OSError:
            if old.exists() and not final.exists():
                os.rename(old, final)
            raise
    except OSError as exc:
        log(f"consolidate: cannot replace {final}: {exc}")
        shutil.rmtree(staging, ignore_errors=True)
        return 1
    shutil.rmtree(old, ignore_errors=True)
    log(f"consolidate: {len(manifest)} unique image(s) from {len(markets)} market(s), preferred {preferred or 'none'}")
    return 0 if manifest else 1


def ensure_thumb(meta):
    urlbase = meta.get("urlbase", "")
    market = meta.get("market", "")
    date = meta.get("date", "")
    if not urlbase or not market or not date:
        return ""
    thumb = THUMB_ROOT / market / f"{date}_400x240.jpg"
    if not thumb.exists():
        try:
            download(image_url(urlbase, "_400x240"), thumb, timeout=45)
        except Exception as exc:
            log(f"{market}: thumbnail {date} failed: {exc}")
            return ""
    return str(thumb)


def thumbs_for(metas):
    with concurrent.futures.ThreadPoolExecutor(WORKERS) as pool:
        return list(pool.map(ensure_thumb, metas))


def fresh():
    try:
        age = datetime.datetime.now().timestamp() - STAMP.stat().st_mtime
    except OSError:
        return False
    manifest = consolidated_dir() / "index.json"
    try:
        return 0 <= age < STALE_SECONDS and manifest.stat().st_size > 2
    except OSError:
        return False


# ---- commands ----

def cmd_fetch(_args):
    try:
        os.nice(10)
    except OSError:
        pass
    with Lock() as got:
        if not got:
            log("another fetch is running")
            return 0
        if IF_STALE and fresh():
            thumbs_for([row[3] for row in view_rows(preferred_market())])
            return 0
        if metered():
            log("metered connection, skipping")
            return 0
        try:
            DATA_ROOT.mkdir(parents=True, exist_ok=True)
            free = shutil.disk_usage(DATA_ROOT).free
        except OSError as exc:
            log(f"cache unavailable: {exc}")
            return EX_TEMPFAIL
        if free < MIN_FREE_BYTES:
            log("less than 512 MiB free, skipping")
            return 1
        preferred = preferred_market()
        order = market_order(preferred, DEFAULT_MARKETS)
        index = local_index()
        sync(order[:1], FIRST_BATCH, index)
        if not REACHED:
            log("network unreachable")
            return EX_TEMPFAIL
        consolidate_locked(preferred)
        thumbs_for([row[3] for row in view_rows(preferred)])
        calls, failures = LIST_CALLS, LIST_FAILURES
        sync(order, BACKFILL, index)
        consolidate_locked(preferred)
        thumbs_for([row[3] for row in view_rows(preferred)])
        if LIST_FAILURES - failures >= LIST_CALLS - calls:
            log("backfill failed for every market")
            return EX_TEMPFAIL
        try:
            STAMP.parent.mkdir(parents=True, exist_ok=True)
            STAMP.touch()
        except OSError:
            pass
        return 0



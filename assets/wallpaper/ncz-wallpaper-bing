def cmd_consolidate(_args):
    with Lock(wait=120) as got:
        if not got:
            log("consolidate: lock busy")
            return 1
        return consolidate_locked(preferred_market())


def take_options(args):
    global PREFER, IF_STALE
    rest = []
    it = iter(args)
    for arg in it:
        if arg == "--prefer":
            PREFER = next(it, "")
        elif arg.startswith("--prefer="):
            PREFER = arg.split("=", 1)[1]
        elif arg == "--if-stale":
            IF_STALE = True
        else:
            rest.append(arg)
    return rest


cmd = sys.argv[1] if len(sys.argv) > 1 else "fetch"
args = take_options(sys.argv[2:])
commands = {
    "fetch": cmd_fetch,
    "pick": cmd_pick,
    "latest": cmd_latest,
    "info": cmd_info,
    "list": cmd_list,
    "markets": cmd_markets,
    "consolidate": cmd_consolidate,
}
if cmd == "pin":
    raise SystemExit(cmd_pin(args, True))
if cmd == "unpin":
    raise SystemExit(cmd_pin(args, False))
if cmd not in commands:
    print("usage: ncz-wallpaper-bing {fetch [--if-stale]|pick|latest|info|list [--all|--consolidated|<market>...]|markets|consolidate|pin <market> <yyyymmdd>|unpin <market> <yyyymmdd>} [--prefer <market|auto>]", file=sys.stderr)
    raise SystemExit(2)
raise SystemExit(commands[cmd](args))

def cpu_bench(seconds=1.2, threads=None):
    """Single/multi-thread SHA-256 throughput in MiB/s (C-level, GIL released).

    hashlib releases the GIL for buffers > 2047 bytes, so the multi-thread run
    measures real core scaling rather than the interpreter lock.  Each worker
    counts its own iterations until a shared deadline, so the result is
    independent of Python minor-version loop speed.
    """
    import threading
    buf = b"\xa5" * (1 << 20)

    def worker(counts, idx, deadline):
        h = hashlib.sha256()
        n = 0
        while time.perf_counter() < deadline:
            h.update(buf)
            n += 1
        counts[idx] = n

    # single thread
    t0 = time.perf_counter()
    one = [0]
    worker(one, 0, t0 + seconds)
    single = one[0] / max(time.perf_counter() - t0, 1e-6)

    nthreads = threads or (os.cpu_count() or 1)
    nthreads = max(1, min(nthreads, 32))
    counts = [0] * nthreads
    deadline = time.perf_counter() + seconds
    ths = [threading.Thread(target=worker, args=(counts, i, deadline)) for i in range(nthreads)]
    t0 = time.perf_counter()
    for th in ths:
        th.start()
    for th in ths:
        th.join()
    dt = max(time.perf_counter() - t0, 1e-6)
    multi = sum(counts) / dt
    return {"cpu_single_mibs": round(single, 1), "cpu_multi_mibs": round(multi, 1),
            "cpu_threads": nthreads}


def disk_bench(root="", seconds=2.0, workdir=None):
    """4k random-read latency (median microseconds) on the root filesystem.

    Writes a scratch file (never /tmp unless that is the root fs), drops page
    cache when it can (root), then reads 4k blocks at random offsets.  Returns
    median p50 plus p95 as a robustness signal.
    """
    target_dir = workdir
    if not target_dir:
        # Prefer a writable dir on the SAME filesystem as root so the latency is
        # the root disk's.  /var/tmp then /var/lib then HOME.  Never /tmp (rule).
        for cand in (P(root, "var/tmp"), P(root, "var/lib"), P(root, "home"), os.path.expanduser("~")):
            if cand and os.path.isdir(cand) and os.access(cand, os.W_OK):
                target_dir = cand
                break
    if not target_dir or not os.path.isdir(target_dir):
        target_dir = root or "."
    path = None
    try:
        fd, path = tempfile.mkstemp(prefix=".ncz-cap-disk-", dir=target_dir)
        size = 64 * 1024 * 1024
        # Write every extent (not ftruncate): a sparse file reads as fast zeros
        # and would score a spinning disk like an NVMe.
        chunk = b"\xa5" * (1 << 20)
        try:
            written = 0
            while written < size:
                os.write(fd, chunk)
                written += len(chunk)
            os.fsync(fd)
        finally:
            os.close(fd)
        # best-effort cold cache: fadvise works unprivileged for our own file;
        # drop_caches is the root fallback for the first-boot service.
        try:
            rfd = os.open(path, os.O_RDONLY)
            try:
                os.posix_fadvise(rfd, 0, 0, os.POSIX_FADV_DONTNEED)
            finally:
                os.close(rfd)
        except (AttributeError, OSError):
            try:
                with open(P(root, "proc/sys/vm/drop_caches"), "w") as fh:
                    fh.write("3\n")
            except OSError:
                pass
        samples = []
        rfd = os.open(path, os.O_RDONLY)
        try:
            nblocks = size // 4096
            rnd = __import__("random").Random(20261012)
            t_end = time.perf_counter() + seconds
            while time.perf_counter() < t_end and len(samples) < 8000:
                off = rnd.randrange(nblocks) * 4096
                t0 = time.perf_counter()
                os.pread(rfd, 4096, off)
                samples.append((time.perf_counter() - t0) * 1e6)
        finally:
            os.close(rfd)
        if not samples:
            return None
        samples.sort()
        return {"disk_4k_us": round(samples[len(samples) // 2], 1),
                "disk_4k_p95_us": round(samples[int(len(samples) * 0.95)], 1),
                "disk_samples": len(samples)}
    except OSError:
        return None
    finally:
        if path:
            try:
                os.unlink(path)
            except OSError:
                pass



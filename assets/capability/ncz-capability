def _load_gl():
    egl = ctypes.util.find_library("EGL") or "libEGL.so.1"
    gles = ctypes.util.find_library("GLESv2") or "libGLESv2.so.2"
    gbm = ctypes.util.find_library("gbm") or "libgbm.so.1"
    try:
        libegl = ctypes.CDLL(egl)
        libgles = ctypes.CDLL(gles)
    except OSError:
        return None
    libgbm = None
    try:
        libgbm = ctypes.CDLL(gbm)
    except OSError:
        pass
    return libegl, libgles, libgbm


GL_VENDOR, GL_RENDERER, GL_VERSION = 0x1F00, 0x1F01, 0x1F02
EGL_DEFAULT_DISPLAY = ctypes.c_void_p(0)
EGL_NO_CONTEXT = ctypes.c_void_p(0)
EGL_PLATFORM_GBM_KHR = 0x31D7
EGL_PLATFORM_SURFACELESS_MESA = 0x31DD
EGL_OPENGL_ES_API = 0x30A0
EGL_PBUFFER_BIT = 0x0001
EGL_OPENGL_ES3_BIT = 0x40
EGL_NONE = 0x3038


def _gl_bench_on(libegl, libgles, display, tag):
    """Create a pbuffer GLES3 context on `display` and time a fill+shader frame.

    Returns (renderer, version, ms, err).  Any failure returns err and None ms.
    """
    EGLint = ctypes.c_int
    lE = libegl
    lG = libgles

    def proto(name, restype, argtypes):
        fn = getattr(lE, name, None)
        if fn is None:
            return None
        fn.restype = restype
        fn.argtypes = argtypes
        return fn

    eglInitialize = proto("eglInitialize", ctypes.c_uint, [ctypes.c_void_p, ctypes.POINTER(EGLint), ctypes.POINTER(EGLint)])
    eglBindAPI = proto("eglBindAPI", ctypes.c_uint, [ctypes.c_uint])
    eglChooseConfig = proto("eglChooseConfig", ctypes.c_uint, [ctypes.c_void_p, ctypes.POINTER(EGLint), ctypes.POINTER(ctypes.c_void_p), EGLint, ctypes.POINTER(EGLint)])
    eglCreatePbufferSurface = proto("eglCreatePbufferSurface", ctypes.c_void_p, [ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(EGLint)])
    eglCreateContext = proto("eglCreateContext", ctypes.c_void_p, [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(EGLint)])
    eglMakeCurrent = proto("eglMakeCurrent", ctypes.c_uint, [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p])
    eglDestroyContext = proto("eglDestroyContext", ctypes.c_uint, [ctypes.c_void_p, ctypes.c_void_p])
    eglDestroySurface = proto("eglDestroySurface", ctypes.c_uint, [ctypes.c_void_p, ctypes.c_void_p])
    eglTerminate = proto("eglTerminate", ctypes.c_uint, [ctypes.c_void_p])
    if not (eglInitialize and eglChooseConfig and eglCreatePbufferSurface and
            eglCreateContext and eglMakeCurrent):
        return None, None, None, "libEGL is missing required entry points"

    major, minor = EGLint(0), EGLint(0)
    if not eglInitialize(display, ctypes.byref(major), ctypes.byref(minor)):
        return None, None, None, "eglInitialize failed"
    if eglBindAPI:
        eglBindAPI(EGL_OPENGL_ES_API)
    cfg_attr = (EGLint * 17)(
        0x3033, EGL_PBUFFER_BIT,       # EGL_SURFACE_TYPE
        0x3040, EGL_OPENGL_ES3_BIT,    # EGL_RENDERABLE_TYPE
        0x3024, 8, 0x3023, 8, 0x3022, 8, 0x3021, 8,   # RGBA
        0x3025, 0,                     # EGL_DEPTH_SIZE
        0x3038,
    )
    cfg = ctypes.c_void_p(0)
    ncfg = EGLint(0)
    if not eglChooseConfig(display, cfg_attr, ctypes.byref(cfg), 1, ctypes.byref(ncfg)) or ncfg.value < 1:
        eglTerminate(display)
        return None, None, None, "eglChooseConfig found no ES3 pbuffer config"
    W, H = 1280, 720
    surf_attr = (EGLint * 5)(0x3057, W, 0x3056, H, EGL_NONE)
    surface = eglCreatePbufferSurface(display, cfg, surf_attr)
    if not surface:
        eglTerminate(display)
        return None, None, None, "eglCreatePbufferSurface failed"
    ctx_attr = (EGLint * 3)(0x3098, 3, EGL_NONE)
    ctx = eglCreateContext(display, cfg, EGL_NO_CONTEXT, ctx_attr)
    if not ctx:
        eglDestroySurface(display, surface)
        eglTerminate(display)
        return None, None, None, "eglCreateContext(ES3) failed"
    if not eglMakeCurrent(display, surface, surface, ctx):
        eglDestroyContext(display, ctx)
        eglDestroySurface(display, surface)
        eglTerminate(display)
        return None, None, None, "eglMakeCurrent failed"

    def glproto(name, restype, argtypes):
        fn = getattr(lG, name, None)
        if fn is not None:
            fn.restype = restype
            fn.argtypes = argtypes
        return fn

    glGetString = glproto("glGetString", ctypes.c_char_p, [ctypes.c_uint])
    glCreateShader = glproto("glCreateShader", ctypes.c_uint, [ctypes.c_uint])
    glShaderSource = glproto("glShaderSource", None, [ctypes.c_uint, ctypes.c_int, ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_int)])
    glCompileShader = glproto("glCompileShader", None, [ctypes.c_uint])
    glGetShaderiv = glproto("glGetShaderiv", None, [ctypes.c_uint, ctypes.c_uint, ctypes.POINTER(ctypes.c_int)])
    glCreateProgram = glproto("glCreateProgram", ctypes.c_uint, [])
    glAttachShader = glproto("glAttachShader", None, [ctypes.c_uint, ctypes.c_uint])
    glLinkProgram = glproto("glLinkProgram", None, [ctypes.c_uint])
    glGetProgramiv = glproto("glGetProgramiv", None, [ctypes.c_uint, ctypes.c_uint, ctypes.POINTER(ctypes.c_int)])
    glUseProgram = glproto("glUseProgram", None, [ctypes.c_uint])
    glGetUniformLocation = glproto("glGetUniformLocation", ctypes.c_int, [ctypes.c_uint, ctypes.c_char_p])
    glUniform1f = glproto("glUniform1f", None, [ctypes.c_int, ctypes.c_float])
    glGenVertexArrays = glproto("glGenVertexArrays", None, [ctypes.c_int, ctypes.POINTER(ctypes.c_uint)])
    glBindVertexArray = glproto("glBindVertexArray", None, [ctypes.c_uint])
    glViewport = glproto("glViewport", None, [ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int])
    glDrawArrays = glproto("glDrawArrays", None, [ctypes.c_uint, ctypes.c_int, ctypes.c_int])
    glFinish = glproto("glFinish", None, [])
    glReadPixels = glproto("glReadPixels", None, [ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int,
                                                   ctypes.c_uint, ctypes.c_uint, ctypes.c_void_p])
    glClearColor = glproto("glClearColor", None, [ctypes.c_float] * 4)
    glClear = glproto("glClear", None, [ctypes.c_uint])

    renderer = (glGetString(GL_RENDERER) or b"?").decode("utf-8", "replace")
    version = (glGetString(GL_VERSION) or b"?").decode("utf-8", "replace")

    vs_src = ("#version 300 es\nvoid main(){vec2 p=vec2(float((gl_VertexID<<1)&2),float(gl_VertexID&2));"
              "gl_Position=vec4(p*2.0-1.0,0.0,1.0);}\n")
    fs_src = ("#version 300 es\nprecision highp float;\nout vec4 o;\nuniform float u;\n"
              "void main(){float a=gl_FragCoord.x*0.0001+gl_FragCoord.y*0.0001+u;\n"
              "for(int i=0;i<160;i++){a=sin(a)*1.0007+0.311;}o=vec4(a,a*0.7,a*0.4,1.0);}\n")

    def compile_shader(kind, src_text):
        # Build the C string array AND an explicit length array, and keep both
        # alive for the duration of the glShaderSource call (passing a bare
        # length of NULL relies on NUL-termination and is what a reviewer
        # rightly flagged as fragile in ctypes).
        data = src_text.encode()
        arr = (ctypes.c_char_p * 1)(data)
        lengths = (ctypes.c_int * 1)(len(data))
        sh = glCreateShader(kind)
        glShaderSource(sh, 1, arr, lengths)
        glCompileShader(sh)
        del arr, lengths
        ok = ctypes.c_int(0)
        glGetShaderiv(sh, 0x8B81, ctypes.byref(ok))  # GL_COMPILE_STATUS
        return sh if ok.value else None

    vs = compile_shader(0x8B31, vs_src)   # GL_VERTEX_SHADER
    fs = compile_shader(0x8B30, fs_src)   # GL_FRAGMENT_SHADER
    if not vs or not fs:
        renderer = renderer  # keep what we learned
        eglMakeCurrent(display, ctypes.c_void_p(0), ctypes.c_void_p(0), ctypes.c_void_p(0))
        eglDestroyContext(display, ctx); eglDestroySurface(display, surface); eglTerminate(display)
        return renderer, version, None, "shader compile failed"
    prog = glCreateProgram()
    glAttachShader(prog, vs); glAttachShader(prog, fs); glLinkProgram(prog)
    ok = ctypes.c_int(0)
    glGetProgramiv(prog, 0x8B82, ctypes.byref(ok))  # GL_LINK_STATUS
    if not ok.value:
        eglMakeCurrent(display, ctypes.c_void_p(0), ctypes.c_void_p(0), ctypes.c_void_p(0))
        eglDestroyContext(display, ctx); eglDestroySurface(display, surface); eglTerminate(display)
        return renderer, version, None, "program link failed"
    glUseProgram(prog)
    loc = glGetUniformLocation(prog, b"u")
    glViewport(0, 0, W, H)
    glClearColor(0.0, 0.0, 0.0, 1.0)
    vao = ctypes.c_uint(0)
    glGenVertexArrays(1, ctypes.byref(vao))
    glBindVertexArray(vao.value)
    # warm up, then time N frames.  A 1x1 glReadPixels per frame is the sync
    # point: on tile-based GPUs (Mali) glFinish alone can return before the
    # pass is retired, which made a full-screen shader read as 0.1 ms.
    sync = (ctypes.c_ubyte * 4)()
    for _ in range(3):
        glUniform1f(loc, 0.0)
        glClear(0x4000)   # GL_COLOR_BUFFER_BIT
        glDrawArrays(0x0004, 0, 3)   # GL_TRIANGLES
        if glReadPixels:
            glReadPixels(0, 0, 1, 1, 0x1908, 0x1401, ctypes.byref(sync))  # RGBA/UNSIGNED_BYTE
        glFinish()
    frames = 30
    t0 = time.perf_counter()
    for i in range(frames):
        glUniform1f(loc, i * 0.01)
        glClear(0x4000)
        glDrawArrays(0x0004, 0, 3)
        if glReadPixels:
            glReadPixels(0, 0, 1, 1, 0x1908, 0x1401, ctypes.byref(sync))
    glFinish()
    ms = (time.perf_counter() - t0) * 1000.0 / frames

    eglMakeCurrent(display, ctypes.c_void_p(0), ctypes.c_void_p(0), ctypes.c_void_p(0))
    eglDestroyContext(display, ctx)
    eglDestroySurface(display, surface)
    eglTerminate(display)
    return renderer, version, round(ms, 3), None


def gl_bench(root=""):
    """Best-effort offscreen GL microbench.  Returns dict with renderer/ms/err.

    Order: a caller-supplied seam, then a GBM render node (real GPU on both
    amd64 and arm64 Mali), then surfaceless EGL.  Never raises.
    """
    out = {"gpu_renderer": None, "gpu_version": None, "gpu_ms": None,
           "gpu_measured": False, "gpu_error": None}
    seam = os.environ.get("NCZ_CAPABILITY_GL_BENCH")
    if seam:
        rc, txt = run(["sh", "-c", seam], timeout=30)
        m = re.search(r"([0-9]+(?:\.[0-9]+)?)\s*ms", txt)
        if rc == 0 and m:
            out.update(renderer=txt.strip().splitlines()[0][:200] if txt.strip() else None,
                       gpu_ms=float(m.group(1)), gpu_measured=True)
        else:
            out["gpu_error"] = "seam failed rc=%d" % rc
        return out
    libs = _load_gl()
    if not libs:
        out["gpu_error"] = "libEGL/libGLESv2 not found"
        return out
    libegl, libgles, libgbm = libs

    def platform_display(plat, native):
        """Resolve an EGLDisplay for `plat`, trying core then EXT then legacy.

        The CIX vendor libEGL (Sky1 / Mali) exports neither EGL 1.5's
        eglGetPlatformDisplay nor the EXT form, so a legacy eglGetDisplay(gbm)
        path has to stay live or the arm64 GPU never gets measured.
        """
        for fn_name in ("eglGetPlatformDisplay", "eglGetPlatformDisplayEXT"):
            fn = getattr(libegl, fn_name, None)
            if fn is None:
                continue
            fn.restype = ctypes.c_void_p
            fn.argtypes = [ctypes.c_uint, ctypes.c_void_p, ctypes.c_void_p]
            d = fn(plat, native, None)
            if d:
                return d
        return None

    # GBM render node first: the real GPU on amd64 and on arm64 Mali
    if libgbm is not None:
        libgbm.gbm_create_device.restype = ctypes.c_void_p
        libgbm.gbm_create_device.argtypes = [ctypes.c_int]
        libgbm.gbm_device_destroy.argtypes = [ctypes.c_void_p]
        nodes = sorted(glob.glob(P(root, "dev/dri/renderD*")))
        for node in nodes:
            try:
                fd = os.open(node, os.O_RDWR)
            except OSError:
                try:
                    fd = os.open(node, os.O_RDONLY)
                except OSError:
                    continue
            try:
                gbm_dev = libgbm.gbm_create_device(fd)
                if not gbm_dev:
                    continue
                disp = platform_display(EGL_PLATFORM_GBM_KHR, ctypes.c_void_p(gbm_dev))
                if disp is None:
                    # legacy EGL 1.4 path: eglGetDisplay(gbm device)
                    eglGetDisplay = getattr(libegl, "eglGetDisplay", None)
                    if eglGetDisplay is not None:
                        eglGetDisplay.restype = ctypes.c_void_p
                        eglGetDisplay.argtypes = [ctypes.c_void_p]
                        disp = eglGetDisplay(ctypes.c_void_p(gbm_dev))
                if disp:
                    renderer, version, ms, err = _gl_bench_on(libegl, libgles, disp, node)
                    if ms is not None:
                        out.update(gpu_renderer=renderer, gpu_version=version,
                                   gpu_ms=ms, gpu_measured=True)
                        return out
                    out["gpu_error"] = err or out["gpu_error"]
                libgbm.gbm_device_destroy(ctypes.c_void_p(gbm_dev))
            finally:
                os.close(fd)
    # surfaceless fallback (amd64 Mesa; on Mali this is llvmpipe, so it only
    # ever runs when the GBM path found nothing)
    disp = platform_display(EGL_PLATFORM_SURFACELESS_MESA, ctypes.c_void_p(0))
    if disp:
        renderer, version, ms, err = _gl_bench_on(libegl, libgles, disp, "surfaceless")
        if ms is not None:
            out.update(gpu_renderer=renderer, gpu_version=version, gpu_ms=ms, gpu_measured=True)
            return out
        out["gpu_error"] = err or out["gpu_error"]
    # last resort: a plain EGL_DEFAULT_DISPLAY
    renderer, version, ms, err = _gl_bench_on(libegl, libgles, EGL_DEFAULT_DISPLAY, "default")
    if ms is not None:
        out.update(gpu_renderer=renderer, gpu_version=version, gpu_ms=ms, gpu_measured=True)
    else:
        out["gpu_error"] = out["gpu_error"] or err
    return out


def renderer_from_eglinfo():
    """Fallback renderer/version when the ctypes bench cannot run.

    Reads the first GBM/Wayland block's renderer (the real GPU) before any
    device/surfaceless block, falling back to any renderer line.
    """
    rc, txt = run(["eglinfo", "-B"], timeout=20)
    if rc != 0 or not txt:
        return None, None
    blocks = re.split(r"([A-Za-z ]+platform:)", txt)
    candidates = []
    for i in range(1, len(blocks), 2):
        plat = blocks[i].strip().lower()
        body = blocks[i + 1] if i + 1 < len(blocks) else ""
        for m in re.finditer(r"(?:OpenGL ES|OpenGL core|OpenGL compatibility) profile renderer:\s*(.+)", body):
            candidates.append((plat, m.group(1).strip()))
        for m in re.finditer(r"(?:OpenGL ES|OpenGL core) profile version:\s*(.+)", body):
            candidates.append((plat, None, m.group(1).strip()))
    renderer = None
    version = None
    for c in candidates:
        plat = c[0]
        if len(c) == 2 and c[1] and not SOFTWARE_RE.search(c[1]) and plat in ("gbm", "wayland", "x11"):
            renderer = c[1]
            break
    if renderer is None:
        for c in candidates:
            if len(c) == 2 and c[1]:
                renderer = c[1]
                break
    for c in candidates:
        if len(c) == 3:
            version = c[2]
            break
    return renderer, version


def display_info(root=""):
    conns = []
    for status in glob.glob(P(root, "sys/class/drm/card[0-9]*-*/status")):
        try:
            if open(status).read().strip() != "connected":
                continue
        except OSError:
            continue
        name = os.path.basename(os.path.dirname(status))
        w = h = 0
        modes = os.path.join(os.path.dirname(status), "modes")
        try:
            with open(modes) as fh:
                first = fh.read().splitlines()[0]
            m = re.match(r"(\d+)x(\d+)", first)
            if m:
                w, h = int(m.group(1)), int(m.group(2))
        except (OSError, IndexError):
            pass
        conns.append({"connector": name, "width": w, "height": h})
    outn = len(conns)
    max_w = max([c["width"] for c in conns], default=0)
    max_h = max([c["height"] for c in conns], default=0)
    total = sum(c["width"] * c["height"] for c in conns)
    scale = 1.0
    # a coarse HiDPI hint: a portrait-orientation or very large logical panel
    if max_h >= 2000:
        scale = 2.0
    return {"outputs": outn, "connected": outn > 0, "max_width": max_w, "max_height": max_h,
            "total_pixels": total, "scale": scale, "connectors": conns}


def thermal_info(root=""):
    ac = None
    for p in glob.glob(P(root, "sys/class/power_supply/AC*/online")):
        # OR the supplies: a machine with two adapters is on AC if EITHER is
        # online, so a later "0" must not erase an earlier "1".
        if read_text(p) == "1":
            ac = True
        elif ac is None:
            ac = False
    battery = bool(glob.glob(P(root, "sys/class/power_supply/BAT*")))
    temps = []
    for p in glob.glob(P(root, "sys/class/thermal/thermal_zone*/temp")):
        t = read_int(p)
        if t > 0:
            temps.append(t / 1000.0)
    for p in glob.glob(P(root, "sys/class/hwmon/hwmon*/temp*_input")):
        t = read_int(p)
        if 0 < t < 200000:
            temps.append(t / 1000.0)
    max_c = max(temps) if temps else None
    # throttle point guess: 85 C for T2 Macs / Intel mobile; leave None when unknown
    throttle = 95.0 if max_c is not None else None
    headroom = round(throttle - max_c, 1) if (throttle is not None and max_c is not None) else None
    return {"ac_online": ac, "battery": battery, "max_temp_c": max_c, "headroom_c": headroom}


def gpu_vram_shared(gpus, mem_mb, root=""):
    """Fill renderer/vulkan/software fields into the sysfs GPU list (best effort)."""
    vk_devices = []
    rc, txt = run(["vulkaninfo", "--summary"], timeout=15)
    if rc == 0:
        for m in re.finditer(r"deviceName\s*=\s*(.+)", txt):
            vk_devices.append(m.group(1).strip())
    bench = gl_bench(root)
    egl_renderer, egl_version = (None, None)
    if not bench.get("gpu_measured"):
        egl_renderer, egl_version = renderer_from_eglinfo()
    renderer = bench.get("gpu_renderer") or egl_renderer
    version = bench.get("gpu_version") or egl_version
    # arm64 Mali / Sky1: the DRM card is the display controller (linlondp), so a
    # real GPU entry has to be added from the Mali device node.
    if (os.path.exists(P(root, "dev/mali0")) or
            os.path.isdir(P(root, "sys/bus/platform/drivers/mali_kbase"))) and \
            not any(g.get("driver") in ("mali_kbase", "panthor") for g in gpus):
        gpus.append({"card": "mali0", "vendor": "0x13b5", "device": "mali",
                     "driver": "mali_kbase", "boot_vga": True, "vram_mb": None,
                     "_primary": True, "renderer": renderer,
                     "gl_version": version, "platform": True})
    if renderer:
        target = None
        for g in gpus:
            if g.get("boot_vga") or g.get("_primary"):
                target = g
                break
        if target is None and gpus:
            target = gpus[0]
        if target is not None:
            target["renderer"] = renderer
            target["gl_version"] = version
    for g in gpus:
        g.setdefault("renderer", None)
        g.setdefault("gl_version", None)
        g.setdefault("vulkan", bool(vk_devices))
        g.setdefault("software", False)
        if g.get("renderer") and SOFTWARE_RE.search(g["renderer"]):
            g["software"] = True
        g["class"] = classify_renderer(g.get("renderer") or "")
        if g.get("vram_mb") is None:
            g["vram_shared"] = True
        g["vulkan_devices"] = vk_devices
    bench["gpu_renderer"] = renderer
    return bench


def collect_facts(root="", calibrate=True):
    cpu = cpu_info(root)
    mem = mem_info(root)
    disk = None
    if calibrate:
        db = disk_bench(root)
        disk_us = db["disk_4k_us"] if db else None
    else:
        db = None
        disk_us = None
    st = storage_info(root, disk_us)
    if db:
        st.update({k: v for k, v in db.items() if k.startswith("disk_")})
    gpus = _drm_cards(root)
    if not any(g.get("boot_vga") for g in gpus) and gpus:
        gpus[0]["_primary"] = True
    disp = display_info(root)
    therm = thermal_info(root)
    bench = gpu_vram_shared(gpus, mem["total_mb"], root) if calibrate else {"gpu_measured": False, "gpu_error": None, "gpu_ms": None}
    cpu_b = cpu_bench() if calibrate else {}
    return {
        "cpu": cpu,
        "mem": mem,
        "storage": st,
        "gpus": gpus,
        "display": disp,
        "thermal": therm,
        "platform": {"arch": _platform.machine(), "kernel": _platform.release(),
                     "dmi_product": read_text(P(root, "sys/class/dmi/id/product_name")),
                     "hostname": _platform.node()},
        "calibration": {
            "cpu_single_mibs": cpu_b.get("cpu_single_mibs"),
            "cpu_multi_mibs": cpu_b.get("cpu_multi_mibs"),
            "cpu_threads": cpu_b.get("cpu_threads"),
            "gpu_ms": bench.get("gpu_ms"),
            "gpu_measured": bench.get("gpu_measured", False),
            "gpu_error": bench.get("gpu_error"),
            "gpu_renderer": bench.get("gpu_renderer"),
        },
    }


# ---------------------------------------------------------------------------
# Scoring (pure)
# ---------------------------------------------------------------------------

def _cpu_subscore(facts):
    cal = facts.get("calibration", {}) or {}
    single = cal.get("cpu_single_mibs")
    if single is None:
        # fall back to cores/max MHz so a --no-calibrate run still ranks roughly
        cores = facts.get("cpu", {}).get("cores", 1)
        mhz = facts.get("cpu", {}).get("max_mhz", 0) or 1500
        single = 90.0 + 25.0 * cores + mhz * 0.12
    s_single = rung(float(single), CPU_SINGLE_ANCHORS)
    multi = cal.get("cpu_multi_mibs")
    if multi is not None and single:
        scale = float(multi) / float(single)
        s_scale = rung(scale, CPU_SCALE_ANCHORS)
    else:
        cores = facts.get("cpu", {}).get("cores", 1)
        s_scale = rung(min(cores, 8) * 1.0, [(1, 10), (2, 30), (4, 70), (6, 88), (8, 100)])
    return round(0.6 * s_single + 0.4 * s_scale, 1)


def _gpu_subscore(facts):
    cal = facts.get("calibration", {}) or {}
    gpus = facts.get("gpus", []) or []
    ms = cal.get("gpu_ms")
    if ms is not None and cal.get("gpu_measured"):
        return round(rung(float(ms), GPU_MS_ANCHORS), 1)
    # software anywhere in the display path is a hard low score
    if any(g.get("software") for g in gpus):
        return GPU_CLASS_SCORE["software"]
    classes = [classify_renderer(g.get("renderer") or "") for g in gpus] or ["unknown"]
    best = max(classes, key=lambda c: GPU_CLASS_SCORE.get(c, 45.0))
    score = GPU_CLASS_SCORE.get(best, 45.0)
    # a Vulkan device lifts the floor a little
    if any(g.get("vulkan") for g in gpus):
        score = min(100.0, score + 4.0)
    return round(score, 1)


def _mem_subscore(facts):
    total = facts.get("mem", {}).get("total_mb", 0) or 0
    return round(rung(float(total), MEM_ANCHORS), 1)


def _storage_subscore(facts):
    st = facts.get("storage", {}) or {}
    us = st.get("fourk_read_us")
    if us is not None:
        score = rung(float(us), DISK_US_ANCHORS)
    else:
        score = 50.0
    if st.get("rotational"):
        score = min(score, 35.0)
    bus = st.get("bus")
    if bus == "nvme":
        score = min(100.0, score + 8.0)
    elif bus == "usb":
        score = max(0.0, score - 15.0)
    return round(score, 1)


def _display_subscore(facts):
    d = facts.get("display", {}) or {}
    if not d.get("connected"):
        return 65.0   # headless: not a penalty, not a bonus
    pix = d.get("total_pixels") or (d.get("max_width", 0) * d.get("max_height", 0))
    if not pix:
        return 65.0
    return round(rung(float(pix), DISPLAY_PIX_ANCHORS), 1)


def _thermal_subscore(facts):
    t = facts.get("thermal", {}) or {}
    hr = t.get("headroom_c")
    if hr is None:
        base = 60.0
    else:
        base = rung(float(hr), THERMAL_ANCHORS)
    ac = t.get("ac_online")
    if ac is True:
        base += 8.0
    elif ac is False:
        base -= 8.0
    return round(max(0.0, min(100.0, base)), 1)


def tier_by_score(total):
    for name, thr in TIER_THRESHOLDS:
        if total >= thr:
            return name
    return "T0"


def score(facts, weights=None):
    """Pure scoring function: facts -> subscores, total, tier and caps."""
    w = dict(WEIGHTS)
    if weights:
        w.update(weights)
    subs = {
        "cpu": _cpu_subscore(facts),
        "gpu": _gpu_subscore(facts),
        "mem": _mem_subscore(facts),
        "storage": _storage_subscore(facts),
        "display": _display_subscore(facts),
        "thermal": _thermal_subscore(facts),
    }
    wsum = sum(w.values()) or 1
    total = sum(subs[k] * w[k] for k in subs) / wsum
    total = round(total, 1)
    tscore = tier_by_score(total)

    caps = []
    cal = facts.get("calibration", {}) or {}
    st = facts.get("storage", {}) or {}
    mem = facts.get("mem", {}) or {}
    gpus = facts.get("gpus", []) or []
    if any(g.get("software") for g in gpus):
        caps.append({"subsystem": "gpu", "reason": "software renderer (llvmpipe/softpipe/swrast)",
                     "tier": CAP_SOFTWARE_TIER})
    if cal.get("gpu_ms") is not None and cal.get("gpu_ms") >= SLOW_GPU_MS:
        caps.append({"subsystem": "gpu", "reason": "measured GPU %0.1f ms/frame" % cal["gpu_ms"],
                     "tier": CAP_SLOW_GPU_TIER})
    if st.get("rotational") or (st.get("fourk_read_us") is not None and st["fourk_read_us"] >= SLOW_DISK_US):
        caps.append({"subsystem": "storage",
                     "reason": "slow disk (rotational=%s, 4k=%s us)" % (bool(st.get("rotational")), st.get("fourk_read_us")),
                     "tier": CAP_SLOW_DISK_TIER})
    total_mb = mem.get("total_mb", 0) or 0
    if total_mb and total_mb < 1536:
        caps.append({"subsystem": "mem", "reason": "installed RAM %d MiB" % total_mb, "tier": CAP_TINY_MEM_TIER})
    elif total_mb and total_mb < 3072:
        caps.append({"subsystem": "mem", "reason": "installed RAM %d MiB" % total_mb, "tier": CAP_LOW_MEM_TIER})

    final = tscore
    for c in caps:
        if TIER_INDEX[c["tier"]] < TIER_INDEX[final]:
            final = c["tier"]
    return {
        "subscores": subs,
        "weights": w,
        "score": total,
        "tier_by_score": tscore,
        "caps": caps,
        "tier": final,
    }



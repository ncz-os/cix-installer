def rung(x, anchors):
    """Piecewise-linear map of x onto 0..100 through ascending (value, score) anchors."""
    if x is None:
        return None
    if x <= anchors[0][0]:
        return anchors[0][1]
    for (v0, s0), (v1, s1) in zip(anchors, anchors[1:]):
        if x <= v1:
            return s0 + (s1 - s0) * (x - v0) / (v1 - v0)
    return anchors[-1][1]


def classify_renderer(renderer):
    """Renderer string -> strong|mid|weak|software|unknown (fallback only)."""
    if not renderer:
        return "unknown"
    if SOFTWARE_RE.search(renderer):
        return "software"
    low = renderer.lower()
    for pat, cls in _GPU_RENDERER_RULES:
        if re.search(pat, low):
            return cls
    return "unknown"



def P(root, *parts):
    """Join sysroot-relative paths so `root=""` means the real filesystem.

    os.path.join("", "proc/cpuinfo") is the RELATIVE path "proc/cpuinfo", which
    silently resolves against the caller's cwd.  Every probe path goes through
    here so an empty root still yields the absolute path.
    """
    p = os.path.join(*parts).lstrip("/")
    return (root.rstrip("/") + "/" + p) if root else "/" + p


def read_text(path, default=""):
    try:
        with open(path, "r", errors="replace") as fh:
            return fh.read().strip()
    except OSError:
        return default


def read_int(path, default=0):
    try:
        return int(read_text(path).split()[0])
    except (OSError, ValueError, IndexError):
        return default


def run(cmd, timeout=20):
    """Run a command, return (rc, stdout). Never raises."""
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           timeout=timeout)
        return p.returncode, p.stdout.decode("utf-8", "replace")
    except (OSError, subprocess.SubprocessError):
        return 127, ""


def cpu_info(root=""):
    txt = read_text(P(root, "proc/cpuinfo"))
    model = ""
    m = re.search(r"^(?:model name|Model)\s*:\s*(.+)$", txt, re.M)
    if m:
        model = m.group(1).strip()
    if not model:
        m = re.search(r"^Hardware\s*:\s*(.+)$", txt, re.M)
        if m:
            model = m.group(1).strip()
    cores = 0
    for name in glob.glob(P(root, "sys/devices/system/cpu/cpu[0-9]*/topology/thread_siblings_list")):
        try:
            cores = max(cores, len(open(name).read().strip().split(",")))
        except OSError:
            pass
    # physical cores = unique core_id * package
    core_ids = set()
    for base in glob.glob(P(root, "sys/devices/system/cpu/cpu[0-9]*/topology")):
        core_ids.add((read_text(os.path.join(base, "physical_package_id")),
                      read_text(os.path.join(base, "core_id"))))
    phys = len([c for c in core_ids if c != ("", "")]) or 0
    threads = len(glob.glob(P(root, "sys/devices/system/cpu/cpu[0-9]*")))
    max_mhz = 0
    for f in ("cpufreq/cpuinfo_max_freq", "cpufreq/scaling_max_freq"):
        for p in glob.glob(P(root, "sys/devices/system/cpu/cpu[0-9]*", f)):
            max_mhz = max(max_mhz, read_int(p) // 1000)
    if not max_mhz:
        # x86: cpu MHz in cpuinfo is the current clock, not the max; use the
        # model-number table only as a coarse fallback (kept tiny on purpose).
        m = re.search(r"@\s*([0-9.]+)\s*GHz", model)
        if m:
            max_mhz = int(float(m.group(1)) * 1000)
    return {
        "model": model or "unknown",
        "cores": phys or cores or threads or 1,
        "threads": threads or 1,
        "max_mhz": max_mhz,
        "microarch": microarch(model),
        "arch": _platform.machine(),
    }


def microarch(model):
    """Coarse x86/arm microarchitecture label (informational, not weighted)."""
    m = model.lower()
    for name, pat in (
        ("sandybridge", r"i[357]-\d{4}m?\b|sandy bridge"),
        ("ivybridge", r"i[357]-\d{4}u|i[357]-\d{4}qm|ivy bridge"),
        ("haswell", r"i[357]-\d{4}(h|mq|hq)|haswell"),
        ("skylake", r"i[357]-\d{4}(u|hq|h)\b.*(6|7)\d{3}|skylake"),
        ("coffeelake", r"i[357]-\d{4}\d|coffee lake"),
        ("tigerlake", r"i[357]-1\d{3}g|tiger lake"),
        ("alderlake", r"i[357]-12\d{3}|alder lake"),
        ("raptorlake", r"i[357]-13\d{3}|raptor"),
        ("arrowlake", r"core ultra|arrow lake|arl"),
    ):
        if re.search(pat, m):
            return name
    return "unknown"


def mem_info(root=""):
    total = avail = 0
    for line in read_text(P(root, "proc/meminfo")).splitlines():
        if line.startswith("MemTotal:"):
            total = read_int_str(line)
        elif line.startswith("MemAvailable:"):
            avail = read_int_str(line)
    return {"total_mb": total, "available_mb": avail}


def read_int_str(line):
    parts = line.split()
    if len(parts) >= 2 and parts[1].isdigit():
        kb = int(parts[1])
        return kb // 1024
    return 0


def _mount_lookup(root, path):
    """Return (source_device, mountpoint) for the filesystem holding path."""
    best = ("", "/")
    rp = os.path.realpath(P(root, path.lstrip("/")))
    try:
        for line in read_text(P(root, "proc/mounts")).splitlines():
            parts = line.split()
            if len(parts) < 3:
                continue
            src, mnt = parts[0], parts[1]
            if rp == mnt or rp.startswith(mnt.rstrip("/") + "/"):
                if len(mnt) >= len(best[1]):
                    best = (src, mnt)
    except OSError:
        pass
    return best


def _sys_block_for(root, dev):
    if not dev.startswith("/dev/"):
        return None
    name = dev.split("/")[-1]
    # resolve a partition to its parent block device
    base = re.sub(r"\d+$", "", name).rstrip("p") if re.match(r"^[a-z]+\d", name) else name
    for cand in (base, name):
        if os.path.isdir(P(root, "sys/block", cand)):
            return cand
    return None


def storage_info(root="", disk_us=None):
    dev, mnt = _mount_lookup(root, "/")
    blk = _sys_block_for(root, dev)
    rotational = False
    bus = "unknown"
    if blk:
        rotational = read_text(P(root, "sys/block", blk, "queue/rotational")) == "1"
        if os.path.exists(P(root, "sys/block", blk, "device")) or True:
            rp = os.path.realpath(P(root, "sys/block", blk))
            if "/nvme" in rp:
                bus = "nvme"
            elif "usb" in rp.lower() or "usb" in os.path.realpath(P(root, "sys/block", blk, "device")).lower():
                bus = "usb"
            else:
                bus = "sata"
    return {"root_dev": dev or "unknown", "root_mount": mnt, "block": blk or "unknown",
            "rotational": rotational, "bus": bus, "fourk_read_us": disk_us}


def _drm_cards(root=""):
    cards = []
    for card in sorted(glob.glob(P(root, "sys/class/drm/card[0-9]*"))):
        name = os.path.basename(card)
        if "-" in name:
            continue
        dev = os.path.join(card, "device")
        if not os.path.isdir(dev):
            continue
        driver = ""
        try:
            driver = os.path.basename(os.path.realpath(os.path.join(dev, "driver")))
        except OSError:
            pass
        cards.append({
            "card": name,
            "vendor": read_text(os.path.join(dev, "vendor")),
            "device": read_text(os.path.join(dev, "device")),
            "driver": driver,
            "boot_vga": read_text(os.path.join(dev, "boot_vga")) == "1",
            "vram_mb": read_int(os.path.join(dev, "mem_info_vram_total")) // (1024 * 1024) or None,
        })
    return cards



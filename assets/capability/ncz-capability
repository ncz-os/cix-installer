def features_path():
    env = os.environ.get("NCZ_CAPABILITY_FEATURES")
    if env and os.path.isfile(env):
        return env
    here = os.path.dirname(os.path.realpath(__file__))
    for c in (os.path.join(here, "capability-features.tsv"),
              "/usr/share/ncz/capability/capability-features.tsv",
              "/usr/local/share/ncz/capability/capability-features.tsv"):
        if os.path.isfile(c):
            return c
    return None


def load_features(path=None):
    path = path or features_path()
    if path and os.path.isfile(path):
        try:
            with open(path) as fh:
                text = fh.read()
        except OSError:
            text = DEFAULT_FEATURES_TSV
    else:
        text = DEFAULT_FEATURES_TSV
    feats = []
    for line in text.splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        cols = line.rstrip("\n").split("\t")
        if len(cols) < 7:
            continue
        feats.append({"feature": cols[0], "kind": cols[1], "target": cols[2],
                      "values": {"T0": cols[3], "T1": cols[4], "T2": cols[5], "T3": cols[6]}})
    return feats


def features_for_tier(tier, path=None):
    """Return {feature: {kind,target,value}} for a tier.

    `tier` must be one of TIERS; an unknown tier is an error rather than a quiet
    fall back to T2 (a silent richer default would be the wrong failure mode).
    """
    if tier not in TIER_INDEX:
        raise ValueError("unknown capability tier %r" % (tier,))
    out = {}
    for f in load_features(path):
        # the TSV always carries T0..T3; if a future edit drops one, fall back
        # to the nearest LOWER tier present, never to a richer one.
        values = f["values"]
        value = values.get(tier)
        if value is None:
            lower = [t for t in TIERS if t in values and TIER_INDEX[t] < TIER_INDEX[tier]]
            if not lower:
                raise ValueError("feature %s has no value at or below tier %s"
                                 % (f["feature"], tier))
            value = values[lower[-1]]
        out[f["feature"]] = {"kind": f["kind"], "target": f["target"], "value": value}
    return out


def parse_override(path):
    """Parse a capability.override file into {tier: 'T2', overrides: {feature: value}}."""
    res = {"tier": None, "overrides": {}, "gsettings": {}, "env": {}, "flags": {}}
    if not path or not os.path.isfile(path):
        return res
    with open(path) as fh:
        for raw in fh:
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue
            if "=" not in line:
                continue
            k, v = (s.strip() for s in line.split("=", 1))
            v = v.strip().strip("'\"")
            if k.lower() == "tier":
                if v.upper() in TIER_INDEX:
                    res["tier"] = v.upper()
            elif k.startswith("feature."):
                res["overrides"][k[len("feature."):]] = v
            elif k.startswith("gsetting."):
                res["gsettings"][k[len("gsetting."):]] = v
            elif k.startswith("env."):
                res["env"][k[len("env."):]] = v
            elif k.startswith("flag."):
                res["flags"][k[len("flag."):]] = v
            else:
                res["overrides"][k] = v
    return res


def find_schema_dirs(root=""):
    dirs = []
    for c in ("/usr/share/glib-2.0/schemas", "/opt/singularity/share/glib-2.0/schemas",
              "/usr/local/share/glib-2.0/schemas"):
        p = P(root, c.lstrip("/")) if root else c
        if os.path.isdir(p):
            dirs.append(p)
    return dirs


def _gvariant(value):
    """Render a config string as the gvariant literal an override file needs."""
    if value.lower() in ("true", "false"):
        return value.lower()
    if re.match(r"^-?[0-9]+$", value):
        return value
    if re.match(r"^-?[0-9]*\.[0-9]+$", value):
        return value
    return "'%s'" % value


def build_gsettings_overrides(features, extra=None):
    """feature map -> {schema_id: "key=value\\n..."} grouped by schema."""
    byschema = {}
    for name, f in features.items():
        if f.get("kind") != "gsetting":
            continue
        schema, _, key = f["target"].partition(":")
        byschema.setdefault(schema, []).append((key, f["value"]))
    if extra:
        for target, val in extra.items():
            schema, _, key = target.partition(":")
            byschema.setdefault(schema, []).append((key, val))
    out = {}
    for schema, kvs in byschema.items():
        body = ["[%s]" % schema]
        for key, value in sorted(kvs):
            body.append("%s=%s" % (key, _gvariant(str(value))))
        out[schema] = "\n".join(body) + "\n"
    return out


def _schema_dir_for(root, schema_id):
    for d in find_schema_dirs(root):
        if glob.glob(os.path.join(d, "*.gschema.xml")):
            try:
                for f in glob.glob(os.path.join(d, "*.gschema.xml")):
                    with open(f, errors="replace") as fh:
                        if ('id="%s"' % schema_id) in fh.read():
                            return d
            except OSError:
                continue
    return None


def write_gsettings_override(root, overrides, dry_run=False, log=print):
    """Write ONE 99-ncz-capability.gschema.override per schema DIRECTORY.

    glib-compile-schemas reads every *.gschema.override in a directory, and one
    file may carry several `[schema]` sections.  Grouping by directory matters
    because dev.sinty.desktop (the Singularity payload) and dev.ncz.screensaver
    (the screensaver package) normally live in different directories, but when a
    system keeps them in the same one a per-schema write would overwrite the
    previous section.  Validated on a scratch copy with
    `glib-compile-schemas --strict --dry-run` before anything is installed,
    exactly like hooks 62/64.  Returns the list of written paths.
    """
    bydir = {}
    for schema, body in overrides.items():
        d = _schema_dir_for(root, schema)
        if not d:
            log("[capability] schema %s not installed; skipping override" % schema)
            continue
        bydir.setdefault(d, []).append((schema, body.rstrip("\n")))
    written = []
    for d, items in bydir.items():
        target = os.path.join(d, "99-ncz-capability.gschema.override")
        body = "\n".join(b for _, b in items) + "\n"
        log("[capability] %s -> %s" % (", ".join(sorted(s for s, _ in items)), target))
        if dry_run:
            written.append(target)
            continue
        compiled = False
        if root == "":
            try:
                with tempfile.TemporaryDirectory() as scratch:
                    for pat in ("*.gschema.xml", "*.enums.xml"):
                        for f in glob.glob(os.path.join(d, pat)):
                            os.symlink(f, os.path.join(scratch, os.path.basename(f)))
                    for f in glob.glob(os.path.join(d, "*.gschema.override")):
                        if os.path.basename(f) == "99-ncz-capability.gschema.override":
                            continue   # this file is being replaced; do not double up
                        os.symlink(f, os.path.join(scratch, os.path.basename(f)))
                    with open(os.path.join(scratch, "99-ncz-capability.gschema.override"), "w") as fh:
                        fh.write(body)
                    rc, out = run(["glib-compile-schemas", "--strict", "--dry-run", scratch], timeout=60)
                    if rc == 0:
                        compiled = True
                    else:
                        log("[capability] override failed validation for %s:\n%s" % (d, out[:800]))
            except OSError as e:
                log("[capability] validation error for %s: %s" % (d, e))
        else:
            compiled = True   # test root: no glib available, the test asserts the body
        if not compiled:
            log("[capability] NOT installing override in %s (validation failed)" % d)
            continue
        with open(target, "w") as fh:
            fh.write(body)
        os.chmod(target, 0o644)
        if root == "":
            run(["glib-compile-schemas", d], timeout=60)
        written.append(target)
    return written


def write_env_files(features, env_file, feature_env, dry_run=False, log=print, root=""):
    env_lines = ["# NCZ capability tier defaults (see docs/CAPABILITY-TIERS.md)",
                 "# Generated by ncz-capability; edit /etc/ncz/capability.override instead."]
    flag_lines = ["# NCZ capability feature flags (consumed by wrappers)",
                  "# Generated by ncz-capability."]
    for name, f in sorted(features.items()):
        if f.get("kind") == "env":
            env_lines.append("%s=%s" % (f["target"], f["value"]))
        elif f.get("kind") == "flag":
            flag_lines.append("%s=%s" % (f["target"], f["value"]))
    if dry_run:
        log("[capability] would write %s (%d env)" % (env_file, len(env_lines) - 2))
        log("[capability] would write %s (%d flags)" % (feature_env, len(flag_lines) - 2))
        return
    for path, lines in ((env_file, env_lines), (feature_env, flag_lines)):
        if root:
            path = os.path.join(root, path.lstrip("/"))
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as fh:
            fh.write("\n".join(lines) + "\n")
        os.replace(tmp, path)
        os.chmod(path, 0o644)
    log("[capability] wrote %s and %s" % (env_file, feature_env))


def resolve_tier(facts, scored, override=None, cli_tier=None):
    """Precedence: CLI/tier override > capability.override file > measured."""
    if cli_tier:
        return cli_tier.upper()
    if override and override.get("tier"):
        return override["tier"]
    return scored["tier"]


def _systemd_running():
    return os.path.isdir("/run/systemd/system") and bool(which("systemctl"))


def which(name):
    for d in (os.environ.get("PATH") or "/usr/sbin:/usr/bin:/sbin:/bin").split(":"):
        p = os.path.join(d, name)
        if os.access(p, os.X_OK):
            return p
    return None


# Background indexers that cost CPU/IO without being ship-critical.  Any other
# service is out of scope on purpose: this list is the whole contract.
SERVICE_ALLOWLIST = (
    "tracker-miner-fs-3.service",
    "tracker-miner-fs-4.service",
    "tracker-extract-3.service",
    "tracker-extract-4.service",
)
SERVICE_STATE = "/etc/ncz/capability/service-state"


def apply_service_defaults(indexer_mode, root="", dry_run=False, log=print):
    """Change the DEFAULT enabled-state of a tiny background-load allowlist.

    T0 off  -> disable the allowlist (systemctl enable reverses it; nothing is
               masked, so this is a default, not a hard disable).
    T1 lite -> leave enabled but drop CPUWeight/IOWeight so it yields.
    T2/T3   -> remove our drop-in and re-enable anything WE disabled.

    Only ever runs on a live systemd as root; a test root or a dry run is a
    no-op, and NCZ_CAP_SKIP_SERVICES=1 disables it entirely.
    """
    mode = (indexer_mode or "full").lower()
    if os.environ.get("NCZ_CAP_SKIP_SERVICES") == "1":
        log("[capability] service defaults disabled by NCZ_CAP_SKIP_SERVICES")
        return
    if root or dry_run:
        log("[capability] service defaults: indexer=%s (skipped under root/dry-run)" % mode)
        return
    if not _systemd_running():
        log("[capability] service defaults: systemd not running; skipped")
        return
    systemctl = which("systemctl")
    state = []
    state_path = SERVICE_STATE
    if os.path.isfile(state_path):
        with open(state_path) as fh:
            state = [l.strip() for l in fh if l.strip()]

    def run_systemctl(*args):
        try:
            subprocess.run([systemctl, *args], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=20)
        except (OSError, subprocess.SubprocessError):
            pass

    def present(unit):
        try:
            p = subprocess.run([systemctl, "list-unit-files", "--no-legend", "--plain", unit],
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=20)
        except (OSError, subprocess.SubprocessError):
            return False
        # compare the FIRST field of each row exactly: a substring test would let
        # "tracker-miner-fs-3.service" match a longer unit name.
        for line in p.stdout.decode().splitlines():
            fields = line.split()
            if fields and fields[0] == unit:
                return True
        return False

    if mode == "off":
        for unit in SERVICE_ALLOWLIST:
            if present(unit):
                run_systemctl("disable", unit)
                if unit not in state:
                    state.append(unit)
        os.makedirs(os.path.dirname(state_path), exist_ok=True)
        with open(state_path, "w") as fh:
            fh.write("\n".join(state) + "\n")
        log("[capability] service defaults: T0 disabled %d background indexer(s)" % len(state))
    elif mode == "lite":
        units = [u for u in SERVICE_ALLOWLIST if present(u)]
        for unit in units:
            d = "/etc/systemd/system/%s.d" % unit
            os.makedirs(d, exist_ok=True)
            with open(os.path.join(d, "10-ncz-capability-lite.conf"), "w") as fh:
                fh.write("[Service]\nCPUWeight=20\nIOWeight=20\n")
        run_systemctl("daemon-reload")
        log("[capability] service defaults: T1 lowered scheduling weight for %d indexer(s)" % len(units))
    else:
        # restore: remove our drop-in for every allowlist unit (present or not)
        # and re-enable only the units WE disabled.
        for unit in SERVICE_ALLOWLIST:
            d = "/etc/systemd/system/%s.d" % unit
            try:
                os.unlink(os.path.join(d, "10-ncz-capability-lite.conf"))
            except OSError:
                pass
            try:
                os.rmdir(d)   # succeeds only when we left it empty
            except OSError:
                pass
        for unit in state:
            run_systemctl("enable", unit)
        try:
            os.unlink(state_path)
        except OSError:
            pass
        run_systemctl("daemon-reload")
        log("[capability] service defaults: restored indexer defaults for %s" % mode)


def apply_defaults(facts, scored, cli_tier=None, override_path=GLOBAL_OVERRIDE,
                   json_default=DEFAULT_JSON, env_file=DEFAULT_ENV_FILE,
                   feature_env=DEFAULT_FEATURE_ENV, root="", dry_run=False, log=print):
    ov = parse_override(override_path)
    tier = resolve_tier(facts, scored, ov, cli_tier)
    features = features_for_tier(tier)
    # Apply the override file: a `feature.` entry rewrites a mapped feature; an
    # `env.`/`flag.` entry rewrites the existing target or adds a new one; a
    # `gsetting.` entry is merged into the generated override body.  Each source
    # is applied exactly once.
    for k, v in ov["overrides"].items():
        if k in features:
            features[k]["value"] = v
    by_target = {f["target"]: f for f in features.values() if f.get("kind") in ("env", "flag")}
    for name, val in ov["env"].items():
        if name in by_target:
            by_target[name]["value"] = val
        else:
            features[name] = {"kind": "env", "target": name, "value": val}
    for name, val in ov["flags"].items():
        if name in by_target:
            by_target[name]["value"] = val
        else:
            features[name] = {"kind": "flag", "target": name, "value": val}
    overrides = build_gsettings_overrides(features, extra=ov["gsettings"])
    log("[capability] tier=%s (measured %s, score %s)" % (tier, scored["tier"], scored["score"]))
    written = write_gsettings_override(root, overrides, dry_run=dry_run, log=log)
    write_env_files(features, env_file, feature_env, dry_run=dry_run, log=log, root=root)
    idx = features.get("indexer.mode", {}).get("value", "full")
    apply_service_defaults(idx, root=root, dry_run=dry_run, log=log)
    # Record what was applied so `status` can show it (only the real root; a test
    # root must not touch the host's /etc/ncz/capability.json).
    if root == "" and not dry_run and os.path.isfile(json_default):
        try:
            with open(json_default) as fh:
                doc = json.load(fh)
            doc["applied_tier"] = tier
            doc["applied_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
            tmp = json_default + ".tmp"
            with open(tmp, "w") as fh:
                json.dump(doc, fh, indent=2, sort_keys=True)
                fh.write("\n")
            os.replace(tmp, json_default)
        except (OSError, ValueError):
            pass
    return {"tier": tier, "features": features, "gsettings_files": written}


# ---------------------------------------------------------------------------
# First-boot measured saver pool (operator design 2026-10-12, step 2)
# ---------------------------------------------------------------------------
# The per-saver tier manifest ships in the ncz-screensavers package
# (/usr/share/ncz-screensavers/saver-manifest.json). This step benchmarks the
# manifest's candidates OFF-SCREEN, through the same feed path the lock-hosted
# saver uses (the hack renders into an FBO and streams frames over a
# SOCK_SEQPACKET socket; here ncz-capability plays the feed/lock side), and
# records a per-machine pool in /etc/ncz/capability.json:
#
#     "saver_pool": [{"id": "fractasia_gles3", "scale": 1.0}, ...]
#     "excluded":   [{"id": "hyprsaver_aurora_gles3", "reason": "GLES 3.2 required"}, ...]
#
# The launcher reads that pool as its DEFAULT random/playlist set and per-saver
# Auto render scale; a user setting and /etc/ncz/capability.override still win.
#
# Rules (operator): <=30 s total; only on the measured tiers T0-T2; skipped when
# the GPU is software or the host is headless; for each candidate measure ~2 s
# at native, fall to 0.5 then 0.25 if under 30 fps; keep >=30 fps with p95
# <=40 ms. Any candidate the budget or a failure does not cover falls back to
# the manifest's default_class for the detected GPU class (the safe fallback).
SAVER_BENCH_BUDGET_S = 30.0     # hard cap for the whole step
SAVER_BENCH_WINDOW_S = 2.0      # per-attempt measurement window
SAVER_BENCH_WARMUP_S = 0.5      # frames ignored before timing starts
SAVER_BENCH_MIN_S = 3.5         # budget a candidate needs (startup + window)
SAVER_BENCH_FEED_FPS = 240      # the off-screen child's frame cap
SAVER_MIN_FPS = 30.0
SAVER_MAX_P95_MS = 40.0
SAVER_SCALES = ((1.0, "native"), (0.5, "0.5"), (0.25, "0.25"))
SAVER_DEFAULT_DISPLAY = (1920, 1080)

# lock_framesrc_proto.h constants (base version; the saver side).
_LFS_MAGIC = 0x4C465331
_LFS_VERSION = 1
_LFS_TRANSPORT_SHM = 0x1
_LFS_HELLO, _LFS_FRAME, _LFS_BYE = 1, 2, 3
_LFS_WELCOME, _LFS_STOP = 0x80, 0x82
_LFS_MSG = struct.Struct("<IHHI")
_LFS_HELLO_S = struct.Struct("<III")
_LFS_WELCOME_S = struct.Struct("<III")
_LFS_OUTPUT = struct.Struct("<IIII")
_LFS_MAX_MSG = 4096

# renderer string -> manifest reference class (mirrors the launcher).
SAVER_CLASS_PATTERNS = (
    (r"hd graphics 3000|\bhd 3000\b", "hd3000"),
    (r"hd graphics 4000|\bhd 4000\b", "hd4000"),
    (r"uhd graphics 630|\buhd 630\b", "uhd630"),
    (r"mali-g720|mali g720|immortalis", "mali_g720"),
    (r"navi ?14|5500 ?m|radeon pro 5500", "navi14"),
    (r"rtx ?2060|geforce rtx 2060", "rtx2060"),
)
SAVER_CLASS_FOR_COARSE = {"weak": "uhd630", "mid": "mali_g720", "strong": "rtx2060"}


def saver_manifest_paths(root=""):
    here = os.path.dirname(os.path.realpath(__file__))
    env = os.environ.get("NCZ_SAVER_MANIFEST")
    return [p for p in [
        env,
        P(root, "usr/share/ncz-screensavers/saver-manifest.json") if root
        else "/usr/share/ncz-screensavers/saver-manifest.json",
        P(root, "usr/share/ncz-screensaver-chooser/saver-manifest.json") if root
        else "/usr/share/ncz-screensaver-chooser/saver-manifest.json",
        P(root, "usr/share/ncz/capability/saver-manifest.json") if root
        else "/usr/share/ncz/capability/saver-manifest.json",
        os.path.join(here, "saver-manifest.json"),
    ] if p]


def load_saver_manifest(root=""):
    for path in saver_manifest_paths(root):
        try:
            with open(path) as fh:
                doc = json.load(fh)
        except (OSError, ValueError):
            continue
        if isinstance(doc, dict) and isinstance(doc.get("savers"), dict):
            doc["_path"] = path
            return doc
    return {}


def saver_reference_class(renderer, coarse=None):
    text = (renderer or "").lower()
    for pat, cls in SAVER_CLASS_PATTERNS:
        if re.search(pat, text):
            return cls
    return SAVER_CLASS_FOR_COARSE.get(coarse or "", None)


def gpu_gles_version(facts, gpu=None):
    """(major, minor, raw) for the primary GPU's reported GL/ES version."""
    gpus = facts.get("gpus") or []
    gpu = gpu or next((g for g in gpus if g.get("boot_vga") or g.get("_primary")),
                      gpus[0] if gpus else None)
    raw = (gpu or {}).get("gl_version") or (facts.get("calibration") or {}).get("gpu_version")
    if not raw:
        return (0, 0, None)
    m = re.search(r"(\d+)\s*\.\s*(\d+)", str(raw))
    if not m:
        return (0, 0, raw)
    return (int(m.group(1)), int(m.group(2)), raw)


def _gles_at_least(have, need):
    def parse(v):
        try:
            parts = str(v).split(".")
            return (int(parts[0]), int(parts[1]) if len(parts) > 1 else 0)
        except (ValueError, IndexError):
            return (0, 0)
    return have >= parse(need)


def manifest_fallback_pool(doc, cls):
    """([{id,scale}], [{id,reason}]) from the manifest default_class for `cls`."""
    pool, excluded = [], []
    for hid, saver in sorted((doc.get("savers") or {}).items()):
        entry = ((saver.get("classes") or {}).get(cls)) if cls else None
        if not isinstance(entry, dict):
            excluded.append({"id": hid, "reason": "no reference class %s" % (cls or "?")})
            continue
        kind = entry.get("default_class")
        if kind == "pool":
            pool.append({"id": hid, "scale": 1.0})
        elif kind == "scaled":
            scale = entry.get("default_scale") or entry.get("min_scale_for_30fps") or 0.5
            try:
                pool.append({"id": hid, "scale": float(scale)})
            except (TypeError, ValueError):
                excluded.append({"id": hid, "reason": "no usable scale"})
        else:
            excluded.append({"id": hid,
                             "reason": entry.get("reason") or
                             ("requires GLES %s" % saver.get("min_gles", "3.0"))})
    return pool, excluded


def saver_candidates(doc, gles):
    """Candidate ids whose min_gles the GPU meets, riskiest (scaled/unknown) first."""
    out = []
    for hid, saver in (doc.get("savers") or {}).items():
        if not _gles_at_least(gles, saver.get("min_gles", "3.0")):
            continue
        out.append((hid, saver))
    # scaled or unmeasured first: confirming those changes the outcome most.
    def rank(item):
        hid, saver = item
        classes = saver.get("classes") or {}
        kinds = {c.get("default_class") for c in classes.values() if isinstance(c, dict)}
        return (0 if "scaled" in kinds else 1, hid)
    return [hid for hid, _ in sorted(out, key=rank)]


def _saver_binary_dirs(root=""):
    env = os.environ.get("NCZ_SCREENSAVER_DIRS")
    if env:
        return [d for d in env.split(":") if d]
    return [P(root, d) if root else d for d in (
        "/usr/lib/ncz-screensavers", "/usr/libexec/ncz-screensavers",
        "/opt/ncz-screensavers/bin")]


def find_saver_binary(hid, root=""):
    if not re.match(r"^[A-Za-z0-9_-]+$", hid or ""):
        return None
    for d in _saver_binary_dirs(root):
        cand = os.path.join(d, hid)
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return None


def _recv_packet(sock, maxlen=_LFS_MAX_MSG):
    """Return (data, [fds]) or None when nothing is pending; raises EOFError."""
    try:
        data, ancdata, _flags, _addr = sock.recvmsg(maxlen, socket.CMSG_SPACE(4 * 4))
    except (socket.timeout, BlockingIOError):
        return None
    except (ConnectionResetError, BrokenPipeError, OSError):
        raise EOFError from None
    if not data:
        raise EOFError
    fds = []
    for level, ctype, cdata in ancdata:
        if level == socket.SOL_SOCKET and ctype == socket.SCM_RIGHTS:
            arr = array.array("i")
            arr.frombytes(cdata[: len(cdata) - (len(cdata) % 4)])
            fds.extend(arr.tolist())
    return data, fds


def _saver_log(binary, logpath):
    try:
        with open(logpath, "rb") as fh:
            return fh.read().decode("utf-8", "replace")[-2000:]
    except OSError:
        return ""


def bench_saver_once(hid, scale, display, binary, seconds=SAVER_BENCH_WINDOW_S,
                     warmup=SAVER_BENCH_WARMUP_S, feed_fps=SAVER_BENCH_FEED_FPS,
                     root=""):
    """Run one saver off-screen at `scale` and measure fps + p95 frame time.

    Mirrors the lock feed: the hack is a child given NCZ_FEED_SOCKET; we accept
    its HELLO, send a one-output WELCOME at the scaled geometry, and time the
    FRAME messages it streams. Returns a dict with fps/p95_ms/error/frames.
    """
    bw = max(2, int(display[0] * scale))
    bh = max(2, int(display[1] * scale))
    tmp = tempfile.mkdtemp(prefix="ncz-saverbench-")
    spath = os.path.join(tmp, "bench.sock")
    logpath = os.path.join(tmp, "child.log")
    srv = None
    proc = None
    conn = None
    result = {"hack": hid, "scale": scale, "fps": None, "p95_ms": None,
              "frames": 0, "error": None, "renderer": None}
    try:
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
        srv.bind(spath)
        srv.listen(1)
        srv.settimeout(6.0)
        env = dict(os.environ)
        for k in ("WAYLAND_DISPLAY", "DISPLAY", "NCZ_ALLOW_SOFTWARE",
                  "NCZ_ALLOW_SOFTWARE_FALLBACK"):
            env.pop(k, None)
        env["HOME"] = tmp
        env["XDG_CACHE_HOME"] = os.path.join(tmp, "cache")
        env["XDG_RUNTIME_DIR"] = tmp
        env["NCZ_FEED_SOCKET"] = spath
        env["NCZ_FEED_FPS"] = str(feed_fps)
        env["NCZ_FEED_RENDER_DIV"] = "1"
        env["NCZ_RENDER_SCALE_MODE"] = "fixed"
        env["NCZ_RENDER_SCALE"] = "1.0"
        logf = open(logpath, "wb")
        try:
            proc = subprocess.Popen(
                [binary], env=env, stdin=subprocess.DEVNULL, stdout=logf,
                stderr=logf, start_new_session=True,
                preexec_fn=os.setsid if hasattr(os, "setsid") else None)
        finally:
            logf.close()
        try:
            conn, _ = srv.accept()
        except socket.timeout:
            result["error"] = "saver did not connect (no off-screen EGL?)"
            return result
        conn.settimeout(2.0)
        # HELLO
        got = None
        for _ in range(20):
            try:
                got = _recv_packet(conn)
            except EOFError:
                result["error"] = "saver closed before HELLO"
                return result
            if got:
                break
            time.sleep(0.05)
        if not got:
            result["error"] = "no HELLO from saver"
            return result
        for fd in got[1]:
            os.close(fd)
        # WELCOME (one output at the scaled geometry)
        payload = _LFS_WELCOME_S.pack(_LFS_VERSION, _LFS_TRANSPORT_SHM, 1) + \
            _LFS_OUTPUT.pack(0x5A5E5A5E, bw, bh, 120)
        conn.sendall(_LFS_MSG.pack(_LFS_MAGIC, _LFS_WELCOME, 0, len(payload)) + payload)

        stamps = []
        first = None
        deadline = time.monotonic() + seconds + warmup + 3.0
        while time.monotonic() < deadline:
            r, _, _ = select.select([conn], [], [], 0.2)
            if not r:
                if proc.poll() is not None:
                    break
                continue
            try:
                got = _recv_packet(conn)
            except EOFError:
                break
            if got is None:
                continue
            data, fds = got
            now = time.monotonic()
            for fd in fds:
                os.close(fd)
            if len(data) < _LFS_MSG.size:
                continue
            magic, mtype, _flags, _length = _LFS_MSG.unpack_from(data, 0)
            if magic != _LFS_MAGIC:
                continue
            if mtype == _LFS_FRAME:
                if first is None:
                    first = now
                if now - first >= warmup:
                    stamps.append(now)
            elif mtype == _LFS_BYE:
                break
            # (the child does not need ACKs; it never blocks on the socket)
        result["frames"] = len(stamps) + 1 if first is not None else 0
        if len(stamps) < 3:
            result["error"] = "no frame progress"
            log = _saver_log(binary, logpath)
            if "GLSL" in log or "not supported" in log:
                m = re.search(r"(GLSL[^\\n]*|not supported[^\\n]*)", log)
                result["error"] = (m.group(1) if m else "shader/GL error").strip()
            return result
        elapsed = stamps[-1] - stamps[0]
        if elapsed <= 0:
            result["error"] = "zero elapsed"
            return result
        result["fps"] = round((len(stamps) - 1) / elapsed, 1)
        gaps = sorted((b - a) * 1000.0 for a, b in zip(stamps, stamps[1:]))
        idx = min(len(gaps) - 1, int(0.95 * len(gaps)))
        result["p95_ms"] = round(gaps[idx], 1)
        for m in re.finditer(r"GL_RENDERER=([^\n]+)", _saver_log(binary, logpath)):
            result["renderer"] = m.group(1).strip()
        return result
    except OSError as e:
        result["error"] = "bench error: %s" % e
        return result
    finally:
        if conn is not None:
            try:
                conn.sendall(_LFS_MSG.pack(_LFS_MAGIC, _LFS_STOP, 0, 0))
            except OSError:
                pass
            try:
                conn.close()
            except OSError:
                pass
        if proc is not None and proc.poll() is None:
            try:
                os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
            except (OSError, ProcessLookupError):
                pass
            try:
                proc.wait(timeout=1.0)
            except Exception:
                try:
                    os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
                except (OSError, ProcessLookupError):
                    pass
        if srv is not None:
            try:
                srv.close()
            except OSError:
                pass
        try:
            os.unlink(spath)
        except OSError:
            pass


def _primary_gpu(facts):
    gpus = facts.get("gpus") or []
    return next((g for g in gpus if g.get("boot_vga") or g.get("_primary")),
                gpus[0] if gpus else None)


def _saver_bench_skip_reason(facts, scored):
    tier = (scored or {}).get("tier")
    if tier not in ("T0", "T1", "T2"):
        return "tier %s (benchmark runs on T0-T2 only)" % tier
    gpu = _primary_gpu(facts)
    if gpu is None:
        return "no GPU"
    if gpu.get("software"):
        return "software renderer"
    if not (facts.get("display") or {}).get("outputs"):
        return "headless (no connected display)"
    return None


def saver_bench(facts, scored, root="", budget=SAVER_BENCH_BUDGET_S,
                window=SAVER_BENCH_WINDOW_S, manifest=None, log=None):
    """Measure the saver pool for this machine. Returns the pool fields to record.

    Never raises: any failure falls back to the manifest's default_class for the
    detected GPU class so /etc/ncz/capability.json always carries a usable pool.
    """
    def _log(msg):
        if log:
            log("[capability] saver pool: %s" % msg)

    doc = manifest if manifest is not None else load_saver_manifest(root)
    gpu = _primary_gpu(facts)
    coarse = (gpu or {}).get("class")
    renderer = (gpu or {}).get("renderer") or (facts.get("calibration") or {}).get("gpu_renderer")
    cls = saver_reference_class(renderer, coarse)
    out = {"saver_pool": [], "excluded": [],
           "saver_pool_source": "none", "saver_pool_reference_class": cls,
           "saver_pool_measured": 0, "saver_pool_candidates": 0,
           "saver_pool_elapsed_s": 0.0}
    start = time.monotonic()

    def _fallback(reason):
        pool, excluded = manifest_fallback_pool(doc, cls) if doc.get("savers") else ([], [])
        out["saver_pool"] = pool
        out["excluded"] = excluded
        out["saver_pool_source"] = "manifest-fallback"
        out["saver_pool_skip"] = reason
        out["saver_pool_elapsed_s"] = round(time.monotonic() - start, 2)
        _log("fallback to manifest (%s): %d pool, %d excluded"
             % (reason, len(pool), len(excluded)))
        return out

    if not doc.get("savers"):
        out["saver_pool_source"] = "unavailable"
        out["saver_pool_skip"] = "no saver manifest"
        out["saver_pool_elapsed_s"] = round(time.monotonic() - start, 2)
        return out
    skip = _saver_bench_skip_reason(facts, scored)
    if skip:
        return _fallback(skip)

    major, minor, _raw = gpu_gles_version(facts, gpu)
    gles = (major, minor)
    display = ((facts.get("display") or {}).get("max_width"),
               (facts.get("display") or {}).get("max_height"))
    if not display[0] or not display[1]:
        display = SAVER_DEFAULT_DISPLAY
    candidates = [h for h in saver_candidates(doc, gles)
                  if find_saver_binary(h, root)]
    out["saver_pool_candidates"] = len(candidates)
    if not candidates:
        return _fallback("no installed candidates for GLES %d.%d" % gles)
    _log("%d candidate(s) for GLES %d.%d on %s (>=%gfps, budget %gs)"
         % (len(candidates), major, minor, cls or coarse or "?", SAVER_MIN_FPS, budget))

    pool, excluded = [], []
    measured = 0
    for hid in candidates:
        remaining = budget - (time.monotonic() - start)
        if remaining < SAVER_BENCH_MIN_S:
            # out of budget: the manifest default_class is the safe fallback
            entry = ((doc["savers"][hid].get("classes") or {}).get(cls)) or {}
            kind = entry.get("default_class")
            if kind == "pool":
                pool.append({"id": hid, "scale": 1.0})
            elif kind == "scaled":
                pool.append({"id": hid, "scale": float(
                    entry.get("default_scale") or entry.get("min_scale_for_30fps") or 0.5)})
            else:
                excluded.append({"id": hid,
                                 "reason": "unmeasured (budget); manifest: %s" % (kind or "?")})
            continue
        binary = find_saver_binary(hid, root)
        chosen = None
        last_error = None
        for scale, label in SAVER_SCALES:
            if budget - (time.monotonic() - start) < SAVER_BENCH_MIN_S:
                break
            res = bench_saver_once(hid, scale, display, binary, seconds=window, root=root)
            if res.get("error"):
                last_error = res["error"]
                break
            if res["fps"] is not None and res["fps"] >= SAVER_MIN_FPS and \
                    (res["p95_ms"] is None or res["p95_ms"] <= SAVER_MAX_P95_MS):
                chosen = scale
                break
            last_error = "%s fps at %s" % (res.get("fps"), label)
        if chosen is not None:
            pool.append({"id": hid, "scale": chosen})
            measured += 1
            _log("%s -> pool scale %g" % (hid, chosen))
        else:
            excluded.append({"id": hid,
                             "reason": "measured unhealthy (%s)" % (last_error or "no result")})
    out["saver_pool"] = pool
    out["excluded"] = excluded
    out["saver_pool_source"] = "measured"
    out["saver_pool_measured"] = measured
    out["saver_pool_elapsed_s"] = round(time.monotonic() - start, 2)
    _log("measured %d candidate(s), %d pooled, %d excluded in %.2fs"
         % (measured, len(pool), len(excluded), out["saver_pool_elapsed_s"]))
    return out



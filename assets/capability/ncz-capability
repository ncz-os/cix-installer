def human_summary(doc):
    f = doc.get("facts", {})
    s = doc.get("scoring", {})
    cal = f.get("calibration", {})
    lines = []
    lines.append("NCZ capability profile: %s" % doc.get("hostname", "?"))
    lines.append("  platform : %s %s  (%s)" % (f.get("platform", {}).get("arch", "?"),
                                                f.get("cpu", {}).get("model", "?"),
                                                f.get("platform", {}).get("dmi_product", "")))
    lines.append("  cpu      : %s cores / %s threads @ %s MHz (%s)"
                 % (f.get("cpu", {}).get("cores"), f.get("cpu", {}).get("threads"),
                    f.get("cpu", {}).get("max_mhz"), f.get("cpu", {}).get("microarch")))
    if cal.get("cpu_single_mibs"):
        lines.append("  cpu bench: %s MiB/s single, %s MiB/s multi"
                     % (cal.get("cpu_single_mibs"), cal.get("cpu_multi_mibs")))
    lines.append("  memory   : %s MiB" % f.get("mem", {}).get("total_mb"))
    st = f.get("storage", {})
    lines.append("  storage  : %s (%s, rotational=%s, 4k=%s us)"
                 % (st.get("root_dev"), st.get("bus"), st.get("rotational"), st.get("fourk_read_us")))
    for g in f.get("gpus", []):
        lines.append("  gpu      : %s %s/%s driver=%s class=%s%s"
                     % (g.get("card"), g.get("vendor"), g.get("device"), g.get("driver"),
                        g.get("class"), " SOFTWARE" if g.get("software") else ""))
    if cal.get("gpu_ms") is not None:
        lines.append("  gpu bench: %s ms/frame (%s)" % (cal.get("gpu_ms"), cal.get("gpu_renderer")))
    elif cal.get("gpu_error"):
        lines.append("  gpu bench: unavailable (%s)" % cal.get("gpu_error"))
    d = f.get("display", {})
    lines.append("  display  : %d output(s) %dx%d (%d px)"
                 % (d.get("outputs", 0), d.get("max_width", 0), d.get("max_height", 0), d.get("total_pixels", 0)))
    sub = s.get("subscores", {})
    lines.append("  subscores: cpu=%.1f gpu=%.1f mem=%.1f storage=%.1f display=%.1f thermal=%.1f"
                 % (sub.get("cpu", 0), sub.get("gpu", 0), sub.get("mem", 0),
                    sub.get("storage", 0), sub.get("display", 0), sub.get("thermal", 0)))
    lines.append("  score    : %.1f -> %s" % (s.get("score", 0), s.get("tier_by_score", "?")))
    for c in s.get("caps", []):
        lines.append("  cap      : %s -> %s (%s)" % (c["subsystem"], c["tier"], c["reason"]))
    lines.append("  TIER     : %s" % s.get("tier", "?"))
    if doc.get("saver_pool") is not None or doc.get("excluded") is not None:
        lines.append("  saverpool: %s %d pooled, %d excluded (class %s, %.2fs)"
                     % (doc.get("saver_pool_source", "?"),
                        len(doc.get("saver_pool") or []),
                        len(doc.get("excluded") or []),
                        doc.get("saver_pool_reference_class", "?"),
                        doc.get("saver_pool_elapsed_s", 0.0) or 0.0))
    return "\n".join(lines)


def compute_signature(facts):
    gpus = sorted((g.get("card", ""), g.get("vendor", ""), g.get("device", ""), g.get("driver", ""))
                  for g in facts.get("gpus", []))
    key = json.dumps({
        "gpus": gpus,
        "mem_mb": facts.get("mem", {}).get("total_mb"),
        "disk": facts.get("storage", {}).get("block"),
        "display": facts.get("display", {}).get("connectors"),
        "cpu": facts.get("cpu", {}).get("model"),
    }, sort_keys=True)
    return hashlib.sha256(key.encode()).hexdigest()[:16]


def build_doc(facts, args, run_saver_bench=False):
    scored = score(facts)
    doc = {
        "version": VERSION,
        "generated": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "hostname": facts.get("platform", {}).get("hostname", "?"),
        "facts": facts,
        "scoring": scored,
        "signature": compute_signature(facts),
    }
    if run_saver_bench:
        # The measured pool is recorded in the profile the launcher reads; it is
        # also written to the host file by cmd_probe (the doc is that file).
        doc.update(saver_bench(facts, scored, root=getattr(args, "root", ""),
                               log=None))
    return doc


def cmd_probe(args):
    facts = collect_facts(root=args.root, calibrate=not args.no_calibrate)
    doc = build_doc(facts, args, run_saver_bench=not getattr(args, "no_saver_bench", False))
    out = args.out
    if out:
        os.makedirs(os.path.dirname(out), exist_ok=True)
        tmp = out + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(doc, fh, indent=2, sort_keys=True)
            fh.write("\n")
        os.replace(tmp, out)
    if args.json:
        print(json.dumps(doc, indent=2, sort_keys=True))
    else:
        print(human_summary(doc))
        if out:
            print("  written  : %s" % out)
    return 0


def cmd_score(args):
    with open(args.facts) as fh:
        facts = json.load(fh)
    if "facts" in facts:
        facts = facts["facts"]
    doc = build_doc(facts, args)
    if args.json:
        print(json.dumps(doc["scoring"], indent=2, sort_keys=True))
    else:
        print(human_summary(doc))
    return 0


def cmd_check(args):
    """Validate that the tier's GSettings override compiles against the REAL
    installed schemas -- without changing anything.  The point of this mode is a
    safe dry validation on a live host (a bad override would break every schema):
    it builds the body, drops it next to scratch symlinks of each schema dir and
    runs `glib-compile-schemas --strict --dry-run`.
    """
    facts = _facts_from_json(DEFAULT_JSON) if not args.root else None
    if facts is None:
        facts = collect_facts(root=args.root, calibrate=False)
    scored = score(facts)
    ov = parse_override(args.override)
    tier = resolve_tier(facts, scored, ov, args.tier)
    feats = features_for_tier(tier)
    overrides = build_gsettings_overrides(feats)
    if not which("glib-compile-schemas"):
        print("check: glib-compile-schemas not installed; cannot validate")
        return 2
    rc_all = 0
    checked = 0
    dirs = set()
    for s in overrides:
        d = _schema_dir_for(args.root, s)
        if d:
            dirs.add(d)
    for d in sorted(dirs):
        present = sorted(s for s in overrides if _schema_dir_for(args.root, s) == d)
        body = "\n".join(overrides[s].rstrip("\n") for s in present) + "\n"
        rc, out = 1, ""
        try:
            with tempfile.TemporaryDirectory() as scratch:
                for pat in ("*.gschema.xml", "*.enums.xml", "*.gschema.override"):
                    for f in glob.glob(os.path.join(d, pat)):
                        if os.path.basename(f) == "99-ncz-capability.gschema.override":
                            continue
                        os.symlink(f, os.path.join(scratch, os.path.basename(f)))
                with open(os.path.join(scratch, "99-ncz-capability.gschema.override"), "w") as fh:
                    fh.write(body)
                rc, out = run(["glib-compile-schemas", "--strict", "--dry-run", scratch], timeout=60)
        except OSError as e:
            print("check: %s: %s" % (d, e))
            rc_all = 1
            continue
        checked += 1
        print("%s %s [%s] tier=%s" % ("PASS" if rc == 0 else "FAIL", d, ", ".join(present), tier))
        if rc != 0:
            rc_all = 1
            print(out[:800])
    if not checked:
        print("check: no installed schema dirs for the tier's keys (nothing to validate)")
    return rc_all


def _facts_from_json(path):
    try:
        with open(path) as fh:
            doc = json.load(fh)
    except (OSError, ValueError):
        return None
    if isinstance(doc, dict) and "facts" in doc:
        return doc["facts"]
    if isinstance(doc, dict) and "cpu" in doc:
        return doc
    return None


def cmd_apply(args):
    # Reuse the recorded profile when it exists (the first-boot service runs
    # probe then apply, and re-applying must not re-run the calibration); only
    # measure when there is nothing recorded or --facts points nowhere.
    facts = None
    if args.facts:
        facts = _facts_from_json(args.facts)
        if facts is None:
            print("apply: cannot read facts from %s" % args.facts, file=sys.stderr)
            return 2
    else:
        # only consult the host's recorded profile on the real root; a test root
        # must not pick up the developer machine's /etc/ncz/capability.json
        facts = _facts_from_json(DEFAULT_JSON) if not args.root else None
    if facts is None:
        facts = collect_facts(root=args.root, calibrate=not args.no_calibrate)
    doc = build_doc(facts, args)
    result = apply_defaults(facts, doc["scoring"], cli_tier=args.tier,
                            override_path=args.override, root=args.root,
                            dry_run=args.dry_run)
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    return 0


def cmd_status(args):
    if os.path.isfile(args.json_path):
        with open(args.json_path) as fh:
            doc = json.load(fh)
        print(human_summary(doc))
        print("  applied  : tier %s" % doc.get("applied_tier", "?"))
    else:
        print("no capability profile at %s (run: ncz-capability probe)" % args.json_path)
        return 1
    return 0


def cmd_detect(args):
    """Re-run the probe only when the hardware signature changed."""
    if not os.path.isfile(args.json_path):
        print("no profile; probing")
        args.out = args.json_path
        return cmd_probe(args)
    with open(args.json_path) as fh:
        old = json.load(fh)
    facts = collect_facts(root=args.root, calibrate=True)
    new_sig = compute_signature(facts)
    old_sig = old.get("signature")
    if new_sig == old_sig:
        print("hardware signature unchanged (%s); no re-run" % new_sig)
        return 0
    print("hardware signature changed: %s -> %s; re-probing" % (old_sig, new_sig))
    args.out = args.json_path
    rc = cmd_probe(args)
    if rc == 0 and not args.no_apply:
        facts2 = _facts_from_json(args.json_path) or facts
        doc = build_doc(facts2, args)
        apply_defaults(facts2, doc["scoring"], override_path=args.override, root=args.root)
    return rc


def cmd_saver_pool(args):
    """Print the recorded per-machine saver pool, or measure one now.

    `--measure` runs the same benchmark the first-boot service runs, without
    writing /etc/ncz/capability.json (a dry inspection; use `probe` to record).
    """
    if args.measure:
        facts = collect_facts(root=args.root, calibrate=not args.no_calibrate)
        scored = score(facts)
        res = saver_bench(facts, scored, root=args.root, budget=args.budget)
        print(json.dumps(res, indent=2, sort_keys=True))
        return 0
    doc = {}
    for path in ([args.json_path] if not args.root else
                 [P(args.root, args.json_path.lstrip("/"))]):
        try:
            with open(path) as fh:
                doc = json.load(fh)
            break
        except (OSError, ValueError):
            doc = {}
    pool = doc.get("saver_pool") or []
    out = {
        "reference_class": doc.get("saver_pool_reference_class"),
        "source": doc.get("saver_pool_source"),
        "measured": doc.get("saver_pool_measured"),
        "candidates": doc.get("saver_pool_candidates"),
        "elapsed_s": doc.get("saver_pool_elapsed_s"),
        "pool": pool,
        "excluded": doc.get("excluded") or [],
    }
    if args.json:
        print(json.dumps(out, indent=2, sort_keys=True))
    elif not pool and not out["excluded"]:
        print("no saver pool recorded (run: ncz-capability probe)")
        return 1
    else:
        print("saver pool [%s] class=%s: %d pooled, %d excluded in %ss"
              % (out["source"], out["reference_class"], len(pool),
                 len(out["excluded"]), out["elapsed_s"]))
        for row in pool:
            print("  %-40s scale %s" % (row.get("id"), row.get("scale")))
        for row in out["excluded"]:
            print("  out: %-36s %s" % (row.get("id"), row.get("reason")))
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="ncz-capability",
                                description="NCZ-OS hardware capability profiler and tier default selector")
    p.add_argument("--version", action="version", version="ncz-capability %d" % VERSION)
    sub = p.add_subparsers(dest="cmd", required=True)

    def common(sp):
        sp.add_argument("--root", default="", help="sysroot prefix (test seam)")
        sp.add_argument("--json", action="store_true", help="machine-readable output")

    sp = sub.add_parser("probe", help="collect facts, calibrate and write capability.json")
    common(sp)
    sp.add_argument("--out", default=DEFAULT_JSON)
    sp.add_argument("--no-calibrate", action="store_true")
    sp.add_argument("--no-saver-bench", action="store_true",
                    help="skip the first-boot measured saver pool step")
    sp.set_defaults(fn=cmd_probe)

    sp = sub.add_parser("score", help="score an existing facts json (pure, no hardware)")
    sp.add_argument("facts")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(fn=cmd_score)

    sp = sub.add_parser("apply", help="write the tier's default settings")
    common(sp)
    sp.add_argument("--tier", default=None, choices=list(TIERS) + [t.lower() for t in TIERS])
    sp.add_argument("--override", default=GLOBAL_OVERRIDE)
    sp.add_argument("--facts", default=None, help="facts JSON to use (default: %s if present)" % DEFAULT_JSON)
    sp.add_argument("--dry-run", action="store_true")
    sp.add_argument("--no-calibrate", action="store_true")
    sp.set_defaults(fn=cmd_apply)

    sp = sub.add_parser("status", help="show the recorded profile")
    sp.add_argument("--json-path", default=DEFAULT_JSON)
    sp.set_defaults(fn=cmd_status)

    sp = sub.add_parser("check", help="validate the tier override against the installed schemas (no writes)")
    common(sp)
    sp.add_argument("--tier", default=None, choices=list(TIERS) + [t.lower() for t in TIERS])
    sp.add_argument("--override", default=GLOBAL_OVERRIDE)
    sp.set_defaults(fn=cmd_check)

    sp = sub.add_parser("detect", help="re-probe only if the hardware changed, then apply")
    common(sp)
    sp.add_argument("--json-path", default=DEFAULT_JSON)
    sp.add_argument("--override", default=GLOBAL_OVERRIDE)
    sp.add_argument("--no-apply", action="store_true")
    sp.add_argument("--no-calibrate", action="store_true")
    sp.add_argument("--no-saver-bench", action="store_true")
    sp.set_defaults(fn=cmd_detect)

    sp = sub.add_parser("saver-pool",
                        help="show (or measure) the per-machine saver pool")
    common(sp)
    sp.add_argument("--measure", action="store_true",
                    help="run the benchmark now instead of printing the recorded pool")
    sp.add_argument("--budget", type=float, default=SAVER_BENCH_BUDGET_S)
    sp.add_argument("--json-path", default=DEFAULT_JSON)
    sp.add_argument("--no-calibrate", action="store_true")
    sp.set_defaults(fn=cmd_saver_pool)

    args = p.parse_args(argv)
    if getattr(args, "tier", None):
        args.tier = args.tier.upper()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())

[Unit]
Description=openclaw agent (upstream NemoClaw OSS)
Documentation=https://github.com/openclaw/openclaw
Requires=nclawzero-load-agent-images.service
Wants=network-online.target
After=network-online.target nclawzero-load-agent-images.service

[Container]
Image=ghcr.io/openclaw/openclaw@sha256:06b4f3dfa3c88d49c92e99d635dc62053d4afd045d6220e811dff6190040f3de
# Image pinned to immutable digest (arm64 manifest verified 2026-07). To roll
# forward, resolve a newer sha256 via `crane digest
# ghcr.io/openclaw/openclaw:main` and update here. AutoUpdate=registry
# intentionally OMITTED to prevent unreviewed upstream changes from running
# with API keys.
ContainerName=openclaw
Pull=never
EnvironmentFile=/etc/nclawzero/agent-env
Volume=openclaw-data:/openclaw-data:Z
Volume=/var/lib/nclawzero/openclaw-home:/home/node/.openclaw:Z
# HOST networking (NOT PublishPort). The Cix Sky1 kernel has no veth/bridge
# (CONFIG_VETH off) so any PublishPort= fails on metal with
# "create veth pair: Operation not supported" (status=126, verified .66 2026-07).
# openclaw.json sets gateway.bind=lan; with Network=host it binds directly on
# the host's :18789. Real fix = CONFIG_VETH in a future kernel; this is the
# workaround.
Network=host

[Service]
TimeoutStartSec=600
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target default.target

[Unit]
Description=MNEMOS — memory operating system for agentic AI
Documentation=https://github.com/ncz-os/mnemos
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/ncz-os/mnemos:latest
# Loaded on demand by `ncz install mnemos` — OFFLINE from the ISO-bundled OCI
# archive (assets/agent-images/mnemos.oci.tar via `podman load`), or a ghcr
# pull only if no bundled image is present. Pull=never so systemd never reaches
# for the network. (`ncz install mnemos` rewrites this line if MNEMOS_IMAGE is
# overridden when the active quadlet is staged.)
ContainerName=mnemos
Pull=never
Volume=mnemos-data:/data:Z
# HOST networking (NOT PublishPort). The Cix Sky1 kernel does not build
# veth/bridge support, so netavark's default bridge — and therefore podman
# PublishPort=5002:5002 — fails on metal with
# "netavark: create veth pair: Operation not supported (os error 95)"
# (verified on MS-R1 .66, 2026-07). Host networking binds uvicorn directly on
# the host's :5002 and is the correct model for a single-port appliance server.
Network=host
# Stock image embeds in-process on CPU (nomic-embed-text-v1.5 Q8, 768-dim) —
# no GPU/NPU packages needed. Persistence is sqlite on the mnemos-data volume
# so memories survive container + host restarts.
Environment=MNEMOS_PERSISTENCE_BACKEND=sqlite
Environment=MNEMOS_DATABASE_DSN=sqlite:////data/mnemos.db
Environment=MNEMOS_SQLITE_PATH=/data/mnemos.db

[Service]
TimeoutStartSec=900
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target default.target

#!/usr/bin/python3
"""Desktop-session update watcher using Singularity's notification daemon."""

import json
import os
import pathlib
import subprocess
import time

CHECKER = "/usr/bin/ncz-update-check"
MANAGER = "/usr/bin/ncz-update-manager"
INTERVAL = 6 * 60 * 60


def check():
    result = subprocess.run([CHECKER], text=True, capture_output=True, check=True)
    return json.loads(result.stdout)


def notify(payload):
    count = int(payload["count"])
    if count == 0:
        return
    groups = payload.get("groups", {})
    ncz, debian = int(groups.get("ncz-os", 0)), int(groups.get("debian", 0))
    other = count - ncz - debian
    pieces = []
    if ncz:
        pieces.append(f"{ncz} NCZ-OS")
    if debian:
        pieces.append(f"{debian} Debian")
    if other > 0:
        pieces.append(f"{other} third-party")
    summary = " + ".join(pieces) + f" update{'s' if count != 1 else ''} available" if pieces else f"{count} updates available"
    body = "A Singularity Desktop update is included." if payload["desktop_update"] else "Open Update Manager to review and install them."
    command = [
        "notify-send", "--app-name=NCZ-OS Updates", "--icon=system-software-update",
        "--urgency=normal", "--action=open=Open Update Manager", summary, body,
    ]
    result = subprocess.run(command, text=True, capture_output=True, check=False)
    if result.stdout.strip() == "open":
        subprocess.Popen([MANAGER], start_new_session=True)


def main():
    state_dir = pathlib.Path(os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state")) / "ncz-update-manager"
    state_dir.mkdir(parents=True, exist_ok=True)
    state_file = state_dir / "last-notified"
    time.sleep(90)  # Let networking and the notification daemon settle at login.
    while True:
        try:
            payload = check()
            fingerprint = "\n".join(f'{item["package"]}={item["candidate"]}' for item in payload["updates"])
            previous = state_file.read_text() if state_file.exists() else ""
            if fingerprint and fingerprint != previous:
                notify(payload)
                state_file.write_text(fingerprint)
            elif not fingerprint and state_file.exists():
                state_file.unlink()
        except (OSError, ValueError, subprocess.SubprocessError):
            pass
        time.sleep(INTERVAL)


if __name__ == "__main__":
    main()

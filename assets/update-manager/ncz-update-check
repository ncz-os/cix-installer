#!/usr/bin/python3
"""Report upgrades from the machine's currently configured APT sources, each
labelled with WHO supplies it: the NCZ-OS repo, Debian, or a third party.

The label comes from the candidate's apt origin, never from the package name:
  ncz-os       the source host is an NCZ-OS repo host, or its Release says
               Origin: NCZ-OS (Buildkite Packages cannot carry that Origin, so
               the hosts are listed; see post-install/lib/apt-separation.sh)
  debian       the source's Release says Origin: Debian
  third-party  anything else (Google Chrome, the T2 repo, ...)
Extra NCZ hosts can be added, one per line, in /etc/ncz-os/update-origins.conf
(`ncz-os <host>`), without touching this file.
"""

import json
import re
import subprocess
import sys

DESKTOP_PACKAGE = "ncz-singularity-desktop"
NCZ_HOSTS = {"packages.buildkite.com", "pub-d7b784e01679403d9c70fcd23fff5b96.r2.dev"}
NCZ_RELEASE_ORIGIN = "NCZ-OS"
ORIGINS_CONF = "/etc/ncz-os/update-origins.conf"
GROUPS = ("ncz-os", "debian", "third-party")
LINE_RE = re.compile(
    r"^(?P<package>[^/]+)/(?P<suite>\S+)\s+(?P<candidate>\S+)\s+\S+\s+"
    r"\[upgradable from: (?P<installed>[^\]]+)\]$"
)
ENV = {"LC_ALL": "C.UTF-8", "PATH": "/usr/sbin:/usr/bin:/sbin:/bin"}


def run_apt(*args):
    proc = subprocess.run(
        list(args),
        text=True,
        capture_output=True,
        check=False,
        env=ENV,
    )
    if proc.returncode:
        raise RuntimeError(proc.stderr.strip() or f"{args[0]} exited {proc.returncode}")
    return proc.stdout


def source_key(url):
    """Identity of a source for classification: the host of a network source,
    the PATH of a file: source (each local repo has its own Release Origin)."""
    if url.startswith("file:"):
        return "file:" + re.sub(r"^file:/*", "/", url)
    return re.sub(r"^\S+://", "", url).split("/", 1)[0].split(":", 1)[0]


def extra_ncz_hosts(path=ORIGINS_CONF):
    hosts = set()
    try:
        with open(path, encoding="utf-8") as handle:
            for raw in handle:
                parts = raw.split("#", 1)[0].split()
                if len(parts) == 2 and parts[0] == "ncz-os":
                    hosts.add(parts[1])
    except OSError:
        pass
    return hosts


def parse_source_origins(policy_text):
    """source key -> set of Release Origin values, from a bare `apt-cache policy`."""
    origins = {}
    key = None
    for line in policy_text.splitlines():
        match = re.match(r"^\s+-?\d+ (\S+:\S*)", line)
        if match:
            key = source_key(match.group(1))
            origins.setdefault(key, set())
            continue
        text = line.strip()
        if key and text.startswith("release "):
            for field in text[len("release ") :].split(","):
                if field.startswith("o="):
                    origins[key].add(field[2:])
        elif key and not text.startswith("origin ") and not line.startswith("     "):
            key = None
    return origins


def classify_host(host, origins, ncz_hosts):
    labels = origins.get(host, set())
    if host in ncz_hosts or NCZ_RELEASE_ORIGIN in labels:
        return "ncz-os"
    if any(label == "Debian" or label.startswith("Debian ") for label in labels):
        return "debian"
    return "third-party"


def parse_candidate_hosts(policy_text):
    """package -> list of source keys serving its Candidate version.

    A foreign-architecture heading ("libfoo:armhf:") is also filed under the
    bare name, because `apt list` prints the name without the architecture."""
    result = {}
    package = candidate = None
    in_candidate = False
    for line in policy_text.splitlines():
        head = re.match(r"^(\S+):$", line)
        if head:
            package, candidate, in_candidate = head.group(1), None, False
            result.setdefault(package, [])
            if ":" in package:
                result[package.split(":", 1)[0]] = result[package]
            continue
        if package is None:
            continue
        cand = re.match(r"^\s+Candidate: (\S+)", line)
        if cand:
            candidate = cand.group(1)
            continue
        ver = re.match(r"^(?: \*\*\* |     )(\S+) (-?\d+)\s*$", line)
        if ver:
            in_candidate = ver.group(1) == candidate
            continue
        src = re.match(r"^\s{8}-?\d+ (\S+:\S*)", line)
        if src and in_candidate:
            result[package].append(source_key(src.group(1)))
    return result


def group_for(hosts, origins, ncz_hosts):
    groups = {classify_host(host, origins, ncz_hosts) for host in hosts}
    for name in GROUPS:  # NCZ wins a tie, then Debian
        if name in groups:
            return name
    return "third-party"


def collect():
    listing = run_apt("apt", "list", "--upgradable")
    parsed = []
    for line in listing.splitlines():
        match = LINE_RE.match(line.strip())
        if match:
            parsed.append(match.groupdict())
    ncz_hosts = NCZ_HOSTS | extra_ncz_hosts()
    origins, cand_hosts = {}, {}
    if parsed:
        origins = parse_source_origins(run_apt("apt-cache", "policy"))
        cand_hosts = parse_candidate_hosts(
            run_apt("apt-cache", "policy", *[item["package"] for item in parsed])
        )
    updates = []
    for item in parsed:
        item["desktop"] = item["package"] == DESKTOP_PACKAGE
        item["group"] = group_for(
            cand_hosts.get(item["package"], []), origins, ncz_hosts
        )
        # apt keys a version by (string, metadata hash): a rebuild that kept the
        # version string shows as "1.0 -> 1.0". Flag it so the UI says why.
        item["same_version"] = item["installed"] == item["candidate"]
        updates.append(item)
    updates.sort(
        key=lambda it: (
            GROUPS.index(it["group"]),
            not bool(it["desktop"]),
            str(it["package"]),
        )
    )
    return updates


def main() -> int:
    try:
        updates = collect()
    except (OSError, RuntimeError) as error:
        print(json.dumps({"error": str(error), "updates": []}))
        return 1
    counts = {
        name: sum(1 for item in updates if item["group"] == name) for name in GROUPS
    }
    print(
        json.dumps(
            {
                "count": len(updates),
                "desktop_update": any(item["desktop"] for item in updates),
                "groups": counts,
                "updates": updates,
            }
        )
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/bin/bash
# ncz-cuda-setup -- install the NVIDIA driver + CUDA toolkit chosen for this
# machine, from NVIDIA's apt repo, when the network is available.
#
#   ncz-cuda-setup run [--scheduled]   do the install (idempotent)
#   ncz-cuda-setup retry               clear the backoff and run now
#   ncz-cuda-setup status              selection, state, attempts, last log
#
# Called once by post-install/54-gpu-accel.sh at install time; when that cannot
# finish (no network yet, download failed) ncz-cuda-setup.timer retries it after
# every boot with exponential backoff until the stamp file exists. It never
# blocks login: the timer fires 2 minutes after boot and the service is not part
# of the boot transaction.
#
# Exit codes (systemd SuccessExitStatus=75 so a not-yet case is not "failed"):
#   0   done (installed), skipped by design, or nothing to do / not due yet
#   75  EX_TEMPFAIL: network or download problem, will retry
#   1   hard failure (would remove packages, not installable, no nvcc): retried
#       a few times, then parked as failed until `ncz-cuda-setup retry`
#
# A driver install that fails because the NVIDIA DKMS module does not compile
# (status failed:dkms-build) logs the first compiler error from DKMS's make.log
# and is NOT retried by the timer while the inputs are the same: running
# kernel, kernel config (autoconf.h), driver version apt would install, and
# the NCZ DKMS patches staged for it. Rebuilding identical inputs fails
# identically and costs minutes of CPU per attempt. Any change (new kernel
# booted, new driver point release, new patch) triggers the next attempt.
#
# Local DKMS patches: for each $NV_DKMS_PATCHES/<module>-<version>/ directory
# shipped by the installer, the patches are staged into
# /usr/src/<module>-<version>/patches/ and listed in
# /etc/dkms/<module>-<version>.conf BEFORE apt runs the package postinst, so
# DKMS applies them on every build of exactly that driver version (and on any
# later rebuild, e.g. for a new kernel). Other versions are never touched.
set -u
export LC_ALL=C DEBIAN_FRONTEND=noninteractive

CONF=/etc/ncz/cuda-selection.conf
STATE=/var/lib/ncz
STAMP=$STATE/cuda-setup.done
ATTEMPTS=$STATE/cuda-setup.attempts     # "<count> <next-allowed-epoch>"
STATUS=$STATE/cuda-toolkit.status       # installed:<ver> | skipped:<why> | failed:<why>
LOG=/var/log/ncz-cuda-setup.log
LOCK=/run/ncz-cuda-setup.lock
HOST=developer.download.nvidia.com
MAX_HARD_FAILS=5
DKMS_FAIL=$STATE/cuda-setup.dkms-failed  # key line, pkg/module line, first compiler error
NV_DKMS_PATCHES=${NCZ_NV_DKMS_PATCHES:-/usr/local/lib/ncz/nvidia-dkms}
DKMS_ETC=${NCZ_DKMS_ETC:-/etc/dkms}
DKMS_TREE=${NCZ_DKMS_TREE:-/var/lib/dkms}
SRC_ROOT=${NCZ_SRC_ROOT:-/usr/src}
MODULES_ROOT=${NCZ_MODULES_ROOT:-/lib/modules}
mkdir -p "$STATE" /etc/ncz 2>/dev/null

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$LOG" >&2; }
set_status() { echo "$1" > "$STATUS"; log "status: $1"; }

conf() { # conf KEY
    sed -n "s/^$1=//p" "$CONF" 2>/dev/null | head -n1 | sed -e "s/^'//" -e "s/'\$//"
}

cmd_status() {
    echo "ncz-cuda-setup status"
    if [ -r "$CONF" ]; then
        echo "-- $CONF"; sed 's/^/   /' "$CONF"
    else
        echo "-- no $CONF (no NVIDIA GPU was selected at install time)"
    fi
    echo "-- state"
    echo "   result:   $(cat "$STATUS" 2>/dev/null || echo 'not recorded')"
    echo "   stamp:    $([ -e "$STAMP" ] && echo "done ($(cat "$STAMP" 2>/dev/null))" || echo 'not done')"
    if [ -r "$ATTEMPTS" ]; then
        read -r n next < "$ATTEMPTS"
        echo "   attempts: $n, next scheduled attempt not before $(date -u -d "@${next:-0}" +%FT%TZ 2>/dev/null)"
    fi
    if [ -r "$DKMS_FAIL" ]; then
        echo "   dkms:     build failed for $(sed -n 1p "$DKMS_FAIL" | cut -d'|' -f1-3 | tr '|' ' ')"
        echo "             $(sed -n 3p "$DKMS_FAIL")"
        echo "             retried automatically when the kernel, its config, the driver or the local patches change"
    fi
    local t_en t_act
    t_en=$(systemctl is-enabled ncz-cuda-setup.timer 2>/dev/null); t_en=${t_en:-unknown}
    t_act=$(systemctl is-active ncz-cuda-setup.timer 2>/dev/null); t_act=${t_act:-unknown}
    echo "   timer:    $t_en / $t_act"
    if [ -x "$(conf TOOLKIT_DIR 2>/dev/null)/bin/nvcc" ]; then
        echo "   nvcc:     $("$(conf TOOLKIT_DIR)/bin/nvcc" --version 2>/dev/null | tail -n1)"
    fi
    echo "-- last log lines ($LOG)"
    tail -n 8 "$LOG" 2>/dev/null | sed 's/^/   /'
    return 0
}

net_up() {
    getent hosts "$HOST" >/dev/null 2>&1 || return 1
    if command -v curl >/dev/null 2>&1; then
        curl -fsI --max-time 15 "https://$HOST/compute/cuda/repos/" >/dev/null 2>&1
    else
        # no curl: prove the HTTPS port answers instead of assuming the network is up
        timeout 15 bash -c "exec 3<>/dev/tcp/$HOST/443" >/dev/null 2>&1
    fi
}

backoff_note() { # backoff_note <hard|soft>
    local n=0 next
    [ -r "$ATTEMPTS" ] && read -r n _ < "$ATTEMPTS"
    n=$((n + 1))
    # 5 min, 10, 20, 40 ... capped at 6 h
    local delay=$((300 * (1 << (n > 7 ? 7 : n - 1))))
    [ "$delay" -gt 21600 ] && delay=21600
    next=$(( $(date +%s) + delay ))
    echo "$n $next" > "$ATTEMPTS"
    log "attempt $n failed ($1); next scheduled attempt in ${delay}s"
    echo "$n"
}

apt_run() { apt-get -o DPkg::Lock::Timeout=900 -o Dpkg::Options::=--force-confold "$@"; }

sum_of() { # sum_of FILE... -> one cksum over the files' contents, "none" when there are none
    local f any=0
    for f in "$@"; do [ -r "$f" ] && any=1; done
    [ "$any" = 1 ] || { echo none; return 0; }
    cat "$@" 2>/dev/null | cksum | awk '{print $1 "-" $2}'
}

# stage_dkms_patches: copy each shipped <module>-<version> patch set into the
# DKMS source dir and list it in /etc/dkms/<module>-<version>.conf, so the
# package's own postinst build (and every later DKMS rebuild) applies it. A
# patch set whose "fixed-upstream" marker (line 1: path in the source, line 2:
# fixed string) is already present in an unpacked source is withdrawn instead.
stage_dkms_patches() {
    local d mv conf p n src_file marker f patches
    for d in "$NV_DKMS_PATCHES"/*-*/; do
        [ -d "$d" ] || continue
        mv=$(basename "$d"); conf="$DKMS_ETC/$mv.conf"
        patches=""
        for p in "$d"*.patch; do [ -f "$p" ] && patches="$patches $(basename "$p")"; done
        src_file=""; marker=""
        if [ -r "$d/fixed-upstream" ]; then
            src_file=$(sed -n 1p "$d/fixed-upstream"); marker=$(sed -n 2p "$d/fixed-upstream")
            case "$src_file" in /*|*..*|-*) log "dkms: $mv: ignoring unsafe fixed-upstream path '$src_file'"; src_file=""; marker="" ;; esac
        fi
        if [ -z "$patches" ] || { [ -n "$src_file" ] && [ -n "$marker" ] && [ -r "$SRC_ROOT/$mv/dkms.conf" ] \
                && grep -qF -- "$marker" "$SRC_ROOT/$mv/$src_file" 2>/dev/null; }; then
            # nothing to apply, or the driver source already carries the fix: withdraw our files
            if grep -q '^# Written by ncz-cuda-setup' "$conf" 2>/dev/null; then
                rm -f "$conf"; log "dkms: local patches for $mv withdrawn (${patches:+source already has the fix: $src_file}${patches:-no patches shipped})"
            fi
            for f in "$d"*.patch; do [ -e "$f" ] && rm -f "$SRC_ROOT/$mv/patches/$(basename "$f")"; done
            continue
        fi
        install -d -m0755 "$SRC_ROOT/$mv/patches" "$DKMS_ETC" || { log "dkms: cannot stage patches for $mv"; continue; }
        n=0
        {
            echo "# Written by ncz-cuda-setup (NCZ-OS): local patches for $mv only;"
            echo "# sources in $d. Removed when the driver source carries the fix."
            for p in $patches; do
                install -m0644 "$d$p" "$SRC_ROOT/$mv/patches/$p" || { log "dkms: cannot stage $p for $mv"; continue; }
                echo "PATCH[\${#PATCH[@]}]=\"$p\""
                n=$((n + 1))
            done
        } > "$conf.ncz-tmp" && mv -f "$conf.ncz-tmp" "$conf"
        log "dkms: staged $n local patch(es) for $mv ($conf)"
    done
}

# dkms_first_error: newest NVIDIA DKMS make.log written during this driver
# install attempt (newer than $DRV_MARK) that holds a compiler error ->
# "<kernel>|<module>|<version>|<first error line>"; rc 1 when there is none.
DRV_MARK=$STATE/.cuda-setup.driver-attempt
dkms_first_error() {
    local log_f newest="" k e m v
    for log_f in "$DKMS_TREE"/nvidia*/*/build/make.log; do
        [ -r "$log_f" ] || continue
        [ "$log_f" -nt "$DRV_MARK" ] || continue
        if [ -z "$newest" ] || [ "$log_f" -nt "$newest" ]; then newest=$log_f; fi
    done
    [ -n "$newest" ] || return 1
    e=$(grep -m1 -E '(^|[[:space:]:])error:' "$newest" 2>/dev/null) || return 1
    k=$(head -n1 "$newest" | sed -n 's/.* for kernel \([^ ]*\).*/\1/p')
    v=$(basename "$(dirname "$(dirname "$newest")")"); m=$(basename "$(dirname "$(dirname "$(dirname "$newest")")")")
    printf '%s|%s|%s|%s\n' "${k:-unknown}" "$m" "$v" "$(printf '%s' "$e" | tr -d '\r' | cut -c1-300)"
}

# dkms_pkg: the NVIDIA *-dkms package dpkg has (installed or half-configured).
dkms_pkg() {
    dpkg-query -W -f='${Package} ${db:Status-Abbrev}\n' 'nvidia*dkms' 2>/dev/null \
        | awk '$2 ~ /^[ih]/ && $2 !~ /^.n/ {print $1; exit}'
}

# dkms_key KERNEL MODULE VERSION -> the inputs that decide a DKMS build result.
dkms_key() {
    printf '%s|%s|%s|%s|%s\n' "$1" "$2" "$3" \
        "$(sum_of "$MODULES_ROOT/$1/build/include/generated/autoconf.h")" \
        "$(sum_of "$NV_DKMS_PATCHES/$2-$3"/*.patch)"
}

# dkms_key_now PKG MODULE: the key a build attempted now would have.
dkms_key_now() {
    local ver
    ver=$(apt-cache policy "$1" 2>/dev/null | sed -n 's/^ *Candidate: //p' | head -n1)
    case "$ver" in ""|"(none)") ver=$(dpkg-query -W -f='${Version}' "$1" 2>/dev/null) ;; esac
    ver=${ver#*:}; ver=${ver%-*}
    dkms_key "$(uname -r)" "$2" "$ver"
}

# record_dkms_failure: after a failed driver install; rc 0 when it was a DKMS
# compile error (logged, recorded with its key), 1 otherwise.
record_dkms_failure() {
    local fe k m v e pkg
    fe=$(dkms_first_error) || return 1
    k=${fe%%|*}; fe=${fe#*|}; m=${fe%%|*}; fe=${fe#*|}; v=${fe%%|*}; e=${fe#*|}
    pkg=$(dkms_pkg); pkg=${pkg:-nvidia-kernel-open-dkms}
    log "DKMS build of $m $v for kernel $k failed; first compiler error:"
    log "    $e"
    log "not retrying until the kernel, its config, the driver version or the local patches change (or: ncz-cuda-setup retry)"
    { dkms_key "$k" "$m" "$v"; echo "pkg=$pkg module=$m"; echo "$e"; } > "$DKMS_FAIL"
    return 0
}

do_run() {
    local scheduled=0
    [ "${1:-}" = "--scheduled" ] && scheduled=1
    exec 9>"$LOCK"; flock -n 9 || { log "another ncz-cuda-setup is running"; return 0; }

    if [ -e "$STAMP" ]; then log "already done"; return 0; fi
    if [ ! -r "$CONF" ]; then log "no $CONF: nothing to install"; return 0; fi

    local family; family=$(conf FAMILY)
    if [ "$family" = "kepler-older" ] || [ "$(conf TOOLKIT)" = "none" ]; then
        set_status "skipped:$family-unsupported"
        date -u +%FT%TZ > "$STAMP"; return 0
    fi

    if [ "$scheduled" = 1 ] && [ -r "$DKMS_FAIL" ]; then
        local fpkg fmod
        fpkg=$(sed -n 2p "$DKMS_FAIL" | sed -n 's/.*pkg=\([^ ]*\).*/\1/p')
        fmod=$(sed -n 2p "$DKMS_FAIL" | sed -n 's/.*module=\([^ ]*\).*/\1/p')
        if [ "$(dkms_key_now "${fpkg:-nvidia-kernel-open-dkms}" "${fmod:-nvidia}")" = "$(sed -n 1p "$DKMS_FAIL")" ]; then
            return 0   # same inputs as the failed build: it would fail the same way
        fi
        log "kernel, config, driver or local patches changed since the failed DKMS build; retrying now"
        rm -f "$DKMS_FAIL" "$ATTEMPTS"
    fi

    if [ "$scheduled" = 1 ] && [ -r "$ATTEMPTS" ]; then
        local n next; read -r n next < "$ATTEMPTS"
        if [ "$(date +%s)" -lt "${next:-0}" ]; then return 0; fi
        if [ "${n:-0}" -ge "$MAX_HARD_FAILS" ] && grep -q '^failed:' "$STATUS" 2>/dev/null; then
            return 0   # parked until `ncz-cuda-setup retry`
        fi
    fi

    if ! net_up; then
        log "network to $HOST is not available yet"
        set_status "pending:network"
        backoff_note soft >/dev/null
        return 75
    fi

    log "== run: family=$family driver=$(conf DRIVER_PKGS) toolkit=$(conf TOOLKIT_PKGS)"
    # Sources, key and pin were staged by 54-gpu-accel.sh; refresh the indexes.
    if ! apt_run update >>"$LOG" 2>&1; then
        # A partial failure (one unreachable source) must not stop us if the
        # NVIDIA index itself is usable; the simulation below is the real test.
        log "apt-get update reported errors; continuing to the simulation"
    fi

    local drv pkgs sim
    # NCZ_CUDA_DRIVER_PKGS overrides the driver list (test hook: lets a machine
    # that already has its driver exercise only the toolkit path).
    drv=${NCZ_CUDA_DRIVER_PKGS-$(conf DRIVER_PKGS)}; pkgs=$(conf TOOLKIT_PKGS)
    # shellcheck disable=SC2086
    sim=$(apt_run install -s -y --no-install-recommends --no-remove $drv $pkgs 2>&1); local rc=$?
    if [ $rc -ne 0 ]; then
        log "simulation failed (rc=$rc):"; echo "$sim" | tail -20 | sed 's/^/    /' | tee -a "$LOG" >&2
        if echo "$sim" | grep -qE 'Unable to locate package|Temporary failure|Could not resolve|Failed to fetch'; then
            set_status "pending:index-unavailable"; backoff_note soft >/dev/null; return 75
        fi
        set_status "failed:not-installable"; backoff_note hard >/dev/null; return 1
    fi
    if echo "$sim" | grep -q '^Remv '; then
        log "REFUSING: installing would remove packages:"; echo "$sim" | grep '^Remv ' | sed 's/^/    /' | tee -a "$LOG" >&2
        set_status "failed:would-remove-packages"; backoff_note hard >/dev/null; return 1
    fi

    # Local DKMS patches must be in place before dpkg runs the module postinst.
    stage_dkms_patches

    # Driver first so a toolkit problem never costs the display driver.
    # attempt_log prints only what THIS apt transaction appended to the log: an older "Failed to fetch" line must not
    # turn a hard failure (dpkg/dkms/resolver) into an endless "pending:download" retry (zoder review, verified).
    local logoff
    attempt_log() { tail -c +"$((logoff + 1))" "$LOG" 2>/dev/null; }
    logoff=$(wc -c < "$LOG" 2>/dev/null || echo 0)
    touch "$DRV_MARK" 2>/dev/null
    # shellcheck disable=SC2086
    if ! apt_run install -y --no-install-recommends --no-remove $drv >>"$LOG" 2>&1; then
        if attempt_log | grep -qE 'Failed to fetch|Temporary failure|Could not resolve|Connection (timed out|failed)|Unable to connect'; then
            set_status "pending:download"; backoff_note soft >/dev/null; return 75
        fi
        if record_dkms_failure; then
            set_status "failed:dkms-build"; backoff_note hard >/dev/null; return 1
        fi
        set_status "failed:driver-install"; backoff_note hard >/dev/null; return 1
    fi
    logoff=$(wc -c < "$LOG" 2>/dev/null || echo 0)
    # shellcheck disable=SC2086
    if ! apt_run install -y --no-install-recommends --no-remove $pkgs >>"$LOG" 2>&1; then
        if attempt_log | grep -qE 'Failed to fetch|Temporary failure|Could not resolve|Connection (timed out|failed)|Unable to connect'; then
            set_status "pending:download"; backoff_note soft >/dev/null; return 75
        fi
        set_status "failed:toolkit-install"; backoff_note hard >/dev/null; return 1
    fi

    ldconfig 2>/dev/null || true
    local tdir; tdir=$(conf TOOLKIT_DIR)
    if [ ! -x "$tdir/bin/nvcc" ]; then
        set_status "failed:nvcc-missing"; backoff_note hard >/dev/null; return 1
    fi
    install -d -m0755 /etc/profile.d
    cat > /etc/profile.d/ncz-cuda.sh <<'PROFEOF'
# Written by ncz-cuda-setup. CUDA on PATH; runtime libraries are found through
# /etc/ld.so.conf.d (no LD_LIBRARY_PATH needed).
if [ -d /usr/local/cuda/bin ]; then
    case ":$PATH:" in *:/usr/local/cuda/bin:*) ;; *) PATH="$PATH:/usr/local/cuda/bin" ;; esac
    export PATH
fi
PROFEOF
    chmod 0644 /etc/profile.d/ncz-cuda.sh

    if [ "$(conf KMOD)" = proprietary ] && command -v dkms >/dev/null 2>&1; then
        log "dkms: $(dkms status 2>/dev/null | tr '\n' ';')"
    fi
    set_status "installed:$(dpkg-query -W -f='${Version}' "cuda-nvcc-$(conf TOOLKIT)" 2>/dev/null)"
    date -u +%FT%TZ > "$STAMP"
    rm -f "$ATTEMPTS" "$DKMS_FAIL"
    systemctl disable --now ncz-cuda-setup.timer >/dev/null 2>&1 || true
    log "done: $("$tdir/bin/nvcc" --version 2>/dev/null | tail -n1)"
    return 0
}

case "${1:-}" in
    run)    shift; do_run "$@" ;;
    retry)  rm -f "$ATTEMPTS" "$DKMS_FAIL"; rm -f "$STAMP"; do_run ;;
    status) cmd_status ;;
    *)      echo "usage: ncz-cuda-setup run [--scheduled] | retry | status" >&2; exit 2 ;;
esac

#!/bin/sh
# ncz-gpu-status — report which GPU stack is selected and which one is live.
#
# Prints the SELECTED mode and the ACTUAL bound state separately on purpose:
# when those two disagree the machine is in the half-switched state that used to
# silently drop the desktop to llvmpipe, and this is the tool that shows it.
set -u

REQUIRE_HW=0; QUIET=0
for _a in "$@"; do
    case "$_a" in
        --require-hardware) REQUIRE_HW=1 ;;
        --quiet) QUIET=1 ;;
    esac
done

# ---------------------------------------------------------------------------------------------------------------
# --require-hardware: NEVER-SOFTWARE-RENDER health check (policy since 2026-09-29).
#
# If this machine has a hardware GPU, every renderer a user process can get must be that GPU: not llvmpipe, softpipe,
# swrast, lavapipe or SwiftShader, and no software-forcing variable may be set. Probes run TWICE, once in the session
# environment and once in a bare `env -i` environment, because a process that does not inherit the compositor's GPU
# variables (ssh, cron, systemd --user, D-Bus activation, portals, flatpak, autostart) used to fall back to llvmpipe
# on Sky1 while the compositor itself was fine.
#
# Writes $NCZ_GPU_HEALTH_LOG (default /var/log/ncz-gpu-health.log), prints a banner on failure, exits non-zero.
# A machine without a hardware GPU (KVM) passes with "no GPU: software allowed".
# Test seams: NCZ_SYSROOT, NCZ_GPU_HW_PRESENT, NCZ_PROBE_EGL_SESSION, NCZ_PROBE_EGL_BARE, NCZ_PROBE_VK_SESSION,
# NCZ_PROBE_VK_BARE (each a command printing the probe's text), NCZ_GPU_HEALTH_LOG, NCZ_GPU_BANNER.
# ---------------------------------------------------------------------------------------------------------------
if [ "$REQUIRE_HW" = 1 ]; then
    LOG="${NCZ_GPU_HEALTH_LOG:-/var/log/ncz-gpu-health.log}"
    BANNER="${NCZ_GPU_BANNER:-/etc/issue.d/50-ncz-gpu-health.issue}"
    HWP="${NCZ_GPU_HW_PRESENT:-$(command -v ncz-gpu-hw-present 2>/dev/null || echo /usr/local/bin/ncz-gpu-hw-present)}"
    SOFT_RE='llvmpipe|softpipe|swrast|lavapipe|software rasterizer|swiftshader'
    stamp=$(date -u +%FT%TZ 2>/dev/null || echo unknown)
    problems=""
    add() { problems="$problems
  - $1"; }

    wlog() { { printf '%s\n' "$1" >> "$LOG"; } 2>/dev/null; }
    if [ ! -x "$HWP" ]; then
        echo "GPU HEALTH ERROR: $HWP is missing, cannot tell whether this machine has a GPU (a check that cannot run must not pass)" >&2
        wlog "$stamp ERROR ncz-gpu-hw-present missing"
        exit 2
    fi
    hw=$("$HWP" 2>/dev/null) && has_hw=1 || has_hw=0
    if [ "$has_hw" = 0 ]; then
        msg="$stamp OK no GPU: software allowed (no hardware render device on this machine)"
        [ "$QUIET" = 1 ] || echo "$msg"
        mkdir -p "$(dirname "$LOG")" 2>/dev/null; wlog "$msg"
        rm -f "$BANNER" 2>/dev/null
        exit 0
    fi

    # 1. software-forcing variables in this environment or in the system-wide files
    for v in LIBGL_ALWAYS_SOFTWARE WLR_RENDERER_ALLOW_SOFTWARE; do
        eval "val=\${$v:-}"; [ -n "$val" ] && [ "$val" != 0 ] && add "$v=$val is set in the environment"
    done
    [ "${WLR_RENDERER:-}" = pixman ] && add "WLR_RENDERER=pixman is set in the environment"
    [ "${GSK_RENDERER:-}" = cairo ] && add "GSK_RENDERER=cairo is set in the environment"
    case "${GALLIUM_DRIVER:-}${MESA_LOADER_DRIVER_OVERRIDE:-}" in *llvmpipe*|*softpipe*|*swrast*) add "a Mesa software driver is forced (GALLIUM_DRIVER/MESA_LOADER_DRIVER_OVERRIDE)" ;; esac
    # llvmpipe knobs (LP_*) and a software ICD selected through the Vulkan loader
    # mean software was chosen just as much as a forced Mesa driver. EGL_PLATFORM
    # set to surfaceless/device names Mesa's headless device enumeration, which on
    # a mixed machine pins the software node; a real session never sets it.
    for v in $(env 2>/dev/null | sed -n 's/^\(LP_[A-Za-z0-9_]*\)=.*/\1/p'); do
        eval "val=\${$v:-}"; [ -n "$val" ] && add "$v=$val is set in the environment (llvmpipe)"
    done
    case "${VK_ICD_FILENAMES:-}${VK_DRIVER_FILES:-}${VK_LOADER_DRIVERS_SELECT:-}" in
        *lvp*|*lavapipe*|*llvmpipe*|*swiftshader*) add "a software Vulkan ICD is forced (VK_ICD_FILENAMES/VK_DRIVER_FILES/VK_LOADER_DRIVERS_SELECT)" ;;
    esac
    case "${EGL_PLATFORM:-}" in
        surfaceless|device) add "EGL_PLATFORM=$EGL_PLATFORM pins a headless/device EGL platform" ;;
    esac
    for f in "${NCZ_SYSROOT:-}"/etc/environment "${NCZ_SYSROOT:-}"/etc/environment.d/*.conf; do
        [ -r "$f" ] || continue
        if grep -Eq '^[[:space:]]*(LIBGL_ALWAYS_SOFTWARE|WLR_RENDERER_ALLOW_SOFTWARE)=[^0[:space:]]|^[[:space:]]*WLR_RENDERER=pixman|^[[:space:]]*GSK_RENDERER=cairo|GALLIUM_DRIVER=(llvmpipe|softpipe|swrast)|^[[:space:]]*LP_[A-Za-z0-9_]+=|^[[:space:]]*(VK_ICD_FILENAMES|VK_DRIVER_FILES)=.*(lvp|lavapipe|llvmpipe)|^[[:space:]]*EGL_PLATFORM=(surfaceless|device)' "$f"; then
            add "$f forces software rendering"
        fi
    done

    # 2. probes: EGL and Vulkan, session env and bare env
    #
    # Judge what a client would actually get, not everything the enumeration
    # lists. eglinfo -B and vulkaninfo --summary both enumerate every device on
    # the machine, so a healthy PRIME box that has mesa-vulkan-drivers/swrast
    # installed always lists llvmpipe somewhere; that is not a software desktop.
    #
    # EGL is judged per platform block. Only GBM, Wayland and X11 are platforms a
    # session/compositor uses, so a software renderer in one of those FAILS.
    # Mesa's Surfaceless and Device blocks (the latter enumerates every /dev/dri
    # node, including the software node) are enumeration artifacts no session
    # uses and are IGNORED, each with a line in the health log saying why. Probe
    # text with no platform header at all (test seams, very old eglinfo) is one
    # platform and keeps the original meaning.
    #
    # Vulkan is judged by the FIRST device the loader lists, the device a client
    # that does not choose gets: Intel first + RTX 2060 + llvmpipe later passes,
    # llvmpipe first fails even though a GPU is listed later.
    #
    # Software forced by a variable still FAILS in every case (checked above).
    EGL_SESSION_PLATFORMS='gbm|wayland|x11'
    vk_scan() {   # name output: judge the first device the loader lists
        _name=$1; _out=$2
        _first=$(printf '%s\n' "$_out" | awk 'tolower($0) ~ /devicename/ { print; exit }')
        if [ -n "$_first" ]; then
            printf '%s\n' "$_first" | grep -Eiq "$SOFT_RE" && add "$_name first Vulkan device renders in SOFTWARE: $_first"
            return 0
        fi
        printf '%s\n' "$_out" | grep -Eiq "$SOFT_RE" && add "$_name renders in SOFTWARE: $(printf '%s\n' "$_out" | grep -Ei "$SOFT_RE" | head -1)"
    }
    egl_scan() {   # name output: add a problem for software in a session-platform block
        _name=$1; _out=$2
        if ! printf '%s\n' "$_out" | grep -Eqi 'platform:'; then
            printf '%s\n' "$_out" | grep -Eiq "$SOFT_RE" && add "$_name renders in SOFTWARE: $(printf '%s\n' "$_out" | grep -Ei "$SOFT_RE" | head -1)"
            return 0
        fi
        _scan=$(printf '%s\n' "$_out" | awk -v re="$SOFT_RE" -v use="$EGL_SESSION_PLATFORMS" '
            {
                l = tolower($0)
                if (l ~ /platform:[[:space:]]*$/) {
                    plat = l
                    sub(/[[:space:]]*platform:[[:space:]]*$/, "", plat)
                    next
                }
                if (l ~ re) {
                    if (plat ~ use) printf "FAIL\t%s\t%s\n", plat, $0
                    else printf "IGNORE\t%s\t%s\n", (plat == "" ? "unlabeled" : plat), $0
                }
            }')
        [ -n "$_scan" ] || return 0
        while IFS="$(printf '\t')" read -r _kind _plat _line; do
            case "$_kind" in
                IGNORE) printf 'IGNORED %s platform software renderer (no session/compositor uses it): %s\n' "$_plat" "$_line" >> "$LOG.tmp" 2>/dev/null ;;
                FAIL)   add "$_name renders in SOFTWARE ($_plat platform): $_line" ;;
            esac
        done <<EOF
$_scan
EOF
    }
    probe() {   # name seam-var default-command bare(0|1) scan(none|egl|vk)
        _name=$1; _seam=$2; _def=$3; _bare=$4; _scan_mode=${5:-none}
        eval "_cmd=\${$_seam:-}"
        if [ -n "$_cmd" ]; then out=$(sh -c "$_cmd" 2>&1)                       # test seam: run as given
        elif [ -z "$_def" ]; then echo "$_name: probe tool not installed (skipped)" >> "$LOG.tmp" 2>/dev/null; return 0
        elif [ "$_bare" = 1 ]; then out=$(env -i HOME="${HOME:-/root}" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" PATH=/usr/sbin:/usr/bin:/sbin:/bin sh -c "$_def" 2>&1)
        else out=$(sh -c "$_def" 2>&1); fi
        { echo "== $_name"; printf '%s\n' "$out" | head -40; } >> "$LOG.tmp" 2>/dev/null
        case "$_scan_mode" in
            egl) egl_scan "$_name" "$out" ;;
            vk)  vk_scan "$_name" "$out" ;;
            *)   printf '%s\n' "$out" | grep -Eiq "$SOFT_RE" && add "$_name renders in SOFTWARE: $(printf '%s\n' "$out" | grep -Ei "$SOFT_RE" | head -1)" ;;
        esac
    }
    { : > "$LOG.tmp"; } 2>/dev/null
    EGLCMD=""; command -v eglinfo >/dev/null 2>&1 && EGLCMD="eglinfo -B 2>&1"
    VKCMD=""; command -v vulkaninfo >/dev/null 2>&1 && VKCMD="vulkaninfo --summary 2>&1 | grep -Ei 'deviceName|driverName'"
    SESSION_PRE=""
    [ -r /usr/local/bin/ncz-gpu-env ] && SESSION_PRE=". /usr/local/bin/ncz-gpu-env >/dev/null 2>&1; "
    probe "EGL (session environment)"   NCZ_PROBE_EGL_SESSION "${EGLCMD:+$SESSION_PRE$EGLCMD}" 0 egl
    probe "EGL (bare environment)"      NCZ_PROBE_EGL_BARE    "$EGLCMD" 1 egl
    probe "Vulkan (session environment)" NCZ_PROBE_VK_SESSION "${VKCMD:+$SESSION_PRE$VKCMD}" 0 vk
    probe "Vulkan (bare environment)"   NCZ_PROBE_VK_BARE     "$VKCMD" 1 vk

    mkdir -p "$(dirname "$LOG")" 2>/dev/null
    if [ -z "$problems" ]; then
        wlog "$stamp OK hardware GPU ($hw): no software renderer in the session or bare environment"; { cat "$LOG.tmp" >> "$LOG"; } 2>/dev/null
        rm -f "$LOG.tmp" "$BANNER" 2>/dev/null
        [ "$QUIET" = 1 ] || echo "GPU health OK: hardware GPU ($hw), no software rendering detected"
        exit 0
    fi
    wlog "$stamp FAIL hardware GPU ($hw) present but software rendering is in use:$problems"; { cat "$LOG.tmp" >> "$LOG"; } 2>/dev/null
    rm -f "$LOG.tmp"
    mkdir -p "$(dirname "$BANNER")" 2>/dev/null
    {
        echo "*** NCZ-OS: this machine has a GPU ($hw) but software rendering is in use ***"
        echo "    details: $LOG     check: ncz-gpu-status --require-hardware"
    } > "$BANNER.new" 2>/dev/null && mv -f "$BANNER.new" "$BANNER" 2>/dev/null
    {
        echo "GPU HEALTH FAIL: hardware GPU ($hw) present but software rendering is in use:$problems"
        echo "See $LOG"
    } >&2
    exit 1
fi

# ---------------------------------------------------------------------------------------------------------------
# Not a Sky1 board: the Mali/Panthor switcher (sky1.gpu=, /etc/default/ncz-gpu) does not apply, so report the real
# stack instead of "selected : mali (from built-in default)", which is what a T2 Mac and the GU502LV laptop printed (r201).
# Sky1 = arm64 with the CIX GPU's ACPI device. Test seams: NCZ_GPU_STATUS_ARCH, NCZ_SYSROOT.
# ---------------------------------------------------------------------------------------------------------------
_sys="${NCZ_SYSROOT:-}/sys"
_arch="${NCZ_GPU_STATUS_ARCH:-$(uname -m 2>/dev/null)}"
_sky1=0
case "$_arch" in
    aarch64|arm64)
        # An arm64 board without the CIXH5000 device is not Sky1; an unreadable /sys keeps the Sky1 report.
        if [ -e "$_sys/bus/platform/devices/CIXH5000:00" ] || [ -e /dev/mali0 ] || [ ! -d "$_sys/bus/platform/devices" ]; then
            _sky1=1
        fi
        ;;
esac
if [ "$_sky1" = 0 ]; then
    echo "=== NCZ-OS GPU stack ==="
    echo "platform      : $_arch -- not a CIX Sky1 board; the Mali/Panthor switcher (sky1.gpu=) does not apply"
    _ncards=0
    for _c in "$_sys"/class/drm/card*; do
        [ -e "$_c" ] || continue
        _n=${_c##*/}
        case "$_n" in card*-*) continue ;; esac            # connectors (card0-eDP-1), not cards
        _ncards=$((_ncards + 1))
        _drv=none
        [ -e "$_c/device/driver" ] && _drv=$(basename "$(readlink -f "$_c/device/driver")")
        _bus=$(basename "$(readlink -f "$_c/device" 2>/dev/null)" 2>/dev/null)
        _ids=""
        [ -r "$_c/device/vendor" ] && [ -r "$_c/device/device" ] && \
            _ids=" [$(sed 's/^0x//' "$_c/device/vendor"):$(sed 's/^0x//' "$_c/device/device")]"
        _boot=""
        [ "$(cat "$_c/device/boot_vga" 2>/dev/null)" = 1 ] && _boot=" boot_vga"
        case "$_drv" in
            amdgpu|radeon) _what="AMD (Mesa radeonsi/RADV)" ;;
            i915|xe)       _what="Intel (Mesa iris/ANV)" ;;
            nvidia)        _what="NVIDIA proprietary" ;;
            nouveau)       _what="NVIDIA nouveau (Mesa)" ;;
            simpledrm|efifb|vesafb|bochs|bochs-drm|virtio_gpu|virtio-pci|qxl|cirrus*|vmwgfx) _what="firmware/virtual display" ;;
            none)          _what="NO DRIVER BOUND" ;;
            *)             _what="$_drv" ;;
        esac
        printf 'gpu %-10s: driver=%s (%s) device=%s%s%s\n' "$_n" "$_drv" "$_what" "${_bus:-?}" "$_ids" "$_boot"
    done
    [ "$_ncards" -gt 0 ] || echo "gpu           : no DRM card (no GPU driver bound)"
    echo -n "render nodes  : "
    for _r in "$_sys"/class/drm/renderD*; do
        [ -e "$_r" ] || continue
        printf '/dev/dri/%s(%s) ' "${_r##*/}" "$(basename "$(readlink -f "$_r/device/driver" 2>/dev/null)" 2>/dev/null)"
    done
    echo
    _vk_icds="$(ls "${NCZ_SYSROOT:-}"/etc/vulkan/icd.d/*.json "${NCZ_SYSROOT:-}"/usr/share/vulkan/icd.d/*.json 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ')"
    echo "vulkan ICDs   : ${_vk_icds:-(none)}"
    echo "health check  : ncz-gpu-status --require-hardware"
    exit 0
fi

sel=$(sed -n 's/.*\bsky1\.gpu=\([a-z]*\).*/\1/p' /proc/cmdline 2>/dev/null)
src="kernel cmdline sky1.gpu="
if [ -z "$sel" ]; then
    sel=$(sed -n 's/.*\bncz\.gpu=\([a-z]*\).*/\1/p' /proc/cmdline 2>/dev/null)
    src="kernel cmdline ncz.gpu="
fi
if [ -z "$sel" ] && [ -r /etc/default/ncz-gpu ]; then
    sel=$(sed -n 's/^[[:space:]]*GPU_MODE=["'"'"']*\([a-z]*\).*/\1/p' /etc/default/ncz-gpu | head -1)
    src="/etc/default/ncz-gpu"
fi
case "$sel" in
    vendor|mali)  sel=mali ;;
    mesa|panthor) sel=panthor ;;
    *)            sel=mali; src="built-in default" ;;
esac

# ldconfig is in /sbin, absent from an unprivileged PATH: without this the
# resolutions below silently print blank for a normal user, which looks exactly
# like a broken GL stack. Measured on O6N 2026-08-15.
LDCONFIG=$(command -v ldconfig 2>/dev/null || echo /sbin/ldconfig)

resolve() { "$LDCONFIG" -p 2>/dev/null | awk -v l="$1 " '$0 ~ l {print $NF; exit}'; }
drm_card_driven_by() {
    for dev in /sys/class/drm/card*/device/driver; do
        [ -e "$dev" ] || continue
        [ "$(basename "$(readlink -f "$dev")")" = "$1" ] && return 0
    done
    return 1
}

echo "=== NCZ-OS GPU stack ==="
echo "selected      : $sel   (from $src)"
echo "last applied  : $(cat /etc/ncz-gpu-profile 2>/dev/null || echo unset)"
[ -s /run/ncz-gpu-fallback ] && echo "fallback      : $(cat /run/ncz-gpu-fallback)"

# Decide by what is actually BOUND, not merely loaded. Both modules can sit in
# lsmod at once after a failed switch -- measured on O6N 2026-08-16, where a
# stray mali_kbase at refcount 0 made this report "mali" while panthor owned
# the GPU. /dev/mali0 and the panthor render node are the real evidence.
if [ -e /dev/mali0 ]; then
    live=mali
elif lsmod 2>/dev/null | grep -q '^panthor ' && \
     [ -e /sys/bus/platform/drivers/panthor/CIXH5000:00 ] && \
     drm_card_driven_by panthor; then
    live=panthor
elif lsmod 2>/dev/null | grep -q '^panthor '; then
    live="panthor (loaded, NOT bound)"
elif lsmod 2>/dev/null | grep -q '^mali_kbase '; then
    live="mali (loaded, NOT bound)"
else
    live=none
fi
echo "kernel driver : $live"
echo "/dev/mali0    : $([ -e /dev/mali0 ] && echo present || echo absent)"
echo -n "render nodes  : "
for n in /dev/dri/renderD*; do
    [ -e "$n" ] || continue
    printf '%s(%s) ' "$n" "$(basename "$(readlink -f /sys/class/drm/$(basename "$n")/device/driver 2>/dev/null)" 2>/dev/null)"
done
echo

if [ -e /etc/ld.so.conf.d/00-cixgpu-pro.conf ]; then
    echo "userspace     : vendor Mali (/opt/cixgpu-* on the library path)"
else
    echo "userspace     : Mesa (panfrost/PanVK)"
fi
echo "libEGL.so.1   -> $(resolve libEGL.so.1)"
echo "libGLESv2.so.2-> $(resolve libGLESv2.so.2)"
echo "libOpenCL.so.1-> $(resolve libOpenCL.so.1)"
_vk_icds="$(ls /etc/vulkan/icd.d/*.json /usr/share/vulkan/icd.d/*.json 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ')"
echo "vulkan ICDs   : ${_vk_icds:-(none)}"
# Be honest about a Panthor boot with no Vulkan ICD instead of printing a blank
# line: PanVK comes from mesa-vulkan-drivers, which the Mali-stack purge used to
# remove on arm64 (O6N 2026-10-04). This is informational -- it never fails the
# --require-hardware health check.
if [ -z "$_vk_icds" ]; then
    case "$live" in
        panthor*) echo "                no Vulkan on Panthor: install mesa-vulkan-drivers for the PanVK ICD" ;;
        *)        echo "                no Vulkan ICD on this image" ;;
    esac
fi
echo "blacklist file: $([ -e /etc/modprobe.d/ncz-gpu-drivers.conf ] && echo present || echo MISSING)"

if [ "$live" != none ] && [ "$live" != "$sel" ]; then
    echo
    case "$live" in
        *"NOT bound"*)
            echo "WARNING: selected '$sel' but '$live'. The switcher failed or the"
            echo "         selected driver cannot bind -- check: journalctl -u ncz-gpu-switcher"
            ;;
        *)
            echo "WARNING: selected '$sel' but '$live' is bound. Reboot to apply, or the"
            echo "         switcher failed -- check: journalctl -u ncz-gpu-switcher"
            ;;
    esac
fi

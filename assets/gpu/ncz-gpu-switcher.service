[Unit]
Description=NCZ-OS CIX Sky1 GPU stack switcher
Documentation=man:ncz-gpu-status(1)
DefaultDependencies=no
# After udev so the GPU device exists; after local-fs so /etc and /opt are
# readable. Before the greeter so the driver and the matching userspace are in
# place before anything tries to create a GL/Vulkan context -- a session that
# starts first falls back to llvmpipe and never recovers without a restart.
# systemd-journald.socket matters as much as the other two: with
# DefaultDependencies=no this unit runs early enough that journald may not be
# accepting yet, and its output goes nowhere. Measured on O6N 2026-08-15 -- the
# unit ran and applied panthor correctly, but `journalctl -u ncz-gpu-switcher -b`
# printed "No entries". The whole point of the fail-loud check is diagnostics a
# human can read afterwards, so losing them makes the guard half blind.
After=systemd-udevd.service local-fs.target systemd-journald.socket
Before=display-manager.service greetd.service graphical.target
# CIX Sky1 only. The stale, hand-rolled first-boot allowlist used to be the only
# thing keeping this unit from marking the KVM gate (generic arm64, no CIX GPU)
# failed: it ran, found no CIXH5000, and exited 1 "by design". There is nothing
# for this unit to do on a machine without the GPU, so it must not run at all.
# ConditionFirmware=device-tree-compatible(...) does NOT work here: Sky1 boots
# ACPI (acpi=force), of_node is NULL, and there is no /proc/device-tree, so the
# condition never matches and the unit would be SKIPPED ON SKY1 TOO. What does
# identify Sky1 under ACPI is the CIX GPU platform device the firmware
# instantiates from the CIXH5000 ACPI device: /sys/bus/platform/devices/
# CIXH5000:00. It is created at device enumeration (before this unit, which runs
# at sysinit after systemd-udevd) and exists whether or not mali_kbase or
# panthor has bound to it -- ncz-gpu-hw-present and ncz-gpu-status use the same
# check. ConditionPathExists is evaluated before ExecStart and is not itself a
# failure, so on anything else the unit ends "inactive (dead)", not "failed".
# Sky1 behaviour is unchanged: the condition is satisfied there and the script
# runs exactly as before.
ConditionPathExists=/sys/bus/platform/devices/CIXH5000:00

[Service]
Type=oneshot
ExecStart=/usr/lib/ncz/gpu-switcher.sh
RemainAfterExit=yes
StandardOutput=journal
# Errors also go to the console: if the GPU stack failed to come up, the desktop
# is degraded and the journal may be the harder place to look.
StandardError=journal+console

[Install]
WantedBy=sysinit.target

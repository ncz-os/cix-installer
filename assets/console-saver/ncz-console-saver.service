[Unit]
Description=NCZ Magnetar console screen saver
Documentation=file:/usr/share/doc/ncz-console-saver/README.md
# Server variant only: the image build enables this unit; the desktop image
# never installs it (docs/MAGNETAR-SERVER-VARIANT.md).
ConditionPathExists=/dev/tty0
After=multi-user.target getty.target systemd-user-sessions.service
# The saver must not race a suspend/shutdown; stop cleanly on both.

[Service]
Type=simple
# The saver picks its free VT once, at start. Let the login gettys claim their VTs first or it can pick
# a VT an agetty is about to own (setsid then fails with EPERM and the saver gives up after 3 tries).
ExecStartPre=/bin/sleep 10
ExecStart=/usr/local/bin/ncz-console-saver
Restart=on-failure
RestartSec=30
# The daemon needs VT ioctls and the input devices.
User=root
# Never let a hung saver daemon block shutdown.
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Wed, 14 Oct 2026 11:47:57 -0400
Subject: [PATCH] fix(scene): stop the scene animation after a few cycles

A scene redraws on every frame for as long as its slide is visible,
because its tick callback never stops. On an Intel HD4000 laptop the
tour used 50% of a core for as long as it stayed open, 55% on a CIX
Sky1 board and 88% on a MacBookPro16,1, where the package reached
94-95 C and fell back to 61 C seconds after the tour closed.

Play three cycles when a slide is shown, then rest on the first frame.
Image slides do not use the phase and no longer animate. Showing a
slide again plays the cycles again.

---
 src/scene.vala | 36 +++++++++++++++++++++++++++---------
 1 file changed, 27 insertions(+), 9 deletions(-)

diff --git a/src/scene.vala b/src/scene.vala
index 417e1d2..9c44331 100644
--- a/src/scene.vala
+++ b/src/scene.vala
@@ -112,6 +112,8 @@ namespace Singularity.Apps.Tour {
     public class Scene : Gtk.Widget {
         private const double W = 640;
         private const double H = 400;
+        private const double PERIOD = 2.4;
+        private const int CYCLES = 3;
 
         private string kind;
         private Gdk.Texture? texture = null;
@@ -139,21 +141,37 @@ namespace Singularity.Apps.Tour {
                 icon = theme.lookup_icon (icon_name, null, 256, 1, Gtk.TextDirection.NONE, 0);
             }
             RealDesktop.get_default ().loaded.connect (() => queue_draw ());
-            map.connect (() => {
-                var gtk = Gtk.Settings.get_default ();
-                if (gtk != null && !gtk.gtk_enable_animations) return;
-                tick = add_tick_callback ((w, clock) => {
-                    phase = (clock.get_frame_time () / 1000000.0) % 2.4 / 2.4;
-                    queue_draw ();
-                    return Source.CONTINUE;
-                });
-            });
+            map.connect (start_animation);
             unmap.connect (() => {
                 if (tick != 0) remove_tick_callback (tick);
                 tick = 0;
             });
         }
 
+        // Each scene redraws on every frame while it animates, so the loop
+        // plays a few cycles when the slide is shown and then rests on its
+        // first frame. Image slides do not use the phase and never animate.
+        private void start_animation () {
+            if (tick != 0 || texture != null) return;
+            var gtk = Gtk.Settings.get_default ();
+            if (gtk != null && !gtk.gtk_enable_animations) return;
+            int64 start = -1;
+            tick = add_tick_callback ((w, clock) => {
+                int64 now = clock.get_frame_time ();
+                if (start < 0) start = now;
+                double t = (now - start) / 1000000.0;
+                if (t >= PERIOD * CYCLES) {
+                    phase = 0;
+                    queue_draw ();
+                    tick = 0;
+                    return Source.REMOVE;
+                }
+                phase = (t % PERIOD) / PERIOD;
+                queue_draw ();
+                return Source.CONTINUE;
+            });
+        }
+
         public override void measure (Gtk.Orientation orientation, int for_size, out int minimum, out int natural, out int minimum_baseline, out int natural_baseline) {
             minimum_baseline = natural_baseline = -1;
             minimum = orientation == Gtk.Orientation.HORIZONTAL ? 240 : 150;

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Wed, 18 Nov 2026 12:00:00 -0500
Subject: [PATCH] write: implement the Gtk.AccessibleText vfuncs GTK 4.22 added

Implement the five newly abstract Gtk.AccessibleText methods, reporting the
operations as unsupported with empty attributes and false return values.
---
--- a/src/ui/doc_view.vala
+++ b/src/ui/doc_view.vala
@@ -2063,5 +2063,28 @@
             attribute_values = {};
             return false;
         }
+
+        /* GTK 4.22 added these vfuncs to GtkAccessibleText. */
+        public void get_default_attributes(out string[] attribute_names, out string[] attribute_values) {
+            attribute_names = {};
+            attribute_values = {};
+        }
+
+        public bool get_extents(uint start, uint end, Graphene.Rect extents) {
+            return false;
+        }
+
+        public bool get_offset(Graphene.Point point, out uint offset) {
+            offset = 0;
+            return false;
+        }
+
+        public bool set_caret_position(uint offset) {
+            return false;
+        }
+
+        public bool set_selection(size_t i, Gtk.AccessibleTextRange range) {
+            return false;
+        }
     }
 }

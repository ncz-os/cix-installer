From c969843cf680a28e7ad4f40e86ce086bd3df81df Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Wed, 7 Oct 2026 12:38:59 -0400
Subject: [PATCH] doc-view: implement the AccessibleText vfuncs newer GTK
 declares

WriteDocView implements Gtk.AccessibleText but not get_default_attributes,
get_extents, get_offset, set_caret_position or set_selection. Against Vala
0.56.19 with GTK 4.24 (Debian forky) gtk4.vapi declares all five abstract, so
valac stops with: error: `Singularity.Apps.WriteDocView' does not implement
interface method `Gtk.AccessibleText.get_extents' (and the other four). Report
no default attributes and decline the extents, offset and set requests, which
is what a GTK without those vfuncs does.
---
 src/ui/doc_view.vala | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/src/ui/doc_view.vala b/src/ui/doc_view.vala
index 5c42f25..eb3fee0 100644
--- a/src/ui/doc_view.vala
+++ b/src/ui/doc_view.vala
@@ -1904,5 +1904,27 @@ namespace Singularity.Apps {
             attribute_values = {};
             return false;
         }
+
+        public void get_default_attributes(out string[] attribute_names, out string[] attribute_values) {
+            attribute_names = {};
+            attribute_values = {};
+        }
+
+        public bool get_extents(uint start, uint end, Graphene.Rect extents) {
+            return false;
+        }
+
+        public bool get_offset(Graphene.Point point, out uint offset) {
+            offset = 0;
+            return false;
+        }
+
+        public bool set_caret_position(uint offset) {
+            return false;
+        }
+
+        public bool set_selection(size_t i, Gtk.AccessibleTextRange range) {
+            return false;
+        }
     }
 }
-- 
2.55.0


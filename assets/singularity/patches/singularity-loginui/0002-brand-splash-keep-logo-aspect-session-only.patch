From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Wed, 18 Nov 2026 12:00:00 -0500
Subject: [PATCH] brand splash: keep the logo aspect ratio

Fit the logo inside a height and width bound with one scale factor, keep it
centred, and load the brand mark with enough source width for wide wordmarks.
---
--- a/src/brand.c
+++ b/src/brand.c
@@ -11,7 +11,7 @@
 cairo_surface_t *loginui_load_brand_logo(void) {
     const char *path = getenv("SINGULARITY_SPLASH_LOGO");
     if (!path || !path[0]) path = LOGINUI_BRAND_LOGO_PATH;
-    return loginui_load_image(path, LOGINUI_BRAND_LOGO_SIZE * 2, LOGINUI_BRAND_LOGO_SIZE * 2);
+    return loginui_load_image(path, LOGINUI_BRAND_LOGO_SIZE * 4, LOGINUI_BRAND_LOGO_SIZE * 2);
 }
 
 void loginui_render_brand(cairo_t *cr, int width, int height,
@@ -29,10 +29,15 @@ void loginui_render_brand(cairo_t *cr, int width, int height,
         int lw = cairo_image_surface_get_width(logo);
         int lh = cairo_image_surface_get_height(logo);
         if (lw > 0 && lh > 0) {
+            double box_w = fmin(width * 0.5, l.logo_size * 3.0);
+            double fit = fmin(box_w / lw, l.logo_size / lh);
+            double dw = lw * fit, dh = lh * fit;
             cairo_save(cr);
-            cairo_translate(cr, l.logo_x, l.logo_y);
-            cairo_scale(cr, l.logo_size / lw, l.logo_size / lh);
+            cairo_translate(cr, floor(l.logo_x + (l.logo_size - dw) / 2.0),
+                            floor(l.logo_y + (l.logo_size - dh) / 2.0));
+            cairo_scale(cr, fit, fit);
             cairo_set_source_surface(cr, logo, 0, 0);
+            cairo_pattern_set_filter(cairo_get_source(cr), CAIRO_FILTER_BEST);
             cairo_paint(cr);
             cairo_restore(cr);
         }
@@ -107,9 +112,13 @@ void loginui_render_brand_progress(cairo_t *cr, int width, int height,
         int lw = cairo_image_surface_get_width(logo);
         int lh = cairo_image_surface_get_height(logo);
         if (lw > 0 && lh > 0) {
+            double box_w = fmin(width * 0.5, l.logo_size * 3.0);
+            double fit = fmin(box_w / lw, l.logo_size / lh);
+            double dw = lw * fit, dh = lh * fit;
             cairo_save(cr);
-            cairo_translate(cr, l.logo_x, l.logo_y);
-            cairo_scale(cr, l.logo_size / lw, l.logo_size / lh);
+            cairo_translate(cr, floor(l.logo_x + (l.logo_size - dw) / 2.0),
+                            floor(l.logo_y + (l.logo_size - dh) / 2.0));
+            cairo_scale(cr, fit, fit);
             cairo_set_source_surface(cr, logo, 0, 0);
             cairo_pattern_set_filter(cairo_get_source(cr), CAIRO_FILTER_GOOD);
             cairo_paint(cr);
-- 

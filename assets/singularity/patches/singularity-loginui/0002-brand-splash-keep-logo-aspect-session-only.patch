From 309d8292a5fad73dab1b24f4cce8d5702585c12f Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Wed, 7 Oct 2026 22:25:09 -0400
Subject: [PATCH] brand splash: keep the logo aspect ratio

loginui_render_brand() scaled the logo with cairo_scale(size / lw,
size / lh), forcing every logo into a size x size square. singularity-splash
loads the OS wordmark with loginui_load_image(path, -1, 256), which gives a
wide image (about 3430x256 for the 13:1 NCZ-OS wordmark), so the splash
squeezed it horizontally and stretched it vertically.

Fit the logo inside a box (size tall, up to 3x size or half the surface
wide) with a single scale factor, centred, and place the loading bar 48 px
under the drawn logo. Square emblems are unchanged. Load the default brand
logo up to 4x size wide so a wide mark stays sharp.
---
 src/brand.c | 20 ++++++++++++++++----
 1 file changed, 16 insertions(+), 4 deletions(-)

diff --git a/src/brand.c b/src/brand.c
--- a/src/brand.c
+++ b/src/brand.c
@@ -28,10 +28,20 @@
         int lw = cairo_image_surface_get_width(logo);
         int lh = cairo_image_surface_get_height(logo);
         if (lw > 0 && lh > 0) {
+            /* Fit inside a box (logo_size tall, up to 3x logo_size / half the
+             * surface wide) with ONE scale factor so the aspect ratio is kept.
+             * Square emblems still come out logo_size x logo_size; a wide
+             * wordmark is no longer squeezed into a square. Coordinates are the
+             * logical surface size, so a scaled output scales the whole result. */
+            double box_w = fmin(w * 0.5, l.logo_size * 3.0);
+            double s = fmin(box_w / lw, l.logo_size / lh);
+            double dw = lw * s, dh = lh * s;
             cairo_save(cr);
-            cairo_translate(cr, l.logo_x, l.logo_y);
-            cairo_scale(cr, l.logo_size / lw, l.logo_size / lh);
+            cairo_translate(cr, floor((w - dw) / 2.0),
+                            floor(l.logo_y + (l.logo_size - dh) / 2.0));
+            cairo_scale(cr, s, s);
             cairo_set_source_surface(cr, logo, 0, 0);
+            cairo_pattern_set_filter(cairo_get_source(cr), CAIRO_FILTER_BEST);
             cairo_paint(cr);
             cairo_restore(cr);
         }

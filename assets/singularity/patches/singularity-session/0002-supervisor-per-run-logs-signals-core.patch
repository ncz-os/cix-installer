From ee99ec75983ff09dcceda0a9b68714284a854d71 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Sun, 4 Oct 2026 11:40:52 -0400
Subject: [PATCH] supervisor: keep per-run output, name crash signals, allow
 cores

The supervisor appended every shell restart to a single state/desktop.log, and
the next launcher invocation moved that aside to desktop.log.1 -- overwriting
the run that actually crashed. The failing shell's own stdout/stderr was
destroyed exactly when it was needed for forensics, and no coredump existed
because the shell inherited a soft core limit of 0.

Each run now gets its own timestamped file under state/runs/; the newest 8 are
kept and no previous run's file is ever truncated. desktop.log remains the
supervisor's status log. Exit statuses above 128 are logged with the signal
name (e.g. 139 SEGV) instead of the bare number, and the soft core limit is
raised in the child subshell (ulimit -c unlimited, honouring the hard limit) so
systemd-coredump can capture a core.

The crash-count window, safe-mode request, and clean-exit reset paths are
unchanged.

---
 src/singularity-desktop-session.in | 54 ++++++++++++++++++++++++++++--
 1 file changed, 52 insertions(+), 2 deletions(-)

diff --git a/src/singularity-desktop-session.in b/src/singularity-desktop-session.in
index c0b7831..db4acad 100755
--- a/src/singularity-desktop-session.in
+++ b/src/singularity-desktop-session.in
@@ -66,18 +66,66 @@ stop_helpers_of() {
     rm -f "$_file"
 }
 
+# Per-run child output. Each supervisor restart gets its own timestamped file
+# under state/runs/, the newest _RUN_KEEP are kept, and a previous run's file is
+# never truncated. Before this, every restart appended to the single desktop.log
+# and the next launcher invocation moved that to desktop.log.1 -- so the run
+# that actually crashed was overwritten and its stdout/stderr lost. desktop.log
+# stays as the supervisor's own status log.
+_RUN_DIR="$_STATE/runs"
+_RUN_KEEP=8
+mkdir -p "$_RUN_DIR" 2>/dev/null || true
+
+_run_log_path() { # $1 = sequence number within this supervisor process
+    printf '%s/desktop-%s-%s-%s.log\n' "$_RUN_DIR" "$(date -u +%Y%m%dT%H%M%SZ)" "$$" "$1"
+}
+
+_prune_run_logs() {
+    # Keep the newest $_RUN_KEEP per-run files; never remove a newer one.
+    ls -1t "$_RUN_DIR"/desktop-*.log 2>/dev/null |
+        tail -n +$((_RUN_KEEP + 1)) | while IFS= read -r _old; do
+            [ -n "$_old" ] && rm -f -- "$_old"
+        done
+    return 0
+}
+
+_exit_status_text() { # $1 = exit status; name the signal when it is > 128
+    if [ "$1" -gt 128 ] 2>/dev/null; then
+        _sig=$(( $1 - 128 ))
+        _signame=$(kill -l "$_sig" 2>/dev/null || true)
+        if [ -n "$_signame" ]; then
+            printf '%s (signal %s: %s)' "$1" "$_sig" "$_signame"
+        else
+            printf '%s (signal %s)' "$1" "$_sig"
+        fi
+    else
+        printf '%s' "$1"
+    fi
+}
+
 run_desktop_supervisor() {
     _crashes=0
     _crash_window_started=0
     _crash_window_seconds=300
     _crash_limit=3
+    _run_seq=0
     while true; do
         _t0=$SECONDS
-        "$_DESKTOP" >> "$_LOG" 2>&1 &
+        _run_seq=$((_run_seq + 1))
+        _RUNLOG=$(_run_log_path "$_run_seq")
+        (
+            # systemd-coredump can only capture a core when the soft limit is
+            # non-zero (the image ships soft 0); the hard limit is what gates
+            # this, so raise it only as far as the hard limit allows.
+            ulimit -c unlimited 2>/dev/null || true
+            exec "$_DESKTOP"
+        ) >> "$_RUNLOG" 2>&1 &
         _shell_pid=$!
         record_helper "$_shell_pid" "$_DESKTOP"
         wait "$_shell_pid"
         _EC=$?
+        echo "[$(date)] singularity-desktop run output: $_RUNLOG" >> "$_LOG"
+        _prune_run_logs
         _dt=$((SECONDS - _t0))
         if [ $_EC -eq 0 ]; then
             echo "[$(date)] singularity-desktop exited 0, restarting..." >> "$_LOG"
@@ -105,7 +153,9 @@ run_desktop_supervisor() {
                 kill "$PPID" 2>/dev/null || true
                 return 1
             fi
-            echo "[$(date)] singularity-desktop exited $_EC after ${_dt}s (crash $_crashes/$_crash_limit), restarting in 2s..." >> "$_LOG"
+            _STATUS=$(_exit_status_text "$_EC")
+            printf '[%s] exited %s after %ss\n' "$(date)" "$_STATUS" "$_dt" >> "$_RUNLOG"
+            echo "[$(date)] singularity-desktop exited $_STATUS after ${_dt}s (crash $_crashes/$_crash_limit), restarting in 2s..." >> "$_LOG"
             sleep 2
         fi
     done
-- 
2.55.0


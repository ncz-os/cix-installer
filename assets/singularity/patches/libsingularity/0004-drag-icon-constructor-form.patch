From d7eb42b210d391014a9cbc5a34c94d1a698c83cc Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Wed, 7 Oct 2026 12:19:47 -0400
Subject: [PATCH] drag-lift: create the DragIcon with its constructor form

Debian forky's gtk4.vapi (Vala 0.56.19, GTK 4.24) binds gtk_drag_icon_get_for_drag
as the constructor DragIcon.get_for_drag, so calling it as a static method stops
valac with: drag_lift.vala:100.24-100.54: error: use `new' operator to create
new objects.
---
 src/animation/drag_lift.vala | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/animation/drag_lift.vala b/src/animation/drag_lift.vala
index 1715aef..ffc0c5b 100644
--- a/src/animation/drag_lift.vala
+++ b/src/animation/drag_lift.vala
@@ -97,7 +97,7 @@ namespace Singularity.Animation {
             if (!use_icon || item.get_width() <= 0) return;
             var bin = build_icon(item);
             _icon_bin = bin;
-            var icon = Gtk.DragIcon.get_for_drag(drag) as Gtk.DragIcon;
+            var icon = new Gtk.DragIcon.get_for_drag(drag) as Gtk.DragIcon;
             if (icon == null) return;
             icon.child = bin;
             double x = _press_x, y = _press_y;
-- 
2.55.0


From 12557117aeaf2954c90a30f5c30f025a21f765ea Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Sun, 6 Sep 2026 23:22:04 -0400
Subject: [PATCH] fix(SelectionRow): add set_options() for id/label pairs set
 after construction

set_items(string[]) is the only way to populate a SelectionRow's list
after construction, and it forces options = null -- its current-value
domain IS the display string. That's harmless when an option's id and
label are the same token, but breaks the moment they differ and the
row's item list is only known after an async load (so with_options()
can't be used at construction time either).

Concretely: singularity-shell's OCS wallpaper browser adds a synthetic
Bing entry (id "bing", label "Bing") to a provider list loaded
asynchronously, then calls set_items(). Selecting Bing in the UI set
current_value to "Bing" (the label), which never matched the
BING_PROVIDER_ID ("bing") comparison used everywhere downstream --
the browser silently fell through to the OCS code path and produced
zero results for a provider that has real, working data.

set_options() mirrors set_items() exactly but takes real
Singularity.Core.AppSettingOption id/label pairs, so current_value and
the selected() signal both carry the id even when it differs from the
label -- the with_options() constructor's own contract, just available
after construction.
---
 src/ui/preferences/preferences.vala | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/src/ui/preferences/preferences.vala b/src/ui/preferences/preferences.vala
index 4339307..18040d8 100644
--- a/src/ui/preferences/preferences.vala
+++ b/src/ui/preferences/preferences.vala
@@ -940,6 +940,21 @@ namespace Singularity.Widgets {
             if (expanded) populate_list();
         }
 
+        /**
+         * Replaces the current option list with id/label pairs and rebuilds
+         * the inner list box -- the with_options() equivalent of set_items(),
+         * for a row whose option list is only known after an async load
+         * (set_items()'s current-value domain is the label itself, which
+         * breaks the moment an option's id and display label differ).
+         *
+         * @param new_options New id/label option list.
+         */
+        public void set_options(Gee.ArrayList<Singularity.Core.AppSettingOption> new_options) {
+            options = new_options;
+            items = new GLib.List<string>();
+            if (expanded) populate_list();
+        }
+
         private void populate_list() {
             filter_list(search_entry);
         }

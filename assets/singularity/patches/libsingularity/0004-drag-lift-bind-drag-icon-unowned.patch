From c5ac5508686661933bc6653ba6feb0de39148372 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Wed, 7 Oct 2026 12:23:27 -0400
Subject: [PATCH] drag lift: bind gtk_drag_icon_get_for_drag as the unowned
 function it is

Vala 0.56's gtk4.vapi declares DragIcon.get_for_drag as a named constructor,
so Gtk.DragIcon.get_for_drag(drag) fails with "use `new' operator to create
new objects" and, if given `new', would unref the drag's existing icon
widget it never owned. Bind the C function as an unowned static function in
gdkextra.vapi and call that.
---
 src/animation/drag_lift.vala | 2 +-
 src/vapi/gdkextra.vapi       | 8 ++++++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/animation/drag_lift.vala b/src/animation/drag_lift.vala
index 1715aef..7a4e724 100644
--- a/src/animation/drag_lift.vala
+++ b/src/animation/drag_lift.vala
@@ -97,7 +97,7 @@ namespace Singularity.Animation {
             if (!use_icon || item.get_width() <= 0) return;
             var bin = build_icon(item);
             _icon_bin = bin;
-            var icon = Gtk.DragIcon.get_for_drag(drag) as Gtk.DragIcon;
+            var icon = GdkExtra.drag_icon_for_drag(drag) as Gtk.DragIcon;
             if (icon == null) return;
             icon.child = bin;
             double x = _press_x, y = _press_y;
diff --git a/src/vapi/gdkextra.vapi b/src/vapi/gdkextra.vapi
index 5171720..d68bc19 100644
--- a/src/vapi/gdkextra.vapi
+++ b/src/vapi/gdkextra.vapi
@@ -21,4 +21,12 @@ namespace GdkExtra {
         [CCode (cname = "gdk_memory_texture_builder_build")]
         public Gdk.Texture build ();
     }
+
+    /* GTK's own vapi (Vala 0.56 / GTK 4.24) declares gtk_drag_icon_get_for_drag
+     * as a named constructor, DragIcon.get_for_drag, which Vala treats as
+     * returning a new owned reference. The C function returns the drag's
+     * existing icon widget (transfer none), so bind it as the unowned static
+     * function it is. */
+    [CCode (cname = "gtk_drag_icon_get_for_drag")]
+    public static unowned Gtk.Widget drag_icon_for_drag (Gdk.Drag drag);
 }
-- 

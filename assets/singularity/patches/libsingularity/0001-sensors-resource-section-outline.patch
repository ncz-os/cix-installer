From 025192d7b8447e7b3d7e3c7de052cf86bf70eed9 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Sat, 26 Sep 2026 15:35:32 -0400
Subject: [PATCH] style: bordered frame for stacked popover sections

Adds a .sensors-resource-section CSS class: a 1px border, 8px radius, and
padding around each grouped section so stacked resource-pool sections sharing
one popover column (GPU, VPU, Storage, ...) read as distinct cards instead of
one continuous list.

Assisted-by: Claude Code:claude-opus-5
AI-Scope: Rebased an existing downstream CSS patch onto current upstream head after the original anchor line moved.
---
 src/style/style.css | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/style/style.css b/src/style/style.css
index 5f20bb8..de4f489 100644
--- a/src/style/style.css
+++ b/src/style/style.css
@@ -6631,3 +6631,13 @@ button.recent-color-swatch {
     min-width: 0;
     min-height: 0;
 }
+
+/* Bordered frame so stacked sections sharing a popover column (e.g. the
+   sensors panel resource-pool groups: GPU, VPU, Storage, ...) read as
+   distinct cards instead of one continuous list. */
+.sensors-resource-section {
+    border: 1px solid alpha(@text_color, 0.12);
+    border-radius: 8px;
+    padding: 8px 10px;
+    margin-bottom: 4px;
+}

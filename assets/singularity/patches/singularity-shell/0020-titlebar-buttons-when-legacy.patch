From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Mon, 13 Oct 2026 02:38:00 -0400
Subject: [PATCH] titlebar: include minimize and maximize buttons in the
 SSD layout when legacy-titlebar is on

The labwc SSD layout (Chromium, foot, GTK apps with CSD off) is sourced
from org.gnome.desktop.wm.preferences.button-layout, whose shipped default
is 'appmenu:close' -- close-only, no min/max. The dev.sinty.desktop
'legacy-titlebar' toggle (schema text: 'Show a classic static titlebar
with inline buttons instead of the floating hover window controls')
controls ONLY libsingularity CSD apps and does not feed write_labwc_rc_xml
or apply_gtk_decoration_layout, so a user who flipped it on still got
close-only on every SSD window.

Add a single source of truth (effective_button_layout) that returns
'appmenu:minimize,maximize,close' when legacy-titlebar is on, and feed it
into both the labwc rc.xml generator and the GTK4/xsettingsd propagation.
Re-render rc.xml and GTK decoration layout whenever legacy-titlebar
changes, mirroring the existing button-layout listener.

Upstream default (legacy-titlebar=false) is unchanged: SSD layout still
follows GNOME's button-layout as before. The change is a generic helper,
no NCZ paths or naming.
diff --git a/src/core/shortcut_manager.vala b/src/core/shortcut_manager.vala
index ec17e9a..16bfb93 100644
--- a/src/core/shortcut_manager.vala
+++ b/src/core/shortcut_manager.vala
@@ -199,6 +199,10 @@ namespace Singularity {
                     apply_gtk_decoration_layout();
                 });
             }
+            settings.changed["legacy-titlebar"].connect(() => {
+                write_labwc_rc_xml();
+                apply_gtk_decoration_layout();
+            });
             Bus.own_name(
                 BusType.SESSION,
                 "dev.sinty.desktop",
@@ -712,13 +716,21 @@ namespace Singularity {
 
         private string translate_button_layout() {
             if (wm_settings == null) return ":close";
-            string raw = wm_settings.get_string("button-layout");
+            string raw = effective_button_layout();
             string[] halves = raw.split(":", 2);
             string left = halves.length > 0 ? translate_buttons(halves[0]) : "";
             string right = halves.length > 1 ? translate_buttons(halves[1]) : "";
             return left + ":" + right;
         }
 
+        // Effective GNOME button-layout, overridden by legacy-titlebar.
+        // When legacy-titlebar is on, SSD windows get minimize+maximize regardless
+        // of what the user picked for GNOME's button-layout (which defaults close-only).
+        private string effective_button_layout() {
+            if (settings.get_boolean("legacy-titlebar")) return "appmenu:minimize,maximize,close";
+            return wm_settings.get_string("button-layout");
+        }
+
         private string translate_buttons(string part) {
             var result = new StringBuilder();
             foreach (string token in part.split(",")) {
@@ -741,7 +753,7 @@ namespace Singularity {
 
         private void apply_gtk_decoration_layout() {
             if (wm_settings == null) return;
-            string layout = wm_settings.get_string("button-layout");
+            string layout = effective_button_layout();
 
             // 1. Apply immediately to all GTK4 windows in this process.
             Gtk.Settings.get_default().gtk_decoration_layout = layout;

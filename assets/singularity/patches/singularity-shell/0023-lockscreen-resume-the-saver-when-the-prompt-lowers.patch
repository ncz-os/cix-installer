+/* Resume after a freeze: the prompt was left alone until it lowered, so the
+ * saver should animate again. Clear the hold and let tick() start a fresh
+ * source. The held frames are deliberately NOT cleared: they stay on screen
+ * until the new source delivers its first frame, so there is no flash of the
+ * lock's own background. If the new source fails, the normal fault path
+ * clears the frames (fail-closed). No-op unless the source is held. */
+void lock_framesrc_resume(struct lock_framesrc *h) {
+    if (!h || !h->held || !h->enabled) return;
+    h->held = false;
+    for (struct lfs_out *o = h->outs; o; o = o->next) o->held = false;
+    if (h->conn_fd >= 0) { close(h->conn_fd); h->conn_fd = -1; }
+    h->state = LFS_IDLE;
+    h->backoff_ms = 0;
+    uint64_t now = h->now_ms ? h->now_ms : lfs_now_ms();
+    /* A previous child still inside its SIGTERM grace would make spawn_source()
+     * a no-op; start after reap_child() has had the chance to escalate. */
+    h->reopen_at_ms = (h->child > 0) ? now + LFS_KILL_GRACE_MS + 100u : 0;
+    lfs_log(h, "frame source resumed (prompt lowered)");
+}
+
 void lock_framesrc_tick(struct lock_framesrc *h, uint64_t now_ms) {
     if (!h) return;
     h->now_ms = now_ms;

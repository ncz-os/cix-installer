@@ -525,28 +548,152 @@ static void render_output(struct lock_output *o) {
  * off-screen and hands us a buffer fd over a Unix socket; we import it and
  * present it on the lock surface. The renderer is never code in this process,
  * so a fault there can only cost us the animation: on any error we simply paint
- * the prompt again. These two callbacks are the whole presentation surface.
+ * the prompt again.
+ *
+ * The source keeps running for as long as the lock is held. The first input
+ * raises the unlock prompt OVER the live frames (the clock and password card
+ * are composited on top of the current frame) rather than dropping to a flat
+ * background, and after the prompt has been idle the raw frames show again.
+ * Presentation is therefore driven from two places: framesrc_present() for the
+ * frames themselves and render_output() for the prompt composited over them.
  */
-static void framesrc_present(void *user, struct wl_buffer *buf,
-                             uint32_t w, uint32_t h, int32_t scale) {
+
+#define LOCK_PROMPT_DEFAULT_MS 300000u   /* how long the prompt stays up (5 min) */
+
+static uint64_t prompt_deadline_ms;   /* monotonic ms at which the prompt hides */
+static uint32_t prompt_delay_ms;      /* SINGULARITY_LOCK_RENDERER_DELAY_MS */
+
+/* Compose o->frame_surface (the latest saver frame) plus a translucent scrim
+ * into o->backdrop, at the surface's physical size. Returns NULL when there is
+ * no frame to draw -- the caller then falls back to the lock's own background,
+ * which is the fail-closed look. */
+static cairo_surface_t *build_backdrop(struct lock_output *o, int32_t sc) {
+    if (!o->frame_surface) return NULL;
+    int bw = (int)(o->width * (uint32_t)sc);
+    int bh = (int)(o->height * (uint32_t)sc);
+    if (bw <= 0 || bh <= 0) return NULL;
+    if (!o->backdrop ||
+        cairo_image_surface_get_width(o->backdrop) != bw ||
+        cairo_image_surface_get_height(o->backdrop) != bh) {
+        if (o->backdrop) cairo_surface_destroy(o->backdrop);
+        o->backdrop = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, bw, bh);
+        if (cairo_surface_status(o->backdrop) != CAIRO_STATUS_SUCCESS) {
+            cairo_surface_destroy(o->backdrop);
+            o->backdrop = NULL;
+            return NULL;
+        }
+    }
+    cairo_t *b = cairo_create(o->backdrop);
+    if (cairo_status(b) != CAIRO_STATUS_SUCCESS) { cairo_destroy(b); return NULL; }
+    cairo_set_operator(b, CAIRO_OPERATOR_SOURCE);
+    cairo_set_source_rgb(b, 0.10, 0.10, 0.11);
+    cairo_paint(b);
+    cairo_set_operator(b, CAIRO_OPERATOR_OVER);
+    int fw = cairo_image_surface_get_width(o->frame_surface);
+    int fh = cairo_image_surface_get_height(o->frame_surface);
+    if (fw > 0 && fh > 0) {
+        double s = (bw / (double)fw > bh / (double)fh) ? bw / (double)fw : bh / (double)fh;
+        cairo_save(b);
+        cairo_translate(b, (bw - fw * s) / 2.0, (bh - fh * s) / 2.0);
+        cairo_scale(b, s, s);
+        cairo_set_source_surface(b, o->frame_surface, 0, 0);
+        cairo_paint(b);
+        cairo_restore(b);
+    }
+    /* Keep the clock and the card legible over an arbitrary saver. */
+    cairo_set_source_rgba(b, 0, 0, 0, 0.35);
+    cairo_paint(b);
+    cairo_destroy(b);
+    return o->backdrop;
+}
+
+static void framesrc_present(void *user, const struct lock_framesrc_frame *fr) {
     struct lock_output *o = user;
-    if (!o || !o->surface) return;
-    /* Stop the Cairo animation loop for this surface while frames are shown. */
+    if (!o || !o->surface || !fr) return;
+
+    /* Keep a view of the frame so the prompt can be composited over it, and so
+     * it can be shown again once the prompt hides. The mapping behind
+     * fr->pixels stays valid until the next present()/clear() for this output
+     * (the host releases it only after this callback returns), so the surface
+     * never outlives its pixels. */
+    if (o->frame_surface) { cairo_surface_destroy(o->frame_surface); o->frame_surface = NULL; }
+    if (fr->pixels && fr->width > 0 && fr->height > 0 && fr->stride > 0) {
+        cairo_format_t fmt = (fr->format == LOCK_FRAMESRC_FORMAT_ARGB8888)
+                                 ? CAIRO_FORMAT_ARGB32 : CAIRO_FORMAT_RGB24;
+        o->frame_surface = cairo_image_surface_create_for_data(
+            (unsigned char *)fr->pixels, fmt, (int)fr->width, (int)fr->height,
+            (int)fr->stride);
+        if (cairo_surface_status(o->frame_surface) != CAIRO_STATUS_SUCCESS) {
+            cairo_surface_destroy(o->frame_surface);
+            o->frame_surface = NULL;
+        }
+    }
+    o->frame_buffer = fr->buffer;
+
+    if (o->prompt_visible) {
+        /* The prompt owns the surface; redraw it over the fresh frame. */
+        render_output(o);
+        return;
+    }
+
+    /* No prompt: show the raw frames. Stop the Cairo animation loop for this
+     * surface while the source owns it. */
     if (o->frame_cb) { wl_callback_destroy(o->frame_cb); o->frame_cb = NULL; }
     o->saver_active = true;
-    wl_surface_set_buffer_scale(o->surface, scale > 0 ? scale : 1);
-    wl_surface_attach(o->surface, buf, 0, 0);
-    wl_surface_damage_buffer(o->surface, 0, 0, (int)w, (int)h);
+    wl_surface_set_buffer_scale(o->surface, fr->scale > 0 ? fr->scale : 1);
+    wl_surface_attach(o->surface, fr->buffer, 0, 0);
+    wl_surface_damage_buffer(o->surface, 0, 0, (int)fr->width, (int)fr->height);
     wl_surface_commit(o->surface);
 }
 
 static void framesrc_clear(void *user) {
     struct lock_output *o = user;
     if (!o) return;
+    if (o->frame_surface) { cairo_surface_destroy(o->frame_surface); o->frame_surface = NULL; }
+    o->frame_buffer = NULL;
     o->saver_active = false;
     if (o->configured) render_output(o);
 }
 
+/* First input: raise the prompt over the running saver. The frame source is not
+ * stopped, so frames keep arriving behind the prompt. */
+static void raise_prompt(void) {
+    if (!framesrc) return;
+    prompt_deadline_ms = (uint64_t)(now_us() / 1000)
+        + (prompt_delay_ms ? prompt_delay_ms : LOCK_PROMPT_DEFAULT_MS);
+    bool changed = false;
+    for (struct lock_output *o = outputs; o; o = o->next) {
+        if (!o->configured) continue;
+        if (!o->prompt_visible) { o->prompt_visible = true; changed = true; }
+    }
+    if (changed) {
+        fprintf(stderr, "lock: prompt raised over saver\n");
+        render_all();
+    }
+}
+
+/* Idle after the prompt: hide it and show the raw saver frames again. A source
+ * that has stopped has no frames to return to, so it keeps the prompt. */
+static void lower_prompt(void) {
+    if (!framesrc) return;
+    bool lowered = false;
+    for (struct lock_output *o = outputs; o; o = o->next) {
+        if (!o->prompt_visible || !o->frame_buffer || !o->surface) continue;
+        o->prompt_visible = false;
+        lowered = true;
+        if (o->frame_cb) { wl_callback_destroy(o->frame_cb); o->frame_cb = NULL; }
+        o->saver_active = true;
+        int32_t sc = o->scale > 0 ? o->scale : 1;
+        wl_surface_set_buffer_scale(o->surface, sc);

@@ -484,6 +493,20 @@ static void render_output(struct lock_output *o) {
     st.auth_label = (access("/run/sinty-recoverd.sock", F_OK) == 0) ? "PIN" : NULL;
     bool animating = apply_motion(&st);
 
+#ifdef LOCK_FRAMESRC
+    /* Prompt over the live saver: use the current frame (with a scrim) as the
+     * background. With no frame -- a stopped source -- the lock's own
+     * background stands, which is the fail-closed dark scrim. */
+    if (o->prompt_visible && o->frame_surface) {
+        cairo_surface_t *bd = build_backdrop(o, sc);
+        if (bd) {

+++ b/src/lockscreen/lock_framesrc.h
@@ -31,15 +31,36 @@ struct wl_display;
 struct wl_shm;
 struct wl_buffer;
 
+/* Pixel format of a delivered frame. The values match the wire protocol so the
+ * two can be passed through unchanged. */
+enum lock_framesrc_format {
+    LOCK_FRAMESRC_FORMAT_ARGB8888 = 0,
+    LOCK_FRAMESRC_FORMAT_XRGB8888 = 1,
+};
+
+/* One frame handed to the host by present(). `buffer` is imported and owned by
+ * the frame-source host; it stays valid for this output until the next
+ * present()/clear() and the callee must not destroy it. `pixels` is a read-only
+ * mapping of the very same frame (stride bytes per row, `format` above) with the
+ * same lifetime; it is NULL if the frame could not be mapped in this process. A
+ * host that merely shows the frames can ignore `pixels` and attach `buffer`; a
+ * host that composites its own UI over them (an unlock prompt, say) draws from
+ * `pixels`. */
+struct lock_framesrc_frame {
+    struct wl_buffer *buffer;
+    const void *pixels;
+    uint32_t width, height, stride;
+    enum lock_framesrc_format format;
+    int32_t scale;
+};
+
 /* Callbacks implemented by the lock client. `user` is the per-output pointer
  * the caller registered with lock_framesrc_add_output(). */
 struct lock_framesrc_ops {
-    /* A frame is ready for this output. The callee attaches the buffer to its
-     * lock surface and commits it. The buffer is owned by the host and stays
-     * valid until the next present()/clear() for the same output or until the
-     * host is freed; the callee must not destroy it. */
-    void (*present)(void *user, struct wl_buffer *buf, uint32_t width,
-                    uint32_t height, int32_t scale);
+    /* A frame is ready for this output. The callee presents it: either by
+     * attaching `frame->buffer` to its lock surface, or by compositing it with
+     * its own UI and attaching the result. */
+    void (*present)(void *user, const struct lock_framesrc_frame *frame);
     /* Return this output to the lock's own UI (the prompt/wallpaper). Any frame
      * previously presented for it must be forgotten. */
     void (*clear)(void *user);
@@ -79,16 +100,13 @@ void lock_framesrc_resize_output(struct lock_framesrc *h, void *user,
  * frame presented for it is cleared first. */
 void lock_framesrc_remove_output(struct lock_framesrc *h, void *user);
 
-/* Enable/disable saver display. Enabling starts the frame source; disabling
- * hides frames and stops the source. No-op if a frame source command is unset
- * (external sources still work when enabled). */
+/* Enable/disable saver display. Enabling starts the frame source and keeps it

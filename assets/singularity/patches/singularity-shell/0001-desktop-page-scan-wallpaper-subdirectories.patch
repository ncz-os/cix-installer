+        /*
+         * How many directory levels below each search root to scan.
+         *
+         * The scan used to enumerate each root and accept only entries whose
+         * content-type began with "image/". A directory's content-type is
+         * "inode/directory", so it failed that test and was skipped without
+         * ever being descended into -- which meant wallpapers were only ever
+         * found if they sat directly in a search root. Any distribution or
+         * user that groups wallpapers into folders had them silently ignored;
+         * the picker simply showed nothing from them, which is hard to tell
+         * apart from having none installed.
+         *
+         * Two levels covers the common layouts: a vendor folder such as
+         * <root>/<distro>/, and a collection or artist pack one deeper at
+         * <root>/<distro>/<pack>/. It is deliberately bounded rather than a
+         * full walk so a stray symlink or a deep unrelated tree under a search
+         * root cannot turn the scan into an unbounded traversal.
+         */
+        private const int WALLPAPER_SCAN_DEPTH = 2;
+
+        /*
+         * Collect image files from dir, descending up to depth levels.
+         * Runs on the wallpaper-scan thread; errors are ignored per directory
+         * so one unreadable folder cannot abort the whole scan.
+         */
+        private void scan_wallpaper_dir(File dir,
+                                        ArrayList<WallpaperCandidate> candidates,
+                                        HashSet<string> thread_seen,
+                                        int depth) {
+            try {
+                if (!dir.query_exists()) return;
+                var enumerator = dir.enumerate_children(
+                    "standard::name,standard::type,standard::content-type",
+                    FileQueryInfoFlags.NONE, null);
+                FileInfo info;
+                while ((info = enumerator.next_file(null)) != null) {
+                    if (info.get_file_type() == FileType.DIRECTORY) {
+                        if (depth > 0) {
+                            scan_wallpaper_dir(dir.get_child(info.get_name()),
+                                               candidates, thread_seen, depth - 1);
+                        }
+                        continue;
+                    }
+                    string mime = info.get_content_type();
+                    if (mime != null && mime.has_prefix("image/")) {
+                        string uri = dir.get_child(info.get_name()).get_uri();
+                        if (!thread_seen.contains(uri)) {
+                            thread_seen.add(uri);
+                            candidates.add(new WallpaperCandidate(uri, false));
+                        }
+                    }
+                }
+            } catch (Error e) {
+            }
+        }
+

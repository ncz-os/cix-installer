new file mode 100644
index 0000000..576acb6
--- /dev/null
+++ b/tests/lockscreen-framesrc/README.md
@@ -0,0 +1,35 @@
+# lockscreen frame-source host — headless test
+
+The lock client can present buffers rendered by a **separate process** (a
+screensaver) on its `ext-session-lock-v1` surfaces, so a screensaver is visible
+while the session is locked. The lock never runs renderer code, so a renderer
+fault can only make it fall back to its own prompt. This directory holds the
+headless test.
+
+Build with the feature on:
+
+```sh
+meson setup build -Dlock_framesrc=enabled
+ninja -C build
+```
+
+`test-framesrc.sh` needs a real compositor in a throwaway environment. It drives
+`labwc` (headless), a lock client, and `singularity-lock-framesrc-testsrc` (a
+deterministic frame source that renders a trivial pattern into a memfd — no GPU),
+and asserts on the lock's stderr:
+
+- frames from the source are presented, then a key press dismisses them;
+- `kill -9` of the source, a hung source, a short buffer fd and a source that
+  dies on a GPU error each leave the **lock held** and the client alive;
+- a build with the feature **off** is inert.
+
+Environment (defaults assume the binaries are in `$WORK`, e.g. a container):
+
+| var | meaning |
+|---|---|
+| `WORK` | scratch dir holding the binaries and `tmp/` |
+| `LOCK` | feature-on lock client |
+| `LOCKOFF` | feature-off lock client (case 6) |
+| `SRC` | `singularity-lock-framesrc-testsrc` |
+
+Requirements in the test environment: `labwc`, `wtype`, `wayland-utils`.
diff --git a/tests/lockscreen-framesrc/test-framesrc.sh b/tests/lockscreen-framesrc/test-framesrc.sh
new file mode 100755
index 0000000..60e0e25
--- /dev/null
+++ b/tests/lockscreen-framesrc/test-framesrc.sh
@@ -0,0 +1,140 @@
+#!/bin/bash
+# Headless labwc test for the lock client's out-of-process frame source.
+#
+# Runs INSIDE a debian:forky container with: labwc, wtype, wayland-utils, and the
+# three binaries built by build.sh, all under /work. It drives a real labwc
+# (WLR_BACKENDS=headless) and a real lock client, and asserts on the lock's own
+# stderr log. Restarts labwc per case so a lock left held never wedges the next
+# case.
+set -u
+
+WORK="${WORK:-/work}"
+RT="$WORK/tmp/xdg"
+SOCK="$RT/lfs.sock"
+LOCK="${LOCK:-$WORK/singularity-lockscreen-on}"
+LOCKOFF="${LOCKOFF:-$WORK/singularity-lockscreen-off}"
+SRC="${SRC:-$WORK/singularity-lock-framesrc-testsrc}"
+
+PASS=0; FAIL=0
+ok()   { echo "  PASS: $1"; PASS=$((PASS+1)); }
+bad()  { echo "  FAIL: $1"; FAIL=$((FAIL+1)); }
+have() { grep -qF -- "$2" "$1" 2>/dev/null; }
+
+mkdir -p "$RT"; chmod 700 "$RT"
+export XDG_RUNTIME_DIR="$RT"
+export WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1 WLR_HEADLESS_OUTPUTS=1
+export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1
+unset WAYLAND_DISPLAY
+
+LABWC_PID=""
+LOCK_PID=""
+start_labwc() {
+    rm -f "$RT"/wayland-* "$SOCK"
+    labwc >"$WORK/tmp/labwc.log" 2>&1 &
+    LABWC_PID=$!
+    for _ in $(seq 1 50); do
+        [ -S "$RT/wayland-0" ] && export WAYLAND_DISPLAY=wayland-0 && return 0
+        [ -S "$RT/wayland-1" ] && export WAYLAND_DISPLAY=wayland-1 && return 0
+        sleep 0.1
+    done
+    echo "labwc did not create a wayland socket"; return 1
+}
+stop_all() {
+    [ -n "$LOCK_PID" ] && kill -9 "$LOCK_PID" 2>/dev/null
+    pkill -9 -f lock-framesrc-testsrc 2>/dev/null
+    [ -n "$LABWC_PID" ] && kill -9 "$LABWC_PID" 2>/dev/null
+    LOCK_PID=""; LABWC_PID=""
+    sleep 0.3
+}
+trap 'stop_all' EXIT
+
+start_lock() { # $1 = env value for SINGULARITY_LOCK_RENDERER (may be empty), $2 log
+    local cmd="$1" log="$2"
+    : >"$log"; : >"${log}.lfs"
+    SINGULARITY_LOCK_RENDERER="$cmd" \
+    SINGULARITY_LOCK_RENDERER_SOCKET="$SOCK" \
+    SINGULARITY_LOCK_RENDERER_LOG="${log}.lfs" \
+    "$LOCK" >>"$log" 2>&1 &
+    LOCK_PID=$!
+}
+wait_for() { # $1 file, $2 string, $3 seconds
+    for _ in $(seq 1 $(( ${3:-5} * 10 ))); do
+        have "$1" "$2" && return 0
+        sleep 0.1
+    done
+    return 1
+}
+
+echo "== probe: labwc globals =="
+if ! start_labwc; then echo "FATAL: no headless labwc"; exit 1; fi
+wayland-info 2>/dev/null | grep -o "ext_session_lock_manager_v1" | head -1 \
+    && ok "labwc advertises ext_session_lock_manager_v1" \
+    || bad "labwc does NOT advertise ext_session_lock_manager_v1"
+stop_all
+
+echo "== case 1: frames render (happy path) =="
+start_labwc || exit 1
+start_lock "$SRC --frames 200" "$WORK/tmp/c1.log"
+if wait_for "$WORK/tmp/c1.log" "frame source accepted" 6; then ok "lock accepted the frame source"; else bad "lock did not accept the frame source"; fi
+if wait_for "$WORK/tmp/c1.log" "testsrc: frame seq=" 4; then ok "frame source rendered frames"; else bad "no frames rendered"; fi
+sleep 1
+fcount=$(grep -c "testsrc: frame seq=" "$WORK/tmp/c1.log" || true)
+if [ "${fcount:-0}" -ge 3 ]; then ok "multiple frames streamed ($fcount)"; else bad "too few frames ($fcount)"; fi
+if kill -0 "$LOCK_PID" 2>/dev/null; then ok "lock client alive while presenting"; else bad "lock client died"; fi
+# input: a key press must dismiss the saver back to the prompt. wtype creates a
+# transient virtual keyboard, so the first key can race the seat gaining the
+# keyboard capability; retry a few times.
+for _ in 1 2 3 4 5; do
+    wtype -d 300 -k a >/dev/null 2>&1
+    have "$WORK/tmp/c1.log" "stopped (user activity)" && break
+    sleep 0.3
+done
+if have "$WORK/tmp/c1.log" "stopped (user activity)"; then ok "input dismissed the saver"; else bad "input did not dismiss the saver"; fi
+if kill -0 "$LOCK_PID" 2>/dev/null; then ok "lock client alive after input"; else bad "lock died on input"; fi
+stop_all
+
+echo "== case 2: saver kill -9 (fail-closed) =="
+start_labwc || exit 1
+start_lock "$SRC --frames 200" "$WORK/tmp/c2.log"
+wait_for "$WORK/tmp/c2.log" "frame source accepted" 6 || true
+testsrc_pid=$(pgrep -f "lock-framesrc-testsrc" | head -1)
+if [ -n "$testsrc_pid" ]; then kill -9 "$testsrc_pid"; ok "killed the frame source (-9)"; else bad "frame source pid not found"; fi
+if wait_for "$WORK/tmp/c2.log" "frame source failed" 4 || wait_for "$WORK/tmp/c2.log" "exited status" 2; then ok "lock noticed the dead frame source"; else bad "lock did not notice the dead source"; fi
+sleep 0.5
+if kill -0 "$LOCK_PID" 2>/dev/null; then ok "lock client still alive after saver -9 (fail-closed)"; else bad "lock client died with the saver"; fi
+stop_all
+
+echo "== case 3: hung saver -> frame watchdog =="
+start_labwc || exit 1
+start_lock "$SRC --hang=2" "$WORK/tmp/c3.log"
+wait_for "$WORK/tmp/c3.log" "testsrc: hanging" 6 || true
+if wait_for "$WORK/tmp/c3.log" "frame watchdog" 6; then ok "frame watchdog fired on a hung saver"; else bad "frame watchdog did not fire"; fi
+if kill -0 "$LOCK_PID" 2>/dev/null; then ok "lock client alive after a hung saver"; else bad "lock died on a hung saver"; fi
+stop_all
+
+echo "== case 4: bad fd / short buffer rejected =="
+start_labwc || exit 1
+start_lock "$SRC --bad-fd --frames 3" "$WORK/tmp/c4.log"
+if wait_for "$WORK/tmp/c4.log" "shm too small" 6; then ok "short buffer rejected"; else bad "short buffer not rejected"; fi
+if kill -0 "$LOCK_PID" 2>/dev/null; then ok "lock client alive after a bad fd"; else bad "lock died on a bad fd"; fi
+stop_all
+
+echo "== case 5: saver GPU error (exits after HELLO) =="
+start_labwc || exit 1
+start_lock "$SRC --gpu-error" "$WORK/tmp/c5.log"
+if wait_for "$WORK/tmp/c5.log" "frame source failed" 6 || wait_for "$WORK/tmp/c5.log" "exited status" 3; then ok "GPU error handled"; else bad "GPU error not handled"; fi
+if kill -0 "$LOCK_PID" 2>/dev/null; then ok "lock client alive after a GPU error"; else bad "lock died on a GPU error"; fi
+stop_all
+
+echo "== case 6: default build is inert (no frame source) =="
+start_labwc || exit 1
+: >"$WORK/tmp/c6.log"
+"$LOCKOFF" >>"$WORK/tmp/c6.log" 2>&1 &
+LOCK_PID=$!
+if wait_for "$WORK/tmp/c6.log" "lock: configure" 6; then ok "default build locks as upstream"; else bad "default build did not lock"; fi
+if have "$WORK/tmp/c6.log" "framesrc" ; then bad "default build somehow used the frame source"; else ok "default build used no frame source"; fi
+stop_all
+
+echo ""
+echo "== RESULT: $PASS passed, $FAIL failed =="
+[ "$FAIL" -eq 0 ]

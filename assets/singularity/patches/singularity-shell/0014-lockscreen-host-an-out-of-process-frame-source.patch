@@ -0,0 +1,658 @@
+/*
+ * lock_framesrc.c - see lock_framesrc.h.
+ *
+ * SPDX-License-Identifier: MIT
+ *
+ * A small, deliberately defensive host for an out-of-process frame source. It
+ * owns an AF_UNIX SOCK_SEQPACKET listening socket, optionally spawns a frame
+ * source command, validates every message and every file descriptor before it
+ * is turned into a wl_buffer, presents at most one buffer per output, and drops
+ * to the caller's static UI on any fault. It never signals the lock client.
+ */
+#define _GNU_SOURCE
+#include "lock_framesrc.h"
+#include "lock_framesrc_proto.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <signal.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/un.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <wayland-client.h>
+
+#define LFS_DEFAULT_RESUME_MS 300000u   /* 5 min: the default hack-idle-delay */
+#define LFS_DEFAULT_STALL_MS    3000u
+#define LFS_HELLO_TIMEOUT_MS    3000u
+#define LFS_BACKOFF_MIN_MS       250u
+#define LFS_BACKOFF_MAX_MS     30000u
+#define LFS_KILL_GRACE_MS       1500u
+#define LFS_MAX_OUTPUTS           16u
+
+enum lfs_state { LFS_IDLE, LFS_WAITING, LFS_ACTIVE };
+
+struct lfs_out {
+    struct lock_framesrc *h;
+    struct lfs_out *next;
+    void *user;
+    char name[64];
+    uint32_t hash;
+    uint32_t buf_w, buf_h;   /* buffer size = logical * scale */
+    int32_t scale;
+    struct wl_buffer *cur;   /* currently presented buffer (owned here) */
+    bool has_frame;
+    uint32_t last_seq;
+};
+
+struct lock_framesrc {
+    struct wl_display *display;
+    struct wl_shm *shm;
+    const struct lock_framesrc_ops *ops;
+
+    char sock_path[192];
+    char *spawn_cmd;
+    char log_path[256];
+
+    int listen_fd;
+    int conn_fd;
+    pid_t child;
+    uint64_t child_kill_ms;
+
+    enum lfs_state state;
+    bool enabled;
+    uint32_t transport;
+
+    uint64_t now_ms;          /* last value passed to tick() */
+    uint64_t last_activity_ms;
+    uint64_t last_frame_ms;
+    uint64_t resume_ms;       /* idle delay before the saver returns after input */
+    bool want_start;          /* start immediately (lock engage), ignoring resume_ms */
+    uint64_t hello_deadline_ms;
+    uint64_t reopen_at_ms;
+    uint32_t backoff_ms;
+    uint32_t next_seq;        /* expected seq from the source */
+
+    struct lfs_out *outs;
+    uint32_t n_outs;
+};
+
+/* ---- logging ------------------------------------------------------------- */
+
+static void lfs_log(struct lock_framesrc *h, const char *fmt, ...) {
+    char line[512];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(line, sizeof line, fmt, ap);
+    va_end(ap);
+    fprintf(stderr, "[framesrc] %s\n", line);
+    fflush(stderr);
+    if (h && h->log_path[0]) {
+        FILE *f = fopen(h->log_path, "a");
+        if (f) { fprintf(f, "[framesrc] %s\n", line); fclose(f); }
+    }
+}
+
+static uint64_t lfs_now_ms(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000u + (uint64_t)ts.tv_nsec / 1000000u;
+}
+
+/* ---- helpers ------------------------------------------------------------- */
+
+static struct lfs_out *find_out_by_user(struct lock_framesrc *h, void *user) {
+    for (struct lfs_out *o = h->outs; o; o = o->next)
+        if (o->user == user) return o;
+    return NULL;
+}
+static struct lfs_out *find_out_by_hash(struct lock_framesrc *h, uint32_t hash) {
+    for (struct lfs_out *o = h->outs; o; o = o->next)
+        if (o->hash == hash) return o;
+    return NULL;
+}
+
+static void clear_output(struct lfs_out *o) {
+    if (o->cur) {
+        wl_buffer_destroy(o->cur);
+        o->cur = NULL;
+    }
+    if (o->has_frame) {
+        o->has_frame = false;
+        if (o->h->ops && o->h->ops->clear) o->h->ops->clear(o->user);
+    }
+}
+
+static void clear_all(struct lock_framesrc *h) {
+    for (struct lfs_out *o = h->outs; o; o = o->next) clear_output(o);
+}
+
+static int connect_timeout_ms = 0; /* unused placeholder to keep -Wunused happy */
+
+/* ---- socket setup -------------------------------------------------------- */
+
+static int make_listen_socket(const char *path, char *err, size_t errlen) {
+    struct sockaddr_un addr;
+    memset(&addr, 0, sizeof addr);
+    addr.sun_family = AF_UNIX;
+    if (strlen(path) >= sizeof addr.sun_path) {
+        snprintf(err, errlen, "socket path too long: %s", path);
+        return -1;
+    }
+    strncpy(addr.sun_path, path, sizeof addr.sun_path - 1);
+
+    int fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+    if (fd < 0) { snprintf(err, errlen, "socket: %s", strerror(errno)); return -1; }
+    unlink(path);
+    if (bind(fd, (struct sockaddr *)&addr, sizeof addr) != 0) {
+        snprintf(err, errlen, "bind(%s): %s", path, strerror(errno));
+        close(fd);
+        return -1;
+    }
+    if (listen(fd, 1) != 0) {
+        snprintf(err, errlen, "listen: %s", strerror(errno));
+        close(fd);
+        unlink(path);
+        return -1;
+    }
+    return fd;
+}
+
+static void default_socket_path(char *out, size_t outlen) {
+    const char *s = getenv("SINGULARITY_LOCK_RENDERER_SOCKET");
+    if (s && *s) { snprintf(out, outlen, "%s", s); return; }
+    const char *xdg = getenv("XDG_RUNTIME_DIR");
+    uid_t u = getuid();
+    if (xdg && *xdg) {
+        snprintf(out, outlen, "%s/singularity-lock-renderer-%u.sock", xdg, (unsigned)u);
+        return;
+    }
+    if (access("/run/user", W_OK) == 0) {
+        snprintf(out, outlen, "/run/user/%u/singularity-lock-renderer.sock", (unsigned)u);
+        return;
+    }
+    snprintf(out, outlen, "/tmp/singularity-lock-renderer-%u.sock", (unsigned)u);
+}
+
+/* ---- child lifecycle ----------------------------------------------------- */
+
+static void spawn_source(struct lock_framesrc *h) {
+    if (!h->spawn_cmd || !h->spawn_cmd[0]) return;
+    if (h->child > 0) return;
+    pid_t pid = fork();
+    if (pid < 0) { lfs_log(h, "fork failed: %s", strerror(errno)); return; }
+    if (pid == 0) {
+        /* child: frame source */
+        setsid();
+        setenv("SINGULARITY_LOCK_RENDERER_SOCKET", h->sock_path, 1);
+        execl("/bin/sh", "sh", "-c", h->spawn_cmd, (char *)NULL);
+        _exit(127);
+    }
+    h->child = pid;
+    h->child_kill_ms = 0;
+    lfs_log(h, "spawned frame source pid=%d cmd=%s", (int)pid, h->spawn_cmd);
+}
+
+static void reap_child(struct lock_framesrc *h) {
+    if (h->child <= 0) return;
+    int status = 0;
+    pid_t r = waitpid(h->child, &status, WNOHANG);
+    if (r == h->child) {
+        lfs_log(h, "frame source pid=%d exited status=%d", (int)r, status);
+        h->child = 0;
+        h->child_kill_ms = 0;
+    } else if (r < 0 && errno != EINTR) {
+        h->child = 0; /* already reaped by someone else */
+    }
+    /* Escalate a stubborn child after the grace period. */
+    if (h->child > 0 && h->child_kill_ms && h->now_ms >= h->child_kill_ms + LFS_KILL_GRACE_MS) {
+        lfs_log(h, "frame source pid=%d did not exit; SIGKILL", (int)h->child);
+        kill(h->child, SIGKILL);
+        waitpid(h->child, &status, 0);
+        h->child = 0;
+        h->child_kill_ms = 0;
+    }
+}
+
+static void stop_source(struct lock_framesrc *h, const char *why) {
+    if (h->conn_fd >= 0) {
+        struct lfs_msg m = { .magic = LFS_MAGIC, .type = LFS_STOP, .flags = 0,
+                             .len = (uint32_t)sizeof(struct lfs_ack) };
+        struct lfs_ack a = { .seq = h->next_seq };
+        struct iovec iov[2] = { { &m, sizeof m }, { &a, sizeof a } };
+        struct msghdr msg = { .msg_iov = iov, .msg_iovlen = 2 };
+        (void)sendmsg(h->conn_fd, &msg, MSG_NOSIGNAL);
+        close(h->conn_fd);
+        h->conn_fd = -1;
+    }
+    if (h->child > 0 && !h->child_kill_ms) {
+        kill(h->child, SIGTERM);
+        h->child_kill_ms = h->now_ms ? h->now_ms : lfs_now_ms();
+    }
+    clear_all(h);
+    if (h->state != LFS_IDLE)
+        lfs_log(h, "frame source stopped (%s)", why ? why : "");
+    h->state = LFS_IDLE;
+}
+
+static void fail_and_backoff(struct lock_framesrc *h, const char *why) {
+    if (h->conn_fd >= 0) { close(h->conn_fd); h->conn_fd = -1; }
+    if (h->child > 0 && !h->child_kill_ms) {
+        kill(h->child, SIGTERM);
+        h->child_kill_ms = h->now_ms ? h->now_ms : lfs_now_ms();
+    }
+    clear_all(h);
+    h->state = LFS_IDLE;
+    h->next_seq = 0;
+    h->want_start = true;   /* retry as soon as the backoff window elapses */
+    if (h->backoff_ms == 0) h->backoff_ms = LFS_BACKOFF_MIN_MS;
+    else h->backoff_ms *= 2;
+    if (h->backoff_ms > LFS_BACKOFF_MAX_MS) h->backoff_ms = LFS_BACKOFF_MAX_MS;
+    h->reopen_at_ms = (h->now_ms ? h->now_ms : lfs_now_ms()) + h->backoff_ms;
+    lfs_log(h, "frame source failed (%s); backoff %ums", why ? why : "", h->backoff_ms);
+}
+
+/* ---- buffer import ------------------------------------------------------- */
+
+static int shm_format_from_lfs(uint32_t fmt) {
+    switch (fmt) {
+    case LFS_FMT_ARGB8888: return WL_SHM_FORMAT_ARGB8888;
+    case LFS_FMT_XRGB8888: return WL_SHM_FORMAT_XRGB8888;
+    default: return -1;
+    }
+}
+
+/* Import a SHM frame. Returns a new wl_buffer or NULL. Never keeps fd on
+ * failure. */
+static struct wl_buffer *import_shm(struct lock_framesrc *h, int fd,
+                                    const struct lfs_frame *f) {
+    struct stat st;
+    if (fstat(fd, &st) != 0) { lfs_log(h, "fstat(fd) failed: %s", strerror(errno)); return NULL; }
+    uint64_t need = (uint64_t)f->offset + (uint64_t)f->stride * f->height;
+    if ((uint64_t)st.st_size < need) {
+        lfs_log(h, "shm too small: have %lld need %llu",
+                (long long)st.st_size, (unsigned long long)need);
+        return NULL;
+    }
+    int wlfmt = shm_format_from_lfs(f->format);
+    if (wlfmt < 0) { lfs_log(h, "unsupported shm format %u", f->format); return NULL; }
+    struct wl_shm_pool *pool = wl_shm_create_pool(h->shm, fd, (int)st.st_size);
+    if (!pool) { lfs_log(h, "wl_shm_create_pool failed"); return NULL; }
+    struct wl_buffer *buf = wl_shm_pool_create_buffer(pool, (int)f->offset,
+                                                      (int)f->width, (int)f->height,
+                                                      (int)f->stride, wlfmt);
+    wl_shm_pool_destroy(pool);
+    if (!buf) lfs_log(h, "wl_shm_pool_create_buffer failed");
+    return buf;
+}
+
+/* ---- message I/O --------------------------------------------------------- */
+
+static int recv_one(struct lock_framesrc *h, void *buf, size_t buflen,
+                    int *fd_out) {
+    struct iovec iov = { .iov_base = buf, .iov_len = buflen };
+    char cbuf[CMSG_SPACE(sizeof(int) * 2)];
+    struct msghdr msg;
+    memset(&msg, 0, sizeof msg);
+    msg.msg_iov = &iov;
+    msg.msg_iovlen = 1;
+    msg.msg_control = cbuf;
+    msg.msg_controllen = sizeof cbuf;
+    ssize_t n = recvmsg(h->conn_fd, &msg, MSG_DONTWAIT | MSG_CMSG_CLOEXEC);
+    if (n < 0) {
+        if (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR) return 0;
+        return -1;
+    }
+    if (n == 0) return -1; /* peer closed */
+    if (msg.msg_flags & MSG_TRUNC) { lfs_log(h, "message truncated (too large)"); return -1; }
+    (void)fd_out;
+    *fd_out = -1;
+    for (struct cmsghdr *c = CMSG_FIRSTHDR(&msg); c; c = CMSG_NXTHDR(&msg, c)) {
+        if (c->cmsg_level == SOL_SOCKET && c->cmsg_type == SCM_RIGHTS) {
+            size_t cnt = (c->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+            int fds[2] = { -1, -1 };
+            memcpy(fds, CMSG_DATA(c), cnt > 2 ? 2 * sizeof(int) : cnt * sizeof(int));
+            *fd_out = fds[0];
+            if (cnt > 1) close(fds[1]); /* we only ever want one */
+        }
+    }
+    return (int)n;
+}
+
+static void send_welcome(struct lock_framesrc *h) {
+    uint32_t n = h->n_outs;
+    size_t plen = sizeof(struct lfs_welcome) + n * sizeof(struct lfs_output);
+    if (plen > LFS_MAX_MSG) return;
+    char buf[LFS_MAX_MSG];
+    struct lfs_msg *m = (struct lfs_msg *)buf;
+    m->magic = LFS_MAGIC; m->type = LFS_WELCOME; m->flags = 0; m->len = (uint32_t)plen;
+    struct lfs_welcome *w = (struct lfs_welcome *)(buf + sizeof *m);
+    w->abi = LFS_VERSION;
+    w->transport = LFS_TRANSPORT_SHM;
+    w->n_outputs = n;
+    struct lfs_output *o = (struct lfs_output *)(w + 1);
+    uint32_t i = 0;
+    for (struct lfs_out *it = h->outs; it && i < n; it = it->next, i++) {
+        o[i].name_hash = it->hash;
+        o[i].width = it->buf_w;
+        o[i].height = it->buf_h;
+        o[i].scale_120 = (uint32_t)(it->scale > 0 ? it->scale : 1) * 120u;
+    }
+    struct iovec iov = { buf, sizeof(struct lfs_msg) + plen };
+    struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+    (void)sendmsg(h->conn_fd, &msg, MSG_NOSIGNAL);
+}
+
+static void send_ready(struct lock_framesrc *h, uint32_t seq) {
+    struct lfs_msg m = { .magic = LFS_MAGIC, .type = LFS_READY, .flags = 0,
+                         .len = (uint32_t)sizeof(struct lfs_ack) };
+    struct lfs_ack a = { .seq = seq };
+    struct iovec iov[2] = { { &m, sizeof m }, { &a, sizeof a } };
+    struct msghdr msg = { .msg_iov = iov, .msg_iovlen = 2 };
+    (void)sendmsg(h->conn_fd, &msg, MSG_NOSIGNAL);
+}
+
+static void handle_hello(struct lock_framesrc *h, const void *payload, size_t len) {
+    if (len < sizeof(struct lfs_hello)) { fail_and_backoff(h, "short HELLO"); return; }
+    const struct lfs_hello *he = payload;
+    if (he->abi != LFS_VERSION) {
+        char w[64]; snprintf(w, sizeof w, "ABI %u != %u", he->abi, LFS_VERSION);
+        fail_and_backoff(h, w);
+        return;
+    }
+    if (!(he->transports & LFS_TRANSPORT_SHM)) {
+        fail_and_backoff(h, "source does not offer SHM");
+        return;
+    }
+    send_welcome(h);
+    h->state = LFS_ACTIVE;
+    h->last_frame_ms = h->now_ms;
+    h->backoff_ms = 0;   /* healthy again */
+    lfs_log(h, "frame source accepted (abi=%u transports=0x%x outputs=%u)",
+            he->abi, he->transports, h->n_outs);
+}
+
+static void handle_frame(struct lock_framesrc *h, const void *payload, size_t len, int fd) {
+    if (len != sizeof(struct lfs_frame)) { fail_and_backoff(h, "bad FRAME size"); if (fd>=0) close(fd); return; }
+    const struct lfs_frame *f = payload;
+    if (fd < 0) { fail_and_backoff(h, "FRAME without a file descriptor"); return; }
+    if (f->seq != h->next_seq) {
+        char w[64]; snprintf(w, sizeof w, "seq %u != expected %u", f->seq, h->next_seq);
+        close(fd); fail_and_backoff(h, w);
+        return;
+    }
+    struct lfs_out *o = find_out_by_hash(h, f->output_hash);
+    if (!o) { close(fd); fail_and_backoff(h, "FRAME for unknown output"); return; }
+    if (f->width != o->buf_w || f->height != o->buf_h || f->stride < f->width * 4u || f->width == 0) {
+        close(fd); fail_and_backoff(h, "FRAME geometry mismatch"); return;
+    }
+    struct wl_buffer *buf = import_shm(h, fd, f);
+    close(fd);
+    if (!buf) { fail_and_backoff(h, "buffer import failed"); return; }
+
+    /* Replace any previous frame for this output. */
+    struct wl_buffer *old = o->cur;
+    o->cur = buf;
+    o->has_frame = true;
+    o->last_seq = f->seq;
+    if (h->ops && h->ops->present)
+        h->ops->present(o->user, buf, f->width, f->height, o->scale > 0 ? o->scale : 1);
+    if (old) wl_buffer_destroy(old);
+
+    h->last_frame_ms = h->now_ms;
+    h->next_seq++;
+    send_ready(h, f->seq);
+}
+
+static void drain(struct lock_framesrc *h) {
+    for (int guard = 0; guard < 64; guard++) {
+        char buf[LFS_MAX_MSG];
+        int fd = -1;
+        int n = recv_one(h, buf, sizeof buf, &fd);
+        if (n == 0) return;           /* nothing more right now */
+        if (n < 0) { fail_and_backoff(h, "connection closed"); return; }
+        if ((size_t)n < sizeof(struct lfs_msg)) { if (fd>=0) close(fd); fail_and_backoff(h, "short header"); return; }
+        const struct lfs_msg *m = (const struct lfs_msg *)buf;
+        if (m->magic != LFS_MAGIC) { if (fd>=0) close(fd); fail_and_backoff(h, "bad magic"); return; }
+        if (m->len > sizeof buf - sizeof *m) { if (fd>=0) close(fd); fail_and_backoff(h, "oversize length"); return; }
+        if ((size_t)n < sizeof(struct lfs_msg) + m->len) { if (fd>=0) close(fd); fail_and_backoff(h, "truncated message"); return; }
+        const void *payload = buf + sizeof *m;
+        switch (m->type) {
+        case LFS_HELLO:
+            if (fd >= 0) close(fd);
+            handle_hello(h, payload, m->len);
+            break;
+        case LFS_FRAME:
+            handle_frame(h, payload, m->len, fd);
+            break;
+        case LFS_BYE:
+            if (fd >= 0) close(fd);
+            fail_and_backoff(h, "source said BYE");
+            return;
+        default:
+            if (fd >= 0) close(fd);
+            fail_and_backoff(h, "unknown message type");
+            return;
+        }
+        if (h->state == LFS_IDLE) return; /* failed above */
+    }
+}
+
+/* ---- API ----------------------------------------------------------------- */
+
+struct lock_framesrc *lock_framesrc_new(const char *socket_path,
+                                        const char *spawn_cmd,
+                                        struct wl_display *display,
+                                        struct wl_shm *shm,
+                                        const struct lock_framesrc_ops *ops) {
+    if (!shm) return NULL;
+    struct lock_framesrc *h = calloc(1, sizeof *h);
+    if (!h) return NULL;
+    h->display = display;
+    h->shm = shm;
+    h->ops = ops;
+    h->listen_fd = -1;
+    h->conn_fd = -1;
+    h->state = LFS_IDLE;
+    h->transport = LFS_TRANSPORT_SHM;
+
+    if (socket_path && *socket_path) snprintf(h->sock_path, sizeof h->sock_path, "%s", socket_path);
+    else default_socket_path(h->sock_path, sizeof h->sock_path);
+
+    const char *cmd = spawn_cmd;
+    if (!cmd) cmd = getenv("SINGULARITY_LOCK_RENDERER");
+    if (cmd && *cmd) h->spawn_cmd = strdup(cmd);
+
+    const char *logp = getenv("SINGULARITY_LOCK_RENDERER_LOG");
+    if (logp && *logp) snprintf(h->log_path, sizeof h->log_path, "%s", logp);
+
+    const char *rs = getenv("SINGULARITY_LOCK_RENDERER_DELAY_MS");
+    if (rs && *rs) { unsigned long v = strtoul(rs, NULL, 10); if (v > 0) h->resume_ms = v; }
+    if (!h->resume_ms) h->resume_ms = LFS_DEFAULT_RESUME_MS;
+
+    char err[192];
+    h->listen_fd = make_listen_socket(h->sock_path, err, sizeof err);
+    if (h->listen_fd < 0) {
+        lfs_log(h, "cannot listen: %s", err);
+        free(h->spawn_cmd);
+        free(h);
+        return NULL;
+    }
+    (void)connect_timeout_ms;
+    lfs_log(h, "listening on %s (cmd=%s)", h->sock_path,
+            h->spawn_cmd ? h->spawn_cmd : "<none>");
+    return h;
+}
+
+void lock_framesrc_add_output(struct lock_framesrc *h, void *user, const char *name,
+                              uint32_t logical_w, uint32_t logical_h, int32_t scale) {
+    if (!h || !user || h->n_outs >= LFS_MAX_OUTPUTS) return;
+    struct lfs_out *o = calloc(1, sizeof *o);
+    if (!o) return;
+    o->h = h;
+    o->user = user;
+    o->scale = scale > 0 ? scale : 1;
+    o->buf_w = logical_w * (uint32_t)o->scale;
+    o->buf_h = logical_h * (uint32_t)o->scale;
+    snprintf(o->name, sizeof o->name, "%s", name ? name : "output");
+    o->hash = lfs_name_hash(o->name);
+    o->next = h->outs;
+    h->outs = o;
+    h->n_outs++;
+}
+
+void lock_framesrc_resize_output(struct lock_framesrc *h, void *user,
+                                 uint32_t logical_w, uint32_t logical_h, int32_t scale) {
+    if (!h) return;
+    struct lfs_out *o = find_out_by_user(h, user);
+    if (!o) return;
+    o->scale = scale > 0 ? scale : 1;
+    o->buf_w = logical_w * (uint32_t)o->scale;
+    o->buf_h = logical_h * (uint32_t)o->scale;
+    /* A geometry change invalidates frames already in flight. */
+    clear_output(o);
+}
+
+void lock_framesrc_remove_output(struct lock_framesrc *h, void *user) {
+    if (!h) return;
+    struct lfs_out **pp = &h->outs;
+    while (*pp) {
+        struct lfs_out *o = *pp;
+        if (o->user == user) {
+            *pp = o->next;
+            if (o->cur) wl_buffer_destroy(o->cur);
+            if (h->n_outs) h->n_outs--;
+            free(o);
+            return;
+        }
+        pp = &o->next;
+    }
+}
+
+void lock_framesrc_set_enabled(struct lock_framesrc *h, bool on) {
+    if (!h) return;
+    if (h->enabled == on) return;
+    h->enabled = on;
+    if (!on) {
+        h->want_start = false;
+        stop_source(h, "disabled");
+    } else {
+        /* On lock engage the saver shows immediately (operator ruling): mark
+         * "start now" rather than starting the resume timer. */
+        h->want_start = true;
+        h->last_activity_ms = h->now_ms ? h->now_ms : lfs_now_ms();
+        h->reopen_at_ms = 0;
+        h->backoff_ms = 0;
+        lfs_log(h, "enabled");
+    }
+}
+
+void lock_framesrc_activity(struct lock_framesrc *h) {
+    if (!h || !h->enabled) return;
+    h->last_activity_ms = h->now_ms ? h->now_ms : lfs_now_ms();
+    h->want_start = false;
+    if (h->state != LFS_IDLE) stop_source(h, "user activity");
+    h->next_seq = 0;
+    h->backoff_ms = 0;
+    h->reopen_at_ms = 0;
+}
+
+void lock_framesrc_tick(struct lock_framesrc *h, uint64_t now_ms) {
+    if (!h) return;
+    h->now_ms = now_ms;
+    reap_child(h);
+    if (!h->enabled) return;
+
+    /* Frame watchdog: a stalled source is a dead source. */
+    if (h->state == LFS_ACTIVE && now_ms > h->last_frame_ms + LFS_DEFAULT_STALL_MS) {
+        fail_and_backoff(h, "frame watchdog");
+        return;
+    }
+    if (h->state == LFS_WAITING && now_ms > h->hello_deadline_ms) {
+        fail_and_backoff(h, "HELLO timeout");
+        return;
+    }
+
+    if (h->state == LFS_IDLE) {
+        uint64_t resume_ms = h->resume_ms ? h->resume_ms : LFS_DEFAULT_RESUME_MS;
+        if (!h->want_start && now_ms < h->last_activity_ms + resume_ms)
+            return;                                             /* still showing the prompt */
+        if (now_ms < h->reopen_at_ms) return;                   /* backing off */
+        /* Start (or restart) the source. */
+        h->want_start = false;
+        spawn_source(h);
+        h->state = LFS_WAITING;
+        h->hello_deadline_ms = now_ms + LFS_HELLO_TIMEOUT_MS;
+        h->next_seq = 0;
+    }
+}
+
+int lock_framesrc_poll_fd(struct lock_framesrc *h) {
+    if (!h) return -1;
+    if (h->conn_fd >= 0) return h->conn_fd;
+    if (h->enabled) return h->listen_fd;
+    return -1;
+}
+
+void lock_framesrc_dispatch(struct lock_framesrc *h) {
+    if (!h) return;
+    if (!h->now_ms) h->now_ms = lfs_now_ms();
+
+    /* Accept a pending connection. */
+    if (h->conn_fd < 0 && h->enabled && h->listen_fd >= 0) {
+        int c = accept4(h->listen_fd, NULL, NULL, SOCK_CLOEXEC | SOCK_NONBLOCK);
+        if (c >= 0) {
+            if (h->conn_fd >= 0) close(h->conn_fd);
+            h->conn_fd = c;
+            h->state = LFS_WAITING;
+            h->hello_deadline_ms = h->now_ms + LFS_HELLO_TIMEOUT_MS;
+            h->next_seq = 0;
+            lfs_log(h, "source connected");
+        } else if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) {
+            /* transient; ignore */
+        }
+    }
+    if (h->conn_fd >= 0) drain(h);
+    /* Push presentation to the compositor promptly. */
+    if (h->display) wl_display_flush(h->display);
+}
+
+bool lock_framesrc_displaying(const struct lock_framesrc *h) {
+    if (!h) return false;
+    for (struct lfs_out *o = h->outs; o; o = o->next)
+        if (o->has_frame) return true;
+    return false;
+}
+
+void lock_framesrc_free(struct lock_framesrc *h) {
+    if (!h) return;
+    stop_source(h, "free");
+    /* Reap the child without waiting forever. */
+    if (h->child > 0) {
+        for (int i = 0; i < 20 && h->child > 0; i++) {
+            h->now_ms = lfs_now_ms();
+            reap_child(h);
+            if (h->child > 0) usleep(50000);
+        }
+        if (h->child > 0) { kill(h->child, SIGKILL); waitpid(h->child, NULL, 0); h->child = 0; }
+    }
+    for (struct lfs_out *o = h->outs; o;) {
+        struct lfs_out *n = o->next;
+        if (o->cur) wl_buffer_destroy(o->cur);
+        free(o);
+        o = n;
+    }
+    if (h->listen_fd >= 0) close(h->listen_fd);
+    if (h->sock_path[0]) unlink(h->sock_path);
+    free(h->spawn_cmd);
+    free(h);
+}
diff --git a/src/lockscreen/lock_framesrc.h b/src/lockscreen/lock_framesrc.h
new file mode 100644
index 0000000..ef7a407
--- /dev/null
+++ b/src/lockscreen/lock_framesrc.h
@@ -0,0 +1,110 @@
+/*
+ * lock_framesrc.h - host side of the out-of-process frame-source protocol for
+ * a session-lock client.
+ *
+ * SPDX-License-Identifier: MIT
+ *
+ * ext-session-lock-v1 presents exactly one client's surface while a session is
+ * locked, and Wayland subsurfaces must come from the same wl_client, so a
+ * screensaver cannot draw underneath the lock from another process. Instead the
+ * screensaver renders off-screen and sends the lock client a buffer file
+ * descriptor over a Unix socket; the lock imports it and presents it on its own
+ * per-output lock surface. The lock never executes frame-source code.
+ *
+ * Failure containment is the point. A frame source is arbitrary third-party
+ * code: if it crashes, hangs, or sends garbage, the lock must keep the session
+ * locked and keep its own unlock prompt usable. This module therefore treats
+ * every fault as "the renderer is gone": it drops back to the caller's static
+ * UI, reaps the frame source, and never signals the lock client.
+ *
+ * This is NOT part of the default build. Compile with -Dlock_framesrc=enabled.
+ * At runtime the module is inert unless SINGULARITY_LOCK_RENDERER names a frame
+ * source command, so the default lock client is unchanged.
+ */
+#ifndef LOCK_FRAMESRC_H
+#define LOCK_FRAMESRC_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct wl_display;
+struct wl_shm;
+struct wl_buffer;
+
+/* Callbacks implemented by the lock client. `user` is the per-output pointer
+ * the caller registered with lock_framesrc_add_output(). */
+struct lock_framesrc_ops {
+    /* A frame is ready for this output. The callee attaches the buffer to its
+     * lock surface and commits it. The buffer is owned by the host and stays
+     * valid until the next present()/clear() for the same output or until the
+     * host is freed; the callee must not destroy it. */
+    void (*present)(void *user, struct wl_buffer *buf, uint32_t width,
+                    uint32_t height, int32_t scale);
+    /* Return this output to the lock's own UI (the prompt/wallpaper). Any frame
+     * previously presented for it must be forgotten. */
+    void (*clear)(void *user);
+};
+
+struct lock_framesrc;
+
+/* Create the host.
+ *
+ *   socket_path  AF_UNIX path for the frame source to connect to. NULL selects
+ *                $SINGULARITY_LOCK_RENDERER_SOCKET or a per-uid default under
+ *                $XDG_RUNTIME_DIR.
+ *   spawn_cmd    shell command line used to launch a frame source when frames
+ *                are wanted. NULL selects $SINGULARITY_LOCK_RENDERER; if that
+ *                is also unset the host never spawns anything (an external
+ *                frame source may still connect).
+ *   display,shm  the lock client's already-bound globals. shm is required.
+ *
+ * Returns NULL if the socket cannot be created or shm is NULL. */
+struct lock_framesrc *lock_framesrc_new(const char *socket_path,
+                                        const char *spawn_cmd,
+                                        struct wl_display *display,
+                                        struct wl_shm *shm,
+                                        const struct lock_framesrc_ops *ops);
+
+/* Register an output before enabling the host. `user` is the caller's opaque
+ * handle. name may be NULL. Logical size and integer output scale are used to
+ * derive the buffer size requested from the frame source. */
+void lock_framesrc_add_output(struct lock_framesrc *h, void *user,
+                              const char *name, uint32_t logical_w,
+                              uint32_t logical_h, int32_t scale);
+void lock_framesrc_resize_output(struct lock_framesrc *h, void *user,
+                                 uint32_t logical_w, uint32_t logical_h,
+                                 int32_t scale);
+
+/* Drop an output (e.g. hot-unplug) before the caller frees its handle. Any
+ * frame presented for it is cleared first. */
+void lock_framesrc_remove_output(struct lock_framesrc *h, void *user);
+
+/* Enable/disable saver display. Enabling starts the frame source; disabling
+ * hides frames and stops the source. No-op if a frame source command is unset
+ * (external sources still work when enabled). */
+void lock_framesrc_set_enabled(struct lock_framesrc *h, bool on);
+
+/* Report user activity (a key/pointer/touch event). Hides any frames, stops the
+ * current frame source, and re-arms the resume timer so frames return after the
+ * configured idle delay. Safe to call at any time. */
+void lock_framesrc_activity(struct lock_framesrc *h);
+
+/* Periodic housekeeping: reaps the child, enforces the frame watchdog and the
+ * backoff, starts/resumes the source when due, and advances the connection
+ * state machine. Call once per main-loop iteration. */
+void lock_framesrc_tick(struct lock_framesrc *h, uint64_t now_ms);
+
+/* The socket fd to include in the caller's poll set, or -1. */
+int lock_framesrc_poll_fd(struct lock_framesrc *h);
+
+/* Process pending socket data: accept, read and dispatch messages. Call when
+ * poll_fd() is readable. Never blocks. */
+void lock_framesrc_dispatch(struct lock_framesrc *h);
+
+/* True while frames from a source are being presented (at least one output has
+ * an active frame). */
+bool lock_framesrc_displaying(const struct lock_framesrc *h);
+
+void lock_framesrc_free(struct lock_framesrc *h);
+
+#endif /* LOCK_FRAMESRC_H */
diff --git a/src/lockscreen/lock_framesrc_proto.h b/src/lockscreen/lock_framesrc_proto.h
new file mode 100644
index 0000000..89659e2
--- /dev/null
+++ b/src/lockscreen/lock_framesrc_proto.h
@@ -0,0 +1,105 @@
+/*
+ * lock_framesrc_proto.h - wire protocol between a session-lock client and an
+ * out-of-process frame source (a screensaver).
+ *
+ * SPDX-License-Identifier: MIT
+ *
+ * While a session is locked, ext-session-lock-v1 presents exactly one client's
+ * surface, so a separate screensaver process cannot draw underneath it. A
+ * frame source instead renders off-screen and hands the lock client a buffer
+ * file descriptor, which the lock imports and presents on its own lock surface.
+ * The lock never executes frame-source code, so a fault there can only make the
+ * lock fall back to its own prompt.
+ *
+ * Transport: AF_UNIX SOCK_SEQPACKET. Message boundaries are preserved and
+ * SCM_RIGHTS ancillary data arrives with its message, so one recvmsg() yields
+ * one message and its file descriptor. All integers are little-endian; this
+ * protocol is only used on the same host.
+ *
+ * This header is dependency-free and is shared verbatim by the lock client and
+ * by frame sources.
+ */
+#ifndef LOCK_FRAMESRC_PROTO_H
+#define LOCK_FRAMESRC_PROTO_H
+
+#include <stdint.h>
+
+#define LFS_MAGIC        0x4c465331u   /* "LFS1" */
+#define LFS_VERSION      1u
+
+/* No payload may exceed this. Bounds every allocation the host makes from a
+ * message it has not yet validated. */
+#define LFS_MAX_MSG      4096u
+
+/* Transport bitmask exchanged in HELLO / WELCOME. */
+#define LFS_TRANSPORT_SHM    0x1u      /* memfd / wl_shm buffer (always usable) */
+#define LFS_TRANSPORT_DMABUF 0x2u      /* linux-dmabuf buffer (needs the global) */
+
+enum lfs_type {
+    LFS_HELLO   = 1,   /* saver -> lock : who I am, what I can send */
+    LFS_FRAME   = 2,   /* saver -> lock : one buffer + fd */
+    LFS_BYE     = 3,   /* saver -> lock : I am done (clean) */
+
+    LFS_WELCOME = 0x80,/* lock -> saver : accepted; here is the geometry to use */
+    LFS_READY   = 0x81,/* lock -> saver : previous frame consumed; send the next */
+    LFS_STOP    = 0x82,/* lock -> saver : stop and exit (input arrived / unlocking) */
+};
+
+/* Buffer pixel formats. LFS_FMT_TOKEN covers both transports and maps to
+ * WL_SHM_FORMAT_{XRGB,ARGB}8888 and DRM_FORMAT_{XRGB,ARGB}8888. */
+enum lfs_format {
+    LFS_FMT_ARGB8888 = 0,
+    LFS_FMT_XRGB8888 = 1,
+};
+
+struct lfs_msg {
+    uint32_t magic;
+    uint16_t type;
+    uint16_t flags;
+    uint32_t len;
+};
+
+struct lfs_output {
+    uint32_t name_hash;   /* stable hash of the output name (see lfs_name_hash) */
+    uint32_t width;       /* BUFFER width  = logical width  * scale */
+    uint32_t height;      /* BUFFER height = logical height * scale */
+    uint32_t scale_120;   /* integer scale * 120 (120 = 1.0) */
+};
+
+struct lfs_hello {
+    uint32_t abi;
+    uint32_t transports;  /* LFS_TRANSPORT_* the sender supports */
+    uint32_t n_outputs;
+};
+
+struct lfs_welcome {
+    uint32_t abi;
+    uint32_t transport;   /* the one transport the lock will use */
+    uint32_t n_outputs;
+};
+
+struct lfs_frame {
+    uint32_t seq;
+    uint32_t output_hash;
+    uint32_t width;
+    uint32_t height;
+    uint32_t stride;
+    uint32_t offset;
+    uint32_t format;      /* enum lfs_format */
+    uint32_t modifier_lo; /* DRM format modifier, low 32 bits (0 for SHM) */
+    uint32_t modifier_hi; /* DRM format modifier, high 32 bits (0 for SHM) */
+};
+
+struct lfs_ack {
+    uint32_t seq;
+};
+
+/* FNV-1a over the output name. The exact function is part of the ABI: both
+ * sides must hash identically. An un-named output uses its index string. */
+static inline uint32_t lfs_name_hash(const char *s) {
+    uint32_t h = 2166136261u;
+    for (; s && *s; s++) { h ^= (unsigned char)*s; h *= 16777619u; }
+    return h;
+}
+
+#endif /* LOCK_FRAMESRC_PROTO_H */
diff --git a/src/lockscreen/lock_framesrc_testsrc.c b/src/lockscreen/lock_framesrc_testsrc.c
new file mode 100644
index 0000000..8c67005
--- /dev/null
+++ b/src/lockscreen/lock_framesrc_testsrc.c
@@ -0,0 +1,203 @@
+/*
+ * lock_framesrc_testsrc.c - a deterministic frame source for testing the lock
+ * client's out-of-process frame-source host. NOT installed; built only when the
+ * lock_framesrc option is enabled.
+ *
+ * SPDX-License-Identifier: MIT
+ *
+ * It speaks the same wire protocol as a real screensaver feed, but renders a
+ * trivial, unmistakable pattern into a memfd instead of a GLES3 hack, so a
+ * headless compositor test can drive every code path without a GPU. Modes:
+ *
+ *   (default)        stream frames, cycle the colour every frame
+ *   --frames N       exit cleanly after N frames
+ *   --hang[=N]       after N frames (default 0) stop sending, stay alive
+ *   --bad-fd         send a frame whose fd is too small (protocol-error path)
+ *   --bad-format     send a frame with an unknown pixel format
+ *   --gpu-error      fail right after HELLO, as a hack would on a GL error
+ *   --bye            send LFS_BYE instead of exiting
+ *
+ * The socket path comes from $SINGULARITY_LOCK_RENDERER_SOCKET (set by the lock
+ * client when it spawns us) or argv --socket PATH.
+ */
+#define _GNU_SOURCE
+#include "lock_framesrc_proto.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+
+static void die(const char *m) { fprintf(stderr, "testsrc: %s: %s\n", m, strerror(errno)); exit(2); }
+static void die2(const char *m) { fprintf(stderr, "testsrc: %s\n", m); exit(2); }
+
+static int send_msg(int fd, const void *payload, uint32_t len, uint16_t type, int passfd) {
+    struct lfs_msg m = { .magic = LFS_MAGIC, .type = type, .flags = 0, .len = len };
+    struct iovec iov[2] = { { &m, sizeof m }, { (void *)payload, len } };
+    struct msghdr msg;
+    memset(&msg, 0, sizeof msg);
+    msg.msg_iov = iov;
+    msg.msg_iovlen = (len > 0) ? 2 : 1;
+    char cbuf[CMSG_SPACE(sizeof(int))];
+    if (passfd >= 0) {
+        memset(cbuf, 0, sizeof cbuf);
+        msg.msg_control = cbuf;
+        msg.msg_controllen = sizeof cbuf;
+        struct cmsghdr *c = CMSG_FIRSTHDR(&msg);
+        c->cmsg_level = SOL_SOCKET;
+        c->cmsg_type = SCM_RIGHTS;
+        c->cmsg_len = CMSG_LEN(sizeof(int));
+        memcpy(CMSG_DATA(c), &passfd, sizeof(int));
+    }
+    ssize_t n = sendmsg(fd, &msg, MSG_NOSIGNAL);
+    return (int)n;
+}
+
+static int recv_msg(int fd, void *buf, size_t buflen) {
+    struct iovec iov = { .iov_base = buf, .iov_len = buflen };
+    struct msghdr msg;
+    memset(&msg, 0, sizeof msg);
+    msg.msg_iov = &iov;
+    msg.msg_iovlen = 1;
+    char cbuf[CMSG_SPACE(sizeof(int))];
+    msg.msg_control = cbuf;
+    msg.msg_controllen = sizeof cbuf;
+    ssize_t n = recvmsg(fd, &msg, 0);
+    if (n < 0) die("recvmsg");
+    return (int)n;
+}
+
+static int connect_sock(const char *path) {
+    struct sockaddr_un addr;
+    memset(&addr, 0, sizeof addr);
+    addr.sun_family = AF_UNIX;
+    snprintf(addr.sun_path, sizeof addr.sun_path, "%s", path);
+    for (int i = 0; i < 200; i++) {
+        int fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+        if (fd < 0) die("socket");
+        if (connect(fd, (struct sockaddr *)&addr, sizeof addr) == 0)
+            return fd;
+        close(fd);
+        struct timespec ts = { .tv_sec = 0, .tv_nsec = 50 * 1000 * 1000 };
+        nanosleep(&ts, NULL);
+    }
+    die2("could not connect to the lock socket");
+    return -1;
+}
+
+/* Render one frame into a fresh memfd and return its fd (position 0). */
+static int render_frame(uint32_t w, uint32_t h, uint32_t stride, uint32_t seq, int bad) {
+    int fd = memfd_create("lfs-frame", MFD_CLOEXEC);
+    if (fd < 0) die("memfd_create");
+    size_t sz = bad ? 16 : (size_t)stride * h;      /* deliberately too small */
+    if (ftruncate(fd, (off_t)sz) != 0) die("ftruncate");
+    if (!bad) {
+        unsigned char *p = mmap(NULL, sz, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+        if (p == MAP_FAILED) die("mmap");
+        /* A moving bright band over a colour that cycles with seq: a reader can
+         * tell consecutive frames apart with the naked eye. */
+        unsigned base = (unsigned)(seq * 37u) & 0xff;
+        for (uint32_t y = 0; y < h; y++) {
+            for (uint32_t x = 0; x < w; x++) {
+                unsigned char *px = p + (size_t)y * stride + (size_t)x * 4;
+                int band = ((x + seq * 8) % 128) < 64;
+                px[0] = (unsigned char)(band ? 255 : base);         /* B */
+                px[1] = (unsigned char)(band ? 255 : (base ^ 0x55));/* G */
+                px[2] = (unsigned char)(band ? 255 : (base ^ 0xaa));/* R */
+                px[3] = 0xff;                                       /* A */
+            }
+        }
+        munmap(p, sz);
+    }
+    lseek(fd, 0, SEEK_SET);
+    return fd;
+}
+
+int main(int argc, char **argv) {
+    const char *path = getenv("SINGULARITY_LOCK_RENDERER_SOCKET");
+    int mode_frames = -1;      /* -1 = forever */
+    int hang_after = -1;       /* -1 = never */
+    int bad_fd = 0, bad_format = 0, gpu_error = 0, use_bye = 0;
+    for (int i = 1; i < argc; i++) {
+        if (!strcmp(argv[i], "--socket") && i + 1 < argc) path = argv[++i];
+        else if (!strcmp(argv[i], "--frames") && i + 1 < argc) mode_frames = atoi(argv[++i]);
+        else if (!strncmp(argv[i], "--hang", 6)) {
+            hang_after = 0;
+            const char *eq = strchr(argv[i], '=');
+            if (eq) hang_after = atoi(eq + 1);
+        }
+        else if (!strcmp(argv[i], "--bad-fd")) bad_fd = 1;
+        else if (!strcmp(argv[i], "--bad-format")) bad_format = 1;
+        else if (!strcmp(argv[i], "--gpu-error")) gpu_error = 1;
+        else if (!strcmp(argv[i], "--bye")) use_bye = 1;
+    }
+    if (!path || !*path) die2("no socket path (set SINGULARITY_LOCK_RENDERER_SOCKET)");
+
+    int fd = connect_sock(path);
+
+    struct lfs_hello he = { .abi = LFS_VERSION, .transports = LFS_TRANSPORT_SHM, .n_outputs = 0 };
+    if (send_msg(fd, &he, sizeof he, LFS_HELLO, -1) < 0) die("send HELLO");
+    fprintf(stderr, "testsrc: connected, HELLO sent\n");
+
+    if (gpu_error) { fprintf(stderr, "testsrc: simulating GPU error\n"); return 3; }
+    if (use_bye) { send_msg(fd, NULL, 0, LFS_BYE, -1); return 0; }
+
+    /* Read WELCOME. */
+    char buf[LFS_MAX_MSG];
+    int n = recv_msg(fd, buf, sizeof buf);
+    struct lfs_msg *m = (struct lfs_msg *)buf;
+    if (n < (int)sizeof *m || m->magic != LFS_MAGIC || m->type != LFS_WELCOME)
+        die2("expected WELCOME");
+    struct lfs_welcome *w = (struct lfs_welcome *)(buf + sizeof *m);
+    struct lfs_output *outs = (struct lfs_output *)(w + 1);
+    if (w->n_outputs == 0) die2("lock reported no outputs");
+    fprintf(stderr, "testsrc: WELCOME transport=0x%x outputs=%u\n", w->transport, w->n_outputs);
+
+    uint32_t seq = 0;
+    uint32_t oi = 0;
+    for (;;) {
+        if (mode_frames >= 0 && (int)seq >= mode_frames) break;
+        if (hang_after >= 0 && (int)seq >= hang_after) {
+            fprintf(stderr, "testsrc: hanging after %u frames\n", seq);
+            for (;;) pause();
+        }
+
+        struct lfs_output *o = &outs[oi % w->n_outputs];
+        oi++;
+        uint32_t stride = o->width * 4u;
+        int imgfd = render_frame(o->width, o->height, stride, seq, bad_fd);
+        struct lfs_frame f = {
+            .seq = seq, .output_hash = o->name_hash,
+            .width = o->width, .height = o->height, .stride = stride, .offset = 0,
+            .format = bad_format ? 0xdeadbeefu : LFS_FMT_XRGB8888,
+            .modifier_lo = 0, .modifier_hi = 0,
+        };
+        if (send_msg(fd, &f, sizeof f, LFS_FRAME, imgfd) < 0) die("send FRAME");
+        close(imgfd);
+        fprintf(stderr, "testsrc: frame seq=%u %ux%u\n", seq, o->width, o->height);
+
+        /* Wait for READY (or the socket closing). */
+        struct pollfd p = { .fd = fd, .events = POLLIN };
+        if (poll(&p, 1, 5000) <= 0) die2("timeout waiting for READY");
+        int rn = recv_msg(fd, buf, sizeof buf);
+        if (rn <= 0) { fprintf(stderr, "testsrc: lock closed\n"); return 0; }
+        struct lfs_msg *rm = (struct lfs_msg *)buf;
+        if (rm->type == LFS_STOP) { fprintf(stderr, "testsrc: STOP\n"); return 0; }
+        if (rm->type != LFS_READY) { fprintf(stderr, "testsrc: unexpected type %u\n", rm->type); return 0; }
+        seq++;
+        struct timespec ts = { .tv_sec = 0, .tv_nsec = 100 * 1000 * 1000 };
+        nanosleep(&ts, NULL);   /* ~10 fps, like a real saver */
+    }
+    fprintf(stderr, "testsrc: done after %u frames\n", seq);
+    close(fd);
+    return 0;
+}

+                    : _("Bing image unpinned.");
+            } catch (Error e) {
+                card.message.label = _("Could not toggle pin: %s").printf(e.message);
+                status.label = _("Pin toggle failed. Try again.");
+            }
+            card.spinner.stop();
+            update_controls();
+        }

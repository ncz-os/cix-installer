diff --git a/src/boot_splash_main.c b/src/boot_splash_main.c
index 6b2fedb..4bde3fd 100644
--- a/src/boot_splash_main.c
+++ b/src/boot_splash_main.c
@@ -89,6 +89,14 @@ static int create_fb(struct fb *f, uint32_t w, uint32_t h) {
     if (f->map == MAP_FAILED) return -1;
     f->surface = cairo_image_surface_create_for_data(f->map, CAIRO_FORMAT_RGB24,
                                                      (int)w, (int)h, (int)f->pitch);
+
+    if (cairo_surface_status(f->surface) != CAIRO_STATUS_SUCCESS) {
+        fprintf(stderr, "boot-splash: cannot create a Cairo surface over the framebuffer: %s\n",
+                cairo_status_to_string(cairo_surface_status(f->surface)));
+        cairo_surface_destroy(f->surface);
+        f->surface = NULL;
+        return -1;
+    }
     return 0;
 }
 
@@ -211,7 +219,12 @@ static void destroy_fb(struct fb *f) {
 }
 
 static void render(struct fb *f, double progress) {
+    if (!f->surface || cairo_surface_status(f->surface) != CAIRO_STATUS_SUCCESS) return;
     cairo_t *cr = cairo_create(f->surface);
+    if (!cr || cairo_status(cr) != CAIRO_STATUS_SUCCESS) {
+        if (cr) cairo_destroy(cr);
+        return;
+    }
     loginui_render_brand_progress(cr, mode.hdisplay, mode.vdisplay, 1.0, logo, progress, 1.0);
     cairo_destroy(cr);
     cairo_surface_flush(f->surface);
@@ -317,6 +330,13 @@ static int run_firmware_fb(double safety_seconds) {
         return 1;
     }
     cairo_surface_t *surface = cairo_image_surface_create(CAIRO_FORMAT_RGB24, (int)info.width, (int)info.height);
+    if (!surface || cairo_surface_status(surface) != CAIRO_STATUS_SUCCESS) {
+        fprintf(stderr, "boot-splash: cannot create the Cairo surface: %s\n",

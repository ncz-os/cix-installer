@@ -428,6 +448,10 @@ static int run_firmware_fb(double safety_seconds) {
         if (exists(FIRMWARE_FB_OWNER) || exists(FIRST_FRAME) || any_card() || t - start_t > safety_seconds) break;
         update_notice(t);
         cairo_t *cr = cairo_create(surface);

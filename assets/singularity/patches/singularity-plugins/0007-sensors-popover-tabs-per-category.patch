+    private void add_section(SectionFill fill) {
+        Box section = begin_detail_section();
+        fill();
+        finish_detail_section(section);
+    }
+
+    private void select_tab(string id) {
+        foreach (DetailTab tab in detail_tabs) {
+            if (tab.id == id) {
+                current_tab = tab;
+                detail_target = tab.columns[0];
+                return;
+            }
+        }
+    }

From a95e5ab7a833d237578572eb4bd12b560ef99f5a Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Fri, 16 Oct 2026 23:01:34 -0400
Subject: [PATCH] fix: cancel the failed session before creating a new one

greetd keeps a session under configuration after a rejected password, so
the next create_session failed with "a session is already being configured"
and the greeter retried in a loop. Cancel it first and create the new
session once greetd answers the cancel. greetd replies in order and answers
cancel_session with "success", so replies are counted: the cancel's own
reply restarts authentication and earlier replies for the cancelled session
are dropped instead of being taken for a login.

---
 src/greeter_main.c | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/src/greeter_main.c b/src/greeter_main.c
index b2d7d59..28e0f61 100644
--- a/src/greeter_main.c
+++ b/src/greeter_main.c
@@ -66,6 +66,8 @@ static bool status_error = false;
 static bool awaiting_auth = false;
 static bool auth_prompt_waiting = false;
 static bool auth_restart_pending = false;
+static int requests_in_flight = 0;
+static int replies_until_cancel_ack = 0;
 
 static int greetd_fd = -1;
 static bool preview = false;
@@ -434,7 +436,7 @@ static void greetd_send_object(JsonBuilder *b) {
     json_generator_set_root(g, json_builder_get_root(b));
     gsize jlen = 0;
     char *json = json_generator_to_data(g, &jlen);
-    greetd_send(json);
+    if (greetd_send(json)) requests_in_flight++;
     g_free(json);
     g_object_unref(g);
     g_object_unref(b);
@@ -474,6 +476,7 @@ static void greetd_cancel_session(void) {
     json_builder_begin_object(b);
     json_builder_set_member_name(b, "type"); json_builder_add_string_value(b, "cancel_session");
     greetd_send_object(b);
+    replies_until_cancel_ack = requests_in_flight;
 }
 
 static void begin_authentication(void) {
@@ -612,6 +615,16 @@ static void greetd_handle(void) {
     if (!payload) return;
     if (!read_exact(greetd_fd, payload, len)) { free(payload); running = false; return; }
     payload[len] = '\0';
+    if (requests_in_flight > 0) requests_in_flight--;
+    if (replies_until_cancel_ack > 0) {
+        if (--replies_until_cancel_ack == 0) {
+            awaiting_auth = false;
+            auth_prompt_waiting = false;
+            if (auth_restart_pending && !recovery_mode) begin_authentication();
+        }
+        free(payload);
+        return;
+    }
 
     JsonParser *p = json_parser_new();
     if (json_parser_load_from_data(p, payload, len, NULL)) {
@@ -673,7 +686,10 @@ static void greetd_handle(void) {
                     snprintf(status_text, sizeof status_text, "%s", desc);
                     status_error = true;
                 }
-                if (was_authenticating && !recovery_mode) begin_authentication();
+                if (was_authenticating && !recovery_mode) {
+                    auth_restart_pending = true;
+                    greetd_cancel_session();
+                }
                 render_all();
             }
         }

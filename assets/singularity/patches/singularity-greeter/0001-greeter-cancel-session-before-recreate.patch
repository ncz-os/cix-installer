From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Sun, 11 Oct 2026 11:47:48 -0400
Subject: [PATCH] greeter: cancel the failed session before creating a new one

After a rejected password the greeter called create_session again while
greetd still held the previous session under configuration, so greetd
answered "a session is already being configured" and the prompt looped.
Cancel the session first and re-create it only once greetd acknowledges
the cancel; a pending cancel is counted so its success reply is not
mistaken for a completed login.

Assisted-by: opencode:deepseek-flash
AI-Scope: generated the cancel_session acknowledgement counter and the cancel-before-recreate retry in greeter_main.c
---
 src/greeter_main.c | 27 +++++++++++++++++++++++++--
 1 file changed, 25 insertions(+), 2 deletions(-)

diff --git a/src/greeter_main.c b/src/greeter_main.c
index 3e0ff3e..b5a8c26 100644
--- a/src/greeter_main.c
+++ b/src/greeter_main.c
@@ -65,6 +65,11 @@ static bool status_error = false;
 static bool awaiting_auth = false;
 static bool auth_prompt_waiting = false;
 static bool auth_restart_pending = false;
+/* Number of cancel_session requests we have sent that greetd has not yet
+ * acknowledged. greetd answers a cancel with the same "success" response it
+ * uses to signal a completed authentication, so without this counter the
+ * greeter would treat a cancel acknowledgement as a successful login. */
+static int cancels_in_flight = 0;
 
 static int greetd_fd = -1;
 static bool preview = false;
@@ -462,6 +467,7 @@ static void greetd_cancel_session(void) {
     json_builder_begin_object(b);
     json_builder_set_member_name(b, "type"); json_builder_add_string_value(b, "cancel_session");
     greetd_send_object(b);
+    cancels_in_flight++;
 }
 
 static void begin_authentication(void) {
@@ -633,7 +639,16 @@ static void greetd_handle(void) {
                     render_all();
                 }
             } else if (g_strcmp0(type, "success") == 0) {
-                if (awaiting_auth) {
+                if (cancels_in_flight > 0) {
+                    /* This is greetd acknowledging a cancel_session, not a
+                     * completed login. Re-create the session now that the old
+                     * one is torn down, so the prompt stays live. */
+                    cancels_in_flight--;
+                    if (auth_restart_pending) {
+                        auth_restart_pending = false;
+                        begin_authentication();
+                    }
+                } else if (awaiting_auth) {
                     awaiting_auth = false;
                     auth_prompt_waiting = false;
                     remember_login();
@@ -660,7 +675,15 @@ static void greetd_handle(void) {
                     snprintf(status_text, sizeof status_text, "%s", desc);
                     status_error = true;
                 }
-                if (was_authenticating && !recovery_mode) begin_authentication();
+                if (was_authenticating && !recovery_mode) {
+                    /* greetd keeps the failed session under configuration until
+                     * it is cancelled. Creating a new one without cancelling
+                     * fails with "a session is already being configured" and
+                     * loops forever. Cancel it; the cancel acknowledgement
+                     * re-creates the session (see the success branch). */
+                    auth_restart_pending = true;
+                    greetd_cancel_session();
+                }
                 render_all();
             }
         }

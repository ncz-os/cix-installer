From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Mon, 12 Oct 2026 12:30:00 -0400
Subject: [PATCH] greeter: match the lock login card (shared field label + output scale)

Remove the greeter-only second row so its login card is identical to the
lock's: the greetd/PAM prompt and the synthetic "touch the sensor" banner no
longer paint a status row under the field; the prompt is routed through the
shared loginui_field_label() into the single credential field (still functional:
it gates posting the typed secret). Also render at the output scale with
wl_surface_set_buffer_scale() like the lock's own output-scale handler, so a
HiDPI panel gets a native-density card instead of a compositor-upscaled one.
Assisted-by: opencode:deepseek-flash
AI-Scope: authored on the pinned upstream commit; measured red->green headless
---
diff --git a/src/greeter_main.c b/src/greeter_main.c
--- a/src/greeter_main.c
+++ b/src/greeter_main.c
@@ -57,6 +57,13 @@
 static size_t password_len = 0;
 static char pending_password[1024];
 static char status_text[128] = "";
+/* The most recent greetd/PAM prompt (e.g. "Password: "). It is NOT drawn as a
+ * second row under the field -- it is resolved into the one shared credential
+ * field label by loginui_field_label() so the greeter card matches the lock
+ * card exactly. Kept functional: the prompt still gates when a typed secret is
+ * posted back to greetd (auth_prompt_waiting). */
+static char auth_prompt[160] = "";
+static char label_buf[64];
 static bool auth_is_pin = false; /* SintyOS: the credential is a PIN, not a Unix password */
 static bool auth_has_tpm = true;
 static bool recovery_mode = false; /* --recovery: forgotten-PIN escape hatch, launched as root by sinty-greetd-launch */
@@ -288,7 +295,8 @@
     if (recovery_mode)
         st.auth_label = recovery_step == 0 ? "Recovery code" : (auth_has_tpm ? "New PIN" : "New passphrase");
     else
-        st.auth_label = auth_is_pin ? (auth_has_tpm ? "PIN" : "Passphrase") : "Password";
+        st.auth_label = loginui_field_label(label_buf, sizeof label_buf, auth_prompt,
+                                            auth_is_pin, auth_has_tpm);
 
     double cx, cy, cw, ch;
     loginui_render(cr, &st, &cx, &cy, &cw, &ch);
@@ -489,6 +497,7 @@
     if (preview || recovery_mode || n_users == 0 || greetd_fd < 0 || awaiting_auth) return;
     awaiting_auth = true;
     auth_prompt_waiting = false;
+    auth_prompt[0] = '\0';
     auth_restart_pending = false;
     pending_password[0] = '\0';
     if (status_text[0] == '\0')
@@ -654,8 +663,12 @@
                         snprintf(status_text, sizeof status_text, "%s", "Authenticating...");
                     } else {
                         auth_prompt_waiting = true;
-                        if (is_plain_credential_prompt(m)) status_text[0] = '\0';
-                        else snprintf(status_text, sizeof status_text, "%s", m);
+                        /* Route the prompt into the ONE shared field label (via
+                         * loginui_field_label at render time) instead of a second
+                         * status row, so the greeter card matches the lock card;
+                         * status_text stays empty here. */
+                        snprintf(auth_prompt, sizeof auth_prompt, "%s", m);
+                        status_text[0] = '\0';
                     }
                     status_error = false;
                     render_all();

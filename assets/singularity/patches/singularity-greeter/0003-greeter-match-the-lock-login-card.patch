From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Sat, 17 Oct 2026 04:40:00 -0400
Subject: [PATCH] greeter: match the lock login card (shared field label)

Remove the greeter-only second row so its login card is identical to the
lock card: the greetd/PAM prompt and the synthetic sensor banner no longer
paint a status row under the field. A non-plain prompt (for example an
"Enter TPM PIN:" message) is routed into the shared credential field label
instead, and the plain Password/PIN prompt line stays hidden as upstream
d7bb2de already does.

Scaling is deliberately not part of this patch any more. Upstream 59560be4
("hand over on the shared progress frame at the output scale") renders at the
output scale itself through the render_scale global, so this queue carries
only the card-shape change (operator decision 2026-11-04).

Refreshed 2026-11-04 against greeter 59560be4 on top of 0001 and 0002.
---
diff --git a/src/greeter_main.c b/src/greeter_main.c
index 33f6851..dfb8047 100644
--- a/src/greeter_main.c
+++ b/src/greeter_main.c
@@ -57,6 +57,7 @@ static char password[1024];
 static size_t password_len = 0;
 static char pending_password[1024];
 static char status_text[128] = "";
+static char auth_prompt[128] = "";
 static bool auth_is_pin = false; /* SintyOS: the credential is a PIN, not a Unix password */
 static bool auth_has_tpm = true;
 static bool recovery_mode = false; /* --recovery: forgotten-PIN escape hatch, launched as root by sinty-greetd-launch */
@@ -280,7 +281,10 @@ static void render_surface(struct wl_surface *surface, int w, int h) {
     st.avatar = u ? u->avatar : NULL;
     st.background = u ? u->bg : NULL;
     st.password_dots = (int)password_len;
-    st.status_text = status_text[0] ? status_text : NULL;
+    /* One shared field label: a non-plain prompt routes into it (see
+     * greetd_handle), so the greeter card has one credential row like the lock. */
+    st.status_text = auth_prompt[0] ? auth_prompt
+                                    : (status_text[0] ? status_text : NULL);
     st.status_error = status_error;
     if (recovery_mode)
         st.auth_label = recovery_step == 0 ? "Recovery code" : (auth_has_tpm ? "New PIN" : "New passphrase");
@@ -488,14 +492,16 @@ static void begin_authentication(void) {
     auth_prompt_waiting = false;
     auth_restart_pending = false;
     pending_password[0] = '\0';
-    if (status_text[0] == '\0')
-        snprintf(status_text, sizeof status_text, "%s", "Touch the fingerprint sensor or enter your password");
+    /* No synthetic "touch the sensor" banner: the greeter card must equal the
+     * lock card, and that banner was a second row the lock never shows. */
+    auth_prompt[0] = '\0';
     status_error = false;
     greetd_create_session(users[sel_user].username);
 }
 
 static void restart_authentication(void) {
     auth_prompt_waiting = false;
+    auth_prompt[0] = '\0';
     pending_password[0] = '\0';
     if (awaiting_auth) {
         auth_restart_pending = true;
@@ -661,8 +667,14 @@ static void greetd_handle(void) {
                         snprintf(status_text, sizeof status_text, "%s", "Authenticating...");
                     } else {
                         auth_prompt_waiting = true;
-                        if (is_plain_credential_prompt(m)) status_text[0] = '\0';
-                        else snprintf(status_text, sizeof status_text, "%s", m);
+                        /* A non-plain prompt (e.g. "Enter TPM PIN:") goes into the
+                         * ONE shared field label instead of a second status row. */
+                        if (is_plain_credential_prompt(m)) {
+                            status_text[0] = '\0';
+                        } else {
+                            snprintf(auth_prompt, sizeof auth_prompt, "%s", m);
+                            status_text[0] = '\0';
+                        }
                     }
                     status_error = false;
                     render_all();
@@ -685,6 +697,7 @@ static void greetd_handle(void) {
                 awaiting_auth = false;
                 auth_prompt_waiting = false;
                 auth_restart_pending = false;
+                auth_prompt[0] = '\0';
                 memset(password, 0, sizeof password);
                 memset(pending_password, 0, sizeof pending_password);
                 password_len = 0;

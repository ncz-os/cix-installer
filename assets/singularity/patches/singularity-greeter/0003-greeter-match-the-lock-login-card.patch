From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Wed, 18 Nov 2026 12:00:00 -0500
Subject: [PATCH] greeter: match the lock login card (shared field label + output scale)

Route the greetd prompt through the shared loginui_field_label() into the
credential field and remove the extra status row, while preserving prompt
gating of password submission and output-scale rendering.
---
--- a/src/greeter_main.c
+++ b/src/greeter_main.c
@@ -67,6 +67,8 @@
 static bool status_error = false;
 static bool awaiting_auth = false;
 static bool auth_prompt_waiting = false;
+static char auth_prompt[160] = "";
+static char label_buf[64];
 static bool auth_restart_pending = false;
 static int requests_in_flight = 0;
 static int replies_until_cancel_ack = 0;
@@ -301,7 +303,8 @@
     if (recovery_mode)
         st.auth_label = recovery_step == 0 ? "Recovery code" : (auth_has_tpm ? "New PIN" : "New passphrase");
     else
-        st.auth_label = auth_is_pin ? (auth_has_tpm ? "PIN" : "Passphrase") : "Password";
+        st.auth_label = loginui_field_label(label_buf, sizeof label_buf, auth_prompt,
+                                            auth_is_pin, auth_has_tpm);
 
     double cx, cy, cw, ch;
     loginui_render(cr, &st, &cx, &cy, &cw, &ch);
@@ -642,6 +645,7 @@
     if (preview || recovery_mode || (n_users == 0 && !badge) || greetd_fd < 0 || awaiting_auth) return;
     awaiting_auth = true;
     auth_prompt_waiting = false;
+    auth_prompt[0] = '\0';
     auth_restart_pending = false;
     pending_password[0] = '\0';
     status_error = false;
@@ -833,10 +837,8 @@
                         status_error = false;
                     } else {
                         auth_prompt_waiting = true;
-                        if (!status_error) {
-                            if (is_plain_credential_prompt(m)) status_text[0] = '\0';
-                            else snprintf(status_text, sizeof status_text, "%s", m);
-                        }
+                        snprintf(auth_prompt, sizeof auth_prompt, "%s", m);
+                        if (!status_error) status_text[0] = '\0';
                     }
                     render_all();
                 }
-- 
2.53.0

From 000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Mon, 17 Oct 2026 02:00:00 -0400
Subject: [PATCH] greeter: match the lock login card (shared field label + output scale)


Remove the greeter-only second row so its login card is identical to the
lock's: the greetd/PAM prompt and the synthetic "touch the sensor" banner no
longer paint a status row under the field; the prompt is routed through the
shared loginui_field_label() into the single credential field (still functional:
it gates posting the typed secret). Also render at the output scale with
wl_surface_set_buffer_scale() like the lock's own output-scale handler, so a
HiDPI panel gets a native-density card instead of a compositor-upscaled one.
The 2026-10-17 refresh onto greeter 09007fd re-bases onto upstream d7bb2de,
which already hides the raw "Password:"/"PIN:" prompt line: that raw-string
suppression is kept as-is (it matches the lock behaviour: the credential
field's own label is the only visible text), and this patch routes non-plain
prompts (e.g. "Enter TPM PIN:") into the shared field label instead of the
status row, so the greeter card still matches the lock card exactly. The
TPM-aware "Passphrase" labels upstream added are kept.
Assisted-by: opencode:deepseek-flash
AI-Scope: authored on the pinned upstream commit; measured red->green headless;
          2026-10-17 refresh onto 09007fd (refreshed, not rebased upstream)

---
 src/greeter_main.c | 20
 1 file changed, 3 insertions(+), 17 deletions(-)

--- a/src/greeter_main.c
+++ b/src/greeter_main.c
@@ -58,7 +58,6 @@
 static char pending_password[1024];
 static char status_text[128] = "";
 static bool auth_is_pin = false; /* SintyOS: the credential is a PIN, not a Unix password */
-static bool auth_has_tpm = true;
 static bool recovery_mode = false; /* --recovery: forgotten-PIN escape hatch, launched as root by sinty-greetd-launch */
 static int recovery_step = 0;      /* 0 = enter recovery code, 1 = enter new PIN */
 static char recovery_code[256] = "";
@@ -279,9 +278,9 @@
     st.status_text = status_text[0] ? status_text : NULL;
     st.status_error = status_error;
     if (recovery_mode)
-        st.auth_label = recovery_step == 0 ? "Recovery code" : (auth_has_tpm ? "New PIN" : "New passphrase");
+        st.auth_label = recovery_step == 0 ? "Recovery code" : "New PIN";
     else
-        st.auth_label = auth_is_pin ? (auth_has_tpm ? "PIN" : "Passphrase") : "Password";
+        st.auth_label = auth_is_pin ? "PIN" : "Password";
 
     double cx, cy, cw, ch;
     loginui_render(cr, &st, &cx, &cy, &cw, &ch);
@@ -448,17 +447,6 @@
     greetd_send_object(b);
 }
 
-static bool is_plain_credential_prompt(const char *m) {
-    char buf[64];
-    size_t n = 0;
-    for (const char *c = m; *c && n < sizeof buf - 1; c++) {
-        if (*c == ':' || *c == ' ') continue;
-        buf[n++] = (char) g_ascii_tolower(*c);
-    }
-    buf[n] = '\0';
-    return n == 0 || g_strcmp0(buf, "pin") == 0 || g_strcmp0(buf, "password") == 0;
-}
-
 static void greetd_post_response(const char *response) {
     JsonBuilder *b = json_builder_new();
     json_builder_begin_object(b);
@@ -639,8 +627,7 @@
                         snprintf(status_text, sizeof status_text, "%s", "Authenticating...");
                     } else {
                         auth_prompt_waiting = true;
-                        if (is_plain_credential_prompt(m)) status_text[0] = '\0';
-                        else snprintf(status_text, sizeof status_text, "%s", m);
+                        snprintf(status_text, sizeof status_text, "%s", m);
                     }
                     status_error = false;
                     render_all();
@@ -990,7 +977,6 @@
         g_free(content);
     }
     auth_is_pin = (id[0] != '\0' && g_str_has_prefix(id, "sinty"));
-    auth_has_tpm = g_file_test("/dev/tpmrm0", G_FILE_TEST_EXISTS) || g_file_test("/dev/tpm0", G_FILE_TEST_EXISTS);
     if (try_logo_file(logo)) return;
     if (try_logo_file(id)) return;
     try_logo_file("emblem-singularity");

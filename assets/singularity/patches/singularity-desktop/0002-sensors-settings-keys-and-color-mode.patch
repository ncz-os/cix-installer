From 8541b04ae0a49b239aa533575af258f6347de596 Mon Sep 17 00:00:00 2001
From: Jason Perlow <jperlow@gmail.com>
Date: Mon, 21 Sep 2026 16:30:54 -0400
Subject: [PATCH] schema: sensors settings keys + color-mode toggle

Adds the sensors-* keys the sensors plugin already reads via
schema.has_key() guards but that were never declared -- every one of
sensors-interval-seconds/show-frequency/show-utilization/grouped/
gpu-zone/cpu-zone has been silently falling through to hardcoded
defaults since the plugin shipped, because has_key() always returned
false against the undeclared keys.

Also adds sensors-color-mode ("rgb" default, "auto-contrast" the new
option): lets the sensors indicator use plain legible text instead of
severity-colored dots, per operator request.

Assisted-by: Claude Code:claude-sonnet-5
AI-Scope: Declared the missing sensors-* keys plus a new sensors-color-mode key.
---
 data/dev.sinty.desktop.gschema.xml | 35 ++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/data/dev.sinty.desktop.gschema.xml b/data/dev.sinty.desktop.gschema.xml
index 93f09bf..5f9f6ee 100644
--- a/data/dev.sinty.desktop.gschema.xml
+++ b/data/dev.sinty.desktop.gschema.xml
@@ -1090,5 +1090,40 @@
       <summary>Tablet button actions</summary>
       <description>Action for each tablet button (Pad, Pad2 to Pad9): a mouse button, none, action:NAME for a shell action or key:SHORTCUT for a keyboard shortcut. Missing buttons are sent to the app.</description>
     </key>
+    <key name="sensors-interval-seconds" type="i">
+      <default>3</default>
+      <summary>Sensors polling interval</summary>
+      <description>Seconds between sensor reads for the sensors panel indicator.</description>
+    </key>
+    <key name="sensors-show-frequency" type="b">
+      <default>true</default>
+      <summary>Show CPU clock frequency</summary>
+      <description>Whether the sensors indicator includes the current CPU clock speed.</description>
+    </key>
+    <key name="sensors-show-utilization" type="b">
+      <default>true</default>
+      <summary>Show CPU and memory utilization</summary>
+      <description>Whether the sensors indicator includes CPU and memory usage percentages.</description>
+    </key>
+    <key name="sensors-grouped" type="b">
+      <default>true</default>
+      <summary>Group sensors by family</summary>
+      <description>Whether the sensors popover collapses each sensor family to one aggregate row.</description>
+    </key>
+    <key name="sensors-gpu-zone" type="s">
+      <default>""</default>
+      <summary>GPU thermal zone name hint</summary>
+      <description>Overrides autodetection of which thermal zone is the GPU.</description>
+    </key>
+    <key name="sensors-cpu-zone" type="s">
+      <default>""</default>
+      <summary>CPU thermal zone name hint</summary>
+      <description>Overrides autodetection of which thermal zone is the CPU.</description>
+    </key>
+    <key name="sensors-color-mode" type="s">
+      <default>"rgb"</default>
+      <summary>Sensors indicator text color mode</summary>
+      <description>"rgb" colors each reading by severity (success/warning/error). "auto-contrast" renders plain, legible text using the panel's own foreground color instead of severity colors.</description>
+    </key>
   </schema>
 </schemalist>
-- 

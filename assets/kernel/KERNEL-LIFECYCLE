# NCZ-OS kernel lifecycle (promotion state), machine-readable. KEY=value.
# Read by build/check-kernel-lifecycle.py (run by verify-kernel-default-policy.sh
# Check 11 before any kernel is staged). Flow and rules: docs/RC-DEFINITION.md.
#
# WRITER: the kernel-ci promotion registry
# (<artifact store>/projects/kernel-ci/registry.json, states
# provisional -> boot-tested -> current; the previous current -> retired)
# regenerates this file on every promotion and opens a pin-bump branch that
# changes it together with the per-arch pins. Do not hand-edit it per release.
# The values below are the hand-written SEED (rc4, 2026-11-07), the first
# promotion; the registry takes over from it.
#
# Every committed pin for an arch must equal CURRENT_KVER_<arch> (and
# CURRENT_PKG_<arch> when set), must not be RETIRED and must not sort below
# MIN_VERSION (an -rcN sorts below its final release). An empty CURRENT_KVER_<arch>
# means no kernel is promoted for that arch: its builds are refused.
LIFECYCLE_SCHEMA=1
LIFECYCLE_SOURCE=seed-rc4-20261107

# Lowest upstream kernel version any default may pin.
MIN_VERSION=7.3.3

# amd64: T2 7.4.0-rc2-3 (forky rebuild 2026-11-10 of the 7.4.0-rc2-2 source;
# -2 was an Ubuntu-host build and is never promoted, 03:05Z order A), on the
# 7.4 kernel line (operator 2026-11-09 22:20Z). KVM boot gate PASS 2026-11-10
# (TYPHON k743-kvm-gate); HARDWARE PASS 2026-11-10 (DELL .70 + MEDUSA .38
# one-shot boots, 05:03Z). Registry t2-amd64 current = 7.4.0-rc2-t2-ncz+3
# (promoted 2026-11-10; 7.3.3-t2-ncz+r297 retired). Pool dir in
# amd64-stable-manifest.json.
CURRENT_KVER_amd64=7.3.3-t2-ncz
CURRENT_PKG_amd64=7.3.3-r297

# arm64: Sky1 7.4.0-rc2-sky1-ncz r299 (ULTRA non-git export build 2026-11-10,
# v7.4-rc2 7475ea8b, linux-cix kernel-dev/sky1-7.4-rc2-r3 f6950f68, 32 patches,
# localversion-ncz -sky1-ncz). CANDIDATE: KVM boot gate PASS (r299 staging),
# hardware boot PENDING (NEEDS 6) per the 2026-11-09 22:20Z order. Pool dir
# kernel-staging/r299-7.4.0-rc2-sky1-ncz-20261109 (assets/kernel/mainline.release).
CURRENT_KVER_arm64=7.4.0-rc2-sky1-ncz
CURRENT_PKG_arm64=7.4.0-rc2-sky1-ncz+r299

# Retired KVERs, comma-separated: never pinned again, on any arch.
# 7.3.3-t2-ncz retired at the amd64 7.4 line switch and 7.3.3-sky1-ncz at the
# arm64 one (candidate pin bumps; the rescue entry on installed hosts keeps the
# same kernel + accelerator blacklist per ONE-KERNEL, so nothing pins a retired
# KVER).
RETIRED=7.3.0-t2-ncz,7.3.1-t2-ncz,7.3.3-t2-ncz,7.3.0-sky1-ncz,7.3.1-sky1-ncz,7.3.3-sky1-ncz


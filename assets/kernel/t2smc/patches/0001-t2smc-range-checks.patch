diff --git a/src/t2smc_range.h b/src/t2smc_range.h
new file mode 100644
index 0000000..53d4e49
--- /dev/null
+++ b/src/t2smc_range.h
@@ -0,0 +1,103 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * t2smc_range.h - side-effect-free range validation for t2smc.
+ *
+ * The user-writable SMC surfaces (fan F%dMn/F%dTg, charge limit BCLM/CHLS/
+ * CHWA, RTC offset CLKO) are validated here. The helpers touch no kernel
+ * state, so the boundary logic is unit-testable from userspace with a stub
+ * reader (tests/test_t2smc_range.c).
+ */
+#ifndef _T2SMC_RANGE_H
+#define _T2SMC_RANGE_H
+
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/types.h>
+#else
+#include <errno.h>
+#include <stdbool.h>
+#endif
+
+/* Indices into fan_speed_fmt[] (see t2smc.c). */
+#define T2SMC_FAN_OPT_ACTUAL  0
+#define T2SMC_FAN_OPT_MIN     1
+#define T2SMC_FAN_OPT_MAX     2
+#define T2SMC_FAN_OPT_SAFE    3
+#define T2SMC_FAN_OPT_TARGET  4
+
+#ifndef T2SMC_CHWA_FIXED_LIMIT
+#define T2SMC_CHWA_FIXED_LIMIT 80
+#endif
+#ifndef T2SMC_RTC_BITS
+#define T2SMC_RTC_BITS 48
+#endif
+
+/* Reader callback used by t2smc_fan_write_check(); wraps t2smc_read_fan()
+ * in the driver and a table-backed stub in the unit test. */
+typedef int (*t2smc_fan_read_fn)(void *ctx, int fan_idx, int option,
+				 unsigned int *speed);
+
+/* Accept @val only inside the fan envelope; a fan_min write may not exceed
+ * the fan's current target either. */
+static inline bool t2smc_fan_speed_valid(unsigned int min, unsigned int max,
+					 unsigned int cur, unsigned int val,
+					 bool is_min)
+{
+	if (min > max)
+		return false;
+	if (val < min || val > max)
+		return false;
+	if (is_min && val > cur)
+		return false;
+	return true;
+}
+
+/* Read min/max/current-target via @read and validate @val. Returns 0 when
+ * acceptable, -EINVAL when out of range, or the reader's error. */
+static inline int t2smc_fan_write_check(t2smc_fan_read_fn read, void *ctx,
+					int fan_idx, unsigned int val,
+					bool is_min)
+{
+	unsigned int min, max, cur;
+	int ret;
+
+	ret = read(ctx, fan_idx, T2SMC_FAN_OPT_MIN, &min);
+	if (ret)
+		return ret;
+	ret = read(ctx, fan_idx, T2SMC_FAN_OPT_MAX, &max);
+	if (ret)
+		return ret;
+	ret = read(ctx, fan_idx, T2SMC_FAN_OPT_TARGET, &cur);
+	if (ret)
+		return ret;
+
+	if (!t2smc_fan_speed_valid(min, max, cur, val, is_min))
+		return -EINVAL;
+	return 0;
+}
+
+/* Only accept limits the SMC implements: CHLS keeps 0..100; CHWA-only
+ * hardware accepts the fixed 80 or off (100) and rejects the rest; BCLM-only
+ * hardware keeps 0..100. */
+static inline bool t2smc_charge_limit_valid(bool has_chls, bool has_chwa,
+					    unsigned int val)
+{
+	if (val > 100)
+		return false;
+	if (has_chls)
+		return true;
+	if (has_chwa)
+		return val == T2SMC_CHWA_FIXED_LIMIT || val == 100;
+	return true;
+}
+
+/* CLKO is a signed 48-bit offset in 1/32768 s units. */
+static inline bool t2smc_rtc_offset_valid(long long off)
+{
+	const long long lo = -(1LL << (T2SMC_RTC_BITS - 1));
+	const long long hi =  (1LL << (T2SMC_RTC_BITS - 1)) - 1;
+
+	return off >= lo && off <= hi;
+}
+
+#endif /* _T2SMC_RANGE_H */

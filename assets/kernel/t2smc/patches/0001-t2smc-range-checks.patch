+}
+
+/*
+ * Fan envelope for @channel: the factory snapshot captured at init, or the
+ * live F%dMn/F%dMx when the snapshot is unavailable (an SMC read failed at
+ * init).  Using the snapshot keeps a raised minimum from ratcheting the
+ * accepted floor upward.
+ */
+static int t2smc_fan_envelope(struct t2smc_device *t2, int channel,
+			      unsigned int *min, unsigned int *max)
+{
+	int ret;
+
+	if (channel < 0 || (unsigned int)channel >= t2->fan_count)
+		return -EINVAL;
+
+	if (t2->fan_min_factory) {
+		*min = t2->fan_min_factory[channel];
+		*max = t2->fan_max_factory[channel];
+		return 0;
+	}
+
+	ret = t2smc_read_fan(t2, channel, T2SMC_FAN_OPT_MIN, min);
+	if (ret)
+		return ret;
+	return t2smc_read_fan(t2, channel, T2SMC_FAN_OPT_MAX, max);
+}

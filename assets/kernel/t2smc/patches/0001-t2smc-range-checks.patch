+/*
+ * Snapshot the factory fan envelope once at init. The validator uses this
+ * (not the live F%dMn) so writing a new F%dMn cannot create a one-way
+ * ratchet that rejects a later, smaller min.
+ */
+static void t2smc_capture_fan_envelope(struct t2smc_device *t2)
+{
+	unsigned int *mins, *maxs;
+	unsigned int i;
+	int ret;
+
+	if (!t2->fan_count)
+		return;
+
+	mins = kcalloc(t2->fan_count, sizeof(*mins), GFP_KERNEL);
+	maxs = kcalloc(t2->fan_count, sizeof(*maxs), GFP_KERNEL);
+	if (!mins || !maxs) {
+		kfree(mins);
+		kfree(maxs);
+		dev_warn(t2->dev, "fan envelope allocation failed\n");
+		return;
+	}
+
+	for (i = 0; i < t2->fan_count; i++) {
+		ret = t2smc_read_fan(t2, i, T2SMC_FAN_OPT_MIN, &mins[i]);
+		if (ret)
+			goto out;
+		ret = t2smc_read_fan(t2, i, T2SMC_FAN_OPT_MAX, &maxs[i]);
+		if (ret)
+			goto out;
+	}
+
+	t2->fan_min_factory = mins;
+	t2->fan_max_factory = maxs;
+	return;
+out:
+	dev_warn(t2->dev,
+		 "fan envelope unavailable (%d); falling back to live limits\n",
+		 ret);
+	kfree(mins);
+	kfree(maxs);
+}

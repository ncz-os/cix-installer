diff --git a/t2smc_range.h b/t2smc_range.h
new file mode 100644
index 0000000..7ef4be6
--- /dev/null
+++ b/t2smc_range.h
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * t2smc_range.h - side-effect-free range validation for t2smc.
+ *
+ * The user-writable SMC surfaces (fan F%dMn/F%dTg, charge limit BCLM/CHLS/
+ * CHWA, RTC offset CLKO) are validated here.  The helpers touch no kernel
+ * state, so the boundary logic is unit-testable from userspace with a stub
+ * reader (tests/test_t2smc_range.c).
+ */
+#ifndef _T2SMC_RANGE_H
+#define _T2SMC_RANGE_H
+
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/types.h>
+#else
+#include <errno.h>
+#include <stdbool.h>
+#endif
+
+/* Indices into fan_speed_fmt[] (see t2smc.c). */
+#define T2SMC_FAN_OPT_ACTUAL  0
+#define T2SMC_FAN_OPT_MIN     1
+#define T2SMC_FAN_OPT_MAX     2
+#define T2SMC_FAN_OPT_SAFE    3
+#define T2SMC_FAN_OPT_TARGET  4
+
+#ifndef T2SMC_CHWA_FIXED_LIMIT
+#define T2SMC_CHWA_FIXED_LIMIT 80
+#endif
+#ifndef T2SMC_RTC_BITS
+#define T2SMC_RTC_BITS 48
+#endif
+
+/* Reader callback used by t2smc_fan_write_check(); wraps t2smc_read_fan()
+ * in the driver and a table-backed stub in the unit test. */
+typedef int (*t2smc_fan_read_fn)(void *ctx, int fan_idx, int option,
+				 unsigned int *speed);
+
+/*
+ * Accept @val only inside the factory envelope; @is_min writes may not
+ * exceed the current target unless the target is zero (the SMC reports
+ * stale/auto mode as zero).  Take @val as a signed long so a hwmon writer
+ * can hand us the original 64-bit value before narrowing to unsigned int -
+ * min/max comparisons against an unsigned int reject any negative input
+ * and any value above UINT_MAX.
+ */
+static inline bool t2smc_fan_speed_valid(unsigned int min, unsigned int max,
+					 unsigned int cur, long val,
+					 bool is_min)
+{
+	if (min > max)
+		return false;
+	if (val < (long)min || val > (long)max)
+		return false;
+	if (is_min && cur && val > (long)cur)
+		return false;
+	return true;
+}
+
+/*
+ * Validate a fan min/target write against the *factory* envelope captured at
+ * init.  Reading the live F%dMn as the floor would let a raised minimum
+ * ratchet one-way upward (a later, smaller minimum could never be written
+ * again); the factory snapshot keeps the floor fixed.
+ *
+ * The current target is read only for a minimum write.  A target write is
+ * validated purely against the envelope: reading F%dTg there would reject an
+ * otherwise-valid target whenever the SMC reports a stale zero or fails the
+ * read.  Returns 0 when acceptable, -EINVAL when out of range, or the
+ * reader's error.
+ */
+static inline int t2smc_fan_write_check(t2smc_fan_read_fn read, void *ctx,
+					int fan_idx, long val, bool is_min,
+					unsigned int envelope_min,
+					unsigned int envelope_max)
+{
+	unsigned int cur = 0;
+	int ret;
+
+	if (is_min) {
+		ret = read(ctx, fan_idx, T2SMC_FAN_OPT_TARGET, &cur);
+		if (ret)
+			return ret;
+	}
+
+	if (!t2smc_fan_speed_valid(envelope_min, envelope_max, cur, val,
+				   is_min))
+		return -EINVAL;
+	return 0;
+}
+
+/*
+ * Number of slots to allocate for the T..U temperature-discovery pass.
+ * Allocate the whole candidate range, not pass one's success count: a key
+ * that transiently failed pass one can succeed on pass two and would
+ * otherwise overrun a pass-one-sized array.
+ */
+static inline unsigned int t2smc_temp_alloc_count(unsigned int begin,
+						  unsigned int end)
+{
+	return end > begin ? end - begin : 0;
+}
+
+/* Only accept limits the SMC implements: CHLS keeps 0..100; CHWA-only
+ * hardware accepts the fixed 80 or off (100) and rejects the rest; BCLM-only
+ * hardware keeps 0..100. */
+static inline bool t2smc_charge_limit_valid(bool has_chls, bool has_chwa,
+					    unsigned int val)
+{
+	if (val > 100)
+		return false;
+	if (has_chls)
+		return true;
+	if (has_chwa)
+		return val == T2SMC_CHWA_FIXED_LIMIT || val == 100;
+	return true;
+}
+
+/* CLKO is a signed 48-bit offset in 1/32768 s units. */
+static inline bool t2smc_rtc_offset_valid(long long off)
+{
+	const long long lo = -(1LL << (T2SMC_RTC_BITS - 1));
+	const long long hi =  (1LL << (T2SMC_RTC_BITS - 1)) - 1;
+
+	return off >= lo && off <= hi;
+}
+
+/*
+ * Fold @off into the signed 48-bit CLKO register the SMC expects: keep the
+ * low T2SMC_RTC_BITS bits and sign-extend from bit T2SMC_RTC_BITS - 1.
+ *
+ * This intentionally preserves the pinned driver's modulo-and-sign-extend
+ * behaviour.  Unlike the validator, it never rejects; callers that need to
+ * reject out-of-range offsets must call t2smc_rtc_offset_valid() first.
+ */
+static inline long long t2smc_rtc_offset_wrap(long long off)
+{
+	const unsigned long long mask = (1ULL << T2SMC_RTC_BITS) - 1;
+	unsigned long long raw = (unsigned long long)off & mask;
+
+	if (raw & (1ULL << (T2SMC_RTC_BITS - 1)))
+		raw |= ~mask;
+	return (long long)raw;
+}
+
+#endif /* _T2SMC_RANGE_H */

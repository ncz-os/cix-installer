 			T2SMC_ADAPTER_POWER_OLD : T2SMC_ADAPTER_POWER;
 		ret = t2smc_read_scaled(t2, key, 1000000, &val);
+		if (ret)
+			return ret;
 		break;
 	default:
 		return -EINVAL;
 	}
 

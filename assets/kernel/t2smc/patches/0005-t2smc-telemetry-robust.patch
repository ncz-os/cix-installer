+++ b/t2smc.c
@@ -509,18 +509,45 @@ static int t2smc_read_scaled(struct t2smc_device *t2, const char *key,
 			return ret;
 
 		memcpy(&raw, buf, sizeof(raw));
+		/*
+		 * IEEE 754 special values (zero/exponent all-zeros,
+		 * infinity/exponent all-ones) yield an undefined
+		 * decode; clamp them to the appropriate extreme here
+		 * rather than letting the shift-and-multiply path
+		 * produce a meaningless sentinel.
+		 */
 		magnitude = (raw & GENMASK(22, 0)) | BIT(23);
 		exponent = ((raw >> 23) & 0xff) - 127 - 23;
+
+		/*
+		 * Exponent >= 63 will overflow a long after the scale
+		 * multiply and shift; saturate to the signed extreme.
+		 */
+		if (exponent >= 63) {
+			*val = raw & BIT(31) ? LONG_MIN : LONG_MAX;
+			return 0;
+		}
+
 		magnitude *= scale;
 
+		/*
+		 * After multiplying by @scale, magnitude may have grown
+		 * large enough that the subsequent left shift would
+		 * overflow u64.  Saturate so the final signed result is
+		 * always in range rather than silently wrapping.
+		 */
+		if (exponent > 0 &&
+		    (magnitude >> (64 - exponent)) != 0) {
+			*val = raw & BIT(31) ? LONG_MIN : LONG_MAX;
+			return 0;
+		}
+
 		if (exponent < -63)
 			magnitude = 0;
 		else if (exponent < 0)
 			magnitude >>= -exponent;
-		else if (exponent < 63)
-			magnitude <<= exponent;
 		else
-			magnitude = LONG_MAX;
+			magnitude <<= exponent;
 
 		*val = min_t(u64, magnitude, LONG_MAX);
 		if (raw & BIT(31))
@@ -1416,52 +1443,70 @@ static ssize_t t2smc_power_show(struct device *dev,
 		return sysfs_emit(buf, "%u\n", READ_ONCE(t2->power_status));
 	case T2SMC_POWER_CAPACITY:

# NCZ-OS unified kernel policy, machine-readable (2026-10-05).
# Read by build/verify-kernel-default-policy.sh. KEY=value, no spaces.
# Human text and rationale: docs/ONE-KERNEL.md
#
# ONE kernel, the SAME pinned build on every architecture. It is the
# DEFAULT boot kernel, the installer boot kernel, and the kernel the RESCUE
# entry boots. 7.2.x, and since 2026-11-16 the whole 7.3.x series, is retired
# everywhere: no default, no rescue, no edge, no installer, no previous-kernel
# entry, no apt component for the image. There is no EDGE channel any more.
#
# LINE DECISION (operator 2026-11-16, 26.10 Cygnus PR4: "release will use 7.4
# kernel, no edge and 7.3 will be retired"): the line is 7.4.x on BOTH arches
# and it is the ONLY line -- this supersedes the 2026-11-13 7.3.4 decision and
# cancels the earlier 7.4 line switch (the edge-kernel lane is cancelled and
# unmerged). The 7.4.0-rc3 base is ACCEPTED for this release; it must move to
# the final 7.4 kernel in a later PATCH release.
#
# The exact pinned version lives in the per-arch pins, all of which must equal
# the single source of truth assets/kernel/default-kernel.json:
#   arm64: assets/kernel/mainline.release (r303-7.4.0-rc3-sky1-ncz-20261115;
#          manifest variants.mainline.kver)
#   amd64: assets/kernel/amd64-stable/KVER + .PKGVERSION
# amd64 is 7.4.0-rc3-t2-ncz, package revision 7.4.0-rc3-4 (the rebuild that
# carries 7002 and the 7101-7107 AER/DPC series, replacing 9013; the earlier staged
# -1 and -2 debs are NOT the release kernel). arm64 is 7.4.0-rc3-sky1-ncz, package version 7.4.0-rc3-sky1-ncz+r303
# (kernel-staging/r303-7.4.0-rc3-sky1-ncz-20261115) -- MALI ONLY: the vendor
# Mali out-of-tree modules are built against this tree, CONFIG_DRM_PANTHOR is
# off and no panthor module or package is built.
# Which version may be pinned (MIN_VERSION, CURRENT, RETIRED) lives in
# assets/kernel/KERNEL-LIFECYCLE, written by the kernel-ci promotion registry.
DEFAULT_BASE=7.4

# An -rcN default is permitted ONLY while the pinned line version is still an
# -rcN and RC_DEFAULT_ALLOWED=1. The verifier fails if a default is an
# -rcN while this is 0, and also fails if this is 1 but the pinned version is
# no longer an -rcN (a stale allowance). The accepted 7.4.0-rc3 base keeps an
# -rcN default in play until the final 7.4 kernel ships in a PATCH release:
RC_DEFAULT_ALLOWED=1
RC_DEFAULT_EXPIRY_NOTE=7.4.0-rc3 accepted for 26.10 Cygnus PR4 (operator 2026-11-16); the final 7.4 kernel replaces the rc3 default in a later PATCH release

# RESCUE = the SAME pinned kernel as DEFAULT, not a separate series and not an
# older kernel. Its whole difference is the accelerator drivers blacklisted on
# the kernel command line (module_blacklist=...). RESCUE_SAME_KERNEL=1 means the
# verifier requires the rescue entry to load the default KVER and to carry the
# per-arch blacklist markers below.
RESCUE_SAME_KERNEL=1
# amd64 rescue blacklist when the target is an Apple T2 Mac: the panel is wired
# to the AMD dGPU on these machines, so amdgpu is KEPT (blacklisting it would be
# a black screen); only the other GPU/compute stacks are dropped.
RESCUE_AMD64_BLACKLIST_T2=nvidia,nvidia_drm,nvidia_modeset,nvidia_uvm,nouveau,radeon
# amd64 rescue blacklist on a generic (non-T2) PC: the panel is driven by
# amdgpu/radeon/i915/xe, so all discrete GPU stacks are dropped and the console
# stays on by simpledrm/efifb/fbdev. The decision is made on the target via
# assets/refind/ncz-t2-detect.sh.
RESCUE_AMD64_BLACKLIST_GENERIC=amdgpu,radeon,nouveau,nvidia,nvidia_drm,nvidia_modeset,nvidia_uvm
# arm64/Sky1 rescue blacklist: every CIX accelerator (GPU mali/panthor, VPU,
# NPU and their aliases), never the display controller (linlondp).
RESCUE_ARM64_BLACKLIST=panthor,panfrost,mali_kbase,memory_group_manager,protected_memory_allocator,amvx,aipu,armchina_npu,cix_vpu,linlon_vpu

# No EDGE channel any more (since 2026-10-05).
EDGE_ENABLED=0

# FRESHNESS ACKNOWLEDGEMENT. build/preflight-freshness-gate.sh refuses to
# build while assets/kernel/mainline is not the pool's newest staging build of
# the pinned line -- unless the operator has explicitly declined that newer
# build. Value = "<pinned-build>:<declined-newer-build>": BOTH names must match
# the resolved mainline pin AND the pool's newest build, so repointing mainline
# or any even-newer build still FAILs closed. Set only with explicit operator
# direction for this build.
#
# 2026-11-16 (26.10 Cygnus PR4): the pin is r303-7.4.0-rc3-sky1-ncz-20261115,
# the newest staged 7.4.0-rc3 build, so no acknowledgement is needed and the
# former r285:r286 ACK stays cleared. Re-add a
# MAINLINE_FRESHNESS_ACK=<pin>:<declined-newer> line only to decline a
# genuinely newer non-shipping build, with explicit operator direction.

# Retired kernels (<kver>+<rev>, '*' = every revision): generated from the kernel-ci
# promotion registry; a retired kernel can never be pinned again.
RETIRED_KERNELS_AMD64=7.3.0-t2-ncz+*,7.3.1-t2-ncz+r295,7.3.3-t2-ncz+r297-reinstate1,7.3.4-t2-ncz+r303,7.4.0-rc2-t2-ncz+*

# Retired kernels (<kver>+<rev>, '*' = every revision): generated from the kernel-ci
# promotion registry; a retired kernel can never be pinned again.
RETIRED_KERNELS_ARM64=7.3.0-sky1-ncz+r293,7.3.3-sky1-ncz+r298,7.3.4-sky1-ncz+r304,7.4.0-rc2-sky1-ncz+*


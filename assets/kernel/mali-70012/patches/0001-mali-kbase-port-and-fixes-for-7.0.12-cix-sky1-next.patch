+	 * the ncz72 BSP branch's rewrite of the same driver (see
+	 * MALI_KBASE_TARGETS_7_0_12_CIX_SKY1_NEXT_BACKPORT in
+	 * version_compat_defs.h for the general explanation of why this
+	 * kernel needs its own guard rather than a LINUX_VERSION_CODE
+	 * check). This kernel's scmi_perf_domain.c only exports
+	 * scmi_perf_domain_est_power()/scmi_perf_domain_power_scale(); it
+	 * has no equivalent of scmi_device_opp_table_parse() reachable from
+	 * outside the driver, so we cannot add SCMI OPPs for this device
+	 * ourselves. Instead, rely on whatever already populated
+	 * dev_pm_opp_get_opp_count() for kbdev->sky1_perf_dev: on this
+	 * platform, the SCMI perf-domain genpd attach already registers
+	 * OPPs via ACPI (the same mechanism the in-tree panthor GPU driver
+	 * relies on for its own DVFS on this exact kernel/hardware), so
+	 * this should already be non-zero by the time we get here. If it
+	 * is not, fail exactly like the upstream call would have on a
+	 * genuinely-empty OPP table, rather than silently disabling DVFS.
+	 */
+	if (dev_pm_opp_get_opp_count(kbdev->sky1_perf_dev) > 0) {
+		err = 0;
+		dev_info(kbdev->dev,
+			 "SKY1_7_0_12_OPP: OPP table already populated (%d entries); GPU DVFS scaling available.\n",
+			 dev_pm_opp_get_opp_count(kbdev->sky1_perf_dev));
+	} else {
+		/* Codex review flagged (adversarial review, 2026-07-26): the
+		 * caller chain (kbase_devfreq_init() -> kbase_backend_devfreq_init())
+		 * does NOT treat a non-zero return here as probe-fatal -- it logs
+		 * "Continuing without devfreq" and the module still loads, GPU
+		 * still runs, just pinned at whatever default/OPP-less clock the
+		 * platform leaves it at. That is silent from the outside unless
+		 * dmesg is actually checked, and for a performance A/B test that
+		 * would quietly invalidate the comparison rather than fail loudly.
+		 * This unique, grep-able marker exists specifically so a deploying/
+		 * testing agent MUST check dmesg for it before trusting any A/B
+		 * result from this 7.0.12 build: if this line is present, GPU
+		 * DVFS is NOT active and the run is not comparable to the 7.2
+		 * kernel's (or any DVFS-enabled kernel's) numbers.
+		 */
+		err = -ENODEV;
+		dev_err(kbdev->dev,
+			 "SKY1_7_0_12_OPP_MISSING: no OPP table for GPU perf domain and this kernel has no scmi_device_opp_table_parse() to populate one (see MALI_KBASE_TARGETS_7_0_12_CIX_SKY1_NEXT_BACKPORT); GPU DVFS will NOT scale -- do not trust A/B perf numbers from this boot without investigating.\n");
+	}
+#else
 	err = scmi_device_opp_table_parse(kbdev->sky1_perf_dev);
+#endif
 	if (err) {
 		dev_err(kbdev->dev, "Failed to parse opp table from scmi, err = %d.\n", err);
 		return err;

 	}
+out:
 	mutex_unlock(&gmux_data->index_lock);
 }
 
@@ -849,6 +872,7 @@ static int __gmux_set_discrete_state(struct apple_gmux_data *gmux_data,
 
 	mutex_lock(&gmux_data->power_lock);
 	reinit_completion(&gmux_data->powerchange_done);
+	gmux_data->last_mmio_error = 0;
 
 	if (state == VGA_SWITCHEROO_ON) {
 		if (gmux_data->use_pwrd_power_sequence &&
@@ -950,6 +974,19 @@ static int __gmux_set_discrete_state(struct apple_gmux_data *gmux_data,

# /etc/ncz/image-ci.env -- host-specific inputs for image-ci-poll.service
#
# READ THIS FIRST: EnvironmentFile files are read LITERALLY. systemd does not
# expand %h (or any specifier) here -- a value of "%h/..." would be passed through
# as that literal text. The unit therefore carries the %h default for the clone
# path in its ExecStart, where specifiers do work. Set NCZ_IMAGE_CI_REPO below
# ONLY if this host keeps its clone under a different name, and use an ABSOLUTE
# path. Existing clones: HYDRA ~/Projects/lieutenant-ncz-work/cix-430 and
# TYPHON ~/Projects/lieutenant-ncz-work/cix-459.
#NCZ_IMAGE_CI_REPO=/home/jasonperlow/Projects/lieutenant-ncz-work/cix-430
#
# Where the artifact store is visible on THIS host (absolute paths). HYDRA and
# TYPHON have no ARGONAS mount, so they point at a mirror of
# ncz-singularity-debs/ and ncz-screensavers-debs/; a host with /mnt/datapool
# mounted points there instead.
NCZ_PAYLOAD_SRC_ROOT=/home/jasonperlow/.cache/store-mirror
NCZ_SSPLUGIN_SRC_ROOT=/home/jasonperlow/.cache/store-mirror
#
# State file the poller remembers the last-seen values in (per host):
NCZ_IMAGE_CI_STATE=/home/jasonperlow/.cache/ncz-image-ci/state.json

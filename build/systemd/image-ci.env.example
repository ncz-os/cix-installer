# /etc/ncz/image-ci.env -- host-specific inputs for image-ci-poll.service
#
# The clone the poller runs from. %h expands to the invoking user's home, so the
# same example works on every build host as long as the clone keeps this name.
# Existing clones today: HYDRA ~/Projects/lieutenant-ncz-work/cix-430 and
# TYPHON ~/Projects/lieutenant-ncz-work/cix-459 -- rename the clone (or edit this
# line) so the two agree. Pointing this at a path that does not exist on the host
# makes the service fail at `cd` with "No such file or directory".
NCZ_IMAGE_CI_REPO=%h/Projects/lieutenant-ncz-work/cix-installer
#
# Where the artifact store is visible on THIS host. HYDRA and TYPHON have no
# ARGONAS mount, so they point at a mirror of ncz-singularity-debs/ and
# ncz-screensavers-debs/; a host with /mnt/datapool mounted points there.
NCZ_PAYLOAD_SRC_ROOT=%h/.cache/store-mirror
NCZ_SSPLUGIN_SRC_ROOT=%h/.cache/store-mirror
#
# State file the poller remembers the last-seen values in (per host):
NCZ_IMAGE_CI_STATE=%h/.cache/ncz-image-ci/state.json

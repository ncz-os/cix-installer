# /etc/ncz/image-ci.env -- host-specific inputs for image-ci-poll.service
#
# The repo the poller runs from (a checkout of cix-installer):
NCZ_IMAGE_CI_REPO=/home/jasonperlow/Projects/lieutenant-ncz-work/cix-461
#
# Where the artifact store is visible on THIS host. HYDRA and TYPHON have no
# ARGONAS mount, so they point at a mirror of ncz-singularity-debs/ and
# ncz-screensavers-debs/ ; a host with /mnt/datapool mounted points there.
NCZ_PAYLOAD_SRC_ROOT=/home/jasonperlow/.cache/store-mirror
NCZ_SSPLUGIN_SRC_ROOT=/home/jasonperlow/.cache/store-mirror
#
# State file the poller remembers the last-seen values in (per host):
NCZ_IMAGE_CI_STATE=/home/jasonperlow/.cache/ncz-image-ci/state.json

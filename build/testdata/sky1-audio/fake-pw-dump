#!/usr/bin/env python3
"""pw-dump stand-in: one Node per sink of the fake pactl state; names in "errored" are in state "error"."""

import json
import os

st = json.load(open(os.environ["FAKE_PA_STATE"]))
names = [s["name"] for s in st["native"]] + [m["sink"] for m in st["modules"]]
bad = set(st.get("errored", []))
print(json.dumps([
    {"id": 100 + i, "type": "PipeWire:Interface:Node",
     "info": {"state": "error" if n in bad else "suspended", "props": {"node.name": n, "media.class": "Audio/Sink"}}}
    for i, n in enumerate(names)
]))

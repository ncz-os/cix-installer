# build/screensavers-version.env -- single source of truth for the ncz-screensavers
# version floor enforced by:
#   post-install/59-ncz-screensavers-pkg.sh       (the install hook, runtime)
#   build/build-desktop-mirror.sh                 (the offline-mirror pool)
#   build/build-squashfs-layers.sh                (pre-flight: required in pool)
#   build/build-role-delta-mkosi.sh               (pre-flight: required in pool)
#   build/test-screensavers-mandatory-install.sh  (fail-before/pass-after gate)
#   build/verify-installed-target.sh              (the post-install assertion)
#
# Raise the floor here in ONE commit; every consumer reads it through the same
# helper. The published set on Buildkite Packages + Cloudflare R2 currently is
# ncz-screensavers 0.8.9 (amd64, arm64). 0.8.10 lands when the next operator
# package promotion publishes -- then bump this file and push.

# Minimum version the image must carry. Read by sourcing the file; compared with
# dpkg --compare-versions.
NCZ_SCREENSAVERS_MIN_VERSION=0.8.9

# Hard error message used everywhere the floor is violated. Keep it identical
# so operator logs are easy to scan for the same failure class.
NCZ_SCREENSAVERS_MISSING_MSG="ncz-screensavers is mandatory on desktop images; it is NOT in the offline mirror or has no candidate. Operator 2026-10-05: 'If we are distributing screensavers as Deb they need to be apt installed during installation.' Re-publish the package (oc-apt-publish) and rebuild the offline mirror."
NCZ_SCREENSAVERS_TOO_OLD_MSG="ncz-screensavers is too old for this image. The required minimum is in build/screensavers-version.env (NCZ_SCREENSAVERS_MIN_VERSION); rebuild with a newer published deb."

# Required product metadata inside the package's Published field. ncz-screensavers
# is published by Jason Perlow <jperlow@gmail.com>; we assert it to reject a
# mirrored wrong-source package.
NCZ_SCREENSAVERS_REQUIRED_MAINTAINER="Jason Perlow <jperlow@gmail.com>"
MACHINE ??= "cixmini"
DISTRO ?= "nclawzero"
PACKAGE_CLASSES ?= "package_rpm"
EXTRA_IMAGE_FEATURES ?= "debug-tweaks"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
BB_DISKMON_DIRS ??= "STOPTASKS,${TMPDIR},1G,100K HALT,${TMPDIR},100M,1K"
CONF_VERSION = "2"

# These tokens are replaced by build/ncz-yocto.sh. TMPDIR is deliberately on
# the host-local build bind; only the reusable downloads/sstate live on NFS.
DL_DIR = "@SHARED_CONTAINER@/downloads"
SSTATE_DIR = "@SHARED_CONTAINER@/sstate-cache"
TMPDIR = "@BUILD_CONTAINER@/tmp"

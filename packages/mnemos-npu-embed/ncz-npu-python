#!/bin/sh
# The interpreter that can drive the NPU. The system python is too new for the
# cix-noe-umd wheels (they pin >=3.11,<3.13). This is the same venv
# 47-embedkit.sh builds and installs libnoe + NOE_Engine into -- there is only
# one NPU-capable interpreter on the image, not one per consumer.
exec /opt/ncz/embed-venv/bin/python "$@"

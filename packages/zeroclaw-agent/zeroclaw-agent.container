[Unit]
Description=ZeroClaw Hive Worker (Podman Quadlet)
After=network-online.target

[Container]
Image=ghcr.io/zeroclaw-labs/zeroclaw:latest
EnvironmentFile=/etc/default/zeroclaw
# Bind to the 4 small, low-power cores (1.8 GHz) on Cix Sky1
CPUSetCPUs=4-7
# Hard cap memory to 512MB
Memory=512m
Network=host
# Optional: drop capabilities
DropCapability=all

[Install]
WantedBy=default.target

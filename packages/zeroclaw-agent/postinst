#!/bin/bash
set -e

# Copy the quadlet file to the systemd containers directory
mkdir -p /etc/containers/systemd
cp /usr/share/zeroclaw-agent/zeroclaw-agent.container /etc/containers/systemd/

# Copy the default config if it does not exist
if [ ! -f /etc/default/zeroclaw ]; then
    cp /usr/share/zeroclaw-agent/zeroclaw.default /etc/default/zeroclaw
fi

# Reload systemd to generate the service from the quadlet
systemctl daemon-reload
systemctl enable --now zeroclaw-agent.service

exit 0

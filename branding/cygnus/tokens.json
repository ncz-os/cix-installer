  "console": {
    "$comment": "Linux VT order: 0 black,1 red,2 green,3 brown/yellow,4 blue,5 magenta,6 cyan,7 light gray,8-15 bright. 'tty' is for the installed system (every foreground slot readable on slot 0). 'installer' is for the d-i boot only: slot 4 becomes the violet window surface that the newt palette paints dialogs on, so it is NOT a readable foreground there.",
    "tty": ["#0B0714", "#E8485F", "#2FC486", "#E0A93A", "#8C77FF", "#F03FA3", "#1FC3DD", "#CFC3E6",
            "#6E5C94", "#FF6A80", "#5EF0B0", "#FFD166", "#AE9DFF", "#FF7CC4", "#5DE8F8", "#F4EEFC"],
    "installer": ["#0B0714", "#E8485F", "#2FC486", "#E0A93A", "#2A1D45", "#C2177E", "#2ED8F0", "#CFC3E6",
                  "#6E5C94", "#FF6A80", "#5EF0B0", "#FFD166", "#AE9DFF", "#FF7CC4", "#8BEBF8", "#F4EEFC"]
  },
  "newt": {
    "$comment": "NEWT_COLORS for the d-i newt frontend, evaluated against console.installer. fg,bg names map to VT slots: black 0, red 1, green 2, brown 3, blue 4, magenta 5, cyan 6, lightgray 7, gray 8, brightred 9, brightgreen 10, yellow 11, brightblue 12, brightmagenta 13, brightcyan 14, white 15. Newt backgrounds may only use slots 0-7.",
    "palette": {
      "root": ["lightgray", "black"],
      "border": ["brightmagenta", "blue"],
      "window": ["white", "blue"],
      "shadow": ["black", "black"],
      "title": ["brightcyan", "blue"],
      "button": ["white", "magenta"],
      "actbutton": ["black", "cyan"],
      "compactbutton": ["white", "blue"],
      "checkbox": ["white", "blue"],
      "actcheckbox": ["black", "cyan"],
      "entry": ["white", "black"],
      "disentry": ["lightgray", "blue"],
      "label": ["white", "blue"],
      "listbox": ["white", "blue"],
      "actlistbox": ["black", "cyan"],
      "sellistbox": ["white", "magenta"],
      "actsellistbox": ["black", "cyan"],
      "textbox": ["white", "blue"],
      "acttextbox": ["black", "cyan"],
      "helpline": ["black", "cyan"],
      "roottext": ["brightcyan", "black"],
      "emptyscale": ["white", "black"],
      "fullscale": ["black", "magenta"]
    }
  },
  "boot": {

  "screensaver-palettes": {
    "$comment": "Proposed 'cygnus' palette for the Black Hole and shader savers. Each pair is (hot, cool) for accretion/emissive ramps: magenta carries the hot side, cyan the cool side, over the violet-black field. Consumed by LEAD 20 / the ncz-screensavers owners; not applied from this repo.",
    "cygnus": {
      "field": "#0B0714",
      "ramp": ["#0B0714", "#3A0B3A", "#A0106A", "#E8339A", "#FF9BD0", "#FFFFFF"],
      "cool-ramp": ["#0B0714", "#074452", "#0E8FA8", "#2ED8F0", "#8BEBF8", "#FFFFFF"],
      "pairs": [["#E8339A", "#2ED8F0"], ["#FF5CB4", "#13B6D1"], ["#C2177E", "#8BEBF8"], ["#FF9BD0", "#0E8FA8"]],
      "starfield-tint": "#CFC3E6",
      "photon-ring": "#FFE6F4"
    }
  },
  "singularity": {
    "$comment": "Values for Singularity's own settings (schema dev.sinty.desktop). libsingularity paints accent_bg_color = @accent_color with accent_fg_color = white, so ONE hex must carry white text (>= 4.5) and read as a UI indicator (>= 3.0) on every dark surface, including upstream's #242424 when no theme is active.",
    "accent-color": "custom",
    "custom-accent-color": "#D6208C",
    "custom-accent-colors": ["#D6208C", "#2ED8F0", "#FF5CB4", "#13B6D1", "#A0106A"],
    "theme-name": "Cygnus",
    "theme-mode": "dark",
    "upstream-dark-window-bg": "#242424",
    "upstream-dark-surface-bg": "#1E1E1E"
  },
  "contrast": {
    "$comment": "WCAG 2.x pairs [fg, bg, minimum]. 4.5 = AA body text, 3.0 = AA large text / UI component boundaries. Rule carried from the sensors-plugin contrast fix: text is always checked against the surface it actually sits on; never inherit a contrast guess from the upstream theme.",
    "text": 4.5,
    "ui": 3.0,
    "mode-pairs": [
      ["text", "bg", 4.5], ["text", "surface-1", 4.5], ["text", "surface-2", 4.5], ["text", "surface-3", 4.5],
      ["text-secondary", "bg", 4.5], ["text-secondary", "surface-2", 4.5], ["text-secondary", "surface-3", 4.5],
      ["text-muted", "bg", 4.5], ["text-muted", "surface-1", 4.5], ["text-muted", "surface-2", 4.5],
      ["accent", "bg", 4.5], ["accent", "surface-1", 4.5], ["accent", "surface-2", 4.5],
      ["accent-fg", "accent-bg", 4.5],
      ["secondary", "bg", 4.5], ["secondary", "surface-2", 4.5],
      ["secondary-fg", "secondary-bg", 4.5],
      ["link", "bg", 4.5], ["link", "surface-2", 4.5],
      ["selection-fg", "selection-bg", 4.5],
      ["success", "bg", 4.5], ["warning", "bg", 4.5], ["error", "bg", 4.5],
      ["on-status", "success", 4.5], ["on-status", "warning", 4.5], ["on-status", "error", 4.5],
      ["focus-ring", "bg", 3.0], ["focus-ring", "surface-2", 3.0],
      ["accent-bg", "bg", 3.0], ["border-strong", "bg", 3.0]
    ],
    "singularity-pairs": [
      ["#FFFFFF", "custom-accent-color", 4.5],
      ["custom-accent-color", "upstream-dark-window-bg", 3.0],
      ["custom-accent-color", "upstream-dark-surface-bg", 3.0],
      ["custom-accent-color", "dark.bg", 3.0],
      ["custom-accent-color", "dark.surface-2", 3.0]
    ]
  }
